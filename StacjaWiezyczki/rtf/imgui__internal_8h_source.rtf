520 {\cf17 inline} {\cf18 float}  ImSaturate({\cf18 float} f)                                       \{ {\cf19 return} (f < 0.0f) ? 0.0f : (f > 1.0f) ? 1.0f : f; \}\par
521 {\cf17 inline} {\cf18 float}  ImLengthSqr({\cf17 const} ImVec2& lhs)                            \{ {\cf19 return} (lhs.x * lhs.x) + (lhs.y * lhs.y); \}\par
