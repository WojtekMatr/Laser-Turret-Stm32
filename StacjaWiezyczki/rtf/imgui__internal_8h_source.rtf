526 {\cf17 inline} {\cf18 float}  ImFloor({\cf18 float} f)                                          \{ {\cf19 return} ({\cf18 float})((f >= 0 || (float)(int)f == f) ? (int)f : (int)f - 1); \} {\cf20 // Decent replacement for floorf()}\par
527 {\cf17 inline} ImVec2 ImFloor({\cf17 const} ImVec2& v)                                  \{ {\cf19 return} ImVec2(ImFloor(v.x), ImFloor(v.y)); \}\par
