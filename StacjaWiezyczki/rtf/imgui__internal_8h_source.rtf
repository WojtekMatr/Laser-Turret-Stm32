514 {\cf17 inline} ImVec2 ImMin({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)               \{ {\cf19 return} ImVec2(lhs.x < rhs.x ? lhs.x : rhs.x, lhs.y < rhs.y ? lhs.y : rhs.y); \}\par
515 {\cf17 inline} ImVec2 ImMax({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)               \{ {\cf19 return} ImVec2(lhs.x >= rhs.x ? lhs.x : rhs.x, lhs.y >= rhs.y ? lhs.y : rhs.y); \}\par
516 {\cf17 inline} ImVec2 ImClamp({\cf17 const} ImVec2& v, {\cf17 const} ImVec2&mn, {\cf17 const} ImVec2&mx)\{ {\cf19 return} ImVec2((v.x < mn.x) ? mn.x : (v.x > mx.x) ? mx.x : v.x, (v.y < mn.y) ? mn.y : (v.y > mx.y) ? mx.y : v.y); \}\par
517 {\cf17 inline} ImVec2 ImLerp({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf18 float} t)         \{ {\cf19 return} ImVec2(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t); \}\par
518 {\cf17 inline} ImVec2 ImLerp({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& t) \{ {\cf19 return} ImVec2(a.x + (b.x - a.x) * t.x, a.y + (b.y - a.y) * t.y); \}\par
