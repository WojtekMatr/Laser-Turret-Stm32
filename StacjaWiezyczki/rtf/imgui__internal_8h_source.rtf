851 {\cf21 #ifndef IM_DRAWLIST_ARCFAST_TABLE_SIZE}\par
852 {\cf21 #define IM_DRAWLIST_ARCFAST_TABLE_SIZE                          48 }{\cf20 // Number of samples in lookup table.}\par
