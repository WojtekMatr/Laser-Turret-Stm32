3828 {\cf20 // Refer to ImFontAtlasPackGetRect() to better understand how this works.}\par
3829 {\cf21 #define ImFontAtlasRectId_IndexMask_        (0x0007FFFF)    }{\cf20 // 20-bits signed: index to access builder->RectsIndex[].}\par
3830 {\cf21 #define ImFontAtlasRectId_GenerationMask_   (0x3FF00000)    }{\cf20 // 10-bits: entry generation, so each ID is unique and get can safely detected old identifiers.}\par
3831 {\cf21 #define ImFontAtlasRectId_GenerationShift_  (20)}\par
3832 {\cf17 inline} {\cf18 int}               ImFontAtlasRectId_GetIndex(ImFontAtlasRectId {\cf18 id})       \{ {\cf19 return} ({\cf18 id} & ImFontAtlasRectId_IndexMask_); \}\par
3833 {\cf17 inline} {\cf18 unsigned} {\cf18 int}      ImFontAtlasRectId_GetGeneration(ImFontAtlasRectId {\cf18 id})  \{ {\cf19 return} ({\cf18 unsigned} {\cf18 int})({\cf18 id} & ImFontAtlasRectId_GenerationMask_) >> ImFontAtlasRectId_GenerationShift_; \}\par
3834 {\cf17 inline} ImFontAtlasRectId ImFontAtlasRectId_Make({\cf18 int} index_idx, {\cf18 int} gen_idx)     \{ IM_ASSERT(index_idx >= 0 && index_idx <= ImFontAtlasRectId_IndexMask_ && gen_idx <= (ImFontAtlasRectId_GenerationMask_ >> ImFontAtlasRectId_GenerationShift_)); {\cf19 return} (ImFontAtlasRectId)(index_idx | (gen_idx << ImFontAtlasRectId_GenerationShift_)); \}\par
3835 \par
3836 {\cf20 // Packed rectangle lookup entry (we need an indirection to allow removing/reordering rectangles)}\par
3837 {\cf20 // User are returned ImFontAtlasRectId values which are meant to be persistent.}\par
3838 {\cf20 // We handle this with an indirection. While Rects[] may be in theory shuffled, compacted etc., RectsIndex[] cannot it is keyed by ImFontAtlasRectId.}\par
3839 {\cf20 // RectsIndex[] is used both as an index into Rects[] and an index into itself. This is basically a free-list. See ImFontAtlasBuildAllocRectIndexEntry() code.}\par
3840 {\cf20 // Having this also makes it easier to e.g. sort rectangles during repack.}\par
3841 {\cf17 struct }ImFontAtlasRectEntry\par
3842 \{\par
3843     {\cf18 int}                 TargetIndex : 20;   {\cf20 // When Used: ImFontAtlasRectId -> into Rects[]. When unused: index to next unused RectsIndex[] slot to consume free-list.}\par
3844     {\cf18 unsigned} {\cf18 int}        Generation : 10;    {\cf20 // Increased each time the entry is reused for a new rectangle.}\par
3845     {\cf18 unsigned} {\cf18 int}        IsUsed : 1;\par
3846 \};\par
