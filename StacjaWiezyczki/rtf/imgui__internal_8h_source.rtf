504 {\cf20 // - ImMin/ImMax/ImClamp/ImLerp/ImSwap are used by widgets which support variety of types: signed/unsigned int/long long float/double}\par
505 {\cf20 // (Exceptionally using templates here but we could also redefine them for those types)}\par
506 {\cf17 template}<{\cf17 typename} T> T ImMin(T lhs, T rhs)                              \{ {\cf19 return} lhs < rhs ? lhs : rhs; \}\par
507 {\cf17 template}<{\cf17 typename} T> T ImMax(T lhs, T rhs)                              \{ {\cf19 return} lhs >= rhs ? lhs : rhs; \}\par
508 {\cf17 template}<{\cf17 typename} T> T ImClamp(T v, T mn, T mx)                         \{ {\cf19 return} (v < mn) ? mn : (v > mx) ? mx : v; \}\par
509 {\cf17 template}<{\cf17 typename} T> T ImLerp(T a, T b, {\cf18 float} t)                        \{ {\cf19 return} (T)(a + (b - a) * t); \}\par
510 {\cf17 template}<{\cf17 typename} T> {\cf18 void} ImSwap(T& a, T& b)                            \{ T tmp = a; a = b; b = tmp; \}\par
511 {\cf17 template}<{\cf17 typename} T> T ImAddClampOverflow(T a, T b, T mn, T mx)         \{ {\cf19 if} (b < 0 && (a < mn - b)) {\cf19 return} mn; {\cf19 if} (b > 0 && (a > mx - b)) {\cf19 return} mx; {\cf19 return} a + b; \}\par
512 {\cf17 template}<{\cf17 typename} T> T ImSubClampOverflow(T a, T b, T mn, T mx)         \{ {\cf19 if} (b > 0 && (a < mn + b)) {\cf19 return} mn; {\cf19 if} (b < 0 && (a > mx + b)) {\cf19 return} mx; {\cf19 return} a - b; \}\par
