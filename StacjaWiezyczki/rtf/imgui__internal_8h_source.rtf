787 {\cf20 // Helper: ImChunkStream<>}\par
788 {\cf20 // Build and iterate a contiguous stream of variable-sized structures.}\par
789 {\cf20 // This is used by Settings to store persistent data while reducing allocation count.}\par
790 {\cf20 // We store the chunk size first, and align the final size on 4 bytes boundaries.}\par
791 {\cf20 // The tedious/zealous amount of casting is to avoid -Wcast-align warnings.}\par
792 {\cf17 template}<{\cf17 typename} T>\par
793 {\cf17 struct }ImChunkStream\par
794 \{\par
795     ImVector<char>  Buf;\par
796 \par
797     {\cf18 void}    clear()                     \{ Buf.clear(); \}\par
798     {\cf18 bool}    empty(){\cf17  const               }\{ {\cf19 return} Buf.Size == 0; \}\par
799     {\cf18 int}     size(){\cf17  const                }\{ {\cf19 return} Buf.Size; \}\par
800     T*      alloc_chunk({\cf18 size_t} sz)      \{ {\cf18 size_t} HDR_SZ = 4; sz = IM_MEMALIGN(HDR_SZ + sz, 4u); {\cf18 int} off = Buf.Size; Buf.resize(off + ({\cf18 int})sz); (({\cf18 int}*)({\cf18 void}*)(Buf.Data + off))[0] = (int)sz; {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + off + ({\cf18 int})HDR_SZ); \}\par
801     T*      begin()                     \{ {\cf18 size_t} HDR_SZ = 4; {\cf19 if} (!Buf.Data) {\cf19 return} NULL; {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + HDR_SZ); \}\par
802     T*      next_chunk(T* p)            \{ {\cf18 size_t} HDR_SZ = 4; IM_ASSERT(p >= begin() && p < end()); p = (T*)({\cf18 void}*)(({\cf18 char}*)({\cf18 void}*)p + chunk_size(p)); {\cf19 if} (p == (T*)({\cf18 void}*)(({\cf18 char}*)end() + HDR_SZ)) {\cf19 return} (T*)0; IM_ASSERT(p < end()); {\cf19 return} p; \}\par
803     {\cf18 int}     chunk_size({\cf17 const} T* p)      \{ {\cf19 return} (({\cf17 const} {\cf18 int}*)p)[-1]; \}\par
804     T*      end()                       \{ {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + Buf.Size); \}\par
805     {\cf18 int}     offset_from_ptr({\cf17 const} T* p) \{ IM_ASSERT(p >= begin() && p < end()); {\cf17 const} ptrdiff_t off = ({\cf17 const} {\cf18 char}*)p - Buf.Data; {\cf19 return} ({\cf18 int})off; \}\par
806     T*      ptr_from_offset({\cf18 int} off)    \{ IM_ASSERT(off >= 4 && off < Buf.Size); {\cf19 return} (T*)({\cf18 void}*)(Buf.Data + off); \}\par
807     {\cf18 void}    swap(ImChunkStream<T>& rhs) \{ rhs.Buf.swap(Buf); \}\par
808 \};\par
