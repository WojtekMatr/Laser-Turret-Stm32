618 {\cf20 // Helper: ImBitArray}\par
619 {\cf21 #define         IM_BITARRAY_TESTBIT(_ARRAY, _N)                 ((_ARRAY[(_N) >> 5] & ((ImU32)1 << ((_N) & 31))) != 0) }{\cf20 // Macro version of ImBitArrayTestBit(): ensure args have side-effect or are costly!}\par
620 {\cf21 #define         IM_BITARRAY_CLEARBIT(_ARRAY, _N)                ((_ARRAY[(_N) >> 5] &= ~((ImU32)1 << ((_N) & 31))))    }{\cf20 // Macro version of ImBitArrayClearBit(): ensure args have side-effect or are costly!}\par
621 {\cf17 inline} {\cf18 size_t}   ImBitArrayGetStorageSizeInBytes({\cf18 int} bitcount)   \{ {\cf19 return} ({\cf18 size_t})((bitcount + 31) >> 5) << 2; \}\par
622 {\cf17 inline} {\cf18 void}     ImBitArrayClearAllBits(ImU32* arr, {\cf18 int} bitcount)\{ memset(arr, 0, ImBitArrayGetStorageSizeInBytes(bitcount)); \}\par
623 {\cf17 inline} {\cf18 bool}     ImBitArrayTestBit({\cf17 const} ImU32* arr, {\cf18 int} n)      \{ ImU32 mask = (ImU32)1 << (n & 31); {\cf19 return} (arr[n >> 5] & mask) != 0; \}\par
624 {\cf17 inline} {\cf18 void}     ImBitArrayClearBit(ImU32* arr, {\cf18 int} n)           \{ ImU32 mask = (ImU32)1 << (n & 31); arr[n >> 5] &= ~mask; \}\par
625 {\cf17 inline} {\cf18 void}     ImBitArraySetBit(ImU32* arr, {\cf18 int} n)             \{ ImU32 mask = (ImU32)1 << (n & 31); arr[n >> 5] |= mask; \}\par
626 {\cf17 inline} {\cf18 void}     ImBitArraySetBitRange(ImU32* arr, {\cf18 int} n, {\cf18 int} n2) {\cf20 // Works on range [n..n2)}\par
627 \{\par
628     n2--;\par
629     {\cf19 while} (n <= n2)\par
630     \{\par
631         {\cf18 int} a_mod = (n & 31);\par
632         {\cf18 int} b_mod = (n2 > (n | 31) ? 31 : (n2 & 31)) + 1;\par
633         ImU32 mask = (ImU32)(((ImU64)1 << b_mod) - 1) & ~(ImU32)(((ImU64)1 << a_mod) - 1);\par
634         arr[n >> 5] |= mask;\par
635         n = (n + 32) & ~31;\par
636     \}\par
637 \}\par
638 \par
639 {\cf17 typedef} ImU32* ImBitArrayPtr; {\cf20 // Name for use in structs}\par
640 \par
641 {\cf20 // Helper: ImBitArray class (wrapper over ImBitArray functions)}\par
642 {\cf20 // Store 1-bit per value.}\par
643 {\cf17 template}<{\cf18 int} BITCOUNT, {\cf18 int} OFFSET = 0>\par
644 {\cf17 struct }ImBitArray\par
645 \{\par
646     ImU32           Data[(BITCOUNT + 31) >> 5];\par
647     ImBitArray()                                \{ ClearAllBits(); \}\par
648     {\cf18 void}            ClearAllBits()              \{ memset(Data, 0, {\cf17 sizeof}(Data)); \}\par
649     {\cf18 void}            SetAllBits()                \{ memset(Data, 255, {\cf17 sizeof}(Data)); \}\par
650     {\cf18 bool}            TestBit({\cf18 int} n){\cf17  const        }\{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); {\cf19 return} IM_BITARRAY_TESTBIT(Data, n); \}\par
651     {\cf18 void}            SetBit({\cf18 int} n)               \{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); ImBitArraySetBit(Data, n); \}\par
652     {\cf18 void}            ClearBit({\cf18 int} n)             \{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); ImBitArrayClearBit(Data, n); \}\par
653     {\cf18 void}            SetBitRange({\cf18 int} n, {\cf18 int} n2)  \{ n += OFFSET; n2 += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT && n2 > n && n2 <= BITCOUNT); ImBitArraySetBitRange(Data, n, n2); \} {\cf20 // Works on range [n..n2)}\par
654     {\cf18 bool}            operator[]({\cf18 int} n){\cf17  const     }\{ n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); {\cf19 return} IM_BITARRAY_TESTBIT(Data, n); \}\par
655 \};\par
