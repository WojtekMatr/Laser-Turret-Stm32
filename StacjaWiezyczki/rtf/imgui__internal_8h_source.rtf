721 {\cf20 // Helper: ImStableVector<>}\par
722 {\cf20 // Allocating chunks of BLOCKSIZE items. Objects pointers are never invalidated when growing, only by clear().}\par
723 {\cf20 // Important: does not destruct anything!}\par
724 {\cf20 // Implemented only the minimum set of functions we need for it.}\par
725 {\cf17 template}<{\cf17 typename} T, {\cf18 int} BLOCKSIZE>\par
726 {\cf17 struct }ImStableVector\par
727 \{\par
728     {\cf18 int}                 Size = 0;\par
729     {\cf18 int}                 Capacity = 0;\par
730     ImVector<T*>        Blocks;\par
731 \par
732     {\cf20 // Functions}\par
733     {\cf17 inline} ~ImStableVector()                        \{ {\cf19 for} (T* block : Blocks) IM_FREE(block); \}\par
734 \par
735     {\cf17 inline} {\cf18 void}         clear()                     \{ Size = Capacity = 0; Blocks.clear_delete(); \}\par
736     {\cf17 inline} {\cf18 void}         resize({\cf18 int} new_size)        \{ {\cf19 if} (new_size > Capacity) reserve(new_size); Size = new_size; \}\par
737     {\cf17 inline} {\cf18 void}         reserve({\cf18 int} new_cap)\par
738     \{\par
739         new_cap = IM_MEMALIGN(new_cap, BLOCKSIZE);\par
740         {\cf18 int} old_count = Capacity / BLOCKSIZE;\par
741         {\cf18 int} new_count = new_cap / BLOCKSIZE;\par
742         {\cf19 if} (new_count <= old_count)\par
743             {\cf19 return};\par
744         Blocks.resize(new_count);\par
745         {\cf19 for} ({\cf18 int} n = old_count; n < new_count; n++)\par
746             Blocks[n] = (T*)IM_ALLOC({\cf17 sizeof}(T) * BLOCKSIZE);\par
747         Capacity = new_cap;\par
748     \}\par
749     {\cf17 inline} T&           operator[]({\cf18 int} i)           \{ IM_ASSERT(i >= 0 && i < Size); {\cf19 return} Blocks[i / BLOCKSIZE][i % BLOCKSIZE]; \}\par
750     {\cf17 inline} {\cf17 const} T&     operator[]({\cf18 int} i){\cf17  const     }\{ IM_ASSERT(i >= 0 && i < Size); {\cf19 return} Blocks[i / BLOCKSIZE][i % BLOCKSIZE]; \}\par
751     {\cf17 inline} T*           push_back({\cf17 const} T& v)       \{ {\cf18 int} i = Size; IM_ASSERT(i >= 0); {\cf19 if} (Size == Capacity) reserve(Capacity + BLOCKSIZE); {\cf18 void}* ptr = &Blocks[i / BLOCKSIZE][i % BLOCKSIZE]; memcpy(ptr, &v, {\cf17 sizeof}(v)); Size++; {\cf19 return} (T*)ptr; \}\par
752 \};\par
753 \par
754 {\cf20 // Helper: ImPool<>}\par
755 {\cf20 // Basic keyed storage for contiguous instances, slow/amortized insertion, O(1) indexable, O(Log N) queries by ID over a dense/hot buffer,}\par
756 {\cf20 // Honor constructor/destructor. Add/remove invalidate all pointers. Indexes have the same lifetime as the associated object.}\par
757 {\cf17 typedef} {\cf18 int} ImPoolIdx;\par
758 {\cf17 template}<{\cf17 typename} T>\par
759 {\cf17 struct }ImPool\par
760 \{\par
761     ImVector<T>     Buf;        {\cf20 // Contiguous data}\par
762     ImGuiStorage    Map;        {\cf20 // ID->Index}\par
763     ImPoolIdx       FreeIdx;    {\cf20 // Next free idx to use}\par
764     ImPoolIdx       AliveCount; {\cf20 // Number of active/alive items (for display purpose)}\par
765 \par
766     ImPool()    \{ FreeIdx = AliveCount = 0; \}\par
767     ~ImPool()   \{ Clear(); \}\par
768     T*          GetByKey(ImGuiID key)               \{ {\cf18 int} idx = Map.GetInt(key, -1); {\cf19 return} (idx != -1) ? &Buf[idx] : NULL; \}\par
769     T*          GetByIndex(ImPoolIdx n)             \{ {\cf19 return} &Buf[n]; \}\par
770     ImPoolIdx   GetIndex({\cf17 const} T* p){\cf17  const          }\{ IM_ASSERT(p >= Buf.Data && p < Buf.Data + Buf.Size); {\cf19 return} (ImPoolIdx)(p - Buf.Data); \}\par
771     T*          GetOrAddByKey(ImGuiID key)          \{ {\cf18 int}* p_idx = Map.GetIntRef(key, -1); {\cf19 if} (*p_idx != -1) {\cf19 return} &Buf[*p_idx]; *p_idx = FreeIdx; {\cf19 return} Add(); \}\par
772     {\cf18 bool}        Contains({\cf17 const} T* p){\cf17  const          }\{ {\cf19 return} (p >= Buf.Data && p < Buf.Data + Buf.Size); \}\par
773     {\cf18 void}        Clear()                             \{ {\cf19 for} ({\cf18 int} n = 0; n < Map.Data.Size; n++) \{ {\cf18 int} idx = Map.Data[n].val_i; {\cf19 if} (idx != -1) Buf[idx].~T(); \} Map.Clear(); Buf.clear(); FreeIdx = AliveCount = 0; \}\par
774     T*          Add()                               \{ {\cf18 int} idx = FreeIdx; {\cf19 if} (idx == Buf.Size) \{ Buf.resize(Buf.Size + 1); FreeIdx++; \} {\cf19 else} \{ FreeIdx = *({\cf18 int}*)&Buf[idx]; \} IM_PLACEMENT_NEW(&Buf[idx]) T(); AliveCount++; {\cf19 return} &Buf[idx]; \}\par
775     {\cf18 void}        Remove(ImGuiID key, {\cf17 const} T* p)     \{ Remove(key, GetIndex(p)); \}\par
776     {\cf18 void}        Remove(ImGuiID key, ImPoolIdx idx)  \{ Buf[idx].~T(); *({\cf18 int}*)&Buf[idx] = FreeIdx; FreeIdx = idx; Map.SetInt(key, -1); AliveCount--; \}\par
777     {\cf18 void}        Reserve({\cf18 int} capacity)               \{ Buf.reserve(capacity); Map.Data.reserve(capacity); \}\par
778 \par
779     {\cf20 // To iterate a ImPool: for (int n = 0; n < pool.GetMapSize(); n++) if (T* t = pool.TryGetMapData(n)) \{ ... \}}\par
780     {\cf20 // Can be avoided if you know .Remove() has never been called on the pool, or AliveCount == GetMapSize()}\par
