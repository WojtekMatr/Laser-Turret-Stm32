3823 {\cf20 // Helpers: ImTextureRef ==/!= operators provided as convenience}\par
3824 {\cf20 // (note that _TexID and _TexData are never set simultaneously)}\par
3825 {\cf17 inline} {\cf18 bool} operator==({\cf17 const} ImTextureRef& lhs, {\cf17 const} ImTextureRef& rhs)    \{ {\cf19 return} lhs._TexID == rhs._TexID && lhs._TexData == rhs._TexData; \}\par
3826 {\cf17 inline} {\cf18 bool} operator!=({\cf17 const} ImTextureRef& lhs, {\cf17 const} ImTextureRef& rhs)    \{ {\cf19 return} lhs._TexID != rhs._TexID || lhs._TexData != rhs._TexData; \}\par
