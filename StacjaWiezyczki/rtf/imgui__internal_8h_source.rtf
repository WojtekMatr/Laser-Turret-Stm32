2054 \par
2055 {\cf20 // Macros used by Recoverable Error handling}\par
2056 {\cf20 // - Only dispatch error if _EXPR: evaluate as assert (similar to an assert macro).}\par
2057 {\cf20 // - The message will always be a string literal, in order to increase likelihood of being display by an assert handler.}\par
2058 {\cf20 // - See 'Demo->Configuration->Error Handling' and ImGuiIO definitions for details on error handling.}\par
2059 {\cf20 // - Read https://github.com/ocornut/imgui/wiki/Error-Handling for details on error handling.}\par
2060 {\cf21 #ifndef IM_ASSERT_USER_ERROR}\par
2061 {\cf21 #define IM_ASSERT_USER_ERROR(_EXPR,_MSG)            do \{ if (!(_EXPR)) \{ if (ImGui::ErrorLog(_MSG)) \{ IM_ASSERT((_EXPR) && _MSG); \} \} \} while (0)               }{\cf20 // Recoverable User Error}\par
2062 {\cf21 #define IM_ASSERT_USER_ERROR_RET(_EXPR,_MSG)        do \{ if (!(_EXPR)) \{ if (ImGui::ErrorLog(_MSG)) \{ IM_ASSERT((_EXPR) && _MSG); \} return; \} \} while (0)       }{\cf20 // Recoverable User Error}\par
2063 {\cf21 #define IM_ASSERT_USER_ERROR_RETV(_EXPR,_RETV,_MSG) do \{ if (!(_EXPR)) \{ if (ImGui::ErrorLog(_MSG)) \{ IM_ASSERT((_EXPR) && _MSG); \} return _RETV; \} \} while (0) }{\cf20 // Recoverable User Error}\par
2064 {\cf21 #endif}\par
2065 \par
2066 {\cf20 // The error callback is currently not public, as it is expected that only advanced users will rely on it.}\par
2067 {\cf17 typedef} void (*ImGuiErrorCallback)(ImGuiContext* ctx, {\cf18 void}* user_data, {\cf17 const} {\cf18 char}* msg); {\cf20 // Function signature for g.ErrorCallback}\par
