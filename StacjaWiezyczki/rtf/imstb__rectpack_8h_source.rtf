4 {\cf20 // }\par
5 {\cf20 // stb_rect_pack.h - v1.01 - public domain - rectangle packing}\par
6 {\cf20 // Sean Barrett 2014}\par
7 {\cf20 //}\par
8 {\cf20 // Useful for e.g. packing rectangular textures into an atlas.}\par
9 {\cf20 // Does not do rotation.}\par
10 {\cf20 //}\par
11 {\cf20 // Before #including,}\par
12 {\cf20 //}\par
13 {\cf20 //    #define STB_RECT_PACK_IMPLEMENTATION}\par
14 {\cf20 //}\par
15 {\cf20 // in the file that you want to have the implementation.}\par
16 {\cf20 //}\par
17 {\cf20 // Not necessarily the awesomest packing method, but better than}\par
18 {\cf20 // the totally naive one in stb_truetype (which is primarily what}\par
19 {\cf20 // this is meant to replace).}\par
20 {\cf20 //}\par
21 {\cf20 // Has only had a few tests run, may have issues.}\par
22 {\cf20 //}\par
23 {\cf20 // More docs to come.}\par
24 {\cf20 //}\par
25 {\cf20 // No memory allocations; uses qsort() and assert() from stdlib.}\par
26 {\cf20 // Can override those by defining STBRP_SORT and STBRP_ASSERT.}\par
27 {\cf20 //}\par
28 {\cf20 // This library currently uses the Skyline Bottom-Left algorithm.}\par
29 {\cf20 //}\par
30 {\cf20 // Please note: better rectangle packers are welcome! Please}\par
31 {\cf20 // implement them to the same API, but with a different init}\par
32 {\cf20 // function.}\par
33 {\cf20 //}\par
34 {\cf20 // Credits}\par
