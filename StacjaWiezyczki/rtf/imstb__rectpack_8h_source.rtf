341 {\cf17 typedef} {\cf17 struct}\par
342 \{\par
343    {\cf18 int} x,y;\par
344    stbrp_node **prev_link;\par
345 \} stbrp__findresult;\par
346 \par
347 {\cf17 static} stbrp__findresult stbrp__skyline_find_best_pos(stbrp_context *c, {\cf18 int} width, {\cf18 int} height)\par
348 \{\par
349    {\cf18 int} best_waste = (1<<30), best_x, best_y = (1 << 30);\par
350    stbrp__findresult fr;\par
351    stbrp_node **prev, *node, *tail, **best = NULL;\par
352 \par
353    {\cf20 // align to multiple of c->align}\par
354    width = (width + c->align - 1);\par
355    width -= width % c->align;\par
356    STBRP_ASSERT(width % c->align == 0);\par
357 \par
358    {\cf20 // if it can't possibly fit, bail immediately}\par
359    {\cf19 if} (width > c->width || height > c->height) \{\par
360       fr.prev_link = NULL;\par
361       fr.x = fr.y = 0;\par
362       {\cf19 return} fr;\par
363    \}\par
364 \par
365    node = c->active_head;\par
366    prev = &c->active_head;\par
367    {\cf19 while} (node->x + width <= c->width) \{\par
368       {\cf18 int} y,waste;\par
369       y = stbrp__skyline_find_min_y(c, node, node->x, width, &waste);\par
370       {\cf19 if} (c->heuristic == STBRP_HEURISTIC_Skyline_BL_sortHeight) \{ {\cf20 // actually just want to test BL}\par
371          {\cf20 // bottom left}\par
372          {\cf19 if} (y < best_y) \{\par
373             best_y = y;\par
374             best = prev;\par
375          \}\par
376       \} {\cf19 else} \{\par
377          {\cf20 // best-fit}\par
378          {\cf19 if} (y + height <= c->height) \{\par
379             {\cf20 // can only use it if it first vertically}\par
380             {\cf19 if} (y < best_y || (y == best_y && waste < best_waste)) \{\par
381                best_y = y;\par
382                best_waste = waste;\par
383                best = prev;\par
384             \}\par
385          \}\par
386       \}\par
387       prev = &node->next;\par
388       node = node->next;\par
389    \}\par
390 \par
391    best_x = (best == NULL) ? 0 : (*best)->x;\par
392 \par
393    {\cf20 // if doing best-fit (BF), we also have to try aligning right edge to each node position}\par
394    {\cf20 //}\par
395    {\cf20 // e.g, if fitting}\par
396    {\cf20 //}\par
397    {\cf20 //     ____________________}\par
398    {\cf20 //    |____________________|}\par
399    {\cf20 //}\par
400    {\cf20 //            into}\par
401    {\cf20 //}\par
402    {\cf20 //   |                         |}\par
403    {\cf20 //   |             ____________|}\par
404    {\cf20 //   |____________|}\par
405    {\cf20 //}\par
406    {\cf20 // then right-aligned reduces waste, but bottom-left BL is always chooses left-aligned}\par
407    {\cf20 //}\par
408    {\cf20 // This makes BF take about 2x the time}\par
409 \par
410    {\cf19 if} (c->heuristic == STBRP_HEURISTIC_Skyline_BF_sortHeight) \{\par
411       tail = c->active_head;\par
412       node = c->active_head;\par
413       prev = &c->active_head;\par
414       {\cf20 // find first node that's admissible}\par
415       while (tail->x < width)\par
416          tail = tail->next;\par
417       while (tail) \{\par
418          int xpos = tail->x - width;\par
419          int y,waste;\par
420          STBRP_ASSERT(xpos >= 0);\par
421          {\cf20 // find the left position that matches this}\par
422          while (node->next->x <= xpos) \{\par
423             prev = &node->next;\par
424             node = node->next;\par
425          \}\par
426          STBRP_ASSERT(node->next->x > xpos && node->x <= xpos);\par
427          y = stbrp__skyline_find_min_y(c, node, xpos, width, &waste);\par
428          if (y + height <= c->height) \{\par
429             if (y <= best_y) \{\par
430                if (y < best_y || waste < best_waste || (waste==best_waste && xpos < best_x)) \{\par
431                   best_x = xpos;\par
432                   {\cf20 //STBRP_ASSERT(y <= best_y); [DEAR IMGUI]}\par
433                   best_y = y;\par
434                   best_waste = waste;\par
435                   best = prev;\par
436                \}\par
437             \}\par
438          \}\par
439          tail = tail->next;\par
440       \}\par
441    \}\par
442 \par
443    fr.prev_link = best;\par
444    fr.x = best_x;\par
445    fr.y = best_y;\par
446    {\cf19 return} fr;\par
447 \}\par
448 \par
449 {\cf17 static} stbrp__findresult stbrp__skyline_pack_rectangle(stbrp_context *context, {\cf18 int} width, {\cf18 int} height)\par
450 \{\par
451    {\cf20 // find best position according to heuristic}\par
452    stbrp__findresult res = stbrp__skyline_find_best_pos(context, width, height);\par
453    stbrp_node *node, *cur;\par
454 \par
455    {\cf20 // bail if:}\par
456    {\cf20 //    1. it failed}\par
457    {\cf20 //    2. the best node doesn't fit (we don't always check this)}\par
458    {\cf20 //    3. we're out of memory}\par
459    {\cf19 if} (res.prev_link == NULL || res.y + height > context->height || context->free_head == NULL) \{\par
460       res.prev_link = NULL;\par
461       {\cf19 return} res;\par
462    \}\par
463 \par
464    {\cf20 // on success, create new node}\par
465    node = context->free_head;\par
466    node->x = (stbrp_coord) res.x;\par
467    node->y = (stbrp_coord) (res.y + height);\par
468 \par
469    context->free_head = node->next;\par
470 \par
471    {\cf20 // insert the new node into the right starting point, and}\par
472    {\cf20 // let 'cur' point to the remaining nodes needing to be}\par
473    {\cf20 // stitched back in}\par
474 \par
475    cur = *res.prev_link;\par
476    {\cf19 if} (cur->x < res.x) \{\par
477       {\cf20 // preserve the existing one, so start testing with the next one}\par
478       stbrp_node *next = cur->next;\par
479       cur->next = node;\par
480       cur = next;\par
481    \} {\cf19 else} \{\par
482       *res.prev_link = node;\par
483    \}\par
484 \par
485    {\cf20 // from here, traverse cur and free the nodes, until we get to one}\par
486    {\cf20 // that shouldn't be freed}\par
487    {\cf19 while} (cur->next && cur->next->x <= res.x + width) \{\par
488       stbrp_node *next = cur->next;\par
489       {\cf20 // move the current node to the free list}\par
490       cur->next = context->free_head;\par
491       context->free_head = cur;\par
492       cur = next;\par
493    \}\par
494 \par
495    {\cf20 // stitch the list back in}\par
496    node->next = cur;\par
497 \par
498    {\cf19 if} (cur->x < res.x + width)\par
499       cur->x = (stbrp_coord) (res.x + width);\par
500 \par
501 {\cf21 #ifdef _DEBUG}\par
502    cur = context->active_head;\par
503    {\cf19 while} (cur->x < context->width) \{\par
504       STBRP_ASSERT(cur->x < cur->next->x);\par
505       cur = cur->next;\par
506    \}\par
507    STBRP_ASSERT(cur->next == NULL);\par
508 \par
509    \{\par
510       {\cf18 int} count=0;\par
511       cur = context->active_head;\par
512       {\cf19 while} (cur) \{\par
513          cur = cur->next;\par
514          ++count;\par
515       \}\par
516       cur = context->free_head;\par
517       {\cf19 while} (cur) \{\par
518          cur = cur->next;\par
519          ++count;\par
520       \}\par
521       STBRP_ASSERT(count == context->num_nodes+2);\par
522    \}\par
523 {\cf21 #endif}\par
524 \par
525    {\cf19 return} res;\par
526 \}\par
527 \par
528 {\cf17 static} {\cf18 int} STBRP__CDECL rect_height_compare({\cf17 const} {\cf18 void} *a, {\cf17 const} {\cf18 void} *b)\par
529 \{\par
530    {\cf17 const} stbrp_rect *p = ({\cf17 const} stbrp_rect *) a;\par
531    {\cf17 const} stbrp_rect *q = ({\cf17 const} stbrp_rect *) b;\par
532    {\cf19 if} (p->h > q->h)\par
533       {\cf19 return} -1;\par
534    {\cf19 if} (p->h < q->h)\par
535       {\cf19 return}  1;\par
536    {\cf19 return} (p->w > q->w) ? -1 : (p->w < q->w);\par
537 \}\par
538 \par
539 {\cf17 static} {\cf18 int} STBRP__CDECL rect_original_order({\cf17 const} {\cf18 void} *a, {\cf17 const} {\cf18 void} *b)\par
540 \{\par
541    {\cf17 const} stbrp_rect *p = ({\cf17 const} stbrp_rect *) a;\par
542    {\cf17 const} stbrp_rect *q = ({\cf17 const} stbrp_rect *) b;\par
543    {\cf19 return} (p->was_packed < q->was_packed) ? -1 : (p->was_packed > q->was_packed);\par
544 \}\par
545 \par
546 STBRP_DEF {\cf18 int} stbrp_pack_rects(stbrp_context *context, stbrp_rect *rects, {\cf18 int} num_rects)\par
547 \{\par
548    {\cf18 int} i, all_rects_packed = 1;\par
549 \par
550    {\cf20 // we use the 'was_packed' field internally to allow sorting/unsorting}\par
551    {\cf19 for} (i=0; i < num_rects; ++i) \{\par
552       rects[i].was_packed = i;\par
553    \}\par
554 \par
555    {\cf20 // sort according to heuristic}\par
556    STBRP_SORT(rects, num_rects, {\cf17 sizeof}(rects[0]), rect_height_compare);\par
557 \par
558    {\cf19 for} (i=0; i < num_rects; ++i) \{\par
559       {\cf19 if} (rects[i].w == 0 || rects[i].h == 0) \{\par
560          rects[i].x = rects[i].y = 0;  {\cf20 // empty rect needs no space}\par
561       \} {\cf19 else} \{\par
562          stbrp__findresult fr = stbrp__skyline_pack_rectangle(context, rects[i].w, rects[i].h);\par
563          {\cf19 if} (fr.prev_link) \{\par
564             rects[i].x = (stbrp_coord) fr.x;\par
565             rects[i].y = (stbrp_coord) fr.y;\par
566          \} {\cf19 else} \{\par
567             rects[i].x = rects[i].y = STBRP__MAXVAL;\par
568          \}\par
569       \}\par
570    \}\par
571 \par
572    {\cf20 // unsort}\par
573    STBRP_SORT(rects, num_rects, {\cf17 sizeof}(rects[0]), rect_original_order);\par
574 \par
575    {\cf20 // set was_packed flags and all_rects_packed status}\par
576    {\cf19 for} (i=0; i < num_rects; ++i) \{\par
577       rects[i].was_packed = !(rects[i].x == STBRP__MAXVAL && rects[i].y == STBRP__MAXVAL);\par
578       {\cf19 if} (!rects[i].was_packed)\par
579          all_rects_packed = 0;\par
580    \}\par
581 \par
582    {\cf20 // return the all_rects_packed status}\par
583    {\cf19 return} all_rects_packed;\par
584 \}\par
585 {\cf21 #endif}\par
