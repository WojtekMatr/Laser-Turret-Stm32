134 STBRP_DEF {\cf18 void} stbrp_init_target (stbrp_context *context, {\cf18 int} width, {\cf18 int} height, stbrp_node *nodes, {\cf18 int} num_nodes);\par
135 {\cf20 // Initialize a rectangle packer to:}\par
136 {\cf20 //    pack a rectangle that is 'width' by 'height' in dimensions}\par
137 {\cf20 //    using temporary storage provided by the array 'nodes', which is 'num_nodes' long}\par
138 {\cf20 //}\par
139 {\cf20 // You must call this function every time you start packing into a new target.}\par
140 {\cf20 //}\par
141 {\cf20 // There is no "shutdown" function. The 'nodes' memory must stay valid for}\par
142 {\cf20 // the following stbrp_pack_rects() call (or calls), but can be freed after}\par
143 {\cf20 // the call (or calls) finish.}\par
144 {\cf20 //}\par
145 {\cf20 // Note: to guarantee best results, either:}\par
146 {\cf20 //       1. make sure 'num_nodes' >= 'width'}\par
147 {\cf20 //   or  2. call stbrp_allow_out_of_mem() defined below with 'allow_out_of_mem = 1'}\par
148 {\cf20 //}\par
149 {\cf20 // If you don't do either of the above things, widths will be quantized to multiples}\par
150 {\cf20 // of small integers to guarantee the algorithm doesn't run out of temporary storage.}\par
151 {\cf20 //}\par
152 {\cf20 // If you do #2, then the non-quantized algorithm will be used, but the algorithm}\par
153 {\cf20 // may run out of temporary storage and be unable to pack some rectangles.}\par
154 \par
155 STBRP_DEF {\cf18 void} stbrp_setup_allow_out_of_mem (stbrp_context *context, {\cf18 int} allow_out_of_mem);\par
156 {\cf20 // Optionally call this function after init but before doing any packing to}\par
157 {\cf20 // change the handling of the out-of-temp-memory scenario, described above.}\par
158 {\cf20 // If you call init again, this will be reset to the default (false).}\par
159 \par
