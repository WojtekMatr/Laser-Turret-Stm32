94 STBRP_DEF {\cf18 int} stbrp_pack_rects (stbrp_context *context, stbrp_rect *rects, {\cf18 int} num_rects);\par
95 {\cf20 // Assign packed locations to rectangles. The rectangles are of type}\par
96 {\cf20 // 'stbrp_rect' defined below, stored in the array 'rects', and there}\par
97 {\cf20 // are 'num_rects' many of them.}\par
98 {\cf20 //}\par
99 {\cf20 // Rectangles which are successfully packed have the 'was_packed' flag}\par
100 {\cf20 // set to a non-zero value and 'x' and 'y' store the minimum location}\par
101 {\cf20 // on each axis (i.e. bottom-left in cartesian coordinates, top-left}\par
102 {\cf20 // if you imagine y increasing downwards). Rectangles which do not fit}\par
103 {\cf20 // have the 'was_packed' flag set to 0.}\par
104 {\cf20 //}\par
105 {\cf20 // You should not try to access the 'rects' array from another thread}\par
106 {\cf20 // while this function is running, as the function temporarily reorders}\par
107 {\cf20 // the array while it executes.}\par
108 {\cf20 //}\par
109 {\cf20 // To pack into another rectangle, you need to call stbrp_init_target}\par
110 {\cf20 // again. To continue packing into the same rectangle, you can call}\par
111 {\cf20 // this function again. Calling this multiple times with multiple rect}\par
112 {\cf20 // arrays will probably produce worse packing results than calling it}\par
113 {\cf20 // a single time with the full rectangle array, but the option is}\par
114 {\cf20 // available.}\par
115 {\cf20 //}\par
116 {\cf20 // The function returns 1 if all of the rectangles were successfully}\par
117 {\cf20 // packed and 0 otherwise.}\par
118 \par
119 {\cf17 struct }stbrp_rect\par
120 \{\par
121    {\cf20 // reserved for your use:}\par
122    {\cf18 int}            id;\par
123 \par
124    {\cf20 // input:}\par
125    stbrp_coord    w, h;\par
126 \par
127    {\cf20 // output:}\par
128    stbrp_coord    x, y;\par
129    {\cf18 int}            was_packed;  {\cf20 // non-zero if valid packing}\par
130 \par
131 \}; {\cf20 // 16 bytes, nominally}\par
