233 STBRP_DEF {\cf18 void} stbrp_setup_heuristic(stbrp_context *context, {\cf18 int} heuristic)\par
234 \{\par
235    {\cf19 switch} (context->init_mode) \{\par
236       {\cf19 case} STBRP__INIT_skyline:\par
237          STBRP_ASSERT(heuristic == STBRP_HEURISTIC_Skyline_BL_sortHeight || heuristic == STBRP_HEURISTIC_Skyline_BF_sortHeight);\par
238          context->heuristic = heuristic;\par
239          {\cf19 break};\par
240       {\cf19 default}:\par
241          STBRP_ASSERT(0);\par
242    \}\par
243 \}\par
244 \par
245 STBRP_DEF {\cf18 void} stbrp_setup_allow_out_of_mem(stbrp_context *context, {\cf18 int} allow_out_of_mem)\par
246 \{\par
247    {\cf19 if} (allow_out_of_mem)\par
248       {\cf20 // if it's ok to run out of memory, then don't bother aligning them;}\par
249       {\cf20 // this gives better packing, but may fail due to OOM (even though}\par
250       {\cf20 // the rectangles easily fit). @TODO a smarter approach would be to only}\par
251       {\cf20 // quantize once we've hit OOM, then we could get rid of this parameter.}\par
252       context->align = 1;\par
253    {\cf19 else} \{\par
254       {\cf20 // if it's not ok to run out of memory, then quantize the widths}\par
255       {\cf20 // so that num_nodes is always enough nodes.}\par
256       {\cf20 //}\par
257       {\cf20 // I.e. num_nodes * align >= width}\par
258       {\cf20 //                  align >= width / num_nodes}\par
259       {\cf20 //                  align = ceil(width/num_nodes)}\par
260 \par
261       context->align = (context->width + context->num_nodes-1) / context->num_nodes;\par
262    \}\par
263 \}\par
264 \par
265 STBRP_DEF {\cf18 void} stbrp_init_target(stbrp_context *context, {\cf18 int} width, {\cf18 int} height, stbrp_node *nodes, {\cf18 int} num_nodes)\par
266 \{\par
267    {\cf18 int} i;\par
268 \par
269    {\cf19 for} (i=0; i < num_nodes-1; ++i)\par
270       nodes[i].next = &nodes[i+1];\par
271    nodes[i].next = NULL;\par
272    context->init_mode = STBRP__INIT_skyline;\par
273    context->heuristic = STBRP_HEURISTIC_Skyline_default;\par
274    context->free_head = &nodes[0];\par
275    context->active_head = &context->extra[0];\par
276    context->width = width;\par
277    context->height = height;\par
278    context->num_nodes = num_nodes;\par
279    stbrp_setup_allow_out_of_mem(context, 0);\par
280 \par
281    {\cf20 // node 0 is the full width, node 1 is the sentinel (lets us not store width explicitly)}\par
282    context->extra[0].x = 0;\par
283    context->extra[0].y = 0;\par
284    context->extra[0].next = &context->extra[1];\par
285    context->extra[1].x = (stbrp_coord) width;\par
286    context->extra[1].y = (1<<30);\par
287    context->extra[1].next = NULL;\par
288 \}\par
289 \par
290 {\cf20 // find minimum y position if it starts at x1}\par
291 {\cf17 static} {\cf18 int} stbrp__skyline_find_min_y(stbrp_context *c, stbrp_node *first, {\cf18 int} x0, {\cf18 int} width, {\cf18 int} *pwaste)\par
292 \{\par
293    stbrp_node *node = first;\par
294    {\cf18 int} x1 = x0 + width;\par
295    {\cf18 int} min_y, visited_width, waste_area;\par
296 \par
297    STBRP__NOTUSED(c);\par
298 \par
299    STBRP_ASSERT(first->x <= x0);\par
300 \par
301 {\cf21    #if 0}\par
302    {\cf20 // skip in case we're past the node}\par
303    {\cf19 while} (node->next->x <= x0)\par
304       ++node;\par
305 {\cf21    #else}\par
306    STBRP_ASSERT(node->next->x > x0); {\cf20 // we ended up handling this in the caller for efficiency}\par
307 {\cf21    #endif}\par
308 \par
309    STBRP_ASSERT(node->x <= x0);\par
310 \par
311    min_y = 0;\par
312    waste_area = 0;\par
313    visited_width = 0;\par
314    {\cf19 while} (node->x < x1) \{\par
315       {\cf19 if} (node->y > min_y) \{\par
316          {\cf20 // raise min_y higher.}\par
317          {\cf20 // we've accounted for all waste up to min_y,}\par
318          {\cf20 // but we'll now add more waste for everything we've visited}\par
319          waste_area += visited_width * (node->y - min_y);\par
320          min_y = node->y;\par
321          {\cf20 // the first time through, visited_width might be reduced}\par
322          {\cf19 if} (node->x < x0)\par
323             visited_width += node->next->x - x0;\par
324          {\cf19 else}\par
325             visited_width += node->next->x - node->x;\par
326       \} {\cf19 else} \{\par
327          {\cf20 // add waste area}\par
328          {\cf18 int} under_width = node->next->x - node->x;\par
329          {\cf19 if} (under_width + visited_width > width)\par
330             under_width = width - visited_width;\par
331          waste_area += under_width * (min_y - node->y);\par
332          visited_width += under_width;\par
333       \}\par
334       node = node->next;\par
335    \}\par
336 \par
337    *pwaste = waste_area;\par
338    {\cf19 return} min_y;\par
339 \}\par
