518 {\cf20 // API drag: on mouse drag, move the cursor and selection endpoint to the clicked location}\par
519 {\cf17 static} {\cf18 void} stb_textedit_drag(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 float} x, {\cf18 float} y)\par
520 \{\par
521    {\cf18 int} p = 0;\par
522    {\cf18 int} side_on_line;\par
523 \par
524    {\cf20 // In single-line mode, just always make y = 0. This lets the drag keep working if the mouse}\par
525    {\cf20 // goes off the top or bottom of the text}\par
526    {\cf19 if}( state->single_line )\par
527    \{\par
528       StbTexteditRow r;\par
529       STB_TEXTEDIT_LAYOUTROW(&r, str, 0);\par
530       y = r.ymin;\par
531    \}\par
532 \par
533    {\cf19 if} (state->select_start == state->select_end)\par
534       state->select_start = state->cursor;\par
535 \par
536    p = stb_text_locate_coord(str, x, y, &side_on_line);\par
537    state->cursor = state->select_end = p;\par
538    str->LastMoveDirectionLR = (ImS8)(side_on_line ? ImGuiDir_Right : ImGuiDir_Left);\par
539 \}\par
