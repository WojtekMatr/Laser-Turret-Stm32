429 {\cf20 //      Mouse input handling}\par
430 {\cf20 //}\par
431 \par
432 {\cf20 // traverse the layout to locate the nearest character to a display position}\par
433 {\cf17 static} {\cf18 int} stb_text_locate_coord(IMSTB_TEXTEDIT_STRING *str, {\cf18 float} x, {\cf18 float} y, {\cf18 int}* out_side_on_line)\par
434 \{\par
435    StbTexteditRow r;\par
436    {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
437    {\cf18 float} base_y = 0, prev_x;\par
438    {\cf18 int} i=0, k;\par
439 \par
440    r.x0 = r.x1 = 0;\par
441    r.ymin = r.ymax = 0;\par
442    r.num_chars = 0;\par
443    *out_side_on_line = 0;\par
444 \par
445    {\cf20 // search rows to find one that straddles 'y'}\par
446    {\cf19 while} (i < n) \{\par
447       STB_TEXTEDIT_LAYOUTROW(&r, str, i);\par
448       {\cf19 if} (r.num_chars <= 0)\par
449          {\cf19 return} n;\par
450 \par
451       {\cf19 if} (i==0 && y < base_y + r.ymin)\par
452          {\cf19 return} 0;\par
453 \par
454       {\cf19 if} (y < base_y + r.ymax)\par
455          {\cf19 break};\par
456 \par
457       i += r.num_chars;\par
458       base_y += r.baseline_y_delta;\par
459    \}\par
460 \par
461    {\cf20 // below all text, return 'after' last character}\par
462    {\cf19 if} (i >= n)\par
463    \{\par
464       *out_side_on_line = 1;\par
465       {\cf19 return} n;\par
466    \}\par
467 \par
468    {\cf20 // check if it's before the beginning of the line}\par
469    {\cf19 if} (x < r.x0)\par
470       {\cf19 return} i;\par
471 \par
472    {\cf20 // check if it's before the end of the line}\par
473    {\cf19 if} (x < r.x1) \{\par
474       {\cf20 // search characters in row for one that straddles 'x'}\par
475       prev_x = r.x0;\par
476       {\cf19 for} (k=0; k < r.num_chars; k = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, i + k) - i) \{\par
477          {\cf18 float} w = STB_TEXTEDIT_GETWIDTH(str, i, k);\par
478          {\cf19 if} (x < prev_x+w) \{\par
479             *out_side_on_line = (k == 0) ? 0 : 1;\par
480             {\cf19 if} (x < prev_x+w/2)\par
481                {\cf19 return} k+i;\par
482             {\cf19 else}\par
483                {\cf19 return} IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, i + k);\par
484          \}\par
485          prev_x += w;\par
486       \}\par
487       {\cf20 // shouldn't happen, but if it does, fall through to end-of-line case}\par
488    \}\par
489 \par
490    {\cf20 // if the last character is a newline, return that. otherwise return 'after' the last character}\par
491    *out_side_on_line = 1;\par
492    {\cf19 if} (STB_TEXTEDIT_GETCHAR(str, i+r.num_chars-1) == STB_TEXTEDIT_NEWLINE)\par
493       {\cf19 return} i+r.num_chars-1;\par
494    {\cf19 else}\par
495       {\cf19 return} i+r.num_chars;\par
496 \}\par
497 \par
498 {\cf20 // API click: on mouse down, move the cursor to the clicked location, and reset the selection}\par
499 {\cf17 static} {\cf18 void} stb_textedit_click(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 float} x, {\cf18 float} y)\par
500 \{\par
501    {\cf20 // In single-line mode, just always make y = 0. This lets the drag keep working if the mouse}\par
502    {\cf20 // goes off the top or bottom of the text}\par
503    {\cf18 int} side_on_line;\par
504    {\cf19 if}( state->single_line )\par
505    \{\par
506       StbTexteditRow r;\par
507       STB_TEXTEDIT_LAYOUTROW(&r, str, 0);\par
508       y = r.ymin;\par
509    \}\par
510 \par
511    state->cursor = stb_text_locate_coord(str, x, y, &side_on_line);\par
512    state->select_start = state->cursor;\par
513    state->select_end = state->cursor;\par
514    state->has_preferred_x = 0;\par
515    str->LastMoveDirectionLR = (ImS8)(side_on_line ? ImGuiDir_Right : ImGuiDir_Left);\par
516 \}\par
