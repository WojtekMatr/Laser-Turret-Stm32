721 {\cf21 #ifndef STB_TEXTEDIT_MOVEWORDLEFT}\par
722 {\cf17 static} {\cf18 int} stb_textedit_move_to_word_previous( IMSTB_TEXTEDIT_STRING *str, {\cf18 int} c )\par
723 \{\par
724    c = IMSTB_TEXTEDIT_GETPREVCHARINDEX( str, c ); {\cf20 // always move at least one character}\par
725    {\cf19 while} (c >= 0 && !is_word_boundary(str, c))\par
726       c = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, c);\par
727 \par
728    {\cf19 if}( c < 0 )\par
729       c = 0;\par
730 \par
731    {\cf19 return} c;\par
732 \}\par
733 {\cf21 #define STB_TEXTEDIT_MOVEWORDLEFT stb_textedit_move_to_word_previous}\par
734 {\cf21 #endif}\par
