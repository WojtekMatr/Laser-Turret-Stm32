\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 1 {\cf20 // [DEAR IMGUI]}\par
2 {\cf20 // This is a slightly modified version of stb_textedit.h 1.14.}\par
3 {\cf20 // Those changes would need to be pushed into nothings/stb:}\par
4 {\cf20 // - Fix in stb_textedit_discard_redo (see https://github.com/nothings/stb/issues/321)}\par
5 {\cf20 // - Fix in stb_textedit_find_charpos to handle last line (see https://github.com/ocornut/imgui/issues/6000 + #6783)}\par
6 {\cf20 // - Added name to struct or it may be forward declared in our code.}\par
7 {\cf20 // - Added UTF-8 support (see https://github.com/nothings/stb/issues/188 + https://github.com/ocornut/imgui/pull/7925)}\par
8 {\cf20 // - Changed STB_TEXTEDIT_INSERTCHARS() to return inserted count (instead of 0/1 bool), allowing partial insertion.}\par
9 {\cf20 // Grep for [DEAR IMGUI] to find some changes.}\par
10 {\cf20 // - Also renamed macros used or defined outside of IMSTB_TEXTEDIT_IMPLEMENTATION block from STB_TEXTEDIT_* to IMSTB_TEXTEDIT_*}\par
11 \par
12 {\cf20 // stb_textedit.h - v1.14  - public domain - Sean Barrett}\par
13 {\cf20 // Development of this library was sponsored by RAD Game Tools}\par
14 {\cf20 //}\par
15 {\cf20 // This C header file implements the guts of a multi-line text-editing}\par
16 {\cf20 // widget; you implement display, word-wrapping, and low-level string}\par
17 {\cf20 // insertion/deletion, and stb_textedit will map user inputs into}\par
18 {\cf20 // insertions & deletions, plus updates to the cursor position,}\par
19 {\cf20 // selection state, and undo state.}\par
20 {\cf20 //}\par
21 {\cf20 // It is intended for use in games and other systems that need to build}\par
22 {\cf20 // their own custom widgets and which do not have heavy text-editing}\par
23 {\cf20 // requirements (this library is not recommended for use for editing large}\par
24 {\cf20 // texts, as its performance does not scale and it has limited undo).}\par
25 {\cf20 //}\par
26 {\cf20 // Non-trivial behaviors are modelled after Windows text controls.}\par
27 {\cf20 //}\par
28 {\cf20 //}\par
29 {\cf20 // LICENSE}\par
30 {\cf20 //}\par
31 {\cf20 // See end of file for license information.}\par
32 {\cf20 //}\par
33 {\cf20 //}\par
34 {\cf20 // DEPENDENCIES}\par
35 {\cf20 //}\par
36 {\cf20 // Uses the C runtime function 'memmove', which you can override}\par
37 {\cf20 // by defining IMSTB_TEXTEDIT_memmove before the implementation.}\par
38 {\cf20 // Uses no other functions. Performs no runtime allocations.}\par
39 {\cf20 //}\par
40 {\cf20 //}\par
41 {\cf20 // VERSION HISTORY}\par
42 {\cf20 //}\par
43 {\cf20 //   !!!! (2025-10-23) changed STB_TEXTEDIT_INSERTCHARS() to return inserted count (instead of 0/1 bool), allowing partial insertion.}\par
44 {\cf20 //   1.14 (2021-07-11) page up/down, various fixes}\par
45 {\cf20 //   1.13 (2019-02-07) fix bug in undo size management}\par
