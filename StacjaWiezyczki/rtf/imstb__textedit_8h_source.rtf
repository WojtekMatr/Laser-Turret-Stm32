1447 {\cf20 // reset the state to default}\par
1448 {\cf17 static} {\cf18 void} stb_textedit_clear_state(STB_TexteditState *state, {\cf18 int} is_single_line)\par
1449 \{\par
1450    state->undostate.undo_point = 0;\par
1451    state->undostate.undo_char_point = 0;\par
1452    state->undostate.redo_point = IMSTB_TEXTEDIT_UNDOSTATECOUNT;\par
1453    state->undostate.redo_char_point = IMSTB_TEXTEDIT_UNDOCHARCOUNT;\par
1454    state->select_end = state->select_start = 0;\par
1455    state->cursor = 0;\par
1456    state->has_preferred_x = 0;\par
1457    state->preferred_x = 0;\par
1458    state->cursor_at_end_of_line = 0;\par
1459    state->initialized = 1;\par
1460    state->single_line = ({\cf18 unsigned} char) is_single_line;\par
1461    state->insert_mode = 0;\par
1462    state->row_count_per_page = 0;\par
1463 \}\par
1464 \par
1465 {\cf20 // API initialize}\par
1466 {\cf17 static} {\cf18 void} stb_textedit_initialize_state(STB_TexteditState *state, {\cf18 int} is_single_line)\par
1467 \{\par
1468    stb_textedit_clear_state(state, is_single_line);\par
1469 \}\par
