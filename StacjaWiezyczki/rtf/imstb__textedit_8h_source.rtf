736 {\cf21 #ifndef STB_TEXTEDIT_MOVEWORDRIGHT}\par
737 {\cf17 static} {\cf18 int} stb_textedit_move_to_word_next( IMSTB_TEXTEDIT_STRING *str, {\cf18 int} c )\par
738 \{\par
739    {\cf17 const} {\cf18 int} len = STB_TEXTEDIT_STRINGLEN(str);\par
740    c = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, c); {\cf20 // always move at least one character}\par
741    {\cf19 while}( c < len && !is_word_boundary( str, c ) )\par
742       c = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, c);\par
743 \par
744    {\cf19 if}( c > len )\par
745       c = len;\par
746 \par
747    {\cf19 return} c;\par
748 \}\par
749 {\cf21 #define STB_TEXTEDIT_MOVEWORDRIGHT stb_textedit_move_to_word_next}\par
750 {\cf21 #endif}\par
