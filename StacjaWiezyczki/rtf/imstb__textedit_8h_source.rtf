1195 {\cf20 //}\par
1196 {\cf20 //      Undo processing}\par
1197 {\cf20 //}\par
1198 {\cf20 // @OPTIMIZE: the undo/redo buffer should be circular}\par
1199 \par
1200 {\cf17 static} {\cf18 void} stb_textedit_flush_redo(StbUndoState *state)\par
1201 \{\par
1202    state->redo_point = IMSTB_TEXTEDIT_UNDOSTATECOUNT;\par
1203    state->redo_char_point = IMSTB_TEXTEDIT_UNDOCHARCOUNT;\par
1204 \}\par
1205 \par
1206 {\cf20 // discard the oldest entry in the undo list}\par
1207 {\cf17 static} {\cf18 void} stb_textedit_discard_undo(StbUndoState *state)\par
1208 \{\par
1209    {\cf19 if} (state->undo_point > 0) \{\par
1210       {\cf20 // if the 0th undo state has characters, clean those up}\par
1211       {\cf19 if} (state->undo_rec[0].char_storage >= 0) \{\par
1212          {\cf18 int} n = state->undo_rec[0].insert_length, i;\par
1213          {\cf20 // delete n characters from all other records}\par
1214          state->undo_char_point -= n;\par
1215          IMSTB_TEXTEDIT_memmove(state->undo_char, state->undo_char + n, ({\cf18 size_t}) (state->undo_char_point*{\cf17 sizeof}(IMSTB_TEXTEDIT_CHARTYPE)));\par
1216          {\cf19 for} (i=0; i < state->undo_point; ++i)\par
1217             {\cf19 if} (state->undo_rec[i].char_storage >= 0)\par
1218                state->undo_rec[i].char_storage -= n; {\cf20 // @OPTIMIZE: get rid of char_storage and infer it}\par
1219       \}\par
1220       --state->undo_point;\par
1221       IMSTB_TEXTEDIT_memmove(state->undo_rec, state->undo_rec+1, ({\cf18 size_t}) (state->undo_point*{\cf17 sizeof}(state->undo_rec[0])));\par
1222    \}\par
1223 \}\par
1224 \par
1225 {\cf20 // discard the oldest entry in the redo list--it's bad if this}\par
1226 {\cf20 // ever happens, but because undo & redo have to store the actual}\par
1227 {\cf20 // characters in different cases, the redo character buffer can}\par
1228 {\cf20 // fill up even though the undo buffer didn't}\par
1229 {\cf17 static} {\cf18 void} stb_textedit_discard_redo(StbUndoState *state)\par
1230 \{\par
1231    {\cf18 int} k = IMSTB_TEXTEDIT_UNDOSTATECOUNT-1;\par
1232 \par
1233    {\cf19 if} (state->redo_point <= k) \{\par
1234       {\cf20 // if the k'th undo state has characters, clean those up}\par
1235       {\cf19 if} (state->undo_rec[k].char_storage >= 0) \{\par
1236          {\cf18 int} n = state->undo_rec[k].insert_length, i;\par
1237          {\cf20 // move the remaining redo character data to the end of the buffer}\par
1238          state->redo_char_point += n;\par
1239          IMSTB_TEXTEDIT_memmove(state->undo_char + state->redo_char_point, state->undo_char + state->redo_char_point-n, ({\cf18 size_t}) ((IMSTB_TEXTEDIT_UNDOCHARCOUNT - state->redo_char_point)*{\cf17 sizeof}(IMSTB_TEXTEDIT_CHARTYPE)));\par
1240          {\cf20 // adjust the position of all the other records to account for above memmove}\par
1241          {\cf19 for} (i=state->redo_point; i < k; ++i)\par
1242             {\cf19 if} (state->undo_rec[i].char_storage >= 0)\par
1243                state->undo_rec[i].char_storage += n;\par
1244       \}\par
1245       {\cf20 // now move all the redo records towards the end of the buffer; the first one is at 'redo_point'}\par
1246       {\cf20 // [DEAR IMGUI]}\par
1247       {\cf18 size_t} move_size = (size_t)((IMSTB_TEXTEDIT_UNDOSTATECOUNT - state->redo_point - 1) * {\cf17 sizeof}(state->undo_rec[0]));\par
1248       {\cf17 const} {\cf18 char}* buf_begin = ({\cf18 char}*)state->undo_rec; (void)buf_begin;\par
1249       {\cf17 const} {\cf18 char}* buf_end   = ({\cf18 char}*)state->undo_rec + {\cf17 sizeof}(state->undo_rec); (void)buf_end;\par
1250       IM_ASSERT((({\cf18 char}*)(state->undo_rec + state->redo_point)) >= buf_begin);\par
1251       IM_ASSERT((({\cf18 char}*)(state->undo_rec + state->redo_point + 1) + move_size) <= buf_end);\par
1252       IMSTB_TEXTEDIT_memmove(state->undo_rec + state->redo_point+1, state->undo_rec + state->redo_point, move_size);\par
1253 \par
1254       {\cf20 // now move redo_point to point to the new one}\par
1255       ++state->redo_point;\par
1256    \}\par
1257 \}\par
1258 \par
1259 {\cf17 static} StbUndoRecord *stb_text_create_undo_record(StbUndoState *state, {\cf18 int} numchars)\par
1260 \{\par
1261    {\cf20 // any time we create a new undo record, we discard redo}\par
1262    stb_textedit_flush_redo(state);\par
1263 \par
1264    {\cf20 // if we have no free records, we have to make room, by sliding the}\par
1265    {\cf20 // existing records down}\par
1266    {\cf19 if} (state->undo_point == IMSTB_TEXTEDIT_UNDOSTATECOUNT)\par
1267       stb_textedit_discard_undo(state);\par
1268 \par
1269    {\cf20 // if the characters to store won't possibly fit in the buffer, we can't undo}\par
1270    {\cf19 if} (numchars > IMSTB_TEXTEDIT_UNDOCHARCOUNT) \{\par
1271       state->undo_point = 0;\par
1272       state->undo_char_point = 0;\par
1273       {\cf19 return} NULL;\par
1274    \}\par
1275 \par
1276    {\cf20 // if we don't have enough free characters in the buffer, we have to make room}\par
1277    {\cf19 while} (state->undo_char_point + numchars > IMSTB_TEXTEDIT_UNDOCHARCOUNT)\par
1278       stb_textedit_discard_undo(state);\par
1279 \par
1280    {\cf19 return} &state->undo_rec[state->undo_point++];\par
1281 \}\par
1282 \par
1283 {\cf17 static} IMSTB_TEXTEDIT_CHARTYPE *stb_text_createundo(StbUndoState *state, {\cf18 int} pos, {\cf18 int} insert_len, {\cf18 int} delete_len)\par
1284 \{\par
1285    StbUndoRecord *r = stb_text_create_undo_record(state, insert_len);\par
1286    {\cf19 if} (r == NULL)\par
1287       {\cf19 return} NULL;\par
1288 \par
1289    r->where = pos;\par
1290    r->insert_length = (IMSTB_TEXTEDIT_POSITIONTYPE) insert_len;\par
1291    r->delete_length = (IMSTB_TEXTEDIT_POSITIONTYPE) delete_len;\par
1292 \par
1293    {\cf19 if} (insert_len == 0) \{\par
1294       r->char_storage = -1;\par
1295       {\cf19 return} NULL;\par
1296    \} {\cf19 else} \{\par
1297       r->char_storage = state->undo_char_point;\par
1298       state->undo_char_point += insert_len;\par
1299       {\cf19 return} &state->undo_char[r->char_storage];\par
1300    \}\par
1301 \}\par
1302 \par
1303 {\cf17 static} {\cf18 void} stb_text_undo(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
1304 \{\par
1305    StbUndoState *s = &state->undostate;\par
1306    StbUndoRecord u, *r;\par
1307    {\cf19 if} (s->undo_point == 0)\par
1308       {\cf19 return};\par
1309 \par
1310    {\cf20 // we need to do two things: apply the undo record, and create a redo record}\par
1311    u = s->undo_rec[s->undo_point-1];\par
1312    r = &s->undo_rec[s->redo_point-1];\par
1313    r->char_storage = -1;\par
1314 \par
1315    r->insert_length = u.delete_length;\par
1316    r->delete_length = u.insert_length;\par
1317    r->where = u.where;\par
1318 \par
1319    {\cf19 if} (u.delete_length) \{\par
1320       {\cf20 // if the undo record says to delete characters, then the redo record will}\par
1321       {\cf20 // need to re-insert the characters that get deleted, so we need to store}\par
1322       {\cf20 // them.}\par
1323 \par
1324       {\cf20 // there are three cases:}\par
1325       {\cf20 //    there's enough room to store the characters}\par
1326       {\cf20 //    characters stored for *redoing* don't leave room for redo}\par
1327       {\cf20 //    characters stored for *undoing* don't leave room for redo}\par
1328       {\cf20 // if the last is true, we have to bail}\par
1329 \par
1330       {\cf19 if} (s->undo_char_point + u.delete_length >= IMSTB_TEXTEDIT_UNDOCHARCOUNT) \{\par
1331          {\cf20 // the undo records take up too much character space; there's no space to store the redo characters}\par
1332          r->insert_length = 0;\par
1333       \} {\cf19 else} \{\par
1334          {\cf18 int} i;\par
1335 \par
1336          {\cf20 // there's definitely room to store the characters eventually}\par
1337          {\cf19 while} (s->undo_char_point + u.delete_length > s->redo_char_point) \{\par
1338             {\cf20 // should never happen:}\par
1339             {\cf19 if} (s->redo_point == IMSTB_TEXTEDIT_UNDOSTATECOUNT)\par
1340                {\cf19 return};\par
1341             {\cf20 // there's currently not enough room, so discard a redo record}\par
1342             stb_textedit_discard_redo(s);\par
1343          \}\par
1344          r = &s->undo_rec[s->redo_point-1];\par
1345 \par
1346          r->char_storage = s->redo_char_point - u.delete_length;\par
1347          s->redo_char_point = s->redo_char_point - u.delete_length;\par
1348 \par
1349          {\cf20 // now save the characters}\par
1350          {\cf19 for} (i=0; i < u.delete_length; ++i)\par
1351             s->undo_char[r->char_storage + i] = STB_TEXTEDIT_GETCHAR(str, u.where + i);\par
1352       \}\par
1353 \par
1354       {\cf20 // now we can carry out the deletion}\par
1355       STB_TEXTEDIT_DELETECHARS(str, u.where, u.delete_length);\par
1356    \}\par
1357 \par
1358    {\cf20 // check type of recorded action:}\par
1359    {\cf19 if} (u.insert_length) \{\par
1360       {\cf20 // easy case: was a deletion, so we need to insert n characters}\par
1361       u.insert_length = STB_TEXTEDIT_INSERTCHARS(str, u.where, &s->undo_char[u.char_storage], u.insert_length);\par
1362       s->undo_char_point -= u.insert_length;\par
1363    \}\par
1364 \par
1365    state->cursor = u.where + u.insert_length;\par
1366 \par
1367    s->undo_point--;\par
1368    s->redo_point--;\par
1369 \}\par
1370 \par
1371 {\cf17 static} {\cf18 void} stb_text_redo(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
1372 \{\par
1373    StbUndoState *s = &state->undostate;\par
1374    StbUndoRecord *u, r;\par
1375    {\cf19 if} (s->redo_point == IMSTB_TEXTEDIT_UNDOSTATECOUNT)\par
1376       {\cf19 return};\par
1377 \par
1378    {\cf20 // we need to do two things: apply the redo record, and create an undo record}\par
1379    u = &s->undo_rec[s->undo_point];\par
1380    r = s->undo_rec[s->redo_point];\par
1381 \par
1382    {\cf20 // we KNOW there must be room for the undo record, because the redo record}\par
1383    {\cf20 // was derived from an undo record}\par
1384 \par
1385    u->delete_length = r.insert_length;\par
1386    u->insert_length = r.delete_length;\par
1387    u->where = r.where;\par
1388    u->char_storage = -1;\par
1389 \par
1390    {\cf19 if} (r.delete_length) \{\par
1391       {\cf20 // the redo record requires us to delete characters, so the undo record}\par
1392       {\cf20 // needs to store the characters}\par
1393 \par
1394       {\cf19 if} (s->undo_char_point + u->insert_length > s->redo_char_point) \{\par
1395          u->insert_length = 0;\par
1396          u->delete_length = 0;\par
1397       \} {\cf19 else} \{\par
1398          {\cf18 int} i;\par
1399          u->char_storage = s->undo_char_point;\par
1400          s->undo_char_point = s->undo_char_point + u->insert_length;\par
1401 \par
1402          {\cf20 // now save the characters}\par
1403          {\cf19 for} (i=0; i < u->insert_length; ++i)\par
1404             s->undo_char[u->char_storage + i] = STB_TEXTEDIT_GETCHAR(str, u->where + i);\par
1405       \}\par
1406 \par
1407       STB_TEXTEDIT_DELETECHARS(str, r.where, r.delete_length);\par
1408    \}\par
1409 \par
1410    {\cf19 if} (r.insert_length) \{\par
1411       {\cf20 // easy case: need to insert n characters}\par
1412       r.insert_length = STB_TEXTEDIT_INSERTCHARS(str, r.where, &s->undo_char[r.char_storage], r.insert_length);\par
1413       s->redo_char_point += r.insert_length;\par
1414    \}\par
1415 \par
1416    state->cursor = r.where + r.insert_length;\par
1417 \par
1418    s->undo_point++;\par
1419    s->redo_point++;\par
1420 \}\par
1421 \par
1422 {\cf17 static} {\cf18 void} stb_text_makeundo_insert(STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length)\par
1423 \{\par
1424    stb_text_createundo(&state->undostate, where, 0, length);\par
1425 \}\par
1426 \par
1427 {\cf17 static} {\cf18 void} stb_text_makeundo_delete(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length)\par
1428 \{\par
1429    {\cf18 int} i;\par
1430    IMSTB_TEXTEDIT_CHARTYPE *p = stb_text_createundo(&state->undostate, where, length, 0);\par
1431    {\cf19 if} (p) \{\par
1432       {\cf19 for} (i=0; i < length; ++i)\par
1433          p[i] = STB_TEXTEDIT_GETCHAR(str, where+i);\par
1434    \}\par
1435 \}\par
1436 \par
1437 {\cf17 static} {\cf18 void} stb_text_makeundo_replace(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} old_length, {\cf18 int} new_length)\par
1438 \{\par
1439    {\cf18 int} i;\par
1440    IMSTB_TEXTEDIT_CHARTYPE *p = stb_text_createundo(&state->undostate, where, old_length, new_length);\par
1441    {\cf19 if} (p) \{\par
1442       {\cf19 for} (i=0; i < old_length; ++i)\par
1443          p[i] = STB_TEXTEDIT_GETCHAR(str, where+i);\par
1444    \}\par
1445 \}\par
