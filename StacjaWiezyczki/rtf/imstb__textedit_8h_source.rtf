754 {\cf20 // update selection and cursor to match each other}\par
755 {\cf17 static} {\cf18 void} stb_textedit_prep_selection_at_cursor(STB_TexteditState *state)\par
756 \{\par
757    {\cf19 if} (!STB_TEXT_HAS_SELECTION(state))\par
758       state->select_start = state->select_end = state->cursor;\par
759    {\cf19 else}\par
760       state->cursor = state->select_end;\par
761 \}\par
762 \par
763 {\cf20 // API cut: delete selection}\par
764 {\cf17 static} {\cf18 int} stb_textedit_cut(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
765 \{\par
766    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
767       stb_textedit_delete_selection(str,state); {\cf20 // implicitly clamps}\par
768       state->has_preferred_x = 0;\par
769       {\cf19 return} 1;\par
770    \}\par
771    {\cf19 return} 0;\par
772 \}\par
773 \par
774 {\cf20 // API paste: replace existing selection with passed-in text}\par
775 {\cf17 static} {\cf18 int} stb_textedit_paste_internal(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, IMSTB_TEXTEDIT_CHARTYPE *text, {\cf18 int} len)\par
776 \{\par
777    {\cf20 // if there's a selection, the paste should delete it}\par
778    stb_textedit_clamp(str, state);\par
779    stb_textedit_delete_selection(str,state);\par
780    {\cf20 // try to insert the characters}\par
781    len = STB_TEXTEDIT_INSERTCHARS(str, state->cursor, text, len);\par
782    {\cf19 if} (len) \{\par
783       stb_text_makeundo_insert(state, state->cursor, len);\par
784       state->cursor += len;\par
785       state->has_preferred_x = 0;\par
786       {\cf19 return} 1;\par
787    \}\par
788    {\cf20 // note: paste failure will leave deleted selection, may be restored with an undo (see https://github.com/nothings/stb/issues/734 for details)}\par
789    {\cf19 return} 0;\par
790 \}\par
