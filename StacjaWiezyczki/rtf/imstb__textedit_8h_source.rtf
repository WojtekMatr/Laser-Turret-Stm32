686 {\cf20 // [DEAR IMGUI] Extracted this function so we can more easily add support for word-wrapping.}\par
687 {\cf21 #ifndef STB_TEXTEDIT_MOVELINESTART}\par
688 {\cf17 static} {\cf18 int} stb_textedit_move_line_start(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} cursor)\par
689 \{\par
690    {\cf19 if} (state->single_line)\par
691       {\cf19 return} 0;\par
692    {\cf19 while} (cursor > 0) \{\par
693       {\cf18 int} prev = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, cursor);\par
694       {\cf19 if} (STB_TEXTEDIT_GETCHAR(str, prev) == STB_TEXTEDIT_NEWLINE)\par
695          {\cf19 break};\par
696       cursor = prev;\par
697    \}\par
698    {\cf19 return} cursor;\par
699 \}\par
700 {\cf21 #define STB_TEXTEDIT_MOVELINESTART stb_textedit_move_line_start}\par
701 {\cf21 #endif}\par
702 {\cf21 #ifndef STB_TEXTEDIT_MOVELINEEND}\par
703 {\cf17 static} {\cf18 int} stb_textedit_move_line_end(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} cursor)\par
704 \{\par
705    {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
706    {\cf19 if} (state->single_line)\par
707       {\cf19 return} n;\par
708    {\cf19 while} (cursor < n && STB_TEXTEDIT_GETCHAR(str, cursor) != STB_TEXTEDIT_NEWLINE)\par
709       cursor = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, cursor);\par
710    {\cf19 return} cursor;\par
711 \}\par
712 {\cf21 #define STB_TEXTEDIT_MOVELINEEND stb_textedit_move_line_end}\par
713 {\cf21 #endif}\par
