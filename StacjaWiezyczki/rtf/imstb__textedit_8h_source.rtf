76 {\cf20 // USAGE}\par
77 {\cf20 //}\par
78 {\cf20 // This file behaves differently depending on what symbols you define}\par
79 {\cf20 // before including it.}\par
80 {\cf20 //}\par
81 {\cf20 //}\par
82 {\cf20 // Header-file mode:}\par
83 {\cf20 //}\par
84 {\cf20 //   If you do not define STB_TEXTEDIT_IMPLEMENTATION before including this,}\par
85 {\cf20 //   it will operate in "header file" mode. In this mode, it declares a}\par
86 {\cf20 //   single public symbol, STB_TexteditState, which encapsulates the current}\par
87 {\cf20 //   state of a text widget (except for the string, which you will store}\par
88 {\cf20 //   separately).}\par
89 {\cf20 //}\par
90 {\cf20 //   To compile in this mode, you must define STB_TEXTEDIT_CHARTYPE to a}\par
91 {\cf20 //   primitive type that defines a single character (e.g. char, wchar_t, etc).}\par
92 {\cf20 //}\par
93 {\cf20 //   To save space or increase undo-ability, you can optionally define the}\par
94 {\cf20 //   following things that are used by the undo system:}\par
95 {\cf20 //}\par
96 {\cf20 //      STB_TEXTEDIT_POSITIONTYPE         small int type encoding a valid cursor position}\par
97 {\cf20 //      STB_TEXTEDIT_UNDOSTATECOUNT       the number of undo states to allow}\par
98 {\cf20 //      STB_TEXTEDIT_UNDOCHARCOUNT        the number of characters to store in the undo buffer}\par
99 {\cf20 //}\par
100 {\cf20 //   If you don't define these, they are set to permissive types and}\par
101 {\cf20 //   moderate sizes. The undo system does no memory allocations, so}\par
102 {\cf20 //   it grows STB_TexteditState by the worst-case storage which is (in bytes):}\par
103 {\cf20 //}\par
104 {\cf20 //        [4 + 3 * sizeof(STB_TEXTEDIT_POSITIONTYPE)] * STB_TEXTEDIT_UNDOSTATECOUNT}\par
105 {\cf20 //      +          sizeof(STB_TEXTEDIT_CHARTYPE)      * STB_TEXTEDIT_UNDOCHARCOUNT}\par
106 {\cf20 //}\par
107 {\cf20 //}\par
108 {\cf20 // Implementation mode:}\par
109 {\cf20 //}\par
110 {\cf20 //   If you define STB_TEXTEDIT_IMPLEMENTATION before including this, it}\par
111 {\cf20 //   will compile the implementation of the text edit widget, depending}\par
112 {\cf20 //   on a large number of symbols which must be defined before the include.}\par
113 {\cf20 //}\par
114 {\cf20 //   The implementation is defined only as static functions. You will then}\par
115 {\cf20 //   need to provide your own APIs in the same file which will access the}\par
116 {\cf20 //   static functions.}\par
117 {\cf20 //}\par
118 {\cf20 //   The basic concept is that you provide a "string" object which}\par
119 {\cf20 //   behaves like an array of characters. stb_textedit uses indices to}\par
120 {\cf20 //   refer to positions in the string, implicitly representing positions}\par
121 {\cf20 //   in the displayed textedit. This is true for both plain text and}\par
122 {\cf20 //   rich text; even with rich text stb_truetype interacts with your}\par
123 {\cf20 //   code as if there was an array of all the displayed characters.}\par
124 {\cf20 //}\par
125 {\cf20 // Symbols that must be the same in header-file and implementation mode:}\par
126 {\cf20 //}\par
127 {\cf20 //     STB_TEXTEDIT_CHARTYPE             the character type}\par
128 {\cf20 //     STB_TEXTEDIT_POSITIONTYPE         small type that is a valid cursor position}\par
129 {\cf20 //     STB_TEXTEDIT_UNDOSTATECOUNT       the number of undo states to allow}\par
130 {\cf20 //     STB_TEXTEDIT_UNDOCHARCOUNT        the number of characters to store in the undo buffer}\par
131 {\cf20 //}\par
132 {\cf20 // Symbols you must define for implementation mode:}\par
133 {\cf20 //}\par
134 {\cf20 //    STB_TEXTEDIT_STRING               the type of object representing a string being edited,}\par
135 {\cf20 //                                      typically this is a wrapper object with other data you need}\par
136 {\cf20 //}\par
137 {\cf20 //    STB_TEXTEDIT_STRINGLEN(obj)       the length of the string (ideally O(1))}\par
138 {\cf20 //    STB_TEXTEDIT_LAYOUTROW(&r,obj,n)  returns the results of laying out a line of characters}\par
139 {\cf20 //                                        starting from character #n (see discussion below)}\par
140 {\cf20 //    STB_TEXTEDIT_GETWIDTH(obj,n,i)    returns the pixel delta from the xpos of the i'th character}\par
141 {\cf20 //                                        to the xpos of the i+1'th char for a line of characters}\par
142 {\cf20 //                                        starting at character #n (i.e. accounts for kerning}\par
143 {\cf20 //                                        with previous char)}\par
144 {\cf20 //    STB_TEXTEDIT_KEYTOTEXT(k)         maps a keyboard input to an insertable character}\par
145 {\cf20 //                                        (return type is int, -1 means not valid to insert)}\par
146 {\cf20 //                                        (not supported if you want to use UTF-8, see below)}\par
147 {\cf20 //    STB_TEXTEDIT_GETCHAR(obj,i)       returns the i'th character of obj, 0-based}\par
148 {\cf20 //    STB_TEXTEDIT_NEWLINE              the character returned by _GETCHAR() we recognize}\par
149 {\cf20 //                                        as manually wordwrapping for end-of-line positioning}\par
150 {\cf20 //}\par
151 {\cf20 //    STB_TEXTEDIT_DELETECHARS(obj,i,n)      delete n characters starting at i}\par
152 {\cf20 //    STB_TEXTEDIT_INSERTCHARS(obj,i,c*,n)   try to insert n characters at i (pointed to by STB_TEXTEDIT_CHARTYPE*)}\par
153 {\cf20 //                                           returns number of characters actually inserted. [DEAR IMGUI]}\par
154 {\cf20 //}\par
155 {\cf20 //    STB_TEXTEDIT_K_SHIFT       a power of two that is or'd in to a keyboard input to represent the shift key}\par
156 {\cf20 //}\par
157 {\cf20 //    STB_TEXTEDIT_K_LEFT        keyboard input to move cursor left}\par
158 {\cf20 //    STB_TEXTEDIT_K_RIGHT       keyboard input to move cursor right}\par
159 {\cf20 //    STB_TEXTEDIT_K_UP          keyboard input to move cursor up}\par
160 {\cf20 //    STB_TEXTEDIT_K_DOWN        keyboard input to move cursor down}\par
161 {\cf20 //    STB_TEXTEDIT_K_PGUP        keyboard input to move cursor up a page}\par
162 {\cf20 //    STB_TEXTEDIT_K_PGDOWN      keyboard input to move cursor down a page}\par
163 {\cf20 //    STB_TEXTEDIT_K_LINESTART   keyboard input to move cursor to start of line  // e.g. HOME}\par
164 {\cf20 //    STB_TEXTEDIT_K_LINEEND     keyboard input to move cursor to end of line    // e.g. END}\par
165 {\cf20 //    STB_TEXTEDIT_K_TEXTSTART   keyboard input to move cursor to start of text  // e.g. ctrl-HOME}\par
166 {\cf20 //    STB_TEXTEDIT_K_TEXTEND     keyboard input to move cursor to end of text    // e.g. ctrl-END}\par
167 {\cf20 //    STB_TEXTEDIT_K_DELETE      keyboard input to delete selection or character under cursor}\par
168 {\cf20 //    STB_TEXTEDIT_K_BACKSPACE   keyboard input to delete selection or character left of cursor}\par
169 {\cf20 //    STB_TEXTEDIT_K_UNDO        keyboard input to perform undo}\par
170 {\cf20 //    STB_TEXTEDIT_K_REDO        keyboard input to perform redo}\par
171 {\cf20 //}\par
172 {\cf20 // Optional:}\par
173 {\cf20 //    STB_TEXTEDIT_K_INSERT              keyboard input to toggle insert mode}\par
174 {\cf20 //    STB_TEXTEDIT_IS_SPACE(ch)          true if character is whitespace (e.g. 'isspace'),}\par
175 {\cf20 //                                          required for default WORDLEFT/WORDRIGHT handlers}\par
176 {\cf20 //    STB_TEXTEDIT_MOVEWORDLEFT(obj,i)   custom handler for WORDLEFT, returns index to move cursor to}\par
177 {\cf20 //    STB_TEXTEDIT_MOVEWORDRIGHT(obj,i)  custom handler for WORDRIGHT, returns index to move cursor to}\par
178 {\cf20 //    STB_TEXTEDIT_K_WORDLEFT            keyboard input to move cursor left one word // e.g. ctrl-LEFT}\par
179 {\cf20 //    STB_TEXTEDIT_K_WORDRIGHT           keyboard input to move cursor right one word // e.g. ctrl-RIGHT}\par
180 {\cf20 //    STB_TEXTEDIT_K_LINESTART2          secondary keyboard input to move cursor to start of line}\par
181 {\cf20 //    STB_TEXTEDIT_K_LINEEND2            secondary keyboard input to move cursor to end of line}\par
182 {\cf20 //    STB_TEXTEDIT_K_TEXTSTART2          secondary keyboard input to move cursor to start of text}\par
183 {\cf20 //    STB_TEXTEDIT_K_TEXTEND2            secondary keyboard input to move cursor to end of text}\par
184 {\cf20 //}\par
185 {\cf20 // To support UTF-8:}\par
186 {\cf20 //}\par
187 {\cf20 //    STB_TEXTEDIT_GETPREVCHARINDEX      returns index of previous character}\par
188 {\cf20 //    STB_TEXTEDIT_GETNEXTCHARINDEX      returns index of next character}\par
189 {\cf20 //    Do NOT define STB_TEXTEDIT_KEYTOTEXT.}\par
190 {\cf20 //    Instead, call stb_textedit_text() directly for text contents.}\par
191 {\cf20 //}\par
192 {\cf20 // Keyboard input must be encoded as a single integer value; e.g. a character code}\par
193 {\cf20 // and some bitflags that represent shift states. to simplify the interface, SHIFT must}\par
194 {\cf20 // be a bitflag, so we can test the shifted state of cursor movements to allow selection,}\par
195 {\cf20 // i.e. (STB_TEXTEDIT_K_RIGHT|STB_TEXTEDIT_K_SHIFT) should be shifted right-arrow.}\par
196 {\cf20 //}\par
197 {\cf20 // You can encode other things, such as CONTROL or ALT, in additional bits, and}\par
198 {\cf20 // then test for their presence in e.g. STB_TEXTEDIT_K_WORDLEFT. For example,}\par
199 {\cf20 // my Windows implementations add an additional CONTROL bit, and an additional KEYDOWN}\par
200 {\cf20 // bit. Then all of the STB_TEXTEDIT_K_ values bitwise-or in the KEYDOWN bit,}\par
201 {\cf20 // and I pass both WM_KEYDOWN and WM_CHAR events to the "key" function in the}\par
202 {\cf20 // API below. The control keys will only match WM_KEYDOWN events because of the}\par
203 {\cf20 // keydown bit I add, and STB_TEXTEDIT_KEYTOTEXT only tests for the KEYDOWN}\par
204 {\cf20 // bit so it only decodes WM_CHAR events.}\par
205 {\cf20 //}\par
206 {\cf20 // STB_TEXTEDIT_LAYOUTROW returns information about the shape of one displayed}\par
207 {\cf20 // row of characters assuming they start on the i'th character--the width and}\par
208 {\cf20 // the height and the number of characters consumed. This allows this library}\par
209 {\cf20 // to traverse the entire layout incrementally. You need to compute word-wrapping}\par
210 {\cf20 // here.}\par
211 {\cf20 //}\par
212 {\cf20 // Each textfield keeps its own insert mode state, which is not how normal}\par
213 {\cf20 // applications work. To keep an app-wide insert mode, update/copy the}\par
214 {\cf20 // "insert_mode" field of STB_TexteditState before/after calling API functions.}\par
215 {\cf20 //}\par
216 {\cf20 // API}\par
217 {\cf20 //}\par
218 {\cf20 //    void stb_textedit_initialize_state(STB_TexteditState *state, int is_single_line)}\par
219 {\cf20 //}\par
220 {\cf20 //    void stb_textedit_click(STB_TEXTEDIT_STRING *str, STB_TexteditState *state, float x, float y)}\par
221 {\cf20 //    void stb_textedit_drag(STB_TEXTEDIT_STRING *str, STB_TexteditState *state, float x, float y)}\par
222 {\cf20 //    int  stb_textedit_cut(STB_TEXTEDIT_STRING *str, STB_TexteditState *state)}\par
223 {\cf20 //    int  stb_textedit_paste(STB_TEXTEDIT_STRING *str, STB_TexteditState *state, STB_TEXTEDIT_CHARTYPE *text, int len)}\par
224 {\cf20 //    void stb_textedit_key(STB_TEXTEDIT_STRING *str, STB_TexteditState *state, STB_TEXEDIT_KEYTYPE key)}\par
225 {\cf20 //    void stb_textedit_text(STB_TEXTEDIT_STRING *str, STB_TexteditState *state, STB_TEXTEDIT_CHARTYPE *text, int text_len)}\par
226 {\cf20 //}\par
227 {\cf20 //    Each of these functions potentially updates the string and updates the}\par
228 {\cf20 //    state.}\par
229 {\cf20 //}\par
230 {\cf20 //      initialize_state:}\par
231 {\cf20 //          set the textedit state to a known good default state when initially}\par
232 {\cf20 //          constructing the textedit.}\par
233 {\cf20 //}\par
234 {\cf20 //      click:}\par
235 {\cf20 //          call this with the mouse x,y on a mouse down; it will update the cursor}\par
236 {\cf20 //          and reset the selection start/end to the cursor point. the x,y must}\par
237 {\cf20 //          be relative to the text widget, with (0,0) being the top left.}\par
238 {\cf20 //}\par
239 {\cf20 //      drag:}\par
240 {\cf20 //          call this with the mouse x,y on a mouse drag/up; it will update the}\par
241 {\cf20 //          cursor and the selection end point}\par
242 {\cf20 //}\par
243 {\cf20 //      cut:}\par
244 {\cf20 //          call this to delete the current selection; returns true if there was}\par
245 {\cf20 //          one. you should FIRST copy the current selection to the system paste buffer.}\par
246 {\cf20 //          (To copy, just copy the current selection out of the string yourself.)}\par
247 {\cf20 //}\par
248 {\cf20 //      paste:}\par
249 {\cf20 //          call this to paste text at the current cursor point or over the current}\par
250 {\cf20 //          selection if there is one.}\par
251 {\cf20 //}\par
252 {\cf20 //      key:}\par
253 {\cf20 //          call this for keyboard inputs sent to the textfield. you can use it}\par
254 {\cf20 //          for "key down" events or for "translated" key events. if you need to}\par
255 {\cf20 //          do both (as in Win32), or distinguish Unicode characters from control}\par
256 {\cf20 //          inputs, set a high bit to distinguish the two; then you can define the}\par
257 {\cf20 //          various definitions like STB_TEXTEDIT_K_LEFT have the is-key-event bit}\par
258 {\cf20 //          set, and make STB_TEXTEDIT_KEYTOCHAR check that the is-key-event bit is}\par
259 {\cf20 //          clear. STB_TEXTEDIT_KEYTYPE defaults to int, but you can #define it to}\par
260 {\cf20 //          anything other type you want before including.}\par
261 {\cf20 //          if the STB_TEXTEDIT_KEYTOTEXT function is defined, selected keys are}\par
262 {\cf20 //          transformed into text and stb_textedit_text() is automatically called.}\par
263 {\cf20 //}\par
264 {\cf20 //      text: (added 2025)}\par
265 {\cf20 //          call this to directly send text input the textfield, which is required}\par
266 {\cf20 //          for UTF-8 support, because stb_textedit_key() + STB_TEXTEDIT_KEYTOTEXT()}\par
267 {\cf20 //          cannot infer text length.}\par
268 {\cf20 //}\par
269 {\cf20 //}\par
270 {\cf20 //   When rendering, you can read the cursor position and selection state from}\par
271 {\cf20 //   the STB_TexteditState.}\par
272 {\cf20 //}\par
273 {\cf20 //}\par
274 {\cf20 // Notes:}\par
275 {\cf20 //}\par
276 {\cf20 // This is designed to be usable in IMGUI, so it allows for the possibility of}\par
277 {\cf20 // running in an IMGUI that has NOT cached the multi-line layout. For this}\par
278 {\cf20 // reason, it provides an interface that is compatible with computing the}\par
279 {\cf20 // layout incrementally--we try to make sure we make as few passes through}\par
280 {\cf20 // as possible. (For example, to locate the mouse pointer in the text, we}\par
281 {\cf20 // could define functions that return the X and Y positions of characters}\par
282 {\cf20 // and binary search Y and then X, but if we're doing dynamic layout this}\par
283 {\cf20 // will run the layout algorithm many times, so instead we manually search}\par
284 {\cf20 // forward in one pass. Similar logic applies to e.g. up-arrow and}\par
285 {\cf20 // down-arrow movement.)}\par
286 {\cf20 //}\par
287 {\cf20 // If it's run in a widget that *has* cached the layout, then this is less}\par
288 {\cf20 // efficient, but it's not horrible on modern computers. But you wouldn't}\par
289 {\cf20 // want to edit million-line files with it.}\par
290 \par
