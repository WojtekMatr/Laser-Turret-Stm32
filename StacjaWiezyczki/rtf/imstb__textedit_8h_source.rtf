715 {\cf21 #ifdef STB_TEXTEDIT_IS_SPACE}\par
716 {\cf17 static} {\cf18 int} is_word_boundary( IMSTB_TEXTEDIT_STRING *str, {\cf18 int} idx )\par
717 \{\par
718    {\cf19 return} idx > 0 ? (STB_TEXTEDIT_IS_SPACE( STB_TEXTEDIT_GETCHAR(str,idx-1) ) && !STB_TEXTEDIT_IS_SPACE( STB_TEXTEDIT_GETCHAR(str, idx) ) ) : 1;\par
719 \}\par
