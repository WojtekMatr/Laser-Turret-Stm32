792 {\cf21 #ifndef STB_TEXTEDIT_KEYTYPE}\par
793 {\cf21 #define STB_TEXTEDIT_KEYTYPE int}\par
794 {\cf21 #endif}\par
795 \par
796 {\cf20 // API key: process text input}\par
797 {\cf20 // [DEAR IMGUI] Added stb_textedit_text(), extracted out and called by stb_textedit_key() for backward compatibility.}\par
798 {\cf17 static} {\cf18 void} stb_textedit_text(IMSTB_TEXTEDIT_STRING* str, STB_TexteditState* state, {\cf17 const} IMSTB_TEXTEDIT_CHARTYPE* text, {\cf18 int} text_len)\par
799 \{\par
800    {\cf20 // can't add newline in single-line mode}\par
801    {\cf19 if} (text[0] == {\cf23 '\\n'} && state->single_line)\par
802       {\cf19 return};\par
803 \par
804    {\cf19 if} (state->insert_mode && !STB_TEXT_HAS_SELECTION(state) && state->cursor < STB_TEXTEDIT_STRINGLEN(str)) \{\par
805       stb_text_makeundo_replace(str, state, state->cursor, 1, 1);\par
806       STB_TEXTEDIT_DELETECHARS(str, state->cursor, 1);\par
807       text_len = STB_TEXTEDIT_INSERTCHARS(str, state->cursor, text, text_len);\par
808       {\cf19 if} (text_len) \{\par
809          state->cursor += text_len;\par
810          state->has_preferred_x = 0;\par
811       \}\par
812    \} {\cf19 else} \{\par
813       stb_textedit_delete_selection(str, state); {\cf20 // implicitly clamps}\par
814       text_len = STB_TEXTEDIT_INSERTCHARS(str, state->cursor, text, text_len);\par
815       {\cf19 if} (text_len) \{\par
816          stb_text_makeundo_insert(state, state->cursor, text_len);\par
817          state->cursor += text_len;\par
818          state->has_preferred_x = 0;\par
819       \}\par
820    \}\par
821 \}\par
822 \par
823 {\cf20 // API key: process a keyboard input}\par
824 {\cf17 static} {\cf18 void} stb_textedit_key(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, STB_TEXTEDIT_KEYTYPE key)\par
825 \{\par
826 retry:\par
827    {\cf19 switch} (key) \{\par
828       {\cf19 default}: \{\par
829 {\cf21 #ifdef STB_TEXTEDIT_KEYTOTEXT}\par
830          {\cf20 // This is not suitable for UTF-8 support.}\par
831          {\cf18 int} c = STB_TEXTEDIT_KEYTOTEXT(key);\par
832          {\cf19 if} (c > 0) \{\par
833             IMSTB_TEXTEDIT_CHARTYPE ch = (IMSTB_TEXTEDIT_CHARTYPE)c;\par
834             stb_textedit_text(str, state, &ch, 1);\par
835          \}\par
836 {\cf21 #endif}\par
837          {\cf19 break};\par
838       \}\par
839 \par
840 {\cf21 #ifdef STB_TEXTEDIT_K_INSERT}\par
841       {\cf19 case} STB_TEXTEDIT_K_INSERT:\par
842          state->insert_mode = !state->insert_mode;\par
843          {\cf19 break};\par
844 {\cf21 #endif}\par
845 \par
846       {\cf19 case} STB_TEXTEDIT_K_UNDO:\par
847          stb_text_undo(str, state);\par
848          state->has_preferred_x = 0;\par
849          {\cf19 break};\par
850 \par
851       {\cf19 case} STB_TEXTEDIT_K_REDO:\par
852          stb_text_redo(str, state);\par
853          state->has_preferred_x = 0;\par
854          {\cf19 break};\par
855 \par
856       {\cf19 case} STB_TEXTEDIT_K_LEFT:\par
857          {\cf20 // if currently there's a selection, move cursor to start of selection}\par
858          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
859             stb_textedit_move_to_first(state);\par
860          {\cf19 else}\par
861             {\cf19 if} (state->cursor > 0)\par
862                state->cursor = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, state->cursor);\par
863          state->has_preferred_x = 0;\par
864          {\cf19 break};\par
865 \par
866       {\cf19 case} STB_TEXTEDIT_K_RIGHT:\par
867          {\cf20 // if currently there's a selection, move cursor to end of selection}\par
868          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
869             stb_textedit_move_to_last(str, state);\par
870          {\cf19 else}\par
871             state->cursor = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->cursor);\par
872          stb_textedit_clamp(str, state);\par
873          state->has_preferred_x = 0;\par
874          {\cf19 break};\par
875 \par
876       {\cf19 case} STB_TEXTEDIT_K_LEFT | STB_TEXTEDIT_K_SHIFT:\par
877          stb_textedit_clamp(str, state);\par
878          stb_textedit_prep_selection_at_cursor(state);\par
879          {\cf20 // move selection left}\par
880          {\cf19 if} (state->select_end > 0)\par
881             state->select_end = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, state->select_end);\par
882          state->cursor = state->select_end;\par
883          state->has_preferred_x = 0;\par
884          {\cf19 break};\par
885 \par
886 {\cf21 #ifdef STB_TEXTEDIT_MOVEWORDLEFT}\par
887       {\cf19 case} STB_TEXTEDIT_K_WORDLEFT:\par
888          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
889             stb_textedit_move_to_first(state);\par
890          {\cf19 else} \{\par
891             state->cursor = STB_TEXTEDIT_MOVEWORDLEFT(str, state->cursor);\par
892             stb_textedit_clamp( str, state );\par
893          \}\par
894          {\cf19 break};\par
895 \par
896       {\cf19 case} STB_TEXTEDIT_K_WORDLEFT | STB_TEXTEDIT_K_SHIFT:\par
897          {\cf19 if}( !STB_TEXT_HAS_SELECTION( state ) )\par
898             stb_textedit_prep_selection_at_cursor(state);\par
899 \par
900          state->cursor = STB_TEXTEDIT_MOVEWORDLEFT(str, state->cursor);\par
901          state->select_end = state->cursor;\par
902 \par
903          stb_textedit_clamp( str, state );\par
904          {\cf19 break};\par
905 {\cf21 #endif}\par
906 \par
907 {\cf21 #ifdef STB_TEXTEDIT_MOVEWORDRIGHT}\par
908       {\cf19 case} STB_TEXTEDIT_K_WORDRIGHT:\par
909          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
910             stb_textedit_move_to_last(str, state);\par
911          {\cf19 else} \{\par
912             state->cursor = STB_TEXTEDIT_MOVEWORDRIGHT(str, state->cursor);\par
913             stb_textedit_clamp( str, state );\par
914          \}\par
915          {\cf19 break};\par
916 \par
917       {\cf19 case} STB_TEXTEDIT_K_WORDRIGHT | STB_TEXTEDIT_K_SHIFT:\par
918          {\cf19 if}( !STB_TEXT_HAS_SELECTION( state ) )\par
919             stb_textedit_prep_selection_at_cursor(state);\par
920 \par
921          state->cursor = STB_TEXTEDIT_MOVEWORDRIGHT(str, state->cursor);\par
922          state->select_end = state->cursor;\par
923 \par
924          stb_textedit_clamp( str, state );\par
925          {\cf19 break};\par
926 {\cf21 #endif}\par
927 \par
928       {\cf19 case} STB_TEXTEDIT_K_RIGHT | STB_TEXTEDIT_K_SHIFT:\par
929          stb_textedit_prep_selection_at_cursor(state);\par
930          {\cf20 // move selection right}\par
931          state->select_end = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->select_end);\par
