613 {\cf21 #define STB_TEXT_HAS_SELECTION(s)   ((s)->select_start != (s)->select_end)}\par
614 \par
615 {\cf20 // make the selection/cursor state valid if client altered the string}\par
616 {\cf17 static} {\cf18 void} stb_textedit_clamp(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
617 \{\par
618    {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
619    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
620       {\cf19 if} (state->select_start > n) state->select_start = n;\par
621       {\cf19 if} (state->select_end   > n) state->select_end = n;\par
622       {\cf20 // if clamping forced them to be equal, move the cursor to match}\par
623       {\cf19 if} (state->select_start == state->select_end)\par
624          state->cursor = state->select_start;\par
625    \}\par
626    {\cf19 if} (state->cursor > n) state->cursor = n;\par
627 \}\par
628 \par
629 {\cf20 // delete characters while updating undo}\par
630 {\cf17 static} {\cf18 void} stb_textedit_delete(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} len)\par
631 \{\par
632    stb_text_makeundo_delete(str, state, where, len);\par
633    STB_TEXTEDIT_DELETECHARS(str, where, len);\par
634    state->has_preferred_x = 0;\par
635 \}\par
636 \par
637 {\cf20 // delete the section}\par
638 {\cf17 static} {\cf18 void} stb_textedit_delete_selection(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
639 \{\par
640    stb_textedit_clamp(str, state);\par
641    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
642       {\cf19 if} (state->select_start < state->select_end) \{\par
643          stb_textedit_delete(str, state, state->select_start, state->select_end - state->select_start);\par
644          state->select_end = state->cursor = state->select_start;\par
645       \} {\cf19 else} \{\par
646          stb_textedit_delete(str, state, state->select_end, state->select_start - state->select_end);\par
647          state->select_start = state->cursor = state->select_end;\par
648       \}\par
649       state->has_preferred_x = 0;\par
650    \}\par
651 \}\par
652 \par
653 {\cf20 // canoncialize the selection so start <= end}\par
654 {\cf17 static} {\cf18 void} stb_textedit_sortselection(STB_TexteditState *state)\par
655 \{\par
656    {\cf19 if} (state->select_end < state->select_start) \{\par
657       {\cf18 int} temp = state->select_end;\par
658       state->select_end = state->select_start;\par
659       state->select_start = temp;\par
660    \}\par
661 \}\par
662 \par
663 {\cf20 // move cursor to first character of selection}\par
664 {\cf17 static} {\cf18 void} stb_textedit_move_to_first(STB_TexteditState *state)\par
665 \{\par
666    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
667       stb_textedit_sortselection(state);\par
668       state->cursor = state->select_start;\par
669       state->select_end = state->select_start;\par
670       state->has_preferred_x = 0;\par
671    \}\par
672 \}\par
673 \par
674 {\cf20 // move cursor to last character of selection}\par
675 {\cf17 static} {\cf18 void} stb_textedit_move_to_last(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
676 \{\par
677    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
678       stb_textedit_sortselection(state);\par
679       stb_textedit_clamp(str, state);\par
680       state->cursor = state->select_end;\par
681       state->select_start = state->select_end;\par
682       state->has_preferred_x = 0;\par
683    \}\par
684 \}\par
