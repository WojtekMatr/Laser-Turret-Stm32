1265 {\cf17 static} stbtt__buf stbtt__cff_index_get(stbtt__buf b, {\cf18 int} i)\par
1266 \{\par
1267    {\cf18 int} count, offsize, start, end;\par
1268    stbtt__buf_seek(&b, 0);\par
1269    count = stbtt__buf_get16(&b);\par
1270    offsize = stbtt__buf_get8(&b);\par
1271    STBTT_assert(i >= 0 && i < count);\par
1272    STBTT_assert(offsize >= 1 && offsize <= 4);\par
1273    stbtt__buf_skip(&b, i*offsize);\par
1274    start = stbtt__buf_get(&b, offsize);\par
1275    end = stbtt__buf_get(&b, offsize);\par
1276    {\cf19 return} stbtt__buf_range(&b, 2+(count+1)*offsize+start, end - start);\par
1277 \}\par
