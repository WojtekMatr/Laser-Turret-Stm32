3635    {\cf19 for} (i=0; i < num_verts; ++i)\par
3636       {\cf19 if} (vertices[i].type == STBTT_vmove)\par
3637          ++n;\par
3638 \par
3639    *num_contours = n;\par
3640    {\cf19 if} (n == 0) {\cf19 return} 0;\par
3641 \par
3642    *contour_lengths = ({\cf18 int} *) STBTT_malloc({\cf17 sizeof}(**contour_lengths) * n, userdata);\par
3643 \par
3644    {\cf19 if} (*contour_lengths == 0) \{\par
3645       *num_contours = 0;\par
3646       {\cf19 return} 0;\par
3647    \}\par
3648 \par
3649    {\cf20 // make two passes through the points so we don't need to realloc}\par
3650    {\cf19 for} (pass=0; pass < 2; ++pass) \{\par
3651       {\cf18 float} x=0,y=0;\par
3652       {\cf19 if} (pass == 1) \{\par
3653          points = (stbtt__point *) STBTT_malloc(num_points * {\cf17 sizeof}(points[0]), userdata);\par
3654          {\cf19 if} (points == NULL) {\cf19 goto} error;\par
3655       \}\par
3656       num_points = 0;\par
3657       n= -1;\par
3658       {\cf19 for} (i=0; i < num_verts; ++i) \{\par
3659          {\cf19 switch} (vertices[i].type) \{\par
3660             {\cf19 case} STBTT_vmove:\par
3661                {\cf20 // start the next contour}\par
3662                {\cf19 if} (n >= 0)\par
3663                   (*contour_lengths)[n] = num_points - start;\par
3664                ++n;\par
3665                start = num_points;\par
3666 \par
3667                x = vertices[i].x, y = vertices[i].y;\par
3668                stbtt__add_point(points, num_points++, x,y);\par
3669                {\cf19 break};\par
3670             {\cf19 case} STBTT_vline:\par
3671                x = vertices[i].x, y = vertices[i].y;\par
3672                stbtt__add_point(points, num_points++, x, y);\par
3673                {\cf19 break};\par
3674             {\cf19 case} STBTT_vcurve:\par
3675                stbtt__tesselate_curve(points, &num_points, x,y,\par
3676                                         vertices[i].cx, vertices[i].cy,\par
3677                                         vertices[i].x,  vertices[i].y,\par
3678                                         objspace_flatness_squared, 0);\par
3679                x = vertices[i].x, y = vertices[i].y;\par
3680                {\cf19 break};\par
3681             {\cf19 case} STBTT_vcubic:\par
3682                stbtt__tesselate_cubic(points, &num_points, x,y,\par
3683                                         vertices[i].cx, vertices[i].cy,\par
3684                                         vertices[i].cx1, vertices[i].cy1,\par
3685                                         vertices[i].x,  vertices[i].y,\par
3686                                         objspace_flatness_squared, 0);\par
3687                x = vertices[i].x, y = vertices[i].y;\par
3688                {\cf19 break};\par
3689          \}\par
3690       \}\par
3691       (*contour_lengths)[n] = num_points - start;\par
3692    \}\par
3693 \par
3694    {\cf19 return} points;\par
3695 error:\par
3696    STBTT_free(points, userdata);\par
3697    STBTT_free(*contour_lengths, userdata);\par
3698    *contour_lengths = 0;\par
3699    *num_contours = 0;\par
3700    {\cf19 return} NULL;\par
3701 \}\par
3702 \par
3703 STBTT_DEF {\cf18 void} stbtt_Rasterize(stbtt__bitmap *result, {\cf18 float} flatness_in_pixels, stbtt_vertex *vertices, {\cf18 int} num_verts, {\cf18 float} scale_x, {\cf18 float} scale_y, {\cf18 float} shift_x, {\cf18 float} shift_y, {\cf18 int} x_off, {\cf18 int} y_off, {\cf18 int} invert, {\cf18 void} *userdata)\par
3704 \{\par
3705    {\cf18 float} scale            = scale_x > scale_y ? scale_y : scale_x;\par
3706    {\cf18 int} winding_count      = 0;\par
3707    {\cf18 int} *winding_lengths   = NULL;\par
3708    stbtt__point *windings = stbtt_FlattenCurves(vertices, num_verts, flatness_in_pixels / scale, &winding_lengths, &winding_count, userdata);\par
3709    {\cf19 if} (windings) \{\par
3710       stbtt__rasterize(result, windings, winding_lengths, winding_count, scale_x, scale_y, shift_x, shift_y, x_off, y_off, invert, userdata);\par
3711       STBTT_free(winding_lengths, userdata);\par
3712       STBTT_free(windings, userdata);\par
3713    \}\par
3714 \}\par
3715 \par
3716 STBTT_DEF {\cf18 void} stbtt_FreeBitmap({\cf18 unsigned} {\cf18 char} *bitmap, {\cf18 void} *userdata)\par
3717 \{\par
3718    STBTT_free(bitmap, userdata);\par
3719 \}\par
