3498 {\cf17 static} {\cf18 void} stbtt__rasterize(stbtt__bitmap *result, stbtt__point *pts, {\cf18 int} *wcount, {\cf18 int} windings, {\cf18 float} scale_x, {\cf18 float} scale_y, {\cf18 float} shift_x, {\cf18 float} shift_y, {\cf18 int} off_x, {\cf18 int} off_y, {\cf18 int} invert, {\cf18 void} *userdata)\par
3499 \{\par
3500    {\cf18 float} y_scale_inv = invert ? -scale_y : scale_y;\par
3501    stbtt__edge *e;\par
3502    {\cf18 int} n,i,j,k,m;\par
3503 {\cf21 #if STBTT_RASTERIZER_VERSION == 1}\par
3504    {\cf18 int} vsubsample = result->h < 8 ? 15 : 5;\par
3505 {\cf21 #elif STBTT_RASTERIZER_VERSION == 2}\par
3506    {\cf18 int} vsubsample = 1;\par
3507 {\cf21 #else}\par
3508 {\cf21    #error "Unrecognized value of STBTT_RASTERIZER_VERSION"}\par
3509 {\cf21 #endif}\par
3510    {\cf20 // vsubsample should divide 255 evenly; otherwise we won't reach full opacity}\par
3511 \par
3512    {\cf20 // now we have to blow out the windings into explicit edge lists}\par
3513    n = 0;\par
3514    {\cf19 for} (i=0; i < windings; ++i)\par
3515       n += wcount[i];\par
3516 \par
3517    e = (stbtt__edge *) STBTT_malloc({\cf17 sizeof}(*e) * (n+1), userdata); {\cf20 // add an extra one as a sentinel}\par
3518    {\cf19 if} (e == 0) {\cf19 return};\par
3519    n = 0;\par
3520 \par
3521    m=0;\par
3522    {\cf19 for} (i=0; i < windings; ++i) \{\par
3523       stbtt__point *p = pts + m;\par
3524       m += wcount[i];\par
3525       j = wcount[i]-1;\par
3526       {\cf19 for} (k=0; k < wcount[i]; j=k++) \{\par
3527          {\cf18 int} a=k,b=j;\par
3528          {\cf20 // skip the edge if horizontal}\par
3529          {\cf19 if} (p[j].y == p[k].y)\par
3530             {\cf19 continue};\par
3531          {\cf20 // add edge from j to k to the list}\par
3532          e[n].invert = 0;\par
3533          {\cf19 if} (invert ? p[j].y > p[k].y : p[j].y < p[k].y) \{\par
3534             e[n].invert = 1;\par
3535             a=j,b=k;\par
3536          \}\par
3537          e[n].x0 = p[a].x * scale_x + shift_x;\par
3538          e[n].y0 = (p[a].y * y_scale_inv + shift_y) * vsubsample;\par
3539          e[n].x1 = p[b].x * scale_x + shift_x;\par
3540          e[n].y1 = (p[b].y * y_scale_inv + shift_y) * vsubsample;\par
3541          ++n;\par
3542       \}\par
3543    \}\par
3544 \par
3545    {\cf20 // now sort the edges by their highest point (should snap to integer, and then by x)}\par
3546    {\cf20 //STBTT_sort(e, n, sizeof(e[0]), stbtt__edge_compare);}\par
3547    stbtt__sort_edges(e, n);\par
3548 \par
3549    {\cf20 // now, traverse the scanlines and find the intersections on each scanline, use xor winding rule}\par
3550    stbtt__rasterize_sorted_edges(result, e, n, vsubsample, off_x, off_y, userdata);\par
3551 \par
3552    STBTT_free(e, userdata);\par
3553 \}\par
