634 STBTT_DEF {\cf18 int}  stbtt_PackFontRanges(stbtt_pack_context *spc, {\cf17 const} {\cf18 unsigned} {\cf18 char} *fontdata, {\cf18 int} font_index, stbtt_pack_range *ranges, {\cf18 int} num_ranges);\par
635 {\cf20 // Creates character bitmaps from multiple ranges of characters stored in}\par
636 {\cf20 // ranges. This will usually create a better-packed bitmap than multiple}\par
