1299 {\cf17 static} {\cf18 int} stbtt__isfont(stbtt_uint8 *font)\par
1300 \{\par
1301    {\cf20 // check the version number}\par
1302    {\cf19 if} (stbtt_tag4(font, {\cf23 '1'},0,0,0))  {\cf19 return} 1; {\cf20 // TrueType 1}\par
1303    {\cf19 if} (stbtt_tag(font, {\cf22 "typ1"}))   {\cf19 return} 1; {\cf20 // TrueType with type 1 font -- we don't support this!}\par
1304    {\cf19 if} (stbtt_tag(font, {\cf22 "OTTO"}))   {\cf19 return} 1; {\cf20 // OpenType with CFF}\par
1305    {\cf19 if} (stbtt_tag4(font, 0,1,0,0)) {\cf19 return} 1; {\cf20 // OpenType 1.0}\par
1306    {\cf19 if} (stbtt_tag(font, {\cf22 "true"}))   {\cf19 return} 1; {\cf20 // Apple specification for TrueType fonts}\par
1307    {\cf19 return} 0;\par
