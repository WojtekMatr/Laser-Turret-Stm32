3602       {\cf18 float} x01 = (x0+x1)/2;\par
3603       {\cf18 float} y01 = (y0+y1)/2;\par
3604       {\cf18 float} x12 = (x1+x2)/2;\par
3605       {\cf18 float} y12 = (y1+y2)/2;\par
