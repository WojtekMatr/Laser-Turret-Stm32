1173 {\cf17 static} stbtt__buf stbtt__new_buf({\cf17 const} {\cf18 void} *p, {\cf18 size_t} size)\par
1174 \{\par
1175    stbtt__buf r;\par
1176    STBTT_assert(size < 0x40000000);\par
1177    r.data = (stbtt_uint8*) p;\par
1178    r.size = (int) size;\par
1179    r.cursor = 0;\par
1180    {\cf19 return} r;\par
1181 \}\par
