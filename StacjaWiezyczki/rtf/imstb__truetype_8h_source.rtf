3304 {\cf20 // directly AA rasterize edges w/o supersampling}\par
3305 {\cf17 static} {\cf18 void} stbtt__rasterize_sorted_edges(stbtt__bitmap *result, stbtt__edge *e, {\cf18 int} n, {\cf18 int} vsubsample, {\cf18 int} off_x, {\cf18 int} off_y, {\cf18 void} *userdata)\par
3306 \{\par
3307    stbtt__hheap hh = \{ 0, 0, 0 \};\par
3308    stbtt__active_edge *active = NULL;\par
3309    {\cf18 int} y,j=0, i;\par
3310    {\cf18 float} scanline_data[129], *scanline, *scanline2;\par
3311 \par
3312    STBTT__NOTUSED(vsubsample);\par
3313 \par
3314    {\cf19 if} (result->w > 64)\par
3315       scanline = ({\cf18 float} *) STBTT_malloc((result->w*2+1) * {\cf17 sizeof}({\cf18 float}), userdata);\par
3316    {\cf19 else}\par
3317       scanline = scanline_data;\par
3318 \par
3319    scanline2 = scanline + result->w;\par
3320 \par
3321    y = off_y;\par
3322    e[n].y0 = (float) (off_y + result->h) + 1;\par
3323 \par
3324    {\cf19 while} (j < result->h) \{\par
3325       {\cf20 // find center of pixel for this scanline}\par
3326       {\cf18 float} scan_y_top    = y + 0.0f;\par
3327       {\cf18 float} scan_y_bottom = y + 1.0f;\par
3328       stbtt__active_edge **step = &active;\par
3329 \par
3330       STBTT_memset(scanline , 0, result->w*{\cf17 sizeof}(scanline[0]));\par
3331       STBTT_memset(scanline2, 0, (result->w+1)*{\cf17 sizeof}(scanline[0]));\par
3332 \par
3333       {\cf20 // update all active edges;}\par
3334       {\cf20 // remove all active edges that terminate before the top of this scanline}\par
3335       {\cf19 while} (*step) \{\par
3336          stbtt__active_edge * z = *step;\par
3337          {\cf19 if} (z->ey <= scan_y_top) \{\par
3338             *step = z->next; {\cf20 // delete from list}\par
3339             STBTT_assert(z->direction);\par
3340             z->direction = 0;\par
3341             stbtt__hheap_free(&hh, z);\par
3342          \} {\cf19 else} \{\par
3343             step = &((*step)->next); {\cf20 // advance through list}\par
3344          \}\par
3345       \}\par
3346 \par
3347       {\cf20 // insert all edges that start before the bottom of this scanline}\par
3348       {\cf19 while} (e->y0 <= scan_y_bottom) \{\par
3349          {\cf19 if} (e->y0 != e->y1) \{\par
3350             stbtt__active_edge *z = stbtt__new_active(&hh, e, off_x, scan_y_top, userdata);\par
3351             {\cf19 if} (z != NULL) \{\par
3352                {\cf19 if} (j == 0 && off_y != 0) \{\par
3353                   {\cf19 if} (z->ey < scan_y_top) \{\par
3354                      {\cf20 // this can happen due to subpixel positioning and some kind of fp rounding error i think}\par
3355                      z->ey = scan_y_top;\par
3356                   \}\par
3357                \}\par
3358                STBTT_assert(z->ey >= scan_y_top); {\cf20 // if we get really unlucky a tiny bit of an edge can be out of bounds}\par
3359                {\cf20 // insert at front}\par
3360                z->next = active;\par
3361                active = z;\par
3362             \}\par
3363          \}\par
3364          ++e;\par
3365       \}\par
3366 \par
3367       {\cf20 // now process all active edges}\par
3368       {\cf19 if} (active)\par
3369          stbtt__fill_active_edges_new(scanline, scanline2+1, result->w, active, scan_y_top);\par
3370 \par
3371       \{\par
3372          {\cf18 float} sum = 0;\par
3373          {\cf19 for} (i=0; i < result->w; ++i) \{\par
3374             {\cf18 float} k;\par
3375             {\cf18 int} m;\par
3376             sum += scanline2[i];\par
3377             k = scanline[i] + sum;\par
3378             k = (float) STBTT_fabs(k)*255 + 0.5f;\par
3379             m = (int) k;\par
3380             {\cf19 if} (m > 255) m = 255;\par
3381             result->pixels[j*result->stride + i] = ({\cf18 unsigned} char) m;\par
3382          \}\par
3383       \}\par
3384       {\cf20 // advance all the edges}\par
3385       step = &active;\par
3386       {\cf19 while} (*step) \{\par
3387          stbtt__active_edge *z = *step;\par
3388          z->fx += z->fdx; {\cf20 // advance to position for current scanline}\par
3389          step = &((*step)->next); {\cf20 // advance through list}\par
3390       \}\par
3391 \par
3392       ++y;\par
3393       ++j;\par
3394    \}\par
3395 \par
3396    stbtt__hheap_cleanup(&hh, userdata);\par
3397 \par
3398    {\cf19 if} (scanline != scanline_data)\par
3399       STBTT_free(scanline, userdata);\par
3400 \}\par
3401 {\cf21 #else}\par
3402 {\cf21 #error "Unrecognized value of STBTT_RASTERIZER_VERSION"}\par
3403 {\cf21 #endif}\par
3404 \par
3405 {\cf21 #define STBTT__COMPARE(a,b)  ((a)->y0 < (b)->y0)}\par
3406 \par
3407 {\cf17 static} {\cf18 void} stbtt__sort_edges_ins_sort(stbtt__edge *p, {\cf18 int} n)\par
3408 \{\par
3409    {\cf18 int} i,j;\par
3410    {\cf19 for} (i=1; i < n; ++i) \{\par
3411       stbtt__edge t = p[i], *a = &t;\par
3412       j = i;\par
3413       {\cf19 while} (j > 0) \{\par
3414          stbtt__edge *b = &p[j-1];\par
3415          {\cf18 int} c = STBTT__COMPARE(a,b);\par
3416          {\cf19 if} (!c) {\cf19 break};\par
3417          p[j] = p[j-1];\par
3418          --j;\par
3419       \}\par
3420       {\cf19 if} (i != j)\par
3421          p[j] = t;\par
3422    \}\par
3423 \}\par
3424 \par
3425 {\cf17 static} {\cf18 void} stbtt__sort_edges_quicksort(stbtt__edge *p, {\cf18 int} n)\par
3426 \{\par
3427    {\cf20 /* threshold for transitioning to insertion sort */}\par
3428    {\cf19 while} (n > 12) \{\par
3429       stbtt__edge t;\par
3430       {\cf18 int} c01,c12,c,m,i,j;\par
3431 \par
3432       {\cf20 /* compute median of three */}\par
3433       m = n >> 1;\par
3434       c01 = STBTT__COMPARE(&p[0],&p[m]);\par
3435       c12 = STBTT__COMPARE(&p[m],&p[n-1]);\par
3436       {\cf20 /* if 0 >= mid >= end, or 0 < mid < end, then use mid */}\par
3437       {\cf19 if} (c01 != c12) \{\par
3438          {\cf20 /* otherwise, we'll need to swap something else to middle */}\par
3439          {\cf18 int} z;\par
3440          c = STBTT__COMPARE(&p[0],&p[n-1]);\par
3441          {\cf20 /* 0>mid && mid<n:  0>n => n; 0<n => 0 */}\par
3442          {\cf20 /* 0<mid && mid>n:  0>n => 0; 0<n => n */}\par
3443          z = (c == c12) ? 0 : n-1;\par
3444          t = p[z];\par
3445          p[z] = p[m];\par
3446          p[m] = t;\par
3447       \}\par
3448       {\cf20 /* now p[m] is the median-of-three */}\par
3449       {\cf20 /* swap it to the beginning so it won't move around */}\par
3450       t = p[0];\par
3451       p[0] = p[m];\par
3452       p[m] = t;\par
3453 \par
3454       {\cf20 /* partition loop */}\par
3455       i=1;\par
3456       j=n-1;\par
3457       {\cf19 for}(;;) \{\par
3458          {\cf20 /* handling of equality is crucial here */}\par
3459          {\cf20 /* for sentinels & efficiency with duplicates */}\par
3460          {\cf19 for} (;;++i) \{\par
3461             {\cf19 if} (!STBTT__COMPARE(&p[i], &p[0])) {\cf19 break};\par
3462          \}\par
3463          {\cf19 for} (;;--j) \{\par
3464             {\cf19 if} (!STBTT__COMPARE(&p[0], &p[j])) {\cf19 break};\par
3465          \}\par
3466          {\cf20 /* make sure we haven't crossed */}\par
3467          {\cf19 if} (i >= j) {\cf19 break};\par
3468          t = p[i];\par
3469          p[i] = p[j];\par
3470          p[j] = t;\par
3471 \par
3472          ++i;\par
3473          --j;\par
3474       \}\par
3475       {\cf20 /* recurse on smaller side, iterate on larger */}\par
3476       {\cf19 if} (j < (n-i)) \{\par
3477          stbtt__sort_edges_quicksort(p,j);\par
3478          p = p+i;\par
3479          n = n-i;\par
3480       \} {\cf19 else} \{\par
3481          stbtt__sort_edges_quicksort(p+i, n-i);\par
3482          n = j;\par
3483       \}\par
3484    \}\par
3485 \}\par
3486 \par
3487 {\cf17 static} {\cf18 void} stbtt__sort_edges(stbtt__edge *p, {\cf18 int} n)\par
3488 \{\par
3489    stbtt__sort_edges_quicksort(p, n);\par
3490    stbtt__sort_edges_ins_sort(p, n);\par
3491 \}\par
