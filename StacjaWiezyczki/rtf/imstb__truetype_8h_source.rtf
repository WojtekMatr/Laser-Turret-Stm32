4310 STBTT_DEF {\cf18 int} stbtt_PackFontRanges(stbtt_pack_context *spc, {\cf17 const} {\cf18 unsigned} {\cf18 char} *fontdata, {\cf18 int} font_index, stbtt_pack_range *ranges, {\cf18 int} num_ranges)\par
4311 \{\par
4312    stbtt_fontinfo info;\par
4313    {\cf18 int} i, j, n, return_value; {\cf20 // [DEAR IMGUI] removed = 1;}\par
4314    {\cf20 //stbrp_context *context = (stbrp_context *) spc->pack_info;}\par
4315    stbrp_rect    *rects;\par
4316 \par
4317    {\cf20 // flag all characters as NOT packed}\par
4318    {\cf19 for} (i=0; i < num_ranges; ++i)\par
4319       {\cf19 for} (j=0; j < ranges[i].num_chars; ++j)\par
4320          ranges[i].chardata_for_range[j].x0 =\par
4321          ranges[i].chardata_for_range[j].y0 =\par
4322          ranges[i].chardata_for_range[j].x1 =\par
4323          ranges[i].chardata_for_range[j].y1 = 0;\par
4324 \par
4325    n = 0;\par
4326    {\cf19 for} (i=0; i < num_ranges; ++i)\par
4327       n += ranges[i].num_chars;\par
4328 \par
4329    rects = (stbrp_rect *) STBTT_malloc({\cf17 sizeof}(*rects) * n, spc->user_allocator_context);\par
4330    {\cf19 if} (rects == NULL)\par
4331       {\cf19 return} 0;\par
4332 \par
4333    info.userdata = spc->user_allocator_context;\par
4334    stbtt_InitFont(&info, fontdata, stbtt_GetFontOffsetForIndex(fontdata,font_index));\par
4335 \par
4336    n = stbtt_PackFontRangesGatherRects(spc, &info, ranges, num_ranges, rects);\par
4337 \par
4338    stbtt_PackFontRangesPackRects(spc, rects, n);\par
4339 \par
4340    return_value = stbtt_PackFontRangesRenderIntoRects(spc, &info, ranges, num_ranges, rects);\par
4341 \par
4342    STBTT_free(rects, spc->user_allocator_context);\par
4343    {\cf19 return} return_value;\par
4344 \}\par
