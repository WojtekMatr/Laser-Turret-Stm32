1195 {\cf17 static} stbtt__buf stbtt__cff_get_index(stbtt__buf *b)\par
1196 \{\par
1197    {\cf18 int} count, start, offsize;\par
1198    start = b->cursor;\par
1199    count = stbtt__buf_get16(b);\par
1200    {\cf19 if} (count) \{\par
1201       offsize = stbtt__buf_get8(b);\par
1202       STBTT_assert(offsize >= 1 && offsize <= 4);\par
1203       stbtt__buf_skip(b, offsize * count);\par
1204       stbtt__buf_skip(b, stbtt__buf_get(b, offsize) - 1);\par
1205    \}\par
1206    {\cf19 return} stbtt__buf_range(b, start, b->cursor - start);\par
1207 \}\par
1208 \par
1209 {\cf17 static} stbtt_uint32 stbtt__cff_int(stbtt__buf *b)\par
1210 \{\par
1211    {\cf18 int} b0 = stbtt__buf_get8(b);\par
1212    {\cf19 if} (b0 >= 32 && b0 <= 246)       {\cf19 return} b0 - 139;\par
1213    {\cf19 else} {\cf19 if} (b0 >= 247 && b0 <= 250) {\cf19 return} (b0 - 247)*256 + stbtt__buf_get8(b) + 108;\par
1214    {\cf19 else} {\cf19 if} (b0 >= 251 && b0 <= 254) {\cf19 return} -(b0 - 251)*256 - stbtt__buf_get8(b) - 108;\par
1215    {\cf19 else} {\cf19 if} (b0 == 28)               {\cf19 return} stbtt__buf_get16(b);\par
1216    {\cf19 else} {\cf19 if} (b0 == 29)               {\cf19 return} stbtt__buf_get32(b);\par
1217    STBTT_assert(0);\par
1218    {\cf19 return} 0;\par
1219 \}\par
1220 \par
1221 {\cf17 static} {\cf18 void} stbtt__cff_skip_operand(stbtt__buf *b) \{\par
1222    {\cf18 int} v, b0 = stbtt__buf_peek8(b);\par
1223    STBTT_assert(b0 >= 28);\par
1224    {\cf19 if} (b0 == 30) \{\par
1225       stbtt__buf_skip(b, 1);\par
1226       {\cf19 while} (b->cursor < b->size) \{\par
1227          v = stbtt__buf_get8(b);\par
1228          {\cf19 if} ((v & 0xF) == 0xF || (v >> 4) == 0xF)\par
1229             {\cf19 break};\par
1230       \}\par
1231    \} {\cf19 else} \{\par
1232       stbtt__cff_int(b);\par
1233    \}\par
1234 \}\par
1235 \par
1236 {\cf17 static} stbtt__buf stbtt__dict_get(stbtt__buf *b, {\cf18 int} key)\par
1237 \{\par
1238    stbtt__buf_seek(b, 0);\par
1239    {\cf19 while} (b->cursor < b->size) \{\par
1240       {\cf18 int} start = b->cursor, end, op;\par
1241       {\cf19 while} (stbtt__buf_peek8(b) >= 28)\par
1242          stbtt__cff_skip_operand(b);\par
1243       end = b->cursor;\par
1244       op = stbtt__buf_get8(b);\par
1245       {\cf19 if} (op == 12)  op = stbtt__buf_get8(b) | 0x100;\par
1246       {\cf19 if} (op == key) {\cf19 return} stbtt__buf_range(b, start, end-start);\par
1247    \}\par
1248    {\cf19 return} stbtt__buf_range(b, 0, 0);\par
1249 \}\par
1250 \par
1251 {\cf17 static} {\cf18 void} stbtt__dict_get_ints(stbtt__buf *b, {\cf18 int} key, {\cf18 int} outcount, stbtt_uint32 *out)\par
1252 \{\par
1253    {\cf18 int} i;\par
1254    stbtt__buf operands = stbtt__dict_get(b, key);\par
1255    {\cf19 for} (i = 0; i < outcount && operands.cursor < operands.size; i++)\par
1256       out[i] = stbtt__cff_int(&operands);\par
1257 \}\par
