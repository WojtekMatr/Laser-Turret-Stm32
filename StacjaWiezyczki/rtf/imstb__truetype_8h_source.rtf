1259 {\cf17 static} {\cf18 int} stbtt__cff_index_count(stbtt__buf *b)\par
1260 \{\par
1261    stbtt__buf_seek(b, 0);\par
1262    {\cf19 return} stbtt__buf_get16(b);\par
1263 \}\par
