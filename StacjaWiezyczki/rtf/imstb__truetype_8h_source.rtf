337 {\cf18 char} ttf_buffer[1<<25];\par
338 \par
339 {\cf18 int} main({\cf18 int} argc, {\cf18 char} **argv)\par
340 \{\par
341    stbtt_fontinfo font;\par
342    {\cf18 unsigned} {\cf18 char} *bitmap;\par
343    {\cf18 int} w,h,i,j,c = (argc > 1 ? atoi(argv[1]) : {\cf22 'a'}), s = (argc > 2 ? atoi(argv[2]) : 20);\par
344 \par
345    fread(ttf_buffer, 1, 1<<25, fopen(argc > 3 ? argv[3] : {\cf22 "c:/windows/fonts/arialbd.ttf"}, {\cf22 "rb"}));\par
346 \par
347    stbtt_InitFont(&font, ttf_buffer, stbtt_GetFontOffsetForIndex(ttf_buffer,0));\par
348    bitmap = stbtt_GetCodepointBitmap(&font, 0,stbtt_ScaleForPixelHeight(&font, s), c, &w, &h, 0,0);\par
349 \par
350    {\cf19 for} (j=0; j < h; ++j) \{\par
351       {\cf19 for} (i=0; i < w; ++i)\par
352          putchar({\cf22 " .:ioVM@"}[bitmap[j*w+i]>>5]);\par
353       putchar({\cf23 '\\n'});\par
354    \}\par
355    {\cf19 return} 0;\par
356 \}\par
357 {\cf21 #endif}\par
