1501 STBTT_DEF {\cf18 int} stbtt_FindGlyphIndex({\cf17 const} stbtt_fontinfo *info, {\cf18 int} unicode_codepoint)\par
1502 \{\par
1503    stbtt_uint8 *data = info->data;\par
1504    stbtt_uint32 index_map = info->index_map;\par
1505 \par
1506    stbtt_uint16 format = ttUSHORT(data + index_map + 0);\par
1507    {\cf19 if} (format == 0) \{ {\cf20 // apple byte encoding}\par
1508       stbtt_int32 bytes = ttUSHORT(data + index_map + 2);\par
1509       {\cf19 if} (unicode_codepoint < bytes-6)\par
1510          {\cf19 return} ttBYTE(data + index_map + 6 + unicode_codepoint);\par
1511       {\cf19 return} 0;\par
1512    \} {\cf19 else} {\cf19 if} (format == 6) \{\par
1513       stbtt_uint32 first = ttUSHORT(data + index_map + 6);\par
1514       stbtt_uint32 count = ttUSHORT(data + index_map + 8);\par
1515       {\cf19 if} ((stbtt_uint32) unicode_codepoint >= first && (stbtt_uint32) unicode_codepoint < first+count)\par
1516          {\cf19 return} ttUSHORT(data + index_map + 10 + (unicode_codepoint - first)*2);\par
1517       {\cf19 return} 0;\par
1518    \} {\cf19 else} {\cf19 if} (format == 2) \{\par
1519       STBTT_assert(0); {\cf20 // @TODO: high-byte mapping for japanese/chinese/korean}\par
1520       {\cf19 return} 0;\par
1521    \} {\cf19 else} {\cf19 if} (format == 4) \{ {\cf20 // standard mapping for windows fonts: binary search collection of ranges}\par
1522       stbtt_uint16 segcount = ttUSHORT(data+index_map+6) >> 1;\par
1523       stbtt_uint16 searchRange = ttUSHORT(data+index_map+8) >> 1;\par
1524       stbtt_uint16 entrySelector = ttUSHORT(data+index_map+10);\par
1525       stbtt_uint16 rangeShift = ttUSHORT(data+index_map+12) >> 1;\par
1526 \par
1527       {\cf20 // do a binary search of the segments}\par
1528       stbtt_uint32 endCount = index_map + 14;\par
1529       stbtt_uint32 search = endCount;\par
1530 \par
1531       {\cf19 if} (unicode_codepoint > 0xffff)\par
1532          {\cf19 return} 0;\par
1533 \par
1534       {\cf20 // they lie from endCount .. endCount + segCount}\par
1535       {\cf20 // but searchRange is the nearest power of two, so...}\par
1536       {\cf19 if} (unicode_codepoint >= ttUSHORT(data + search + rangeShift*2))\par
1537          search += rangeShift*2;\par
1538 \par
1539       {\cf20 // now decrement to bias correctly to find smallest}\par
1540       search -= 2;\par
1541       {\cf19 while} (entrySelector) \{\par
1542          stbtt_uint16 end;\par
1543          searchRange >>= 1;\par
1544          end = ttUSHORT(data + search + searchRange*2);\par
1545          {\cf19 if} (unicode_codepoint > end)\par
1546             search += searchRange*2;\par
1547          --entrySelector;\par
1548       \}\par
1549       search += 2;\par
1550 \par
1551       \{\par
1552          stbtt_uint16 offset, start, last;\par
1553          stbtt_uint16 item = (stbtt_uint16) ((search - endCount) >> 1);\par
1554 \par
1555          start = ttUSHORT(data + index_map + 14 + segcount*2 + 2 + 2*item);\par
1556          last = ttUSHORT(data + endCount + 2*item);\par
1557          {\cf19 if} (unicode_codepoint < start || unicode_codepoint > last)\par
1558             {\cf19 return} 0;\par
1559 \par
1560          offset = ttUSHORT(data + index_map + 14 + segcount*6 + 2 + 2*item);\par
1561          {\cf19 if} (offset == 0)\par
1562             {\cf19 return} (stbtt_uint16) (unicode_codepoint + ttSHORT(data + index_map + 14 + segcount*4 + 2 + 2*item));\par
1563 \par
1564          {\cf19 return} ttUSHORT(data + offset + (unicode_codepoint-start)*2 + index_map + 14 + segcount*6 + 2 + 2*item);\par
1565       \}\par
1566    \} {\cf19 else} {\cf19 if} (format == 12 || format == 13) \{\par
1567       stbtt_uint32 ngroups = ttULONG(data+index_map+12);\par
1568       stbtt_int32 low,high;\par
1569       low = 0; high = (stbtt_int32)ngroups;\par
1570       {\cf20 // Binary search the right group.}\par
1571       {\cf19 while} (low < high) \{\par
1572          stbtt_int32 mid = low + ((high-low) >> 1); {\cf20 // rounds down, so low <= mid < high}\par
1573          stbtt_uint32 start_char = ttULONG(data+index_map+16+mid*12);\par
1574          stbtt_uint32 end_char = ttULONG(data+index_map+16+mid*12+4);\par
1575          {\cf19 if} ((stbtt_uint32) unicode_codepoint < start_char)\par
1576             high = mid;\par
