280 {\cf20 //  Incomplete text-in-3d-api example, which draws quads properly aligned to be lossless.}\par
281 {\cf20 //  See "tests/truetype_demo_win32.c" for a complete version.}\par
282 {\cf21 #if 0}\par
283 {\cf21 #define STB_TRUETYPE_IMPLEMENTATION  }{\cf20 // force following include to generate implementation}\par
284 {\cf21 #include "stb_truetype.h"}\par
285 \par
286 {\cf18 unsigned} {\cf18 char} ttf_buffer[1<<20];\par
287 {\cf18 unsigned} {\cf18 char} temp_bitmap[512*512];\par
288 \par
289 stbtt_bakedchar cdata[96]; {\cf20 // ASCII 32..126 is 95 glyphs}\par
290 GLuint ftex;\par
291 \par
292 {\cf18 void} my_stbtt_initfont({\cf18 void})\par
293 \{\par
294    fread(ttf_buffer, 1, 1<<20, fopen({\cf22 "c:/windows/fonts/times.ttf"}, {\cf22 "rb"}));\par
295    stbtt_BakeFontBitmap(ttf_buffer,0, 32.0, temp_bitmap,512,512, 32,96, cdata); {\cf20 // no guarantee this fits!}\par
296    {\cf20 // can free ttf_buffer at this point}\par
297    glGenTextures(1, &ftex);\par
298    glBindTexture(GL_TEXTURE_2D, ftex);\par
299    glTexImage2D(GL_TEXTURE_2D, 0, GL_ALPHA, 512,512, 0, GL_ALPHA, GL_UNSIGNED_BYTE, temp_bitmap);\par
300    {\cf20 // can free temp_bitmap at this point}\par
301    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);\par
302 \}\par
303 \par
304 {\cf18 void} my_stbtt_print({\cf18 float} x, {\cf18 float} y, {\cf18 char} *text)\par
305 \{\par
306    {\cf20 // assume orthographic projection with units = screen pixels, origin at top left}\par
307    glEnable(GL_BLEND);\par
308    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);\par
309    glEnable(GL_TEXTURE_2D);\par
310    glBindTexture(GL_TEXTURE_2D, ftex);\par
311    glBegin(GL_QUADS);\par
312    {\cf19 while} (*text) \{\par
313       {\cf19 if} (*text >= 32 && *text < 128) \{\par
314          stbtt_aligned_quad q;\par
315          stbtt_GetBakedQuad(cdata, 512,512, *text-32, &x,&y,&q,1);{\cf20 //1=opengl & d3d10+,0=d3d9}\par
316          glTexCoord2f(q.s0,q.t0); glVertex2f(q.x0,q.y0);\par
317          glTexCoord2f(q.s1,q.t0); glVertex2f(q.x1,q.y0);\par
318          glTexCoord2f(q.s1,q.t1); glVertex2f(q.x1,q.y1);\par
319          glTexCoord2f(q.s0,q.t1); glVertex2f(q.x0,q.y1);\par
320       \}\par
321       ++text;\par
322    \}\par
323    glEnd();\par
324 \}\par
325 {\cf21 #endif}\par
