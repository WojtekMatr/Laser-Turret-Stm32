3766 STBTT_DEF {\cf18 void} stbtt_MakeGlyphBitmapSubpixel({\cf17 const} stbtt_fontinfo *info, {\cf18 unsigned} {\cf18 char} *output, {\cf18 int} out_w, {\cf18 int} out_h, {\cf18 int} out_stride, {\cf18 float} scale_x, {\cf18 float} scale_y, {\cf18 float} shift_x, {\cf18 float} shift_y, {\cf18 int} glyph)\par
