3816 {\cf20 //}\par
3817 {\cf20 // bitmap baking}\par
3818 {\cf20 //}\par
3819 {\cf20 // This is SUPER-CRAPPY packing to keep source code small}\par
3820 \par
3821 {\cf17 static} {\cf18 int} stbtt_BakeFontBitmap_internal({\cf18 unsigned} {\cf18 char} *data, {\cf18 int} offset,  {\cf20 // font location (use offset=0 for plain .ttf)}\par
3822                                 {\cf18 float} pixel_height,                     {\cf20 // height of font in pixels}\par
3823                                 {\cf18 unsigned} {\cf18 char} *pixels, {\cf18 int} pw, {\cf18 int} ph,  {\cf20 // bitmap to be filled in}\par
3824                                 {\cf18 int} first_char, {\cf18 int} num_chars,          {\cf20 // characters to bake}\par
3825                                 stbtt_bakedchar *chardata)\par
3826 \{\par
3827    {\cf18 float} scale;\par
3828    {\cf18 int} x,y,bottom_y, i;\par
3829    stbtt_fontinfo f;\par
3830    f.userdata = NULL;\par
3831    {\cf19 if} (!stbtt_InitFont(&f, data, offset))\par
3832       {\cf19 return} -1;\par
3833    STBTT_memset(pixels, 0, pw*ph); {\cf20 // background of 0 around pixels}\par
3834    x=y=1;\par
3835    bottom_y = 1;\par
3836 \par
3837    scale = stbtt_ScaleForPixelHeight(&f, pixel_height);\par
3838 \par
3839    {\cf19 for} (i=0; i < num_chars; ++i) \{\par
3840       {\cf18 int} advance, lsb, x0,y0,x1,y1,gw,gh;\par
3841       {\cf18 int} g = stbtt_FindGlyphIndex(&f, first_char + i);\par
3842       stbtt_GetGlyphHMetrics(&f, g, &advance, &lsb);\par
3843       stbtt_GetGlyphBitmapBox(&f, g, scale,scale, &x0,&y0,&x1,&y1);\par
3844       gw = x1-x0;\par
3845       gh = y1-y0;\par
3846       {\cf19 if} (x + gw + 1 >= pw)\par
3847          y = bottom_y, x = 1; {\cf20 // advance to next row}\par
3848       {\cf19 if} (y + gh + 1 >= ph) {\cf20 // check if it fits vertically AFTER potentially moving to next row}\par
3849          {\cf19 return} -i;\par
3850       STBTT_assert(x+gw < pw);\par
3851       STBTT_assert(y+gh < ph);\par
3852       stbtt_MakeGlyphBitmap(&f, pixels+x+y*pw, gw,gh,pw, scale,scale, g);\par
3853       chardata[i].x0 = (stbtt_int16) x;\par
3854       chardata[i].y0 = (stbtt_int16) y;\par
3855       chardata[i].x1 = (stbtt_int16) (x + gw);\par
3856       chardata[i].y1 = (stbtt_int16) (y + gh);\par
3857       chardata[i].xadvance = scale * advance;\par
3858       chardata[i].xoff     = (float) x0;\par
3859       chardata[i].yoff     = (float) y0;\par
3860       x = x + gw + 1;\par
3861       {\cf19 if} (y+gh+1 > bottom_y)\par
3862          bottom_y = y+gh+1;\par
3863    \}\par
3864    {\cf19 return} bottom_y;\par
3865 \}\par
3866 \par
3867 STBTT_DEF {\cf18 void} stbtt_GetBakedQuad({\cf17 const} stbtt_bakedchar *chardata, {\cf18 int} pw, {\cf18 int} ph, {\cf18 int} char_index, {\cf18 float} *xpos, {\cf18 float} *ypos, stbtt_aligned_quad *q, {\cf18 int} opengl_fillrule)\par
3868 \{\par
3869    {\cf18 float} d3d_bias = opengl_fillrule ? 0 : -0.5f;\par
3870    {\cf18 float} ipw = 1.0f / pw, iph = 1.0f / ph;\par
3871    {\cf17 const} stbtt_bakedchar *b = chardata + char_index;\par
3872    {\cf18 int} round_x = STBTT_ifloor((*xpos + b->xoff) + 0.5f);\par
3873    {\cf18 int} round_y = STBTT_ifloor((*ypos + b->yoff) + 0.5f);\par
3874 \par
3875    q->x0 = round_x + d3d_bias;\par
3876    q->y0 = round_y + d3d_bias;\par
3877    q->x1 = round_x + b->x1 - b->x0 + d3d_bias;\par
3878    q->y1 = round_y + b->y1 - b->y0 + d3d_bias;\par
3879 \par
3880    q->s0 = b->x0 * ipw;\par
3881    q->t0 = b->y0 * iph;\par
3882    q->s1 = b->x1 * ipw;\par
3883    q->t1 = b->y1 * iph;\par
3884 \par
3885    *xpos += b->xadvance;\par
3886 \}\par
