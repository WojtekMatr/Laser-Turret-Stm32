3721 STBTT_DEF {\cf18 unsigned} {\cf18 char} *stbtt_GetGlyphBitmapSubpixel({\cf17 const} stbtt_fontinfo *info, {\cf18 float} scale_x, {\cf18 float} scale_y, {\cf18 float} shift_x, {\cf18 float} shift_y, {\cf18 int} glyph, {\cf18 int} *width, {\cf18 int} *height, {\cf18 int} *xoff, {\cf18 int} *yoff)\par
3722 \{\par
3723    {\cf18 int} ix0,iy0,ix1,iy1;\par
3724    stbtt__bitmap gbm;\par
3725    stbtt_vertex *vertices;\par
3726    {\cf18 int} num_verts = stbtt_GetGlyphShape(info, glyph, &vertices);\par
3727 \par
3728    {\cf19 if} (scale_x == 0) scale_x = scale_y;\par
3729    {\cf19 if} (scale_y == 0) \{\par
3730       {\cf19 if} (scale_x == 0) \{\par
3731          STBTT_free(vertices, info->userdata);\par
3732          {\cf19 return} NULL;\par
3733       \}\par
3734       scale_y = scale_x;\par
3735    \}\par
3736 \par
3737    stbtt_GetGlyphBitmapBoxSubpixel(info, glyph, scale_x, scale_y, shift_x, shift_y, &ix0,&iy0,&ix1,&iy1);\par
3738 \par
3739    {\cf20 // now we get the size}\par
3740    gbm.w = (ix1 - ix0);\par
3741    gbm.h = (iy1 - iy0);\par
3742    gbm.pixels = NULL; {\cf20 // in case we error}\par
3743 \par
3744    {\cf19 if} (width ) *width  = gbm.w;\par
3745    {\cf19 if} (height) *height = gbm.h;\par
3746    {\cf19 if} (xoff  ) *xoff   = ix0;\par
3747    {\cf19 if} (yoff  ) *yoff   = iy0;\par
3748 \par
3749    {\cf19 if} (gbm.w && gbm.h) \{\par
3750       gbm.pixels = ({\cf18 unsigned} {\cf18 char} *) STBTT_malloc(gbm.w * gbm.h, info->userdata);\par
3751       {\cf19 if} (gbm.pixels) \{\par
3752          gbm.stride = gbm.w;\par
3753 \par
3754          stbtt_Rasterize(&gbm, 0.35f, vertices, num_verts, scale_x, scale_y, shift_x, shift_y, ix0, iy0, 1, info->userdata);\par
3755       \}\par
3756    \}\par
3757    STBTT_free(vertices, info->userdata);\par
3758    {\cf19 return} gbm.pixels;\par
3759 \}\par
3760 \par
3761 STBTT_DEF {\cf18 unsigned} {\cf18 char} *stbtt_GetGlyphBitmap({\cf17 const} stbtt_fontinfo *info, {\cf18 float} scale_x, {\cf18 float} scale_y, {\cf18 int} glyph, {\cf18 int} *width, {\cf18 int} *height, {\cf18 int} *xoff, {\cf18 int} *yoff)\par
3762 \{\par
