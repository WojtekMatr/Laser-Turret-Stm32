330 {\cf20 // Complete program (this compiles): get a single bitmap, print as ASCII art}\par
331 {\cf20 //}\par
332 {\cf21 #if 0}\par
333 {\cf21 #include <stdio.h>}\par
334 {\cf21 #define STB_TRUETYPE_IMPLEMENTATION  }{\cf20 // force following include to generate implementation}\par
335 {\cf21 #include "stb_truetype.h"}\par
