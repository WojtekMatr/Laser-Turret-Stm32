1359 {\cf17 static} stbtt__buf stbtt__get_subrs(stbtt__buf cff, stbtt__buf fontdict)\par
1360 \{\par
1361    stbtt_uint32 subrsoff = 0, private_loc[2] = \{ 0, 0 \};\par
1362    stbtt__buf pdict;\par
1363    stbtt__dict_get_ints(&fontdict, 18, 2, private_loc);\par
1364    {\cf19 if} (!private_loc[1] || !private_loc[0]) {\cf19 return} stbtt__new_buf(NULL, 0);\par
1365    pdict = stbtt__buf_range(&cff, private_loc[1], private_loc[0]);\par
