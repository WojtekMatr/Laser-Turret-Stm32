1281 {\cf20 // accessors to parse data from file}\par
1282 {\cf20 //}\par
1283 \par
1284 {\cf20 // on platforms that don't allow misaligned reads, if we want to allow}\par
1285 {\cf20 // truetype fonts that aren't padded to alignment, define ALLOW_UNALIGNED_TRUETYPE}\par
1286 \par
1287 {\cf21 #define ttBYTE(p)     (* (stbtt_uint8 *) (p))}\par
1288 {\cf21 #define ttCHAR(p)     (* (stbtt_int8 *) (p))}\par
1289 {\cf21 #define ttFixed(p)    ttLONG(p)}\par
