1186 {\cf17 static} stbtt__buf stbtt__buf_range({\cf17 const} stbtt__buf *b, {\cf18 int} o, {\cf18 int} s)\par
1187 \{\par
1188    stbtt__buf r = stbtt__new_buf(NULL, 0);\par
1189    {\cf19 if} (o < 0 || s < 0 || o > b->size || s > b->size - o) {\cf19 return} r;\par
1190    r.data = b->data + o;\par
1191    r.size = s;\par
1192    {\cf19 return} r;\par
1193 \}\par
