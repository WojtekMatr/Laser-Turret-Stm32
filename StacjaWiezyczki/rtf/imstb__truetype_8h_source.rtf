952 \par
953 STBTT_DEF {\cf18 unsigned} {\cf18 char} * stbtt_GetGlyphSDF({\cf17 const} stbtt_fontinfo *info, {\cf18 float} scale, {\cf18 int} glyph, {\cf18 int} padding, {\cf18 unsigned} {\cf18 char} onedge_value, {\cf18 float} pixel_dist_scale, {\cf18 int} *width, {\cf18 int} *height, {\cf18 int} *xoff, {\cf18 int} *yoff);\par
954 STBTT_DEF {\cf18 unsigned} {\cf18 char} * stbtt_GetCodepointSDF({\cf17 const} stbtt_fontinfo *info, {\cf18 float} scale, {\cf18 int} codepoint, {\cf18 int} padding, {\cf18 unsigned} {\cf18 char} onedge_value, {\cf18 float} pixel_dist_scale, {\cf18 int} *width, {\cf18 int} *height, {\cf18 int} *xoff, {\cf18 int} *yoff);\par
955 {\cf20 // These functions compute a discretized SDF field for a single character, suitable for storing}\par
956 {\cf20 // in a single-channel texture, sampling with bilinear filtering, and testing against}\par
957 {\cf20 // larger than some threshold to produce scalable fonts.}\par
958 {\cf20 //        info              --  the font}\par
959 {\cf20 //        scale             --  controls the size of the resulting SDF bitmap, same as it would be creating a regular bitmap}\par
960 {\cf20 //        glyph/codepoint   --  the character to generate the SDF for}\par
961 {\cf20 //        padding           --  extra "pixels" around the character which are filled with the distance to the character (not 0),}\par
962 {\cf20 //                                 which allows effects like bit outlines}\par
963 {\cf20 //        onedge_value      --  value 0-255 to test the SDF against to reconstruct the character (i.e. the isocontour of the character)}\par
964 {\cf20 //        pixel_dist_scale  --  what value the SDF should increase by when moving one SDF "pixel" away from the edge (on the 0..255 scale)}\par
965 {\cf20 //                                 if positive, > onedge_value is inside; if negative, < onedge_value is inside}\par
966 {\cf20 //        width,height      --  output height & width of the SDF bitmap (including padding)}\par
967 {\cf20 //        xoff,yoff         --  output origin of the character}\par
968 {\cf20 //        return value      --  a 2D array of bytes 0..255, width*height in size}\par
969 {\cf20 //}\par
970 {\cf20 // pixel_dist_scale & onedge_value are a scale & bias that allows you to make}\par
971 {\cf20 // optimal use of the limited 0..255 for your application, trading off precision}\par
972 {\cf20 // and special effects. SDF values outside the range 0..255 are clamped to 0..255.}\par
973 {\cf20 //}\par
974 {\cf20 // Example:}\par
975 {\cf20 //      scale = stbtt_ScaleForPixelHeight(22)}\par
976 {\cf20 //      padding = 5}\par
977 {\cf20 //      onedge_value = 180}\par
978 {\cf20 //      pixel_dist_scale = 180/5.0 = 36.0}\par
979 {\cf20 //}\par
980 {\cf20 //      This will create an SDF bitmap in which the character is about 22 pixels}\par
981 {\cf20 //      high but the whole bitmap is about 22+5+5=32 pixels high. To produce a filled}\par
982 {\cf20 //      shape, sample the SDF at each pixel and fill the pixel if the SDF value}\par
983 {\cf20 //      is greater than or equal to 180/255. (You'll actually want to antialias,}\par
984 {\cf20 //      which is beyond the scope of this example.) Additionally, you can compute}\par
985 {\cf20 //      offset outlines (e.g. to stroke the character border inside & outside,}\par
986 {\cf20 //      or only outside). For example, to fill outside the character up to 3 SDF}\par
987 {\cf20 //      pixels, you would compare against (180-36.0*3)/255 = 72/255. The above}\par
988 {\cf20 //      choice of variables maps a range from 5 pixels outside the shape to}\par
989 {\cf20 //      2 pixels inside the shape to 0..255; this is intended primarily for apply}\par
990 {\cf20 //      outside effects only (the interior range is needed to allow proper}\par
991 {\cf20 //      antialiasing of the font at *smaller* sizes)}\par
992 {\cf20 //}\par
993 {\cf20 // The function computes the SDF analytically at each SDF pixel, not by e.g.}\par
994 {\cf20 // building a higher-res bitmap and approximating it. In theory the quality}\par
995 {\cf20 // should be as high as possible for an SDF of this size & representation, but}\par
996 {\cf20 // unclear if this is true in practice (perhaps building a higher-res bitmap}\par
997 {\cf20 // and computing from that can allow drop-out prevention).}\par
998 {\cf20 //}\par
999 {\cf20 // The algorithm has not been optimized at all, so expect it to be slow}\par
1000 {\cf20 // if computing lots of characters or very large sizes.}\par
1001 \par
1002 \par
