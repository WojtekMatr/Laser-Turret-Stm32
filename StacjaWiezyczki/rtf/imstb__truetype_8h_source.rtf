2813    {\cf18 float} x0,y0, x1,y1;\par
2814    {\cf18 int} invert;\par
2815 \} stbtt__edge;\par
2816 \par
2817 \par
2818 {\cf17 typedef} {\cf17 struct }stbtt__active_edge\par
2819 \{\par
2820    {\cf17 struct }stbtt__active_edge *next;\par
2821 {\cf21    #if STBTT_RASTERIZER_VERSION==1}\par
2822    {\cf18 int} x,dx;\par
2823    {\cf18 float} ey;\par
2824    {\cf18 int} direction;\par
2825 {\cf21    #elif STBTT_RASTERIZER_VERSION==2}\par
2826    {\cf18 float} fx,fdx,fdy;\par
2827    {\cf18 float} direction;\par
2828    {\cf18 float} sy;\par
2829    {\cf18 float} ey;\par
2830 {\cf21    #else}\par
2831 {\cf21    #error "Unrecognized value of STBTT_RASTERIZER_VERSION"}\par
2832 {\cf21    #endif}\par
2833 \} stbtt__active_edge;\par
2834 \par
2835 {\cf21 #if STBTT_RASTERIZER_VERSION == 1}\par
2836 {\cf21 #define STBTT_FIXSHIFT   10}\par
2837 {\cf21 #define STBTT_FIX        (1 << STBTT_FIXSHIFT)}\par
2838 {\cf21 #define STBTT_FIXMASK    (STBTT_FIX-1)}\par
2839 \par
2840 {\cf17 static} stbtt__active_edge *stbtt__new_active(stbtt__hheap *hh, stbtt__edge *e, {\cf18 int} off_x, {\cf18 float} start_point, {\cf18 void} *userdata)\par
2841 \{\par
2842    stbtt__active_edge *z = (stbtt__active_edge *) stbtt__hheap_alloc(hh, {\cf17 sizeof}(*z), userdata);\par
2843    {\cf18 float} dxdy = (e->x1 - e->x0) / (e->y1 - e->y0);\par
2844    STBTT_assert(z != NULL);\par
2845    {\cf19 if} (!z) {\cf19 return} z;\par
2846 \par
2847    {\cf20 // round dx down to avoid overshooting}\par
2848    {\cf19 if} (dxdy < 0)\par
2849       z->dx = -STBTT_ifloor(STBTT_FIX * -dxdy);\par
2850    {\cf19 else}\par
2851       z->dx = STBTT_ifloor(STBTT_FIX * dxdy);\par
2852 \par
2853    z->x = STBTT_ifloor(STBTT_FIX * e->x0 + z->dx * (start_point - e->y0)); {\cf20 // use z->dx so when we offset later it's by the same amount}\par
2854    z->x -= off_x * STBTT_FIX;\par
2855 \par
2856    z->ey = e->y1;\par
2857    z->next = 0;\par
2858    z->direction = e->invert ? 1 : -1;\par
2859    {\cf19 return} z;\par
2860 \}\par
2861 {\cf21 #elif STBTT_RASTERIZER_VERSION == 2}\par
2862 {\cf17 static} stbtt__active_edge *stbtt__new_active(stbtt__hheap *hh, stbtt__edge *e, {\cf18 int} off_x, {\cf18 float} start_point, {\cf18 void} *userdata)\par
2863 \{\par
2864    stbtt__active_edge *z = (stbtt__active_edge *) stbtt__hheap_alloc(hh, {\cf17 sizeof}(*z), userdata);\par
2865    {\cf18 float} dxdy = (e->x1 - e->x0) / (e->y1 - e->y0);\par
2866    STBTT_assert(z != NULL);\par
2867    {\cf20 //STBTT_assert(e->y0 <= start_point);}\par
2868    {\cf19 if} (!z) {\cf19 return} z;\par
2869    z->fdx = dxdy;\par
2870    z->fdy = dxdy != 0.0f ? (1.0f/dxdy) : 0.0f;\par
2871    z->fx = e->x0 + dxdy * (start_point - e->y0);\par
2872    z->fx -= off_x;\par
2873    z->direction = e->invert ? 1.0f : -1.0f;\par
2874    z->sy = e->y0;\par
2875    z->ey = e->y1;\par
2876    z->next = 0;\par
2877    {\cf19 return} z;\par
2878 \}\par
2879 {\cf21 #else}\par
2880 {\cf21 #error "Unrecognized value of STBTT_RASTERIZER_VERSION"}\par
2881 {\cf21 #endif}\par
2882 \par
2883 {\cf21 #if STBTT_RASTERIZER_VERSION == 1}\par
2884 {\cf20 // note: this routine clips fills that extend off the edges... ideally this}\par
2885 {\cf20 // wouldn't happen, but it could happen if the truetype glyph bounding boxes}\par
2886 {\cf20 // are wrong, or if the user supplies a too-small bitmap}\par
2887 {\cf17 static} {\cf18 void} stbtt__fill_active_edges({\cf18 unsigned} {\cf18 char} *scanline, {\cf18 int} len, stbtt__active_edge *e, {\cf18 int} max_weight)\par
2888 \{\par
2889    {\cf20 // non-zero winding fill}\par
2890    {\cf18 int} x0=0, w=0;\par
2891 \par
2892    {\cf19 while} (e) \{\par
2893       {\cf19 if} (w == 0) \{\par
2894          {\cf20 // if we're currently at zero, we need to record the edge start point}\par
2895          x0 = e->x; w += e->direction;\par
2896       \} {\cf19 else} \{\par
2897          {\cf18 int} x1 = e->x; w += e->direction;\par
2898          {\cf20 // if we went to zero, we need to draw}\par
2899          {\cf19 if} (w == 0) \{\par
2900             {\cf18 int} i = x0 >> STBTT_FIXSHIFT;\par
2901             {\cf18 int} j = x1 >> STBTT_FIXSHIFT;\par
2902 \par
2903             {\cf19 if} (i < len && j >= 0) \{\par
2904                {\cf19 if} (i == j) \{\par
2905                   {\cf20 // x0,x1 are the same pixel, so compute combined coverage}\par
2906                   scanline[i] = scanline[i] + (stbtt_uint8) ((x1 - x0) * max_weight >> STBTT_FIXSHIFT);\par
2907                \} {\cf19 else} \{\par
2908                   {\cf19 if} (i >= 0) {\cf20 // add antialiasing for x0}\par
2909                      scanline[i] = scanline[i] + (stbtt_uint8) (((STBTT_FIX - (x0 & STBTT_FIXMASK)) * max_weight) >> STBTT_FIXSHIFT);\par
2910                   {\cf19 else}\par
2911                      i = -1; {\cf20 // clip}\par
2912 \par
2913                   {\cf19 if} (j < len) {\cf20 // add antialiasing for x1}\par
2914                      scanline[j] = scanline[j] + (stbtt_uint8) (((x1 & STBTT_FIXMASK) * max_weight) >> STBTT_FIXSHIFT);\par
2915                   {\cf19 else}\par
2916                      j = len; {\cf20 // clip}\par
2917 \par
2918                   {\cf19 for} (++i; i < j; ++i) {\cf20 // fill pixels between x0 and x1}\par
2919                      scanline[i] = scanline[i] + (stbtt_uint8) max_weight;\par
2920                \}\par
2921             \}\par
2922          \}\par
2923       \}\par
2924 \par
2925       e = e->next;\par
2926    \}\par
2927 \}\par
2928 \par
2929 {\cf17 static} {\cf18 void} stbtt__rasterize_sorted_edges(stbtt__bitmap *result, stbtt__edge *e, {\cf18 int} n, {\cf18 int} vsubsample, {\cf18 int} off_x, {\cf18 int} off_y, {\cf18 void} *userdata)\par
2930 \{\par
2931    stbtt__hheap hh = \{ 0, 0, 0 \};\par
2932    stbtt__active_edge *active = NULL;\par
2933    {\cf18 int} y,j=0;\par
2934    {\cf18 int} max_weight = (255 / vsubsample);  {\cf20 // weight per vertical scanline}\par
2935    {\cf18 int} s; {\cf20 // vertical subsample index}\par
2936    {\cf18 unsigned} {\cf18 char} scanline_data[512], *scanline;\par
2937 \par
2938    {\cf19 if} (result->w > 512)\par
2939       scanline = ({\cf18 unsigned} {\cf18 char} *) STBTT_malloc(result->w, userdata);\par
2940    {\cf19 else}\par
2941       scanline = scanline_data;\par
2942 \par
2943    y = off_y * vsubsample;\par
2944    e[n].y0 = (off_y + result->h) * ({\cf18 float}) vsubsample + 1;\par
2945 \par
2946    {\cf19 while} (j < result->h) \{\par
2947       STBTT_memset(scanline, 0, result->w);\par
2948       {\cf19 for} (s=0; s < vsubsample; ++s) \{\par
2949          {\cf20 // find center of pixel for this scanline}\par
2950          {\cf18 float} scan_y = y + 0.5f;\par
2951          stbtt__active_edge **step = &active;\par
2952 \par
2953          {\cf20 // update all active edges;}\par
2954          {\cf20 // remove all active edges that terminate before the center of this scanline}\par
2955          {\cf19 while} (*step) \{\par
2956             stbtt__active_edge * z = *step;\par
2957             {\cf19 if} (z->ey <= scan_y) \{\par
2958                *step = z->next; {\cf20 // delete from list}\par
2959                STBTT_assert(z->direction);\par
2960                z->direction = 0;\par
2961                stbtt__hheap_free(&hh, z);\par
2962             \} {\cf19 else} \{\par
2963                z->x += z->dx; {\cf20 // advance to position for current scanline}\par
2964                step = &((*step)->next); {\cf20 // advance through list}\par
2965             \}\par
2966          \}\par
2967 \par
2968          {\cf20 // resort the list if needed}\par
2969          {\cf19 for}(;;) \{\par
2970             {\cf18 int} changed=0;\par
2971             step = &active;\par
2972             {\cf19 while} (*step && (*step)->next) \{\par
2973                {\cf19 if} ((*step)->x > (*step)->next->x) \{\par
2974                   stbtt__active_edge *t = *step;\par
2975                   stbtt__active_edge *q = t->next;\par
2976 \par
2977                   t->next = q->next;\par
2978                   q->next = t;\par
2979                   *step = q;\par
2980                   changed = 1;\par
2981                \}\par
2982                step = &(*step)->next;\par
2983             \}\par
2984             {\cf19 if} (!changed) {\cf19 break};\par
2985          \}\par
2986 \par
2987          {\cf20 // insert all edges that start before the center of this scanline -- omit ones that also end on this scanline}\par
2988          {\cf19 while} (e->y0 <= scan_y) \{\par
2989             {\cf19 if} (e->y1 > scan_y) \{\par
2990                stbtt__active_edge *z = stbtt__new_active(&hh, e, off_x, scan_y, userdata);\par
2991                {\cf19 if} (z != NULL) \{\par
2992                   {\cf20 // find insertion point}\par
2993                   {\cf19 if} (active == NULL)\par
2994                      active = z;\par
2995                   {\cf19 else} {\cf19 if} (z->x < active->x) \{\par
2996                      {\cf20 // insert at front}\par
2997                      z->next = active;\par
2998                      active = z;\par
2999                   \} {\cf19 else} \{\par
3000                      {\cf20 // find thing to insert AFTER}\par
3001                      stbtt__active_edge *p = active;\par
3002                      {\cf19 while} (p->next && p->next->x < z->x)\par
3003                         p = p->next;\par
3004                      {\cf20 // at this point, p->next->x is NOT < z->x}\par
3005                      z->next = p->next;\par
3006                      p->next = z;\par
3007                   \}\par
3008                \}\par
3009             \}\par
3010             ++e;\par
3011          \}\par
3012 \par
3013          {\cf20 // now process all active edges in XOR fashion}\par
3014          {\cf19 if} (active)\par
3015             stbtt__fill_active_edges(scanline, result->w, active, max_weight);\par
3016 \par
3017          ++y;\par
3018       \}\par
3019       STBTT_memcpy(result->pixels + j * result->stride, scanline, result->w);\par
3020       ++j;\par
3021    \}\par
3022 \par
3023    stbtt__hheap_cleanup(&hh, userdata);\par
3024 \par
3025    {\cf19 if} (scanline != scanline_data)\par
3026       STBTT_free(scanline, userdata);\par
3027 \}\par
3028 \par
3029 {\cf21 #elif STBTT_RASTERIZER_VERSION == 2}\par
3030 \par
3031 {\cf20 // the edge passed in here does not cross the vertical line at x or the vertical line at x+1}\par
3032 {\cf20 // (i.e. it has already been clipped to those)}\par
3033 {\cf17 static} {\cf18 void} stbtt__handle_clipped_edge({\cf18 float} *scanline, {\cf18 int} x, stbtt__active_edge *e, {\cf18 float} x0, {\cf18 float} y0, {\cf18 float} x1, {\cf18 float} y1)\par
3034 \{\par
3035    {\cf19 if} (y0 == y1) {\cf19 return};\par
3036    STBTT_assert(y0 < y1);\par
3037    STBTT_assert(e->sy <= e->ey);\par
3038    {\cf19 if} (y0 > e->ey) {\cf19 return};\par
3039    {\cf19 if} (y1 < e->sy) {\cf19 return};\par
3040    {\cf19 if} (y0 < e->sy) \{\par
3041       x0 += (x1-x0) * (e->sy - y0) / (y1-y0);\par
3042       y0 = e->sy;\par
3043    \}\par
3044    {\cf19 if} (y1 > e->ey) \{\par
3045       x1 += (x1-x0) * (e->ey - y1) / (y1-y0);\par
3046       y1 = e->ey;\par
3047    \}\par
3048 \par
3049    {\cf19 if} (x0 == x)\par
3050       STBTT_assert(x1 <= x+1);\par
3051    {\cf19 else} {\cf19 if} (x0 == x+1)\par
3052       STBTT_assert(x1 >= x);\par
3053    {\cf19 else} {\cf19 if} (x0 <= x)\par
3054       STBTT_assert(x1 <= x);\par
3055    {\cf19 else} {\cf19 if} (x0 >= x+1)\par
3056       STBTT_assert(x1 >= x+1);\par
3057    {\cf19 else}\par
3058       STBTT_assert(x1 >= x && x1 <= x+1);\par
3059 \par
3060    {\cf19 if} (x0 <= x && x1 <= x)\par
3061       scanline[x] += e->direction * (y1-y0);\par
3062    {\cf19 else} {\cf19 if} (x0 >= x+1 && x1 >= x+1)\par
3063       ;\par
3064    {\cf19 else} \{\par
3065       STBTT_assert(x0 >= x && x0 <= x+1 && x1 >= x && x1 <= x+1);\par
3066       scanline[x] += e->direction * (y1-y0) * (1-((x0-x)+(x1-x))/2); {\cf20 // coverage = 1 - average x position}\par
3067    \}\par
3068 \}\par
3069 \par
3070 {\cf17 static} {\cf18 float} stbtt__sized_trapezoid_area({\cf18 float} height, {\cf18 float} top_width, {\cf18 float} bottom_width)\par
3071 \{\par
3072    STBTT_assert(top_width >= 0);\par
3073    STBTT_assert(bottom_width >= 0);\par
3074    {\cf19 return} (top_width + bottom_width) / 2.0f * height;\par
3075 \}\par
3076 \par
3077 {\cf17 static} {\cf18 float} stbtt__position_trapezoid_area({\cf18 float} height, {\cf18 float} tx0, {\cf18 float} tx1, {\cf18 float} bx0, {\cf18 float} bx1)\par
3078 \{\par
3079    {\cf19 return} stbtt__sized_trapezoid_area(height, tx1 - tx0, bx1 - bx0);\par
3080 \}\par
3081 \par
3082 {\cf17 static} {\cf18 float} stbtt__sized_triangle_area({\cf18 float} height, {\cf18 float} width)\par
3083 \{\par
3084    {\cf19 return} height * width / 2;\par
3085 \}\par
3086 \par
3087 {\cf17 static} {\cf18 void} stbtt__fill_active_edges_new({\cf18 float} *scanline, {\cf18 float} *scanline_fill, {\cf18 int} len, stbtt__active_edge *e, {\cf18 float} y_top)\par
3088 \{\par
3089    {\cf18 float} y_bottom = y_top+1;\par
3090 \par
3091    {\cf19 while} (e) \{\par
3092       {\cf20 // brute force every pixel}\par
3093 \par
3094       {\cf20 // compute intersection points with top & bottom}\par
3095       STBTT_assert(e->ey >= y_top);\par
3096 \par
3097       {\cf19 if} (e->fdx == 0) \{\par
3098          {\cf18 float} x0 = e->fx;\par
3099          {\cf19 if} (x0 < len) \{\par
3100             {\cf19 if} (x0 >= 0) \{\par
3101                stbtt__handle_clipped_edge(scanline,({\cf18 int}) x0,e, x0,y_top, x0,y_bottom);\par
3102                stbtt__handle_clipped_edge(scanline_fill-1,({\cf18 int}) x0+1,e, x0,y_top, x0,y_bottom);\par
3103             \} {\cf19 else} \{\par
3104                stbtt__handle_clipped_edge(scanline_fill-1,0,e, x0,y_top, x0,y_bottom);\par
3105             \}\par
3106          \}\par
3107       \} {\cf19 else} \{\par
3108          {\cf18 float} x0 = e->fx;\par
3109          {\cf18 float} dx = e->fdx;\par
3110          {\cf18 float} xb = x0 + dx;\par
3111          {\cf18 float} x_top, x_bottom;\par
3112          {\cf18 float} sy0,sy1;\par
3113          {\cf18 float} dy = e->fdy;\par
3114          STBTT_assert(e->sy <= y_bottom && e->ey >= y_top);\par
3115 \par
3116          {\cf20 // compute endpoints of line segment clipped to this scanline (if the}\par
3117          {\cf20 // line segment starts on this scanline. x0 is the intersection of the}\par
3118          {\cf20 // line with y_top, but that may be off the line segment.}\par
3119          {\cf19 if} (e->sy > y_top) \{\par
3120             x_top = x0 + dx * (e->sy - y_top);\par
3121             sy0 = e->sy;\par
3122          \} {\cf19 else} \{\par
3123             x_top = x0;\par
3124             sy0 = y_top;\par
3125          \}\par
3126          {\cf19 if} (e->ey < y_bottom) \{\par
3127             x_bottom = x0 + dx * (e->ey - y_top);\par
3128             sy1 = e->ey;\par
3129          \} {\cf19 else} \{\par
3130             x_bottom = xb;\par
3131             sy1 = y_bottom;\par
3132          \}\par
3133 \par
3134          {\cf19 if} (x_top >= 0 && x_bottom >= 0 && x_top < len && x_bottom < len) \{\par
3135             {\cf20 // from here on, we don't have to range check x values}\par
3136 \par
3137             {\cf19 if} (({\cf18 int}) x_top == ({\cf18 int}) x_bottom) \{\par
3138                {\cf18 float} height;\par
3139                {\cf20 // simple case, only spans one pixel}\par
3140                {\cf18 int} x = (int) x_top;\par
3141                height = (sy1 - sy0) * e->direction;\par
3142                STBTT_assert(x >= 0 && x < len);\par
3143                scanline[x]      += stbtt__position_trapezoid_area(height, x_top, x+1.0f, x_bottom, x+1.0f);\par
3144                scanline_fill[x] += height; {\cf20 // everything right of this pixel is filled}\par
3145             \} {\cf19 else} \{\par
3146                {\cf18 int} x,x1,x2;\par
3147                {\cf18 float} y_crossing, y_final, step, sign, area;\par
3148                {\cf20 // covers 2+ pixels}\par
3149                {\cf19 if} (x_top > x_bottom) \{\par
3150                   {\cf20 // flip scanline vertically; signed area is the same}\par
3151                   {\cf18 float} t;\par
3152                   sy0 = y_bottom - (sy0 - y_top);\par
3153                   sy1 = y_bottom - (sy1 - y_top);\par
3154                   t = sy0, sy0 = sy1, sy1 = t;\par
3155                   t = x_bottom, x_bottom = x_top, x_top = t;\par
3156                   dx = -dx;\par
3157                   dy = -dy;\par
3158                   t = x0, x0 = xb, xb = t;\par
3159                \}\par
3160                STBTT_assert(dy >= 0);\par
3161                STBTT_assert(dx >= 0);\par
3162 \par
3163                x1 = (int) x_top;\par
3164                x2 = (int) x_bottom;\par
3165                {\cf20 // compute intersection with y axis at x1+1}\par
3166                y_crossing = y_top + dy * (x1+1 - x0);\par
3167 \par
3168                {\cf20 // compute intersection with y axis at x2}\par
3169                y_final = y_top + dy * (x2 - x0);\par
3170 \par
3171                {\cf20 //           x1    x_top                            x2    x_bottom}\par
3172                {\cf20 //     y_top  +------|-----+------------+------------+--------|---+------------+}\par
3173                {\cf20 //            |            |            |            |            |            |}\par
3174                {\cf20 //            |            |            |            |            |            |}\par
3175                {\cf20 //       sy0  |      Txxxxx|............|............|............|............|}\par
3176                {\cf20 // y_crossing |            *xxxxx.......|............|............|............|}\par
3177                {\cf20 //            |            |     xxxxx..|............|............|............|}\par
3178                {\cf20 //            |            |     /-   xx*xxxx........|............|............|}\par
3179                {\cf20 //            |            | dy <       |    xxxxxx..|............|............|}\par
3180                {\cf20 //   y_final  |            |     \\-     |          xx*xxx.........|............|}\par
3181                {\cf20 //       sy1  |            |            |            |   xxxxxB...|............|}\par
3182                {\cf20 //            |            |            |            |            |            |}\par
3183                {\cf20 //            |            |            |            |            |            |}\par
3184                {\cf20 //  y_bottom  +------------+------------+------------+------------+------------+}\par
3185                {\cf20 //}\par
3186                {\cf20 // goal is to measure the area covered by '.' in each pixel}\par
3187 \par
3188                {\cf20 // if x2 is right at the right edge of x1, y_crossing can blow up, github #1057}\par
3189                {\cf20 // @TODO: maybe test against sy1 rather than y_bottom?}\par
3190                {\cf19 if} (y_crossing > y_bottom)\par
3191                   y_crossing = y_bottom;\par
3192 \par
3193                sign = e->direction;\par
3194 \par
3195                {\cf20 // area of the rectangle covered from sy0..y_crossing}\par
3196                area = sign * (y_crossing-sy0);\par
3197 \par
3198                {\cf20 // area of the triangle (x_top,sy0), (x1+1,sy0), (x1+1,y_crossing)}\par
3199                scanline[x1] += stbtt__sized_triangle_area(area, x1+1 - x_top);\par
3200 \par
3201                {\cf20 // check if final y_crossing is blown up; no test case for this}\par
3202                {\cf19 if} (y_final > y_bottom) \{\par
3203                   {\cf18 int} denom = (x2 - (x1+1));\par
3204                   y_final = y_bottom;\par
3205                   {\cf19 if} (denom != 0) \{ {\cf20 // [DEAR IMGUI] Avoid div by zero (https://github.com/nothings/stb/issues/1316)}\par
3206                      dy = (y_final - y_crossing ) / denom; {\cf20 // if denom=0, y_final = y_crossing, so y_final <= y_bottom}\par
3207                   \}\par
3208                \}\par
3209 \par
3210                {\cf20 // in second pixel, area covered by line segment found in first pixel}\par
3211                {\cf20 // is always a rectangle 1 wide * the height of that line segment; this}\par
3212                {\cf20 // is exactly what the variable 'area' stores. it also gets a contribution}\par
3213                {\cf20 // from the line segment within it. the THIRD pixel will get the first}\par
3214                {\cf20 // pixel's rectangle contribution, the second pixel's rectangle contribution,}\par
3215                {\cf20 // and its own contribution. the 'own contribution' is the same in every pixel except}\par
3216                {\cf20 // the leftmost and rightmost, a trapezoid that slides down in each pixel.}\par
3217                {\cf20 // the second pixel's contribution to the third pixel will be the}\par
3218                {\cf20 // rectangle 1 wide times the height change in the second pixel, which is dy.}\par
3219 \par
3220                step = sign * dy * 1; {\cf20 // dy is dy/dx, change in y for every 1 change in x,}\par
3221                {\cf20 // which multiplied by 1-pixel-width is how much pixel area changes for each step in x}\par
3222                {\cf20 // so the area advances by 'step' every time}\par
3223 \par
3224                {\cf19 for} (x = x1+1; x < x2; ++x) \{\par
3225                   scanline[x] += area + step/2; {\cf20 // area of trapezoid is 1*step/2}\par
3226                   area += step;\par
3227                \}\par
3228                STBTT_assert(STBTT_fabs(area) <= 1.01f); {\cf20 // accumulated error from area += step unless we round step down}\par
3229                STBTT_assert(sy1 > y_final-0.01f);\par
3230 \par
3231                {\cf20 // area covered in the last pixel is the rectangle from all the pixels to the left,}\par
3232                {\cf20 // plus the trapezoid filled by the line segment in this pixel all the way to the right edge}\par
3233                scanline[x2] += area + sign * stbtt__position_trapezoid_area(sy1-y_final, ({\cf18 float}) x2, x2+1.0f, x_bottom, x2+1.0f);\par
3234 \par
3235                {\cf20 // the rest of the line is filled based on the total height of the line segment in this pixel}\par
3236                scanline_fill[x2] += sign * (sy1-sy0);\par
3237             \}\par
3238          \} {\cf19 else} \{\par
3239             {\cf20 // if edge goes outside of box we're drawing, we require}\par
3240             {\cf20 // clipping logic. since this does not match the intended use}\par
3241             {\cf20 // of this library, we use a different, very slow brute}\par
3242             {\cf20 // force implementation}\par
3243             {\cf20 // note though that this does happen some of the time because}\par
3244             {\cf20 // x_top and x_bottom can be extrapolated at the top & bottom of}\par
3245             {\cf20 // the shape and actually lie outside the bounding box}\par
3246             {\cf18 int} x;\par
3247             {\cf19 for} (x=0; x < len; ++x) \{\par
3248                {\cf20 // cases:}\par
3249                {\cf20 //}\par
3250                {\cf20 // there can be up to two intersections with the pixel. any intersection}\par
3251                {\cf20 // with left or right edges can be handled by splitting into two (or three)}\par
3252                {\cf20 // regions. intersections with top & bottom do not necessitate case-wise logic.}\par
3253                {\cf20 //}\par
3254                {\cf20 // the old way of doing this found the intersections with the left & right edges,}\par
3255                {\cf20 // then used some simple logic to produce up to three segments in sorted order}\par
3256                {\cf20 // from top-to-bottom. however, this had a problem: if an x edge was epsilon}\par
3257                {\cf20 // across the x border, then the corresponding y position might not be distinct}\par
3258                {\cf20 // from the other y segment, and it might ignored as an empty segment. to avoid}\par
3259                {\cf20 // that, we need to explicitly produce segments based on x positions.}\par
3260 \par
3261                {\cf20 // rename variables to clearly-defined pairs}\par
3262                {\cf18 float} y0 = y_top;\par
3263                {\cf18 float} x1 = (float) (x);\par
3264                {\cf18 float} x2 = (float) (x+1);\par
3265                {\cf18 float} x3 = xb;\par
3266                {\cf18 float} y3 = y_bottom;\par
3267 \par
3268                {\cf20 // x = e->x + e->dx * (y-y_top)}\par
3269                {\cf20 // (y-y_top) = (x - e->x) / e->dx}\par
3270                {\cf20 // y = (x - e->x) / e->dx + y_top}\par
3271                {\cf18 float} y1 = (x - x0) / dx + y_top;\par
3272                {\cf18 float} y2 = (x+1 - x0) / dx + y_top;\par
3273 \par
3274                {\cf19 if} (x0 < x1 && x3 > x2) \{         {\cf20 // three segments descending down-right}\par
3275                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x1,y1);\par
3276                   stbtt__handle_clipped_edge(scanline,x,e, x1,y1, x2,y2);\par
3277                   stbtt__handle_clipped_edge(scanline,x,e, x2,y2, x3,y3);\par
3278                \} {\cf19 else} {\cf19 if} (x3 < x1 && x0 > x2) \{  {\cf20 // three segments descending down-left}\par
3279                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x2,y2);\par
3280                   stbtt__handle_clipped_edge(scanline,x,e, x2,y2, x1,y1);\par
3281                   stbtt__handle_clipped_edge(scanline,x,e, x1,y1, x3,y3);\par
3282                \} {\cf19 else} {\cf19 if} (x0 < x1 && x3 > x1) \{  {\cf20 // two segments across x, down-right}\par
3283                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x1,y1);\par
3284                   stbtt__handle_clipped_edge(scanline,x,e, x1,y1, x3,y3);\par
3285                \} {\cf19 else} {\cf19 if} (x3 < x1 && x0 > x1) \{  {\cf20 // two segments across x, down-left}\par
3286                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x1,y1);\par
3287                   stbtt__handle_clipped_edge(scanline,x,e, x1,y1, x3,y3);\par
3288                \} {\cf19 else} {\cf19 if} (x0 < x2 && x3 > x2) \{  {\cf20 // two segments across x+1, down-right}\par
3289                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x2,y2);\par
3290                   stbtt__handle_clipped_edge(scanline,x,e, x2,y2, x3,y3);\par
3291                \} {\cf19 else} {\cf19 if} (x3 < x2 && x0 > x2) \{  {\cf20 // two segments across x+1, down-left}\par
3292                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x2,y2);\par
3293                   stbtt__handle_clipped_edge(scanline,x,e, x2,y2, x3,y3);\par
3294                \} {\cf19 else} \{  {\cf20 // one segment}\par
3295                   stbtt__handle_clipped_edge(scanline,x,e, x0,y0, x3,y3);\par
3296                \}\par
3297             \}\par
3298          \}\par
3299       \}\par
3300       e = e->next;\par
3301    \}\par
3302 \}\par
