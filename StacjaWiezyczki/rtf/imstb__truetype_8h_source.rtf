4927 {\cf17 static} {\cf18 int} stbtt_FindMatchingFont_internal({\cf18 unsigned} {\cf18 char} *font_collection, {\cf18 char} *name_utf8, stbtt_int32 flags)\par
4928 \{\par
4929    stbtt_int32 i;\par
4930    {\cf19 for} (i=0;;++i) \{\par
4931       stbtt_int32 off = stbtt_GetFontOffsetForIndex(font_collection, i);\par
4932       {\cf19 if} (off < 0) {\cf19 return} off;\par
4933       {\cf19 if} (stbtt__matches((stbtt_uint8 *) font_collection, off, (stbtt_uint8*) name_utf8, flags))\par
4934          {\cf19 return} off;\par
4935    \}\par
4936 \}\par
