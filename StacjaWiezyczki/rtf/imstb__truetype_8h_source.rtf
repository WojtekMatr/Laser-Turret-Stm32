640 STBTT_DEF {\cf18 void} stbtt_PackSetOversampling(stbtt_pack_context *spc, {\cf18 unsigned} {\cf18 int} h_oversample, {\cf18 unsigned} {\cf18 int} v_oversample);\par
641 {\cf20 // Oversampling a font increases the quality by allowing higher-quality subpixel}\par
642 {\cf20 // positioning, and is especially valuable at smaller text sizes.}\par
643 {\cf20 //}\par
644 {\cf20 // This function sets the amount of oversampling for all following calls to}\par
645 {\cf20 // stbtt_PackFontRange(s) or stbtt_PackFontRangesGatherRects for a given}\par
646 {\cf20 // pack context. The default (no oversampling) is achieved by h_oversample=1}\par
647 {\cf20 // and v_oversample=1. The total number of pixels required is}\par
648 {\cf20 // h_oversample*v_oversample larger than the default; for example, 2x2}\par
649 {\cf20 // oversampling requires 4x the storage of 1x1. For best results, render}\par
650 {\cf20 // oversampled textures with bilinear filtering. Look at the readme in}\par
651 {\cf20 // stb/tests/oversample for information about oversampled fonts}\par
652 {\cf20 //}\par
653 {\cf20 // To use with PackFontRangesGather etc., you must set it before calls}\par
654 {\cf20 // call to PackFontRangesGatherRects.}\par
655 \par
656 STBTT_DEF {\cf18 void} stbtt_PackSetSkipMissingCodepoints(stbtt_pack_context *spc, {\cf18 int} skip);\par
657 {\cf20 // If skip != 0, this tells stb_truetype to skip any codepoints for which}\par
658 {\cf20 // there is no corresponding glyph. If skip=0, which is the default, then}\par
659 {\cf20 // codepoints without a glyph received the font's "missing character" glyph,}\par
660 {\cf20 // typically an empty box by convention.}\par
661 \par
