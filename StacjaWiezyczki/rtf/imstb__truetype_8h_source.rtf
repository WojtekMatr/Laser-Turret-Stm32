4399 {\cf20 //}\par
4400 {\cf20 // sdf computation}\par
4401 {\cf20 //}\par
4402 \par
4403 {\cf21 #define STBTT_min(a,b)  ((a) < (b) ? (a) : (b))}\par
4404 {\cf21 #define STBTT_max(a,b)  ((a) < (b) ? (b) : (a))}\par
4405 \par
4406 {\cf17 static} {\cf18 int} stbtt__ray_intersect_bezier({\cf18 float} orig[2], {\cf18 float} ray[2], {\cf18 float} q0[2], {\cf18 float} q1[2], {\cf18 float} q2[2], {\cf18 float} hits[2][2])\par
4407 \{\par
4408    {\cf18 float} q0perp = q0[1]*ray[0] - q0[0]*ray[1];\par
4409    {\cf18 float} q1perp = q1[1]*ray[0] - q1[0]*ray[1];\par
4410    {\cf18 float} q2perp = q2[1]*ray[0] - q2[0]*ray[1];\par
4411    {\cf18 float} roperp = orig[1]*ray[0] - orig[0]*ray[1];\par
4412 \par
4413    {\cf18 float} a = q0perp - 2*q1perp + q2perp;\par
4414    {\cf18 float} b = q1perp - q0perp;\par
4415    {\cf18 float} c = q0perp - roperp;\par
4416 \par
4417    {\cf18 float} s0 = 0., s1 = 0.;\par
4418    {\cf18 int} num_s = 0;\par
4419 \par
4420    {\cf19 if} (a != 0.0) \{\par
4421       {\cf18 float} discr = b*b - a*c;\par
4422       {\cf19 if} (discr > 0.0) \{\par
4423          {\cf18 float} rcpna = -1 / a;\par
4424          {\cf18 float} d = (float) STBTT_sqrt(discr);\par
4425          s0 = (b+d) * rcpna;\par
4426          s1 = (b-d) * rcpna;\par
4427          {\cf19 if} (s0 >= 0.0 && s0 <= 1.0)\par
4428             num_s = 1;\par
4429          {\cf19 if} (d > 0.0 && s1 >= 0.0 && s1 <= 1.0) \{\par
4430             {\cf19 if} (num_s == 0) s0 = s1;\par
4431             ++num_s;\par
4432          \}\par
4433       \}\par
4434    \} {\cf19 else} \{\par
4435       {\cf20 // 2*b*s + c = 0}\par
4436       {\cf20 // s = -c / (2*b)}\par
4437       s0 = c / (-2 * b);\par
4438       {\cf19 if} (s0 >= 0.0 && s0 <= 1.0)\par
4439          num_s = 1;\par
4440    \}\par
4441 \par
4442    {\cf19 if} (num_s == 0)\par
4443       {\cf19 return} 0;\par
4444    {\cf19 else} \{\par
4445       {\cf18 float} rcp_len2 = 1 / (ray[0]*ray[0] + ray[1]*ray[1]);\par
4446       {\cf18 float} rayn_x = ray[0] * rcp_len2, rayn_y = ray[1] * rcp_len2;\par
4447 \par
4448       {\cf18 float} q0d =   q0[0]*rayn_x +   q0[1]*rayn_y;\par
4449       {\cf18 float} q1d =   q1[0]*rayn_x +   q1[1]*rayn_y;\par
4450       {\cf18 float} q2d =   q2[0]*rayn_x +   q2[1]*rayn_y;\par
4451       {\cf18 float} rod = orig[0]*rayn_x + orig[1]*rayn_y;\par
4452 \par
4453       {\cf18 float} q10d = q1d - q0d;\par
4454       {\cf18 float} q20d = q2d - q0d;\par
4455       {\cf18 float} q0rd = q0d - rod;\par
4456 \par
4457       hits[0][0] = q0rd + s0*(2.0f - 2.0f*s0)*q10d + s0*s0*q20d;\par
4458       hits[0][1] = a*s0+b;\par
4459 \par
4460       {\cf19 if} (num_s > 1) \{\par
4461          hits[1][0] = q0rd + s1*(2.0f - 2.0f*s1)*q10d + s1*s1*q20d;\par
4462          hits[1][1] = a*s1+b;\par
4463          {\cf19 return} 2;\par
4464       \} {\cf19 else} \{\par
4465          {\cf19 return} 1;\par
4466       \}\par
4467    \}\par
4468 \}\par
4469 \par
4470 {\cf17 static} {\cf18 int} equal({\cf18 float} *a, {\cf18 float} *b)\par
4471 \{\par
4472    {\cf19 return} (a[0] == b[0] && a[1] == b[1]);\par
4473 \}\par
4474 \par
4475 {\cf17 static} {\cf18 int} stbtt__compute_crossings_x({\cf18 float} x, {\cf18 float} y, {\cf18 int} nverts, stbtt_vertex *verts)\par
4476 \{\par
4477    {\cf18 int} i;\par
4478    {\cf18 float} orig[2], ray[2] = \{ 1, 0 \};\par
4479    {\cf18 float} y_frac;\par
4480    {\cf18 int} winding = 0;\par
4481 \par
4482    {\cf20 // make sure y never passes through a vertex of the shape}\par
4483    y_frac = (float) STBTT_fmod(y, 1.0f);\par
4484    {\cf19 if} (y_frac < 0.01f)\par
4485       y += 0.01f;\par
4486    {\cf19 else} {\cf19 if} (y_frac > 0.99f)\par
4487       y -= 0.01f;\par
4488 \par
4489    orig[0] = x;\par
4490    orig[1] = y;\par
4491 \par
4492    {\cf20 // test a ray from (-infinity,y) to (x,y)}\par
4493    {\cf19 for} (i=0; i < nverts; ++i) \{\par
4494       {\cf19 if} (verts[i].type == STBTT_vline) \{\par
4495          {\cf18 int} x0 = (int) verts[i-1].x, y0 = ({\cf18 int}) verts[i-1].y;\par
4496          {\cf18 int} x1 = (int) verts[i  ].x, y1 = ({\cf18 int}) verts[i  ].y;\par
4497          {\cf19 if} (y > STBTT_min(y0,y1) && y < STBTT_max(y0,y1) && x > STBTT_min(x0,x1)) \{\par
4498             {\cf18 float} x_inter = (y - y0) / (y1 - y0) * (x1-x0) + x0;\par
4499             {\cf19 if} (x_inter < x)\par
4500                winding += (y0 < y1) ? 1 : -1;\par
4501          \}\par
4502       \}\par
4503       {\cf19 if} (verts[i].type == STBTT_vcurve) \{\par
4504          {\cf18 int} x0 = (int) verts[i-1].x , y0 = ({\cf18 int}) verts[i-1].y ;\par
4505          {\cf18 int} x1 = (int) verts[i  ].cx, y1 = ({\cf18 int}) verts[i  ].cy;\par
4506          {\cf18 int} x2 = (int) verts[i  ].x , y2 = ({\cf18 int}) verts[i  ].y ;\par
4507          {\cf18 int} ax = STBTT_min(x0,STBTT_min(x1,x2)), ay = STBTT_min(y0,STBTT_min(y1,y2));\par
4508          {\cf18 int} by = STBTT_max(y0,STBTT_max(y1,y2));\par
4509          {\cf19 if} (y > ay && y < by && x > ax) \{\par
4510             {\cf18 float} q0[2],q1[2],q2[2];\par
4511             {\cf18 float} hits[2][2];\par
4512             q0[0] = (float)x0;\par
4513             q0[1] = (float)y0;\par
4514             q1[0] = (float)x1;\par
4515             q1[1] = (float)y1;\par
4516             q2[0] = (float)x2;\par
4517             q2[1] = (float)y2;\par
4518             {\cf19 if} (equal(q0,q1) || equal(q1,q2)) \{\par
4519                x0 = (int)verts[i-1].x; {\cf20 //-V1048}\par
4520                y0 = (int)verts[i-1].y; {\cf20 //-V1048}\par
4521                x1 = (int)verts[i  ].x;\par
4522                y1 = (int)verts[i  ].y;\par
4523                {\cf19 if} (y > STBTT_min(y0,y1) && y < STBTT_max(y0,y1) && x > STBTT_min(x0,x1)) \{\par
4524                   {\cf18 float} x_inter = (y - y0) / (y1 - y0) * (x1-x0) + x0;\par
4525                   {\cf19 if} (x_inter < x)\par
4526                      winding += (y0 < y1) ? 1 : -1;\par
4527                \}\par
4528             \} {\cf19 else} \{\par
4529                {\cf18 int} num_hits = stbtt__ray_intersect_bezier(orig, ray, q0, q1, q2, hits);\par
4530                {\cf19 if} (num_hits >= 1)\par
4531                   {\cf19 if} (hits[0][0] < 0)\par
4532                      winding += (hits[0][1] < 0 ? -1 : 1);\par
4533                {\cf19 if} (num_hits >= 2)\par
4534                   {\cf19 if} (hits[1][0] < 0)\par
4535                      winding += (hits[1][1] < 0 ? -1 : 1);\par
4536             \}\par
4537          \}\par
4538       \}\par
4539    \}\par
4540    {\cf19 return} winding;\par
4541 \}\par
4542 \par
4543 {\cf17 static} {\cf18 float} stbtt__cuberoot( {\cf18 float} x )\par
4544 \{\par
4545    {\cf19 if} (x<0)\par
4546       {\cf19 return} -(float) STBTT_pow(-x,1.0f/3.0f);\par
4547    {\cf19 else}\par
4548       {\cf19 return}  ({\cf18 float}) STBTT_pow( x,1.0f/3.0f);\par
4549 \}\par
4550 \par
4551 {\cf20 // x^3 + a*x^2 + b*x + c = 0}\par
4552 {\cf17 static} {\cf18 int} stbtt__solve_cubic({\cf18 float} a, {\cf18 float} b, {\cf18 float} c, {\cf18 float}* r)\par
4553 \{\par
4554    {\cf18 float} s = -a / 3;\par
4555    {\cf18 float} p = b - a*a / 3;\par
4556    {\cf18 float} q = a * (2*a*a - 9*b) / 27 + c;\par
4557    {\cf18 float} p3 = p*p*p;\par
4558    {\cf18 float} d = q*q + 4*p3 / 27;\par
4559    {\cf19 if} (d >= 0) \{\par
4560       {\cf18 float} z = (float) STBTT_sqrt(d);\par
4561       {\cf18 float} u = (-q + z) / 2;\par
4562       {\cf18 float} v = (-q - z) / 2;\par
4563       u = stbtt__cuberoot(u);\par
4564       v = stbtt__cuberoot(v);\par
4565       r[0] = s + u + v;\par
4566       {\cf19 return} 1;\par
4567    \} {\cf19 else} \{\par
4568       {\cf18 float} u = (float) STBTT_sqrt(-p/3);\par
4569       {\cf18 float} v = (float) STBTT_acos(-STBTT_sqrt(-27/p3) * q / 2) / 3; {\cf20 // p3 must be negative, since d is negative}\par
4570       {\cf18 float} m = (float) STBTT_cos(v);\par
4571       {\cf18 float} n = (float) STBTT_cos(v-3.141592/2)*1.732050808f;\par
4572       r[0] = s + u * 2 * m;\par
4573       r[1] = s - u * (m + n);\par
4574       r[2] = s - u * (m - n);\par
4575 \par
4576       {\cf20 //STBTT_assert( STBTT_fabs(((r[0]+a)*r[0]+b)*r[0]+c) < 0.05f);  // these asserts may not be safe at all scales, though they're in bezier t parameter units so maybe?}\par
4577       {\cf20 //STBTT_assert( STBTT_fabs(((r[1]+a)*r[1]+b)*r[1]+c) < 0.05f);}\par
4578       {\cf20 //STBTT_assert( STBTT_fabs(((r[2]+a)*r[2]+b)*r[2]+c) < 0.05f);}\par
4579       {\cf19 return} 3;\par
4580    \}\par
4581 \}\par
