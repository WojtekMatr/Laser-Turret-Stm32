3583 {\cf17 static} {\cf18 void} stbtt__tesselate_cubic(stbtt__point *points, {\cf18 int} *num_points, {\cf18 float} x0, {\cf18 float} y0, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} x2, {\cf18 float} y2, {\cf18 float} x3, {\cf18 float} y3, {\cf18 float} objspace_flatness_squared, {\cf18 int} n)\par
