4583 STBTT_DEF {\cf18 unsigned} {\cf18 char} * stbtt_GetGlyphSDF({\cf17 const} stbtt_fontinfo *info, {\cf18 float} scale, {\cf18 int} glyph, {\cf18 int} padding, {\cf18 unsigned} {\cf18 char} onedge_value, {\cf18 float} pixel_dist_scale, {\cf18 int} *width, {\cf18 int} *height, {\cf18 int} *xoff, {\cf18 int} *yoff)\par
4584 \{\par
4585    {\cf18 float} scale_x = scale, scale_y = scale;\par
4586    {\cf18 int} ix0,iy0,ix1,iy1;\par
4587    {\cf18 int} w,h;\par
4588    {\cf18 unsigned} {\cf18 char} *data;\par
4589 \par
4590    {\cf19 if} (scale == 0) {\cf19 return} NULL;\par
4591 \par
4592    stbtt_GetGlyphBitmapBoxSubpixel(info, glyph, scale, scale, 0.0f,0.0f, &ix0,&iy0,&ix1,&iy1);\par
4593 \par
4594    {\cf20 // if empty, return NULL}\par
4595    {\cf19 if} (ix0 == ix1 || iy0 == iy1)\par
4596       {\cf19 return} NULL;\par
4597 \par
4598    ix0 -= padding;\par
4599    iy0 -= padding;\par
4600    ix1 += padding;\par
4601    iy1 += padding;\par
4602 \par
4603    w = (ix1 - ix0);\par
4604    h = (iy1 - iy0);\par
4605 \par
4606    {\cf19 if} (width ) *width  = w;\par
4607    {\cf19 if} (height) *height = h;\par
4608    {\cf19 if} (xoff  ) *xoff   = ix0;\par
4609    {\cf19 if} (yoff  ) *yoff   = iy0;\par
4610 \par
4611    {\cf20 // invert for y-downwards bitmaps}\par
4612    scale_y = -scale_y;\par
4613 \par
4614    \{\par
4615       {\cf18 int} x,y,i,j;\par
4616       {\cf18 float} *precompute;\par
4617       stbtt_vertex *verts;\par
4618       {\cf18 int} num_verts = stbtt_GetGlyphShape(info, glyph, &verts);\par
4619       data = ({\cf18 unsigned} {\cf18 char} *) STBTT_malloc(w * h, info->userdata);\par
4620       precompute = ({\cf18 float} *) STBTT_malloc(num_verts * {\cf17 sizeof}({\cf18 float}), info->userdata);\par
4621 \par
4622       {\cf19 for} (i=0,j=num_verts-1; i < num_verts; j=i++) \{\par
4623          {\cf19 if} (verts[i].type == STBTT_vline) \{\par
4624             {\cf18 float} x0 = verts[i].x*scale_x, y0 = verts[i].y*scale_y;\par
4625             {\cf18 float} x1 = verts[j].x*scale_x, y1 = verts[j].y*scale_y;\par
4626             {\cf18 float} dist = (float) STBTT_sqrt((x1-x0)*(x1-x0) + (y1-y0)*(y1-y0));\par
4627             precompute[i] = (dist == 0) ? 0.0f : 1.0f / dist;\par
4628          \} {\cf19 else} {\cf19 if} (verts[i].type == STBTT_vcurve) \{\par
4629             {\cf18 float} x2 = verts[j].x *scale_x, y2 = verts[j].y *scale_y;\par
4630             {\cf18 float} x1 = verts[i].cx*scale_x, y1 = verts[i].cy*scale_y;\par
4631             {\cf18 float} x0 = verts[i].x *scale_x, y0 = verts[i].y *scale_y;\par
4632             {\cf18 float} bx = x0 - 2*x1 + x2, by = y0 - 2*y1 + y2;\par
4633             {\cf18 float} len2 = bx*bx + by*by;\par
4634             {\cf19 if} (len2 != 0.0f)\par
4635                precompute[i] = 1.0f / (bx*bx + by*by);\par
4636             {\cf19 else}\par
4637                precompute[i] = 0.0f;\par
4638          \} {\cf19 else}\par
4639             precompute[i] = 0.0f;\par
4640       \}\par
4641 \par
4642       {\cf19 for} (y=iy0; y < iy1; ++y) \{\par
4643          {\cf19 for} (x=ix0; x < ix1; ++x) \{\par
4644             {\cf18 float} val;\par
4645             {\cf18 float} min_dist = 999999.0f;\par
4646             {\cf18 float} sx = (float) x + 0.5f;\par
4647             {\cf18 float} sy = (float) y + 0.5f;\par
4648             {\cf18 float} x_gspace = (sx / scale_x);\par
4649             {\cf18 float} y_gspace = (sy / scale_y);\par
4650 \par
4651             {\cf18 int} winding = stbtt__compute_crossings_x(x_gspace, y_gspace, num_verts, verts); {\cf20 // @OPTIMIZE: this could just be a rasterization, but needs to be line vs. non-tesselated curves so a new path}\par
4652 \par
4653             {\cf19 for} (i=0; i < num_verts; ++i) \{\par
4654                {\cf18 float} x0 = verts[i].x*scale_x, y0 = verts[i].y*scale_y;\par
4655 \par
4656                {\cf19 if} (verts[i].type == STBTT_vline && precompute[i] != 0.0f) \{\par
4657                   {\cf18 float} x1 = verts[i-1].x*scale_x, y1 = verts[i-1].y*scale_y;\par
4658 \par
4659                   {\cf18 float} dist,dist2 = (x0-sx)*(x0-sx) + (y0-sy)*(y0-sy);\par
4660                   {\cf19 if} (dist2 < min_dist*min_dist)\par
4661                      min_dist = (float) STBTT_sqrt(dist2);\par
4662 \par
4663                   {\cf20 // coarse culling against bbox}\par
4664                   {\cf20 //if (sx > STBTT_min(x0,x1)-min_dist && sx < STBTT_max(x0,x1)+min_dist &&}\par
4665                   {\cf20 //    sy > STBTT_min(y0,y1)-min_dist && sy < STBTT_max(y0,y1)+min_dist)}\par
4666                   dist = (float) STBTT_fabs((x1-x0)*(y0-sy) - (y1-y0)*(x0-sx)) * precompute[i];\par
4667                   STBTT_assert(i != 0);\par
4668                   {\cf19 if} (dist < min_dist) \{\par
4669                      {\cf20 // check position along line}\par
4670                      {\cf20 // x' = x0 + t*(x1-x0), y' = y0 + t*(y1-y0)}\par
4671                      {\cf20 // minimize (x'-sx)*(x'-sx)+(y'-sy)*(y'-sy)}\par
4672                      {\cf18 float} dx = x1-x0, dy = y1-y0;\par
4673                      {\cf18 float} px = x0-sx, py = y0-sy;\par
4674                      {\cf20 // minimize (px+t*dx)^2 + (py+t*dy)^2 = px*px + 2*px*dx*t + t^2*dx*dx + py*py + 2*py*dy*t + t^2*dy*dy}\par
4675                      {\cf20 // derivative: 2*px*dx + 2*py*dy + (2*dx*dx+2*dy*dy)*t, set to 0 and solve}\par
4676                      {\cf18 float} t = -(px*dx + py*dy) / (dx*dx + dy*dy);\par
4677                      {\cf19 if} (t >= 0.0f && t <= 1.0f)\par
4678                         min_dist = dist;\par
4679                   \}\par
4680                \} {\cf19 else} {\cf19 if} (verts[i].type == STBTT_vcurve) \{\par
4681                   {\cf18 float} x2 = verts[i-1].x *scale_x, y2 = verts[i-1].y *scale_y;\par
4682                   {\cf18 float} x1 = verts[i  ].cx*scale_x, y1 = verts[i  ].cy*scale_y;\par
4683                   {\cf18 float} box_x0 = STBTT_min(STBTT_min(x0,x1),x2);\par
4684                   {\cf18 float} box_y0 = STBTT_min(STBTT_min(y0,y1),y2);\par
4685                   {\cf18 float} box_x1 = STBTT_max(STBTT_max(x0,x1),x2);\par
4686                   {\cf18 float} box_y1 = STBTT_max(STBTT_max(y0,y1),y2);\par
4687                   {\cf20 // coarse culling against bbox to avoid computing cubic unnecessarily}\par
4688                   {\cf19 if} (sx > box_x0-min_dist && sx < box_x1+min_dist && sy > box_y0-min_dist && sy < box_y1+min_dist) \{\par
4689                      {\cf18 int} num=0;\par
4690                      {\cf18 float} ax = x1-x0, ay = y1-y0;\par
4691                      {\cf18 float} bx = x0 - 2*x1 + x2, by = y0 - 2*y1 + y2;\par
4692                      {\cf18 float} mx = x0 - sx, my = y0 - sy;\par
4693                      {\cf18 float} res[3] = \{0.f,0.f,0.f\};\par
4694                      {\cf18 float} px,py,t,it,dist2;\par
4695                      {\cf18 float} a_inv = precompute[i];\par
4696                      {\cf19 if} (a_inv == 0.0) \{ {\cf20 // if a_inv is 0, it's 2nd degree so use quadratic formula}\par
4697                         {\cf18 float} a = 3*(ax*bx + ay*by);\par
4698                         {\cf18 float} b = 2*(ax*ax + ay*ay) + (mx*bx+my*by);\par
4699                         {\cf18 float} c = mx*ax+my*ay;\par
4700                         {\cf19 if} (a == 0.0) \{ {\cf20 // if a is 0, it's linear}\par
4701                            {\cf19 if} (b != 0.0) \{\par
4702                               res[num++] = -c/b;\par
4703                            \}\par
4704                         \} {\cf19 else} \{\par
4705                            {\cf18 float} discriminant = b*b - 4*a*c;\par
4706                            {\cf19 if} (discriminant < 0)\par
4707                               num = 0;\par
4708                            {\cf19 else} \{\par
4709                               {\cf18 float} root = (float) STBTT_sqrt(discriminant);\par
4710                               res[0] = (-b - root)/(2*a);\par
4711                               res[1] = (-b + root)/(2*a);\par
4712                               num = 2; {\cf20 // don't bother distinguishing 1-solution case, as code below will still work}\par
4713                            \}\par
4714                         \}\par
4715                      \} {\cf19 else} \{\par
4716                         {\cf18 float} b = 3*(ax*bx + ay*by) * a_inv; {\cf20 // could precompute this as it doesn't depend on sample point}\par
4717                         {\cf18 float} c = (2*(ax*ax + ay*ay) + (mx*bx+my*by)) * a_inv;\par
4718                         {\cf18 float} d = (mx*ax+my*ay) * a_inv;\par
4719                         num = stbtt__solve_cubic(b, c, d, res);\par
4720                      \}\par
4721                      dist2 = (x0-sx)*(x0-sx) + (y0-sy)*(y0-sy);\par
4722                      {\cf19 if} (dist2 < min_dist*min_dist)\par
4723                         min_dist = (float) STBTT_sqrt(dist2);\par
4724 \par
4725                      {\cf19 if} (num >= 1 && res[0] >= 0.0f && res[0] <= 1.0f) \{\par
4726                         t = res[0], it = 1.0f - t;\par
4727                         px = it*it*x0 + 2*t*it*x1 + t*t*x2;\par
4728                         py = it*it*y0 + 2*t*it*y1 + t*t*y2;\par
4729                         dist2 = (px-sx)*(px-sx) + (py-sy)*(py-sy);\par
4730                         {\cf19 if} (dist2 < min_dist * min_dist)\par
4731                            min_dist = (float) STBTT_sqrt(dist2);\par
4732                      \}\par
4733                      {\cf19 if} (num >= 2 && res[1] >= 0.0f && res[1] <= 1.0f) \{\par
4734                         t = res[1], it = 1.0f - t;\par
4735                         px = it*it*x0 + 2*t*it*x1 + t*t*x2;\par
4736                         py = it*it*y0 + 2*t*it*y1 + t*t*y2;\par
4737                         dist2 = (px-sx)*(px-sx) + (py-sy)*(py-sy);\par
4738                         {\cf19 if} (dist2 < min_dist * min_dist)\par
4739                            min_dist = (float) STBTT_sqrt(dist2);\par
4740                      \}\par
4741                      {\cf19 if} (num >= 3 && res[2] >= 0.0f && res[2] <= 1.0f) \{\par
4742                         t = res[2], it = 1.0f - t;\par
4743                         px = it*it*x0 + 2*t*it*x1 + t*t*x2;\par
4744                         py = it*it*y0 + 2*t*it*y1 + t*t*y2;\par
4745                         dist2 = (px-sx)*(px-sx) + (py-sy)*(py-sy);\par
4746                         {\cf19 if} (dist2 < min_dist * min_dist)\par
4747                            min_dist = (float) STBTT_sqrt(dist2);\par
4748                      \}\par
4749                   \}\par
4750                \}\par
4751             \}\par
4752             {\cf19 if} (winding == 0)\par
4753                min_dist = -min_dist;  {\cf20 // if outside the shape, value is negative}\par
4754             val = onedge_value + pixel_dist_scale * min_dist;\par
4755             {\cf19 if} (val < 0)\par
4756                val = 0;\par
4757             {\cf19 else} {\cf19 if} (val > 255)\par
4758                val = 255;\par
4759             data[(y-iy0)*w+(x-ix0)] = ({\cf18 unsigned} char) val;\par
4760          \}\par
4761       \}\par
4762       STBTT_free(precompute, info->userdata);\par
4763       STBTT_free(verts, info->userdata);\par
4764    \}\par
4765    {\cf19 return} data;\par
4766 \}\par
4767 \par
