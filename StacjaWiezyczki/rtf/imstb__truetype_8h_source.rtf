3585    {\cf20 // @TODO this "flatness" calculation is just made-up nonsense that seems to work well enough}\par
3586    {\cf18 float} dx0 = x1-x0;\par
3587    {\cf18 float} dy0 = y1-y0;\par
3588    {\cf18 float} dx1 = x2-x1;\par
3589    {\cf18 float} dy1 = y2-y1;\par
3590    {\cf18 float} dx2 = x3-x2;\par
3591    {\cf18 float} dy2 = y3-y2;\par
