593 STBTT_DEF {\cf18 int}  stbtt_PackBegin(stbtt_pack_context *spc, {\cf18 unsigned} {\cf18 char} *pixels, {\cf18 int} width, {\cf18 int} height, {\cf18 int} stride_in_bytes, {\cf18 int} padding, {\cf18 void} *alloc_context);\par
594 {\cf20 // Initializes a packing context stored in the passed-in stbtt_pack_context.}\par
595 {\cf20 // Future calls using this context will pack characters into the bitmap passed}\par
596 {\cf20 // in here: a 1-channel bitmap that is width * height. stride_in_bytes is}\par
597 {\cf20 // the distance from one row to the next (or 0 to mean they are packed tightly}\par
598 {\cf20 // together). "padding" is the amount of padding to leave between each}\par
599 {\cf20 // character (normally you want '1' for bitmaps you'll use as textures with}\par
600 {\cf20 // bilinear filtering).}\par
601 {\cf20 //}\par
602 {\cf20 // Returns 0 on failure, 1 on success.}\par
