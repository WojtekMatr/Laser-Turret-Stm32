4783 {\cf20 // check if a utf8 string contains a prefix which is the utf16 string; if so return length of matching utf8 string}\par
4784 {\cf17 static} stbtt_int32 stbtt__CompareUTF8toUTF16_bigendian_prefix(stbtt_uint8 *s1, stbtt_int32 len1, stbtt_uint8 *s2, stbtt_int32 len2)\par
4785 \{\par
4786    stbtt_int32 i=0;\par
4787 \par
4788    {\cf20 // convert utf16 to utf8 and compare the results while converting}\par
4789    {\cf19 while} (len2) \{\par
4790       stbtt_uint16 ch = s2[0]*256 + s2[1];\par
4791       {\cf19 if} (ch < 0x80) \{\par
4792          {\cf19 if} (i >= len1) {\cf19 return} -1;\par
4793          {\cf19 if} (s1[i++] != ch) {\cf19 return} -1;\par
4794       \} {\cf19 else} {\cf19 if} (ch < 0x800) \{\par
4795          {\cf19 if} (i+1 >= len1) {\cf19 return} -1;\par
4796          {\cf19 if} (s1[i++] != 0xc0 + (ch >> 6)) {\cf19 return} -1;\par
4797          {\cf19 if} (s1[i++] != 0x80 + (ch & 0x3f)) {\cf19 return} -1;\par
4798       \} {\cf19 else} {\cf19 if} (ch >= 0xd800 && ch < 0xdc00) \{\par
4799          stbtt_uint32 c;\par
4800          stbtt_uint16 ch2 = s2[2]*256 + s2[3];\par
4801          {\cf19 if} (i+3 >= len1) {\cf19 return} -1;\par
4802          c = ((ch - 0xd800) << 10) + (ch2 - 0xdc00) + 0x10000;\par
4803          {\cf19 if} (s1[i++] != 0xf0 + (c >> 18)) {\cf19 return} -1;\par
4804          {\cf19 if} (s1[i++] != 0x80 + ((c >> 12) & 0x3f)) {\cf19 return} -1;\par
4805          {\cf19 if} (s1[i++] != 0x80 + ((c >>  6) & 0x3f)) {\cf19 return} -1;\par
4806          {\cf19 if} (s1[i++] != 0x80 + ((c      ) & 0x3f)) {\cf19 return} -1;\par
4807          s2 += 2; {\cf20 // plus another 2 below}\par
4808          len2 -= 2;\par
4809       \} {\cf19 else} {\cf19 if} (ch >= 0xdc00 && ch < 0xe000) \{\par
4810          {\cf19 return} -1;\par
4811       \} {\cf19 else} \{\par
4812          {\cf19 if} (i+2 >= len1) {\cf19 return} -1;\par
4813          {\cf19 if} (s1[i++] != 0xe0 + (ch >> 12)) {\cf19 return} -1;\par
4814          {\cf19 if} (s1[i++] != 0x80 + ((ch >> 6) & 0x3f)) {\cf19 return} -1;\par
4815          {\cf19 if} (s1[i++] != 0x80 + ((ch     ) & 0x3f)) {\cf19 return} -1;\par
4816       \}\par
4817       s2 += 2;\par
4818       len2 -= 2;\par
4819    \}\par
4820    {\cf19 return} i;\par
4821 \}\par
4822 \par
4823 {\cf17 static} {\cf18 int} stbtt_CompareUTF8toUTF16_bigendian_internal({\cf18 char} *s1, {\cf18 int} len1, {\cf18 char} *s2, {\cf18 int} len2)\par
4824 \{\par
4825    {\cf19 return} len1 == stbtt__CompareUTF8toUTF16_bigendian_prefix((stbtt_uint8*) s1, len1, (stbtt_uint8*) s2, len2);\par
4826 \}\par
4827 \par
4828 {\cf20 // returns results in whatever encoding you request... but note that 2-byte encodings}\par
4829 {\cf20 // will be BIG-ENDIAN... use stbtt_CompareUTF8toUTF16_bigendian() to compare}\par
4830 STBTT_DEF {\cf17 const} {\cf18 char} *stbtt_GetFontNameString({\cf17 const} stbtt_fontinfo *font, {\cf18 int} *length, {\cf18 int} platformID, {\cf18 int} encodingID, {\cf18 int} languageID, {\cf18 int} nameID)\par
4831 \{\par
4832    stbtt_int32 i,count,stringOffset;\par
4833    stbtt_uint8 *fc = font->data;\par
4834    stbtt_uint32 offset = font->fontstart;\par
4835    stbtt_uint32 nm = stbtt__find_table(fc, offset, {\cf22 "name"});\par
4836    {\cf19 if} (!nm) {\cf19 return} NULL;\par
4837 \par
4838    count = ttUSHORT(fc+nm+2);\par
4839    stringOffset = nm + ttUSHORT(fc+nm+4);\par
4840    {\cf19 for} (i=0; i < count; ++i) \{\par
4841       stbtt_uint32 loc = nm + 6 + 12 * i;\par
4842       {\cf19 if} (platformID == ttUSHORT(fc+loc+0) && encodingID == ttUSHORT(fc+loc+2)\par
4843           && languageID == ttUSHORT(fc+loc+4) && nameID == ttUSHORT(fc+loc+6)) \{\par
4844          *length = ttUSHORT(fc+loc+8);\par
4845          {\cf19 return} ({\cf17 const} {\cf18 char} *) (fc+stringOffset+ttUSHORT(fc+loc+10));\par
4846       \}\par
4847    \}\par
4848    {\cf19 return} NULL;\par
4849 \}\par
4850 \par
4851 {\cf17 static} {\cf18 int} stbtt__matchpair(stbtt_uint8 *fc, stbtt_uint32 nm, stbtt_uint8 *name, stbtt_int32 nlen, stbtt_int32 target_id, stbtt_int32 next_id)\par
4852 \{\par
4853    stbtt_int32 i;\par
4854    stbtt_int32 count = ttUSHORT(fc+nm+2);\par
4855    stbtt_int32 stringOffset = nm + ttUSHORT(fc+nm+4);\par
4856 \par
4857    {\cf19 for} (i=0; i < count; ++i) \{\par
4858       stbtt_uint32 loc = nm + 6 + 12 * i;\par
4859       stbtt_int32 {\cf18 id} = ttUSHORT(fc+loc+6);\par
4860       {\cf19 if} ({\cf18 id} == target_id) \{\par
4861          {\cf20 // find the encoding}\par
4862          stbtt_int32 platform = ttUSHORT(fc+loc+0), encoding = ttUSHORT(fc+loc+2), language = ttUSHORT(fc+loc+4);\par
4863 \par
4864          {\cf20 // is this a Unicode encoding?}\par
4865          {\cf19 if} (platform == 0 || (platform == 3 && encoding == 1) || (platform == 3 && encoding == 10)) \{\par
4866             stbtt_int32 slen = ttUSHORT(fc+loc+8);\par
4867             stbtt_int32 off = ttUSHORT(fc+loc+10);\par
4868 \par
4869             {\cf20 // check if there's a prefix match}\par
4870             stbtt_int32 matchlen = stbtt__CompareUTF8toUTF16_bigendian_prefix(name, nlen, fc+stringOffset+off,slen);\par
4871             {\cf19 if} (matchlen >= 0) \{\par
4872                {\cf20 // check for target_id+1 immediately following, with same encoding & language}\par
4873                {\cf19 if} (i+1 < count && ttUSHORT(fc+loc+12+6) == next_id && ttUSHORT(fc+loc+12) == platform && ttUSHORT(fc+loc+12+2) == encoding && ttUSHORT(fc+loc+12+4) == language) \{\par
4874                   slen = ttUSHORT(fc+loc+12+8);\par
4875                   off = ttUSHORT(fc+loc+12+10);\par
4876                   {\cf19 if} (slen == 0) \{\par
4877                      {\cf19 if} (matchlen == nlen)\par
4878                         {\cf19 return} 1;\par
4879                   \} {\cf19 else} {\cf19 if} (matchlen < nlen && name[matchlen] == {\cf23 ' '}) \{\par
4880                      ++matchlen;\par
4881                      {\cf19 if} (stbtt_CompareUTF8toUTF16_bigendian_internal(({\cf18 char}*) (name+matchlen), nlen-matchlen, ({\cf18 char}*)(fc+stringOffset+off),slen))\par
4882                         {\cf19 return} 1;\par
4883                   \}\par
4884                \} {\cf19 else} \{\par
4885                   {\cf20 // if nothing immediately following}\par
4886                   {\cf19 if} (matchlen == nlen)\par
4887                      {\cf19 return} 1;\par
4888                \}\par
4889             \}\par
4890          \}\par
4891 \par
4892          {\cf20 // @TODO handle other encodings}\par
4893       \}\par
4894    \}\par
4895    {\cf19 return} 0;\par
4896 \}\par
4897 \par
4898 {\cf17 static} {\cf18 int} stbtt__matches(stbtt_uint8 *fc, stbtt_uint32 offset, stbtt_uint8 *name, stbtt_int32 flags)\par
4899 \{\par
4900    stbtt_int32 nlen = (stbtt_int32) STBTT_strlen(({\cf18 char} *) name);\par
4901    stbtt_uint32 nm,hd;\par
4902    {\cf19 if} (!stbtt__isfont(fc+offset)) {\cf19 return} 0;\par
4903 \par
4904    {\cf20 // check italics/bold/underline flags in macStyle...}\par
4905    {\cf19 if} (flags) \{\par
4906       hd = stbtt__find_table(fc, offset, {\cf22 "head"});\par
4907       {\cf19 if} ((ttUSHORT(fc+hd+44) & 7) != (flags & 7)) {\cf19 return} 0;\par
4908    \}\par
4909 \par
4910    nm = stbtt__find_table(fc, offset, {\cf22 "name"});\par
4911    {\cf19 if} (!nm) {\cf19 return} 0;\par
4912 \par
4913    {\cf19 if} (flags) \{\par
4914       {\cf20 // if we checked the macStyle flags, then just check the family and ignore the subfamily}\par
4915       {\cf19 if} (stbtt__matchpair(fc, nm, name, nlen, 16, -1))  {\cf19 return} 1;\par
4916       {\cf19 if} (stbtt__matchpair(fc, nm, name, nlen,  1, -1))  {\cf19 return} 1;\par
4917       {\cf19 if} (stbtt__matchpair(fc, nm, name, nlen,  3, -1))  {\cf19 return} 1;\par
4918    \} {\cf19 else} \{\par
4919       {\cf19 if} (stbtt__matchpair(fc, nm, name, nlen, 16, 17))  {\cf19 return} 1;\par
4920       {\cf19 if} (stbtt__matchpair(fc, nm, name, nlen,  1,  2))  {\cf19 return} 1;\par
4921       {\cf19 if} (stbtt__matchpair(fc, nm, name, nlen,  3, -1))  {\cf19 return} 1;\par
4922    \}\par
4923 \par
4924    {\cf19 return} 0;\par
4925 \}\par
