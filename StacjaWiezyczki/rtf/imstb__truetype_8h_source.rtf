4016 \}\par
4017 \par
4018 {\cf21 #define STBTT__OVER_MASK  (STBTT_MAX_OVERSAMPLE-1)}\par
4019 \par
4020 {\cf17 static} {\cf18 void} stbtt__h_prefilter({\cf18 unsigned} {\cf18 char} *pixels, {\cf18 int} w, {\cf18 int} h, {\cf18 int} stride_in_bytes, {\cf18 unsigned} {\cf18 int} kernel_width)\par
4021 \{\par
4022    {\cf18 unsigned} {\cf18 char} buffer[STBTT_MAX_OVERSAMPLE];\par
4023    {\cf18 int} safe_w = w - kernel_width;\par
4024    {\cf18 int} j;\par
4025    STBTT_memset(buffer, 0, STBTT_MAX_OVERSAMPLE); {\cf20 // suppress bogus warning from VS2013 -analyze}\par
4026    {\cf19 for} (j=0; j < h; ++j) \{\par
4027       {\cf18 int} i;\par
4028       {\cf18 unsigned} {\cf18 int} total;\par
4029       STBTT_memset(buffer, 0, kernel_width);\par
4030 \par
4031       total = 0;\par
4032 \par
4033       {\cf20 // make kernel_width a constant in common cases so compiler can optimize out the divide}\par
4034       {\cf19 switch} (kernel_width) \{\par
4035          {\cf19 case} 2:\par
4036             {\cf19 for} (i=0; i <= safe_w; ++i) \{\par
4037                total += pixels[i] - buffer[i & STBTT__OVER_MASK];\par
4038                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i];\par
4039                pixels[i] = ({\cf18 unsigned} char) (total / 2);\par
4040             \}\par
4041             {\cf19 break};\par
4042          {\cf19 case} 3:\par
4043             {\cf19 for} (i=0; i <= safe_w; ++i) \{\par
4044                total += pixels[i] - buffer[i & STBTT__OVER_MASK];\par
4045                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i];\par
4046                pixels[i] = ({\cf18 unsigned} char) (total / 3);\par
4047             \}\par
4048             {\cf19 break};\par
4049          {\cf19 case} 4:\par
4050             {\cf19 for} (i=0; i <= safe_w; ++i) \{\par
4051                total += pixels[i] - buffer[i & STBTT__OVER_MASK];\par
4052                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i];\par
4053                pixels[i] = ({\cf18 unsigned} char) (total / 4);\par
4054             \}\par
4055             {\cf19 break};\par
4056          {\cf19 case} 5:\par
4057             {\cf19 for} (i=0; i <= safe_w; ++i) \{\par
4058                total += pixels[i] - buffer[i & STBTT__OVER_MASK];\par
4059                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i];\par
4060                pixels[i] = ({\cf18 unsigned} char) (total / 5);\par
4061             \}\par
4062             {\cf19 break};\par
4063          {\cf19 default}:\par
4064             {\cf19 for} (i=0; i <= safe_w; ++i) \{\par
4065                total += pixels[i] - buffer[i & STBTT__OVER_MASK];\par
4066                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i];\par
4067                pixels[i] = ({\cf18 unsigned} char) (total / kernel_width);\par
4068             \}\par
4069             {\cf19 break};\par
4070       \}\par
4071 \par
4072       {\cf19 for} (; i < w; ++i) \{\par
4073          STBTT_assert(pixels[i] == 0);\par
4074          total -= buffer[i & STBTT__OVER_MASK];\par
4075          pixels[i] = ({\cf18 unsigned} char) (total / kernel_width);\par
4076       \}\par
4077 \par
4078       pixels += stride_in_bytes;\par
4079    \}\par
4080 \}\par
4081 \par
4082 {\cf17 static} {\cf18 void} stbtt__v_prefilter({\cf18 unsigned} {\cf18 char} *pixels, {\cf18 int} w, {\cf18 int} h, {\cf18 int} stride_in_bytes, {\cf18 unsigned} {\cf18 int} kernel_width)\par
4083 \{\par
4084    {\cf18 unsigned} {\cf18 char} buffer[STBTT_MAX_OVERSAMPLE];\par
4085    {\cf18 int} safe_h = h - kernel_width;\par
4086    {\cf18 int} j;\par
4087    STBTT_memset(buffer, 0, STBTT_MAX_OVERSAMPLE); {\cf20 // suppress bogus warning from VS2013 -analyze}\par
4088    {\cf19 for} (j=0; j < w; ++j) \{\par
4089       {\cf18 int} i;\par
4090       {\cf18 unsigned} {\cf18 int} total;\par
4091       STBTT_memset(buffer, 0, kernel_width);\par
4092 \par
4093       total = 0;\par
4094 \par
4095       {\cf20 // make kernel_width a constant in common cases so compiler can optimize out the divide}\par
4096       {\cf19 switch} (kernel_width) \{\par
4097          {\cf19 case} 2:\par
4098             {\cf19 for} (i=0; i <= safe_h; ++i) \{\par
4099                total += pixels[i*stride_in_bytes] - buffer[i & STBTT__OVER_MASK];\par
4100                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i*stride_in_bytes];\par
4101                pixels[i*stride_in_bytes] = ({\cf18 unsigned} char) (total / 2);\par
4102             \}\par
4103             {\cf19 break};\par
4104          {\cf19 case} 3:\par
4105             {\cf19 for} (i=0; i <= safe_h; ++i) \{\par
4106                total += pixels[i*stride_in_bytes] - buffer[i & STBTT__OVER_MASK];\par
4107                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i*stride_in_bytes];\par
4108                pixels[i*stride_in_bytes] = ({\cf18 unsigned} char) (total / 3);\par
4109             \}\par
4110             {\cf19 break};\par
4111          {\cf19 case} 4:\par
4112             {\cf19 for} (i=0; i <= safe_h; ++i) \{\par
4113                total += pixels[i*stride_in_bytes] - buffer[i & STBTT__OVER_MASK];\par
4114                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i*stride_in_bytes];\par
4115                pixels[i*stride_in_bytes] = ({\cf18 unsigned} char) (total / 4);\par
4116             \}\par
4117             {\cf19 break};\par
4118          {\cf19 case} 5:\par
4119             {\cf19 for} (i=0; i <= safe_h; ++i) \{\par
4120                total += pixels[i*stride_in_bytes] - buffer[i & STBTT__OVER_MASK];\par
4121                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i*stride_in_bytes];\par
4122                pixels[i*stride_in_bytes] = ({\cf18 unsigned} char) (total / 5);\par
4123             \}\par
4124             {\cf19 break};\par
4125          {\cf19 default}:\par
4126             {\cf19 for} (i=0; i <= safe_h; ++i) \{\par
4127                total += pixels[i*stride_in_bytes] - buffer[i & STBTT__OVER_MASK];\par
4128                buffer[(i+kernel_width) & STBTT__OVER_MASK] = pixels[i*stride_in_bytes];\par
4129                pixels[i*stride_in_bytes] = ({\cf18 unsigned} char) (total / kernel_width);\par
4130             \}\par
4131             {\cf19 break};\par
4132       \}\par
4133 \par
4134       {\cf19 for} (; i < h; ++i) \{\par
4135          STBTT_assert(pixels[i*stride_in_bytes] == 0);\par
4136          total -= buffer[i & STBTT__OVER_MASK];\par
4137          pixels[i*stride_in_bytes] = ({\cf18 unsigned} char) (total / kernel_width);\par
4138       \}\par
4139 \par
4140       pixels += 1;\par
4141    \}\par
4142 \}\par
4143 \par
4144 {\cf17 static} {\cf18 float} stbtt__oversample_shift({\cf18 int} oversample)\par
4145 \{\par
4146    {\cf19 if} (!oversample)\par
4147       {\cf19 return} 0.0f;\par
4148 \par
4149    {\cf20 // The prefilter is a box filter of width "oversample",}\par
4150    {\cf20 // which shifts phase by (oversample - 1)/2 pixels in}\par
4151    {\cf20 // oversampled space. We want to shift in the opposite}\par
4152    {\cf20 // direction to counter this.}\par
4153    {\cf19 return} ({\cf18 float})-(oversample - 1) / (2.0f * ({\cf18 float})oversample);\par
4154 \}\par
4155 \par
4156 {\cf20 // rects array must be big enough to accommodate all characters in the given ranges}\par
4157 STBTT_DEF {\cf18 int} stbtt_PackFontRangesGatherRects(stbtt_pack_context *spc, {\cf17 const} stbtt_fontinfo *info, stbtt_pack_range *ranges, {\cf18 int} num_ranges, stbrp_rect *rects)\par
4158 \{\par
4159    {\cf18 int} i,j,k;\par
4160    {\cf18 int} missing_glyph_added = 0;\par
4161 \par
4162    k=0;\par
4163    {\cf19 for} (i=0; i < num_ranges; ++i) \{\par
4164       {\cf18 float} fh = ranges[i].font_size;\par
4165       {\cf18 float} scale = fh > 0 ? stbtt_ScaleForPixelHeight(info, fh) : stbtt_ScaleForMappingEmToPixels(info, -fh);\par
4166       ranges[i].h_oversample = ({\cf18 unsigned} char) spc->h_oversample;\par
4167       ranges[i].v_oversample = ({\cf18 unsigned} char) spc->v_oversample;\par
4168       {\cf19 for} (j=0; j < ranges[i].num_chars; ++j) \{\par
4169          {\cf18 int} x0,y0,x1,y1;\par
4170          {\cf18 int} codepoint = ranges[i].array_of_unicode_codepoints == NULL ? ranges[i].first_unicode_codepoint_in_range + j : ranges[i].array_of_unicode_codepoints[j];\par
4171          {\cf18 int} glyph = stbtt_FindGlyphIndex(info, codepoint);\par
4172          {\cf19 if} (glyph == 0 && (spc->skip_missing || missing_glyph_added)) \{\par
4173             rects[k].w = rects[k].h = 0;\par
4174          \} {\cf19 else} \{\par
4175             stbtt_GetGlyphBitmapBoxSubpixel(info,glyph,\par
4176                                             scale * spc->h_oversample,\par
4177                                             scale * spc->v_oversample,\par
4178                                             0,0,\par
4179                                             &x0,&y0,&x1,&y1);\par
4180             rects[k].w = (stbrp_coord) (x1-x0 + spc->padding + spc->h_oversample-1);\par
4181             rects[k].h = (stbrp_coord) (y1-y0 + spc->padding + spc->v_oversample-1);\par
4182             {\cf19 if} (glyph == 0)\par
4183                missing_glyph_added = 1;\par
4184          \}\par
4185          ++k;\par
4186       \}\par
4187    \}\par
4188 \par
4189    {\cf19 return} k;\par
4190 \}\par
4191 \par
4192 STBTT_DEF {\cf18 void} stbtt_MakeGlyphBitmapSubpixelPrefilter({\cf17 const} stbtt_fontinfo *info, {\cf18 unsigned} {\cf18 char} *output, {\cf18 int} out_w, {\cf18 int} out_h, {\cf18 int} out_stride, {\cf18 float} scale_x, {\cf18 float} scale_y, {\cf18 float} shift_x, {\cf18 float} shift_y, {\cf18 int} prefilter_x, {\cf18 int} prefilter_y, {\cf18 float} *sub_x, {\cf18 float} *sub_y, {\cf18 int} glyph)\par
4193 \{\par
4194    stbtt_MakeGlyphBitmapSubpixel(info,\par
4195                                  output,\par
4196                                  out_w - (prefilter_x - 1),\par
4197                                  out_h - (prefilter_y - 1),\par
4198                                  out_stride,\par
4199                                  scale_x,\par
4200                                  scale_y,\par
4201                                  shift_x,\par
4202                                  shift_y,\par
4203                                  glyph);\par
4204 \par
4205    {\cf19 if} (prefilter_x > 1)\par
4206       stbtt__h_prefilter(output, out_w, out_h, out_stride, prefilter_x);\par
4207 \par
4208    {\cf19 if} (prefilter_y > 1)\par
4209       stbtt__v_prefilter(output, out_w, out_h, out_stride, prefilter_y);\par
4210 \par
4211    *sub_x = stbtt__oversample_shift(prefilter_x);\par
4212    *sub_y = stbtt__oversample_shift(prefilter_y);\par
4213 \}\par
4214 \par
4215 {\cf20 // rects array must be big enough to accommodate all characters in the given ranges}\par
4216 STBTT_DEF {\cf18 int} stbtt_PackFontRangesRenderIntoRects(stbtt_pack_context *spc, {\cf17 const} stbtt_fontinfo *info, stbtt_pack_range *ranges, {\cf18 int} num_ranges, stbrp_rect *rects)\par
4217 \{\par
4218    {\cf18 int} i,j,k, missing_glyph = -1, return_value = 1;\par
4219 \par
4220    {\cf20 // save current values}\par
4221    {\cf18 int} old_h_over = spc->h_oversample;\par
4222    {\cf18 int} old_v_over = spc->v_oversample;\par
4223 \par
4224    k = 0;\par
4225    {\cf19 for} (i=0; i < num_ranges; ++i) \{\par
4226       {\cf18 float} fh = ranges[i].font_size;\par
4227       {\cf18 float} scale = fh > 0 ? stbtt_ScaleForPixelHeight(info, fh) : stbtt_ScaleForMappingEmToPixels(info, -fh);\par
4228       {\cf18 float} recip_h,recip_v,sub_x,sub_y;\par
4229       spc->h_oversample = ranges[i].h_oversample;\par
4230       spc->v_oversample = ranges[i].v_oversample;\par
4231       recip_h = 1.0f / spc->h_oversample;\par
4232       recip_v = 1.0f / spc->v_oversample;\par
4233       sub_x = stbtt__oversample_shift(spc->h_oversample);\par
4234       sub_y = stbtt__oversample_shift(spc->v_oversample);\par
4235       {\cf19 for} (j=0; j < ranges[i].num_chars; ++j) \{\par
4236          stbrp_rect *r = &rects[k];\par
4237          {\cf19 if} (r->was_packed && r->w != 0 && r->h != 0) \{\par
4238             stbtt_packedchar *bc = &ranges[i].chardata_for_range[j];\par
4239             {\cf18 int} advance, lsb, x0,y0,x1,y1;\par
4240             {\cf18 int} codepoint = ranges[i].array_of_unicode_codepoints == NULL ? ranges[i].first_unicode_codepoint_in_range + j : ranges[i].array_of_unicode_codepoints[j];\par
4241             {\cf18 int} glyph = stbtt_FindGlyphIndex(info, codepoint);\par
4242             stbrp_coord pad = (stbrp_coord) spc->padding;\par
4243 \par
4244             {\cf20 // pad on left and top}\par
4245             r->x += pad;\par
4246             r->y += pad;\par
4247             r->w -= pad;\par
4248             r->h -= pad;\par
4249             stbtt_GetGlyphHMetrics(info, glyph, &advance, &lsb);\par
4250             stbtt_GetGlyphBitmapBox(info, glyph,\par
4251                                     scale * spc->h_oversample,\par
4252                                     scale * spc->v_oversample,\par
4253                                     &x0,&y0,&x1,&y1);\par
4254             stbtt_MakeGlyphBitmapSubpixel(info,\par
4255                                           spc->pixels + r->x + r->y*spc->stride_in_bytes,\par
4256                                           r->w - spc->h_oversample+1,\par
4257                                           r->h - spc->v_oversample+1,\par
4258                                           spc->stride_in_bytes,\par
4259                                           scale * spc->h_oversample,\par
4260                                           scale * spc->v_oversample,\par
4261                                           0,0,\par
4262                                           glyph);\par
4263 \par
4264             {\cf19 if} (spc->h_oversample > 1)\par
4265                stbtt__h_prefilter(spc->pixels + r->x + r->y*spc->stride_in_bytes,\par
4266                                   r->w, r->h, spc->stride_in_bytes,\par
4267                                   spc->h_oversample);\par
4268 \par
4269             {\cf19 if} (spc->v_oversample > 1)\par
4270                stbtt__v_prefilter(spc->pixels + r->x + r->y*spc->stride_in_bytes,\par
4271                                   r->w, r->h, spc->stride_in_bytes,\par
4272                                   spc->v_oversample);\par
4273 \par
4274             bc->x0       = (stbtt_int16)  r->x;\par
4275             bc->y0       = (stbtt_int16)  r->y;\par
4276             bc->x1       = (stbtt_int16) (r->x + r->w);\par
4277             bc->y1       = (stbtt_int16) (r->y + r->h);\par
4278             bc->xadvance =                scale * advance;\par
4279             bc->xoff     =       (float)  x0 * recip_h + sub_x;\par
4280             bc->yoff     =       (float)  y0 * recip_v + sub_y;\par
4281             bc->xoff2    =                (x0 + r->w) * recip_h + sub_x;\par
4282             bc->yoff2    =                (y0 + r->h) * recip_v + sub_y;\par
4283 \par
4284             {\cf19 if} (glyph == 0)\par
4285                missing_glyph = j;\par
4286          \} {\cf19 else} {\cf19 if} (spc->skip_missing) \{\par
4287             return_value = 0;\par
4288          \} {\cf19 else} {\cf19 if} (r->was_packed && r->w == 0 && r->h == 0 && missing_glyph >= 0) \{\par
4289             ranges[i].chardata_for_range[j] = ranges[i].chardata_for_range[missing_glyph];\par
4290          \} {\cf19 else} \{\par
4291             return_value = 0; {\cf20 // if any fail, report failure}\par
4292          \}\par
4293 \par
4294          ++k;\par
4295       \}\par
4296    \}\par
4297 \par
4298    {\cf20 // restore original values}\par
4299    spc->h_oversample = old_h_over;\par
4300    spc->v_oversample = old_v_over;\par
4301 \par
4302    {\cf19 return} return_value;\par
4303 \}\par
