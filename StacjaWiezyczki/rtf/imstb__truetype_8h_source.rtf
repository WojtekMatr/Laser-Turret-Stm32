3894 \par
3895 {\cf17 typedef} {\cf18 int} stbrp_coord;\par
3896 \par
3898 {\cf20 //                                                                                //}\par
3899 {\cf20 //                                                                                //}\par
3900 {\cf20 // COMPILER WARNING ?!?!?                                                         //}\par
3901 {\cf20 //                                                                                //}\par
3902 {\cf20 //                                                                                //}\par
3903 {\cf20 // if you get a compile warning due to these symbols being defined more than      //}\par
3904 {\cf20 // once, move #include "stb_rect_pack.h" before #include "stb_truetype.h"         //}\par
3905 {\cf20 //                                                                                //}\par
3907 \par
3908 {\cf17 typedef} {\cf17 struct}\par
3909 \{\par
3910    {\cf18 int} width,height;\par
3911    {\cf18 int} x,y,bottom_y;\par
3912 \} stbrp_context;\par
3913 \par
3914 {\cf17 typedef} {\cf17 struct}\par
3915 \{\par
3916    {\cf18 unsigned} {\cf18 char} x;\par
3917 \} stbrp_node;\par
3918 \par
3919 {\cf17 struct }stbrp_rect\par
3920 \{\par
3921    stbrp_coord x,y;\par
3922    {\cf18 int} id,w,h,was_packed;\par
3923 \};\par
3924 \par
3925 {\cf17 static} {\cf18 void} stbrp_init_target(stbrp_context *con, {\cf18 int} pw, {\cf18 int} ph, stbrp_node *nodes, {\cf18 int} num_nodes)\par
3926 \{\par
3927    con->width  = pw;\par
3928    con->height = ph;\par
3929    con->x = 0;\par
3930    con->y = 0;\par
3931    con->bottom_y = 0;\par
3932    STBTT__NOTUSED(nodes);\par
3933    STBTT__NOTUSED(num_nodes);\par
3934 \}\par
3935 \par
3936 {\cf17 static} {\cf18 void} stbrp_pack_rects(stbrp_context *con, stbrp_rect *rects, {\cf18 int} num_rects)\par
3937 \{\par
3938    {\cf18 int} i;\par
3939    {\cf19 for} (i=0; i < num_rects; ++i) \{\par
3940       {\cf19 if} (con->x + rects[i].w > con->width) \{\par
3941          con->x = 0;\par
3942          con->y = con->bottom_y;\par
3943       \}\par
3944       {\cf19 if} (con->y + rects[i].h > con->height)\par
3945          {\cf19 break};\par
3946       rects[i].x = con->x;\par
3947       rects[i].y = con->y;\par
3948       rects[i].was_packed = 1;\par
3949       con->x += rects[i].w;\par
3950       {\cf19 if} (con->y + rects[i].h > con->bottom_y)\par
3951          con->bottom_y = con->y + rects[i].h;\par
3952    \}\par
3953    {\cf19 for} (   ; i < num_rects; ++i)\par
3954       rects[i].was_packed = 0;\par
3955 \}\par
3956 {\cf21 #endif}\par
