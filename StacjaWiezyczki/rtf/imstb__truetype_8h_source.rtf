1310 {\cf20 // @OPTIMIZE: binary search}\par
1311 {\cf17 static} stbtt_uint32 stbtt__find_table(stbtt_uint8 *data, stbtt_uint32 fontstart, {\cf17 const} {\cf18 char} *tag)\par
1312 \{\par
1313    stbtt_int32 num_tables = ttUSHORT(data+fontstart+4);\par
1314    stbtt_uint32 tabledir = fontstart + 12;\par
1315    stbtt_int32 i;\par
1316    {\cf19 for} (i=0; i < num_tables; ++i) \{\par
1317       stbtt_uint32 loc = tabledir + 16*i;\par
1318       {\cf19 if} (stbtt_tag(data+loc+0, tag))\par
1319          {\cf19 return} ttULONG(data+loc+8);\par
1320    \}\par
1321    {\cf19 return} 0;\par
1322 \}\par
