3959 {\cf20 //}\par
3960 {\cf20 // bitmap baking}\par
3961 {\cf20 //}\par
3962 {\cf20 // This is SUPER-AWESOME (tm Ryan Gordon) packing using stb_rect_pack.h. If}\par
3963 {\cf20 // stb_rect_pack.h isn't available, it uses the BakeFontBitmap strategy.}\par
3964 \par
3965 STBTT_DEF {\cf18 int} stbtt_PackBegin(stbtt_pack_context *spc, {\cf18 unsigned} {\cf18 char} *pixels, {\cf18 int} pw, {\cf18 int} ph, {\cf18 int} stride_in_bytes, {\cf18 int} padding, {\cf18 void} *alloc_context)\par
3966 \{\par
3967    stbrp_context *context = (stbrp_context *) STBTT_malloc({\cf17 sizeof}(*context)            ,alloc_context);\par
3968    {\cf18 int}            num_nodes = pw - padding;\par
3969    stbrp_node    *nodes   = (stbrp_node    *) STBTT_malloc({\cf17 sizeof}(*nodes  ) * num_nodes,alloc_context);\par
3970 \par
3971    {\cf19 if} (context == NULL || nodes == NULL) \{\par
3972       {\cf19 if} (context != NULL) STBTT_free(context, alloc_context);\par
3973       {\cf19 if} (nodes   != NULL) STBTT_free(nodes  , alloc_context);\par
3974       {\cf19 return} 0;\par
3975    \}\par
3976 \par
3977    spc->user_allocator_context = alloc_context;\par
3978    spc->width = pw;\par
3979    spc->height = ph;\par
3980    spc->pixels = pixels;\par
3981    spc->pack_info = context;\par
3982    spc->nodes = nodes;\par
3983    spc->padding = padding;\par
3984    spc->stride_in_bytes = stride_in_bytes != 0 ? stride_in_bytes : pw;\par
3985    spc->h_oversample = 1;\par
3986    spc->v_oversample = 1;\par
3987    spc->skip_missing = 0;\par
3988 \par
3989    stbrp_init_target(context, pw-padding, ph-padding, nodes, num_nodes);\par
3990 \par
3991    {\cf19 if} (pixels)\par
3992       STBTT_memset(pixels, 0, pw*ph); {\cf20 // background of 0 around pixels}\par
3993 \par
3994    {\cf19 return} 1;\par
3995 \}\par
3996 \par
3997 STBTT_DEF {\cf18 void} stbtt_PackEnd  (stbtt_pack_context *spc)\par
3998 \{\par
3999    STBTT_free(spc->nodes    , spc->user_allocator_context);\par
4000    STBTT_free(spc->pack_info, spc->user_allocator_context);\par
4001 \}\par
4002 \par
4003 STBTT_DEF {\cf18 void} stbtt_PackSetOversampling(stbtt_pack_context *spc, {\cf18 unsigned} {\cf18 int} h_oversample, {\cf18 unsigned} {\cf18 int} v_oversample)\par
4004 \{\par
4005    STBTT_assert(h_oversample <= STBTT_MAX_OVERSAMPLE);\par
4006    STBTT_assert(v_oversample <= STBTT_MAX_OVERSAMPLE);\par
4007    {\cf19 if} (h_oversample <= STBTT_MAX_OVERSAMPLE)\par
4008       spc->h_oversample = h_oversample;\par
4009    {\cf19 if} (v_oversample <= STBTT_MAX_OVERSAMPLE)\par
4010       spc->v_oversample = v_oversample;\par
4011 \}\par
4012 \par
4013 STBTT_DEF {\cf18 void} stbtt_PackSetSkipMissingCodepoints(stbtt_pack_context *spc, {\cf18 int} skip)\par
4014 \{\par
