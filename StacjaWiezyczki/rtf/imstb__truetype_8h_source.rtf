106 {\cf20 //      #define STBTT_STATIC}\par
107 {\cf20 //}\par
108 {\cf20 //   Simple 3D API (don't ship this, but it's fine for tools and quick start)}\par
109 {\cf20 //           stbtt_BakeFontBitmap()               -- bake a font to a bitmap for use as texture}\par
110 {\cf20 //           stbtt_GetBakedQuad()                 -- compute quad to draw for a given char}\par
111 {\cf20 //}\par
112 {\cf20 //   Improved 3D API (more shippable):}\par
113 {\cf20 //           #include "stb_rect_pack.h"           -- optional, but you really want it}\par
114 {\cf20 //           stbtt_PackBegin()}\par
115 {\cf20 //           stbtt_PackSetOversampling()          -- for improved quality on small fonts}\par
116 {\cf20 //           stbtt_PackFontRanges()               -- pack and renders}\par
117 {\cf20 //           stbtt_PackEnd()}\par
118 {\cf20 //           stbtt_GetPackedQuad()}\par
119 {\cf20 //}\par
120 {\cf20 //   "Load" a font file from a memory buffer (you have to keep the buffer loaded)}\par
121 {\cf20 //           stbtt_InitFont()}\par
122 {\cf20 //           stbtt_GetFontOffsetForIndex()        -- indexing for TTC font collections}\par
123 {\cf20 //           stbtt_GetNumberOfFonts()             -- number of fonts for TTC font collections}\par
124 {\cf20 //}\par
125 {\cf20 //   Render a unicode codepoint to a bitmap}\par
126 {\cf20 //           stbtt_GetCodepointBitmap()           -- allocates and returns a bitmap}\par
127 {\cf20 //           stbtt_MakeCodepointBitmap()          -- renders into bitmap you provide}\par
128 {\cf20 //           stbtt_GetCodepointBitmapBox()        -- how big the bitmap must be}\par
129 {\cf20 //}\par
130 {\cf20 //   Character advance/positioning}\par
131 {\cf20 //           stbtt_GetCodepointHMetrics()}\par
132 {\cf20 //           stbtt_GetFontVMetrics()}\par
133 {\cf20 //           stbtt_GetFontVMetricsOS2()}\par
134 {\cf20 //           stbtt_GetCodepointKernAdvance()}\par
135 {\cf20 //}\par
136 {\cf20 //   Starting with version 1.06, the rasterizer was replaced with a new,}\par
137 {\cf20 //   faster and generally-more-precise rasterizer. The new rasterizer more}\par
138 {\cf20 //   accurately measures pixel coverage for anti-aliasing, except in the case}\par
139 {\cf20 //   where multiple shapes overlap, in which case it overestimates the AA pixel}\par
140 {\cf20 //   coverage. Thus, anti-aliasing of intersecting shapes may look wrong. If}\par
141 {\cf20 //   this turns out to be a problem, you can re-enable the old rasterizer with}\par
142 {\cf20 //        #define STBTT_RASTERIZER_VERSION 1}\par
143 {\cf20 //   which will incur about a 15% speed hit.}\par
144 {\cf20 //}\par
145 {\cf20 // ADDITIONAL DOCUMENTATION}\par
146 {\cf20 //}\par
147 {\cf20 //   Immediately after this block comment are a series of sample programs.}\par
148 {\cf20 //}\par
149 {\cf20 //   After the sample programs is the "header file" section. This section}\par
150 {\cf20 //   includes documentation for each API function.}\par
151 {\cf20 //}\par
152 {\cf20 //   Some important concepts to understand to use this library:}\par
153 {\cf20 //}\par
154 {\cf20 //      Codepoint}\par
155 {\cf20 //         Characters are defined by unicode codepoints, e.g. 65 is}\par
156 {\cf20 //         uppercase A, 231 is lowercase c with a cedilla, 0x7e30 is}\par
157 {\cf20 //         the hiragana for "ma".}\par
158 {\cf20 //}\par
159 {\cf20 //      Glyph}\par
160 {\cf20 //         A visual character shape (every codepoint is rendered as}\par
161 {\cf20 //         some glyph)}\par
162 {\cf20 //}\par
163 {\cf20 //      Glyph index}\par
164 {\cf20 //         A font-specific integer ID representing a glyph}\par
165 {\cf20 //}\par
166 {\cf20 //      Baseline}\par
167 {\cf20 //         Glyph shapes are defined relative to a baseline, which is the}\par
168 {\cf20 //         bottom of uppercase characters. Characters extend both above}\par
169 {\cf20 //         and below the baseline.}\par
170 {\cf20 //}\par
171 {\cf20 //      Current Point}\par
172 {\cf20 //         As you draw text to the screen, you keep track of a "current point"}\par
173 {\cf20 //         which is the origin of each character. The current point's vertical}\par
174 {\cf20 //         position is the baseline. Even "baked fonts" use this model.}\par
175 {\cf20 //}\par
176 {\cf20 //      Vertical Font Metrics}\par
177 {\cf20 //         The vertical qualities of the font, used to vertically position}\par
178 {\cf20 //         and space the characters. See docs for stbtt_GetFontVMetrics.}\par
179 {\cf20 //}\par
180 {\cf20 //      Font Size in Pixels or Points}\par
181 {\cf20 //         The preferred interface for specifying font sizes in stb_truetype}\par
182 {\cf20 //         is to specify how tall the font's vertical extent should be in pixels.}\par
183 {\cf20 //         If that sounds good enough, skip the next paragraph.}\par
184 {\cf20 //}\par
185 {\cf20 //         Most font APIs instead use "points", which are a common typographic}\par
186 {\cf20 //         measurement for describing font size, defined as 72 points per inch.}\par
187 {\cf20 //         stb_truetype provides a point API for compatibility. However, true}\par
188 {\cf20 //         "per inch" conventions don't make much sense on computer displays}\par
189 {\cf20 //         since different monitors have different number of pixels per}\par
190 {\cf20 //         inch. For example, Windows traditionally uses a convention that}\par
191 {\cf20 //         there are 96 pixels per inch, thus making 'inch' measurements have}\par
192 {\cf20 //         nothing to do with inches, and thus effectively defining a point to}\par
193 {\cf20 //         be 1.333 pixels. Additionally, the TrueType font data provides}\par
194 {\cf20 //         an explicit scale factor to scale a given font's glyphs to points,}\par
195 {\cf20 //         but the author has observed that this scale factor is often wrong}\par
196 {\cf20 //         for non-commercial fonts, thus making fonts scaled in points}\par
197 {\cf20 //         according to the TrueType spec incoherently sized in practice.}\par
198 {\cf20 //}\par
199 {\cf20 // DETAILED USAGE:}\par
200 {\cf20 //}\par
201 {\cf20 //  Scale:}\par
202 {\cf20 //    Select how high you want the font to be, in points or pixels.}\par
203 {\cf20 //    Call ScaleForPixelHeight or ScaleForMappingEmToPixels to compute}\par
204 {\cf20 //    a scale factor SF that will be used by all other functions.}\par
205 {\cf20 //}\par
206 {\cf20 //  Baseline:}\par
207 {\cf20 //    You need to select a y-coordinate that is the baseline of where}\par
208 {\cf20 //    your text will appear. Call GetFontBoundingBox to get the baseline-relative}\par
209 {\cf20 //    bounding box for all characters. SF*-y0 will be the distance in pixels}\par
210 {\cf20 //    that the worst-case character could extend above the baseline, so if}\par
211 {\cf20 //    you want the top edge of characters to appear at the top of the}\par
212 {\cf20 //    screen where y=0, then you would set the baseline to SF*-y0.}\par
213 {\cf20 //}\par
214 {\cf20 //  Current point:}\par
215 {\cf20 //    Set the current point where the first character will appear. The}\par
216 {\cf20 //    first character could extend left of the current point; this is font}\par
217 {\cf20 //    dependent. You can either choose a current point that is the leftmost}\par
218 {\cf20 //    point and hope, or add some padding, or check the bounding box or}\par
219 {\cf20 //    left-side-bearing of the first character to be displayed and set}\par
220 {\cf20 //    the current point based on that.}\par
221 {\cf20 //}\par
222 {\cf20 //  Displaying a character:}\par
223 {\cf20 //    Compute the bounding box of the character. It will contain signed values}\par
224 {\cf20 //    relative to <current_point, baseline>. I.e. if it returns x0,y0,x1,y1,}\par
225 {\cf20 //    then the character should be displayed in the rectangle from}\par
226 {\cf20 //    <current_point+SF*x0, baseline+SF*y0> to <current_point+SF*x1,baseline+SF*y1).}\par
227 {\cf20 //}\par
228 {\cf20 //  Advancing for the next character:}\par
229 {\cf20 //    Call GlyphHMetrics, and compute 'current_point += SF * advance'.}\par
230 {\cf20 //}\par
231 {\cf20 //}\par
232 {\cf20 // ADVANCED USAGE}\par
233 {\cf20 //}\par
234 {\cf20 //   Quality:}\par
235 {\cf20 //}\par
236 {\cf20 //    - Use the functions with Subpixel at the end to allow your characters}\par
237 {\cf20 //      to have subpixel positioning. Since the font is anti-aliased, not}\par
238 {\cf20 //      hinted, this is very import for quality. (This is not possible with}\par
239 {\cf20 //      baked fonts.)}\par
240 {\cf20 //}\par
241 {\cf20 //    - Kerning is now supported, and if you're supporting subpixel rendering}\par
242 {\cf20 //      then kerning is worth using to give your text a polished look.}\par
243 {\cf20 //}\par
244 {\cf20 //   Performance:}\par
245 {\cf20 //}\par
246 {\cf20 //    - Convert Unicode codepoints to glyph indexes and operate on the glyphs;}\par
247 {\cf20 //      if you don't do this, stb_truetype is forced to do the conversion on}\par
248 {\cf20 //      every call.}\par
249 {\cf20 //}\par
250 {\cf20 //    - There are a lot of memory allocations. We should modify it to take}\par
251 {\cf20 //      a temp buffer and allocate from the temp buffer (without freeing),}\par
252 {\cf20 //      should help performance a lot.}\par
253 {\cf20 //}\par
254 {\cf20 // NOTES}\par
255 {\cf20 //}\par
256 {\cf20 //   The system uses the raw data found in the .ttf file without changing it}\par
257 {\cf20 //   and without building auxiliary data structures. This is a bit inefficient}\par
258 {\cf20 //   on little-endian systems (the data is big-endian), but assuming you're}\par
259 {\cf20 //   caching the bitmaps or glyph shapes this shouldn't be a big deal.}\par
260 {\cf20 //}\par
261 {\cf20 //   It appears to be very hard to programmatically determine what font a}\par
262 {\cf20 //   given file is in a general way. I provide an API for this, but I don't}\par
263 {\cf20 //   recommend it.}\par
264 {\cf20 //}\par
265 {\cf20 //}\par
266 {\cf20 // PERFORMANCE MEASUREMENTS FOR 1.06:}\par
267 {\cf20 //}\par
268 {\cf20 //                      32-bit     64-bit}\par
269 {\cf20 //   Previous release:  8.83 s     7.68 s}\par
270 {\cf20 //   Pool allocations:  7.72 s     6.34 s}\par
271 {\cf20 //   Inline sort     :  6.54 s     5.65 s}\par
272 {\cf20 //   New rasterizer  :  5.63 s     5.00 s}\par
