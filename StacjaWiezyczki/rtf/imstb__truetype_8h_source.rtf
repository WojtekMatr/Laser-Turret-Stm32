374 {\cf20 // Complete program: print "Hello World!" banner, with bugs}\par
375 {\cf20 //}\par
376 {\cf21 #if 0}\par
377 {\cf18 char} buffer[24<<20];\par
378 {\cf18 unsigned} {\cf18 char} screen[20][79];\par
379 \par
380 {\cf18 int} main({\cf18 int} arg, {\cf18 char} **argv)\par
381 \{\par
382    stbtt_fontinfo font;\par
383    {\cf18 int} i,j,ascent,baseline,ch=0;\par
384    {\cf18 float} scale, xpos=2; {\cf20 // leave a little padding in case the character extends left}\par
385    {\cf18 char} *text = {\cf22 "Heljo World!"}; {\cf20 // intentionally misspelled to show 'lj' brokenness}\par
386 \par
387    fread(buffer, 1, 1000000, fopen({\cf22 "c:/windows/fonts/arialbd.ttf"}, {\cf22 "rb"}));\par
388    stbtt_InitFont(&font, buffer, 0);\par
389 \par
390    scale = stbtt_ScaleForPixelHeight(&font, 15);\par
391    stbtt_GetFontVMetrics(&font, &ascent,0,0);\par
392    baseline = (int) (ascent*scale);\par
393 \par
394    {\cf19 while} (text[ch]) \{\par
395       {\cf18 int} advance,lsb,x0,y0,x1,y1;\par
396       {\cf18 float} x_shift = xpos - (float) floor(xpos);\par
397       stbtt_GetCodepointHMetrics(&font, text[ch], &advance, &lsb);\par
398       stbtt_GetCodepointBitmapBoxSubpixel(&font, text[ch], scale,scale,x_shift,0, &x0,&y0,&x1,&y1);\par
399       stbtt_MakeCodepointBitmapSubpixel(&font, &screen[baseline + y0][({\cf18 int}) xpos + x0], x1-x0,y1-y0, 79, scale,scale,x_shift,0, text[ch]);\par
400       {\cf20 // note that this stomps the old data, so where character boxes overlap (e.g. 'lj') it's wrong}\par
401       {\cf20 // because this API is really for baking character bitmaps into textures. if you want to render}\par
402       {\cf20 // a sequence of characters, you really need to render each bitmap to a temp buffer, then}\par
403       {\cf20 // "alpha blend" that into the working buffer}\par
404       xpos += (advance * scale);\par
405       {\cf19 if} (text[ch+1])\par
406          xpos += scale*stbtt_GetCodepointKernAdvance(&font, text[ch],text[ch+1]);\par
407       ++ch;\par
408    \}\par
409 \par
410    {\cf19 for} (j=0; j < 20; ++j) \{\par
411       {\cf19 for} (i=0; i < 78; ++i)\par
412          putchar({\cf22 " .:ioVM@"}[screen[j][i]>>5]);\par
413       putchar({\cf23 '\\n'});\par
414    \}\par
415 \par
416    {\cf19 return} 0;\par
417 \}\par
418 {\cf21 #endif}\par
