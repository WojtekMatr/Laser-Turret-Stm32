609 STBTT_DEF {\cf18 int}  stbtt_PackFontRange(stbtt_pack_context *spc, {\cf17 const} {\cf18 unsigned} {\cf18 char} *fontdata, {\cf18 int} font_index, {\cf18 float} font_size,\par
610                                 {\cf18 int} first_unicode_char_in_range, {\cf18 int} num_chars_in_range, stbtt_packedchar *chardata_for_range);\par
611 {\cf20 // Creates character bitmaps from the font_index'th font found in fontdata (use}\par
612 {\cf20 // font_index=0 if you don't know what that is). It creates num_chars_in_range}\par
613 {\cf20 // bitmaps for characters with unicode values starting at first_unicode_char_in_range}\par
614 {\cf20 // and increasing. Data for how to render them is stored in chardata_for_range;}\par
615 {\cf20 // pass these to stbtt_GetPackedQuad to get back renderable quads.}\par
616 {\cf20 //}\par
617 {\cf20 // font_size is the full height of the character from ascender to descender,}\par
618 {\cf20 // as computed by stbtt_ScaleForPixelHeight. To use a point size as computed}\par
619 {\cf20 // by stbtt_ScaleForMappingEmToPixels, wrap the point size in STBTT_POINT_SIZE()}\par
620 {\cf20 // and pass that result as 'font_size':}\par
621 {\cf20 //       ...,                  20 , ... // font max minus min y is 20 pixels tall}\par
622 {\cf20 //       ..., STBTT_POINT_SIZE(20), ... // 'M' is 20 pixels tall}\par
623 \par
624 {\cf17 typedef} {\cf17 struct}\par
625 \{\par
626    {\cf18 float} font_size;\par
627    {\cf18 int} first_unicode_codepoint_in_range;  {\cf20 // if non-zero, then the chars are continuous, and this is the first codepoint}\par
628    {\cf18 int} *array_of_unicode_codepoints;       {\cf20 // if non-zero, then this is an array of unicode codepoints}\par
629    {\cf18 int} num_chars;\par
630    stbtt_packedchar *chardata_for_range; {\cf20 // output}\par
631    {\cf18 unsigned} {\cf18 char} h_oversample, v_oversample; {\cf20 // don't set these, they're used internally}\par
632 \} stbtt_pack_range;\par
