3625 {\cf20 // returns number of contours}\par
3626 {\cf17 static} stbtt__point *stbtt_FlattenCurves(stbtt_vertex *vertices, {\cf18 int} num_verts, {\cf18 float} objspace_flatness, {\cf18 int} **contour_lengths, {\cf18 int} *num_contours, {\cf18 void} *userdata)\par
3627 \{\par
3628    stbtt__point *points=0;\par
3629    {\cf18 int} num_points=0;\par
3630 \par
3631    {\cf18 float} objspace_flatness_squared = objspace_flatness * objspace_flatness;\par
