1291 {\cf17 static} stbtt_uint16 ttUSHORT(stbtt_uint8 *p) \{ {\cf19 return} p[0]*256 + p[1]; \}\par
1292 {\cf17 static} stbtt_int16 ttSHORT(stbtt_uint8 *p)   \{ {\cf19 return} p[0]*256 + p[1]; \}\par
1293 {\cf17 static} stbtt_uint32 ttULONG(stbtt_uint8 *p)  \{ {\cf19 return} (p[0]<<24) + (p[1]<<16) + (p[2]<<8) + p[3]; \}\par
1294 {\cf17 static} stbtt_int32 ttLONG(stbtt_uint8 *p)    \{ {\cf19 return} (p[0]<<24) + (p[1]<<16) + (p[2]<<8) + p[3]; \}\par
1295 \par
1296 {\cf21 #define stbtt_tag4(p,c0,c1,c2,c3) ((p)[0] == (c0) && (p)[1] == (c1) && (p)[2] == (c2) && (p)[3] == (c3))}\par
1297 {\cf21 #define stbtt_tag(p,str)           stbtt_tag4(p,str[0],str[1],str[2],str[3])}\par
