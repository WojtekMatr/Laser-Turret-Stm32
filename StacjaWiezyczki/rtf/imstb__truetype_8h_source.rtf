1388 {\cf17 static} {\cf18 int} stbtt_InitFont_internal(stbtt_fontinfo *info, {\cf18 unsigned} {\cf18 char} *data, {\cf18 int} fontstart)\par
1389 \{\par
1390    stbtt_uint32 cmap, t;\par
1391    stbtt_int32 i,numTables;\par
1392 \par
1393    info->data = data;\par
1394    info->fontstart = fontstart;\par
1395    info->cff = stbtt__new_buf(NULL, 0);\par
1396 \par
1397    cmap = stbtt__find_table(data, fontstart, {\cf22 "cmap"});       {\cf20 // required}\par
1398    info->loca = stbtt__find_table(data, fontstart, {\cf22 "loca"}); {\cf20 // required}\par
1399    info->head = stbtt__find_table(data, fontstart, {\cf22 "head"}); {\cf20 // required}\par
1400    info->glyf = stbtt__find_table(data, fontstart, {\cf22 "glyf"}); {\cf20 // required}\par
1401    info->hhea = stbtt__find_table(data, fontstart, {\cf22 "hhea"}); {\cf20 // required}\par
1402    info->hmtx = stbtt__find_table(data, fontstart, {\cf22 "hmtx"}); {\cf20 // required}\par
1403    info->kern = stbtt__find_table(data, fontstart, {\cf22 "kern"}); {\cf20 // not required}\par
1404    info->gpos = stbtt__find_table(data, fontstart, {\cf22 "GPOS"}); {\cf20 // not required}\par
1405 \par
1406    {\cf19 if} (!cmap || !info->head || !info->hhea || !info->hmtx)\par
1407       {\cf19 return} 0;\par
1408    {\cf19 if} (info->glyf) \{\par
1409       {\cf20 // required for truetype}\par
1410       {\cf19 if} (!info->loca) {\cf19 return} 0;\par
1411    \} {\cf19 else} \{\par
1412       {\cf20 // initialization for CFF / Type2 fonts (OTF)}\par
1413       stbtt__buf b, topdict, topdictidx;\par
1414       stbtt_uint32 cstype = 2, charstrings = 0, fdarrayoff = 0, fdselectoff = 0;\par
1415       stbtt_uint32 cff;\par
1416 \par
1417       cff = stbtt__find_table(data, fontstart, {\cf22 "CFF "});\par
1418       {\cf19 if} (!cff) {\cf19 return} 0;\par
1419 \par
1420       info->fontdicts = stbtt__new_buf(NULL, 0);\par
1421       info->fdselect = stbtt__new_buf(NULL, 0);\par
1422 \par
1423       {\cf20 // @TODO this should use size from table (not 512MB)}\par
1424       info->cff = stbtt__new_buf(data+cff, 512*1024*1024);\par
1425       b = info->cff;\par
1426 \par
1427       {\cf20 // read the header}\par
1428       stbtt__buf_skip(&b, 2);\par
1429       stbtt__buf_seek(&b, stbtt__buf_get8(&b)); {\cf20 // hdrsize}\par
1430 \par
1431       {\cf20 // @TODO the name INDEX could list multiple fonts,}\par
1432       {\cf20 // but we just use the first one.}\par
1433       stbtt__cff_get_index(&b);  {\cf20 // name INDEX}\par
1434       topdictidx = stbtt__cff_get_index(&b);\par
1435       topdict = stbtt__cff_index_get(topdictidx, 0);\par
1436       stbtt__cff_get_index(&b);  {\cf20 // string INDEX}\par
1437       info->gsubrs = stbtt__cff_get_index(&b);\par
1438 \par
1439       stbtt__dict_get_ints(&topdict, 17, 1, &charstrings);\par
1440       stbtt__dict_get_ints(&topdict, 0x100 | 6, 1, &cstype);\par
1441       stbtt__dict_get_ints(&topdict, 0x100 | 36, 1, &fdarrayoff);\par
1442       stbtt__dict_get_ints(&topdict, 0x100 | 37, 1, &fdselectoff);\par
1443       info->subrs = stbtt__get_subrs(b, topdict);\par
1444 \par
1445       {\cf20 // we only support Type 2 charstrings}\par
1446       {\cf19 if} (cstype != 2) {\cf19 return} 0;\par
1447       {\cf19 if} (charstrings == 0) {\cf19 return} 0;\par
1448 \par
1449       {\cf19 if} (fdarrayoff) \{\par
1450          {\cf20 // looks like a CID font}\par
1451          {\cf19 if} (!fdselectoff) {\cf19 return} 0;\par
1452          stbtt__buf_seek(&b, fdarrayoff);\par
1453          info->fontdicts = stbtt__cff_get_index(&b);\par
1454          info->fdselect = stbtt__buf_range(&b, fdselectoff, b.size-fdselectoff);\par
1455       \}\par
1456 \par
1457       stbtt__buf_seek(&b, charstrings);\par
1458       info->charstrings = stbtt__cff_get_index(&b);\par
1459    \}\par
1460 \par
1461    t = stbtt__find_table(data, fontstart, {\cf22 "maxp"});\par
1462    {\cf19 if} (t)\par
1463       info->numGlyphs = ttUSHORT(data+t+4);\par
1464    {\cf19 else}\par
1465       info->numGlyphs = 0xffff;\par
1466 \par
1467    info->svg = -1;\par
1468 \par
1469    {\cf20 // find a cmap encoding table we understand *now* to avoid searching}\par
1470    {\cf20 // later. (todo: could make this installable)}\par
1471    {\cf20 // the same regardless of glyph.}\par
1472    numTables = ttUSHORT(data + cmap + 2);\par
1473    info->index_map = 0;\par
1474    {\cf19 for} (i=0; i < numTables; ++i) \{\par
1475       stbtt_uint32 encoding_record = cmap + 4 + 8 * i;\par
1476       {\cf20 // find an encoding we understand:}\par
1477       {\cf19 switch}(ttUSHORT(data+encoding_record)) \{\par
1478          {\cf19 case} STBTT_PLATFORM_ID_MICROSOFT:\par
1479             {\cf19 switch} (ttUSHORT(data+encoding_record+2)) \{\par
1480                {\cf19 case} STBTT_MS_EID_UNICODE_BMP:\par
1481                {\cf19 case} STBTT_MS_EID_UNICODE_FULL:\par
1482                   {\cf20 // MS/Unicode}\par
1483                   info->index_map = cmap + ttULONG(data+encoding_record+4);\par
1484                   {\cf19 break};\par
1485             \}\par
1486             {\cf19 break};\par
1487         {\cf19 case} STBTT_PLATFORM_ID_UNICODE:\par
1488             {\cf20 // Mac/iOS has these}\par
1489             {\cf20 // all the encodingIDs are unicode, so we don't bother to check it}\par
1490             info->index_map = cmap + ttULONG(data+encoding_record+4);\par
1491             {\cf19 break};\par
1492       \}\par
1493    \}\par
1494    {\cf19 if} (info->index_map == 0)\par
1495       {\cf19 return} 0;\par
1496 \par
1497    info->indexToLocFormat = ttUSHORT(data+info->head + 50);\par
1498    {\cf19 return} 1;\par
1499 \}\par
