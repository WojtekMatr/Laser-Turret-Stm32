1334          stbtt_int32 n = ttLONG(font_collection+8);\par
1335          {\cf19 if} (index >= n)\par
1336             {\cf19 return} -1;\par
1337          {\cf19 return} ttULONG(font_collection+12+index*4);\par
1338       \}\par
1339    \}\par
1340    {\cf19 return} -1;\par
1341 \}\par
