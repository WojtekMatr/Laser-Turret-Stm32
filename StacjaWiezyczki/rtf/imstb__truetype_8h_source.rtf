4371 STBTT_DEF {\cf18 void} stbtt_GetPackedQuad({\cf17 const} stbtt_packedchar *chardata, {\cf18 int} pw, {\cf18 int} ph, {\cf18 int} char_index, {\cf18 float} *xpos, {\cf18 float} *ypos, stbtt_aligned_quad *q, {\cf18 int} align_to_integer)\par
4372 \{\par
4373    {\cf18 float} ipw = 1.0f / pw, iph = 1.0f / ph;\par
4374    {\cf17 const} stbtt_packedchar *b = chardata + char_index;\par
4375 \par
4376    {\cf19 if} (align_to_integer) \{\par
4377       {\cf18 float} x = (float) STBTT_ifloor((*xpos + b->xoff) + 0.5f);\par
4378       {\cf18 float} y = (float) STBTT_ifloor((*ypos + b->yoff) + 0.5f);\par
4379       q->x0 = x;\par
4380       q->y0 = y;\par
4381       q->x1 = x + b->xoff2 - b->xoff;\par
4382       q->y1 = y + b->yoff2 - b->yoff;\par
4383    \} {\cf19 else} \{\par
4384       q->x0 = *xpos + b->xoff;\par
4385       q->y0 = *ypos + b->yoff;\par
4386       q->x1 = *xpos + b->xoff2;\par
4387       q->y1 = *ypos + b->yoff2;\par
4388    \}\par
4389 \par
4390    q->s0 = b->x0 * ipw;\par
4391    q->t0 = b->y0 * iph;\par
4392    q->s1 = b->x1 * ipw;\par
4393    q->t1 = b->y1 * iph;\par
4394 \par
4395    *xpos += b->xadvance;\par
4396 \}\par
