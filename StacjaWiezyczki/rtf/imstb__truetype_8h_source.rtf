1377       t = stbtt__find_table(info->data, info->fontstart, {\cf22 "SVG "});\par
1378       {\cf19 if} (t) \{\par
1379          stbtt_uint32 offset = ttULONG(info->data + t + 2);\par
1380          info->svg = t + offset;\par
1381       \} {\cf19 else} \{\par
1382          info->svg = 0;\par
1383       \}\par
1384    \}\par
