1138 {\cf17 static} stbtt_uint8 stbtt__buf_get8(stbtt__buf *b)\par
1139 \{\par
1140    {\cf19 if} (b->cursor >= b->size)\par
1141       {\cf19 return} 0;\par
1142    {\cf19 return} b->data[b->cursor++];\par
1143 \}\par
1144 \par
1145 {\cf17 static} stbtt_uint8 stbtt__buf_peek8(stbtt__buf *b)\par
1146 \{\par
1147    {\cf19 if} (b->cursor >= b->size)\par
1148       {\cf19 return} 0;\par
1149    {\cf19 return} b->data[b->cursor];\par
1150 \}\par
1151 \par
1152 {\cf17 static} {\cf18 void} stbtt__buf_seek(stbtt__buf *b, {\cf18 int} o)\par
1153 \{\par
1154    STBTT_assert(!(o > b->size || o < 0));\par
1155    b->cursor = (o > b->size || o < 0) ? b->size : o;\par
1156 \}\par
1157 \par
1158 {\cf17 static} {\cf18 void} stbtt__buf_skip(stbtt__buf *b, {\cf18 int} o)\par
1159 \{\par
1160    stbtt__buf_seek(b, b->cursor + o);\par
1161 \}\par
1162 \par
1163 {\cf17 static} stbtt_uint32 stbtt__buf_get(stbtt__buf *b, {\cf18 int} n)\par
1164 \{\par
1165    stbtt_uint32 v = 0;\par
1166    {\cf18 int} i;\par
1167    STBTT_assert(n >= 1 && n <= 4);\par
1168    {\cf19 for} (i = 0; i < n; i++)\par
1169       v = (v << 8) | stbtt__buf_get8(b);\par
1170    {\cf19 return} v;\par
1171 \}\par
