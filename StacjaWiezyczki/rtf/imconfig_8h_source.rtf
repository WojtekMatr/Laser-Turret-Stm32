\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 1 {\cf20 //-----------------------------------------------------------------------------}\par
2 {\cf20 // DEAR IMGUI COMPILE-TIME OPTIONS}\par
3 {\cf20 // Runtime options (clipboard callbacks, enabling various features, etc.) can generally be set via the ImGuiIO structure.}\par
4 {\cf20 // You can use ImGui::SetAllocatorFunctions() before calling ImGui::CreateContext() to rewire memory allocation functions.}\par
5 {\cf20 //-----------------------------------------------------------------------------}\par
6 {\cf20 // A) You may edit imconfig.h (and not overwrite it when updating Dear ImGui, or maintain a patch/rebased branch with your modifications to it)}\par
7 {\cf20 // B) or '#define IMGUI_USER_CONFIG "my_imgui_config.h"' in your project and then add directives in your own file without touching this template.}\par
8 {\cf20 //-----------------------------------------------------------------------------}\par
9 {\cf20 // You need to make sure that configuration settings are defined consistently _everywhere_ Dear ImGui is used, which include the imgui*.cpp}\par
10 {\cf20 // files but also _any_ of your code that uses Dear ImGui. This is because some compile-time options have an affect on data structures.}\par
11 {\cf20 // Defining those options in imconfig.h will ensure every compilation unit gets to see the same data structure layouts.}\par
12 {\cf20 // Call IMGUI_CHECKVERSION() from your .cpp file to verify that the data structures your files are using are matching the ones imgui.cpp is using.}\par
13 {\cf20 //-----------------------------------------------------------------------------}\par
14 \par
15 {\cf21 #pragma once}\par
16 \par
17 {\cf20 //---- Define assertion handler. Defaults to calling assert().}\par
18 {\cf20 // - If your macro uses multiple statements, make sure is enclosed in a 'do \{ .. \} while (0)' block so it can be used as a single statement.}\par
19 {\cf20 // - Compiling with NDEBUG will usually strip out assert() to nothing, which is NOT recommended because we use asserts to notify of programmer mistakes.}\par
20 {\cf20 //#define IM_ASSERT(_EXPR)  MyAssert(_EXPR)}\par
21 {\cf20 //#define IM_ASSERT(_EXPR)  ((void)(_EXPR))     // Disable asserts}\par
22 \par
23 {\cf20 //---- Define attributes of all API symbols declarations, e.g. for DLL under Windows}\par
24 {\cf20 // Using Dear ImGui via a shared library is not recommended, because of function call overhead and because we don't guarantee backward nor forward ABI compatibility.}\par
25 {\cf20 // - Windows DLL users: heaps and globals are not shared across DLL boundaries! You will need to call SetCurrentContext() + SetAllocatorFunctions()}\par
26 {\cf20 //   for each static/DLL boundary you are calling from. Read "Context and Memory Allocators" section of imgui.cpp for more details.}\par
27 {\cf20 //#define IMGUI_API __declspec(dllexport)                   // MSVC Windows: DLL export}\par
28 {\cf20 //#define IMGUI_API __declspec(dllimport)                   // MSVC Windows: DLL import}\par
29 {\cf20 //#define IMGUI_API __attribute__((visibility("default")))  // GCC/Clang: override visibility when set is hidden}\par
30 \par
31 {\cf20 //---- Don't define obsolete functions/enums/behaviors. Consider enabling from time to time after updating to clean your code of obsolete function/names.}\par
32 {\cf20 //#define IMGUI_DISABLE_OBSOLETE_FUNCTIONS}\par
33 \par
34 {\cf20 //---- Disable all of Dear ImGui or don't implement standard windows/tools.}\par
35 {\cf20 // It is very strongly recommended to NOT disable the demo windows and debug tool during development. They are extremely useful in day to day work. Please read comments in imgui_demo.cpp.}\par
