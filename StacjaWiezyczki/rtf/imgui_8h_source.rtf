2050     ImGuiTableFlags_NoBordersInBodyUntilResize = 1 << 12,  {\cf20 // [ALPHA] Disable vertical borders in columns Body until hovered for resize (borders will always appear in Headers). -> May move to style}\par
2051     {\cf20 // Sizing Policy (read above for defaults)}\par
