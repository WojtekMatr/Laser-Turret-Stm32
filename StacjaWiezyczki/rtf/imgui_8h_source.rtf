2889     {\cf20 //inline void IncludeRangeByIndices(int item_begin, int item_end)      \{ IncludeItemsByIndex(item_begin, item_end); \} // [renamed in 1.89.9]}\par
2890     {\cf20 //inline void ForceDisplayRangeByIndices(int item_begin, int item_end) \{ IncludeItemsByIndex(item_begin, item_end); \} // [renamed in 1.89.6]}\par
2891     {\cf20 //inline ImGuiListClipper(int items_count, float items_height = -1.0f) \{ memset((void*)this, 0, sizeof(*this)); ItemsCount = -1; Begin(items_count, items_height); \} // [removed in 1.79]}\par
2892 {\cf21 #endif}\par
