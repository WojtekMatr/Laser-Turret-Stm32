594     {\cf20 // ID stack/scopes}\par
595     {\cf20 // Read the FAQ (docs/FAQ.md or http://dearimgui.com/faq) for more details about how ID are handled in dear imgui.}\par
596     {\cf20 // - Those questions are answered and impacted by understanding of the ID stack system:}\par
597     {\cf20 //   - "Q: Why is my widget not reacting when I click on it?"}\par
598     {\cf20 //   - "Q: How can I have widgets with an empty label?"}\par
599     {\cf20 //   - "Q: How can I have multiple widgets with the same label?"}\par
600     {\cf20 // - Short version: ID are hashes of the entire ID stack. If you are creating widgets in a loop you most likely}\par
601     {\cf20 //   want to push a unique identifier (e.g. object pointer, loop index) to uniquely differentiate them.}\par
602     {\cf20 // - You can also use the "Label##foobar" syntax within widget label to distinguish them from each others.}\par
603     {\cf20 // - In this header file we use the "label"/"name" terminology to denote a string that will be displayed + used as an ID,}\par
604     {\cf20 //   whereas "str_id" denote a string that is only used as an ID and not normally displayed.}\par
605     IMGUI_API {\cf18 void}          PushID({\cf17 const} {\cf18 char}* str_id);                                     {\cf20 // push string into the ID stack (will hash string).}\par
606     IMGUI_API {\cf18 void}          PushID({\cf17 const} {\cf18 char}* str_id_begin, {\cf17 const} {\cf18 char}* str_id_end);       {\cf20 // push string into the ID stack (will hash string).}\par
607     IMGUI_API {\cf18 void}          PushID({\cf17 const} {\cf18 void}* ptr_id);                                     {\cf20 // push pointer into the ID stack (will hash pointer).}\par
608     IMGUI_API {\cf18 void}          PushID({\cf18 int} int_id);                                             {\cf20 // push integer into the ID stack (will hash integer).}\par
609     IMGUI_API {\cf18 void}          PopID();                                                        {\cf20 // pop from the ID stack.}\par
610     IMGUI_API ImGuiID       GetID({\cf17 const} {\cf18 char}* str_id);                                      {\cf20 // calculate unique ID (hash of whole ID stack + given parameter). e.g. if you want to query into ImGuiStorage yourself}\par
611     IMGUI_API ImGuiID       GetID({\cf17 const} {\cf18 char}* str_id_begin, {\cf17 const} {\cf18 char}* str_id_end);\par
612     IMGUI_API ImGuiID       GetID({\cf17 const} {\cf18 void}* ptr_id);\par
613     IMGUI_API ImGuiID       GetID({\cf18 int} int_id);\par
