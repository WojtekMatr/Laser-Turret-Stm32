2060     ImGuiTableFlags_PreciseWidths              = 1 << 19,  {\cf20 // Disable distributing remainder width to stretched columns (width allocation on a 100-wide table with 3 columns: Without this flag: 33,33,34. With this flag: 33,33,33). With larger number of columns, resizing will appear to be less smooth.}\par
2061     {\cf20 // Clipping}\par
