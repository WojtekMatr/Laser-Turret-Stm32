910     {\cf20 // Tables: Headers & Columns declaration}\par
911     {\cf20 // - Use TableSetupColumn() to specify label, resizing policy, default width/weight, id, various other flags etc.}\par
912     {\cf20 // - Use TableHeadersRow() to create a header row and automatically submit a TableHeader() for each column.}\par
913     {\cf20 //   Headers are required to perform: reordering, sorting, and opening the context menu.}\par
914     {\cf20 //   The context menu can also be made available in columns body using ImGuiTableFlags_ContextMenuInBody.}\par
915     {\cf20 // - You may manually submit headers using TableNextRow() + TableHeader() calls, but this is only useful in}\par
916     {\cf20 //   some advanced use cases (e.g. adding custom widgets in header row).}\par
917     {\cf20 // - Use TableSetupScrollFreeze() to lock columns/rows so they stay visible when scrolled. When freezing columns you would usually also use ImGuiTableColumnFlags_NoHide on them.}\par
918     IMGUI_API {\cf18 void}          TableSetupColumn({\cf17 const} {\cf18 char}* label, ImGuiTableColumnFlags flags = 0, {\cf18 float} init_width_or_weight = 0.0f, ImGuiID user_id = 0);\par
