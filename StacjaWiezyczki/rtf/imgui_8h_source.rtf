2181 {\cf20 // IM_MALLOC(), IM_FREE(), IM_NEW(), IM_PLACEMENT_NEW(), IM_DELETE()}\par
2182 {\cf20 // We call C++ constructor on own allocated memory via the placement "new(ptr) Type()" syntax.}\par
2183 {\cf20 // Defining a custom placement new() with a custom parameter allows us to bypass including <new> which on some platforms complains when user has disabled exceptions.}\par
2184 {\cf20 //-----------------------------------------------------------------------------}\par
2185 \par
2186 {\cf17 struct }ImNewWrapper \{\};\par
2187 {\cf17 inline} {\cf18 void}* {\cf17 operator} {\cf17 new}(size_t, ImNewWrapper, {\cf18 void}* ptr) \{ {\cf19 return} ptr; \}\par
2188 {\cf17 inline} {\cf18 void}  {\cf17 operator} {\cf17 delete}({\cf18 void}*, ImNewWrapper, {\cf18 void}*)   \{\} {\cf20 // This is only required so we can use the symmetrical new()}\par
2189 {\cf21 #define IM_ALLOC(_SIZE)                     ImGui::MemAlloc(_SIZE)}\par
2190 {\cf21 #define IM_FREE(_PTR)                       ImGui::MemFree(_PTR)}\par
2191 {\cf21 #define IM_PLACEMENT_NEW(_PTR)              new(ImNewWrapper(), _PTR)}\par
2192 {\cf21 #define IM_NEW(_TYPE)                       new(ImNewWrapper(), ImGui::MemAlloc(sizeof(_TYPE))) _TYPE}\par
2193 {\cf17 template}<{\cf17 typename} T> {\cf18 void} IM_DELETE(T* p)   \{ {\cf19 if} (p) \{ p->~T(); ImGui::MemFree(p); \} \}\par
2194 \par
2195 {\cf20 //-----------------------------------------------------------------------------}\par
2196 {\cf20 // ImVector<>}\par
2197 {\cf20 // Lightweight std::vector<>-like class to avoid dragging dependencies (also, some implementations of STL with debug enabled are absurdly slow, we bypass it so our code runs fast in debug).}\par
2198 {\cf20 //-----------------------------------------------------------------------------}\par
2199 {\cf20 // - You generally do NOT need to care or use this ever. But we need to make it available in imgui.h because some of our public structures are relying on it.}\par
2200 {\cf20 // - We use std-like naming convention here, which is a little unusual for this codebase.}\par
2201 {\cf20 // - Important: clear() frees memory, resize(0) keep the allocated buffer. We use resize(0) a lot to intentionally recycle allocated buffers across frames and amortize our costs.}\par
2202 {\cf20 // - Important: our implementation does NOT call C++ constructors/destructors, we treat everything as raw data! This is intentional but be extra mindful of that,}\par
2203 {\cf20 //   Do NOT use this class as a std::vector replacement in your own code! Many of the structures used by dear imgui can be safely initialized by a zero-memset.}\par
2204 {\cf20 //-----------------------------------------------------------------------------}\par
2205 \par
2206 IM_MSVC_RUNTIME_CHECKS_OFF\par
2207 {\cf17 template}<{\cf17 typename} T>\par
2208 {\cf17 struct }ImVector\par
2209 \{\par
2210     {\cf18 int}                 Size;\par
2211     {\cf18 int}                 Capacity;\par
2212     T*                  Data;\par
2213 \par
2214     {\cf20 // Provide standard typedefs but we don't use them ourselves.}\par
2215     {\cf17 typedef} T                   value_type;\par
2216     {\cf17 typedef} value_type*         iterator;\par
2217     {\cf17 typedef} {\cf17 const} value_type*   const_iterator;\par
2218 \par
2219     {\cf20 // Constructors, destructor}\par
2220     {\cf17 inline} ImVector()                                       \{ Size = Capacity = 0; Data = NULL; \}\par
2221     {\cf17 inline} ImVector({\cf17 const} ImVector<T>& src)                 \{ Size = Capacity = 0; Data = NULL; operator=(src); \}\par
2222     {\cf17 inline} ImVector<T>& operator=({\cf17 const} ImVector<T>& src)   \{ clear(); resize(src.Size); {\cf19 if} (Data && src.Data) memcpy(Data, src.Data, ({\cf18 size_t})Size * {\cf17 sizeof}(T)); {\cf19 return} *{\cf17 this}; \}\par
2223     {\cf17 inline} ~ImVector()                                      \{ {\cf19 if} (Data) IM_FREE(Data); \} {\cf20 // Important: does not destruct anything}\par
2224 \par
2225     {\cf17 inline} {\cf18 void}         clear()                             \{ {\cf19 if} (Data) \{ Size = Capacity = 0; IM_FREE(Data); Data = NULL; \} \}  {\cf20 // Important: does not destruct anything}\par
2226     {\cf17 inline} {\cf18 void}         clear_delete()                      \{ {\cf19 for} ({\cf18 int} n = 0; n < Size; n++) IM_DELETE(Data[n]); clear(); \}     {\cf20 // Important: never called automatically! always explicit.}\par
2227     {\cf17 inline} {\cf18 void}         clear_destruct()                    \{ {\cf19 for} ({\cf18 int} n = 0; n < Size; n++) Data[n].~T(); clear(); \}           {\cf20 // Important: never called automatically! always explicit.}\par
2228 \par
2229     {\cf17 inline} {\cf18 bool}         empty(){\cf17  const                       }\{ {\cf19 return} Size == 0; \}\par
2230     {\cf17 inline} {\cf18 int}          size(){\cf17  const                        }\{ {\cf19 return} Size; \}\par
2231     {\cf17 inline} {\cf18 int}          size_in_bytes(){\cf17  const               }\{ {\cf19 return} Size * (int){\cf17 sizeof}(T); \}\par
2232     {\cf17 inline} {\cf18 int}          max_size(){\cf17  const                    }\{ {\cf19 return} 0x7FFFFFFF / (int){\cf17 sizeof}(T); \}\par
2233     {\cf17 inline} {\cf18 int}          capacity(){\cf17  const                    }\{ {\cf19 return} Capacity; \}\par
2234     {\cf17 inline} T&           operator[]({\cf18 int} i)                   \{ IM_ASSERT(i >= 0 && i < Size); {\cf19 return} Data[i]; \}\par
2235     {\cf17 inline} {\cf17 const} T&     operator[]({\cf18 int} i){\cf17  const             }\{ IM_ASSERT(i >= 0 && i < Size); {\cf19 return} Data[i]; \}\par
2236 \par
2237     {\cf17 inline} T*           begin()                             \{ {\cf19 return} Data; \}\par
2238     {\cf17 inline} {\cf17 const} T*     begin(){\cf17  const                       }\{ {\cf19 return} Data; \}\par
2239     {\cf17 inline} T*           end()                               \{ {\cf19 return} Data + Size; \}\par
2240     {\cf17 inline} {\cf17 const} T*     end(){\cf17  const                         }\{ {\cf19 return} Data + Size; \}\par
2241     {\cf17 inline} T&           front()                             \{ IM_ASSERT(Size > 0); {\cf19 return} Data[0]; \}\par
2242     {\cf17 inline} {\cf17 const} T&     front(){\cf17  const                       }\{ IM_ASSERT(Size > 0); {\cf19 return} Data[0]; \}\par
2243     {\cf17 inline} T&           back()                              \{ IM_ASSERT(Size > 0); {\cf19 return} Data[Size - 1]; \}\par
2244     {\cf17 inline} {\cf17 const} T&     back(){\cf17  const                        }\{ IM_ASSERT(Size > 0); {\cf19 return} Data[Size - 1]; \}\par
2245     {\cf17 inline} {\cf18 void}         swap(ImVector<T>& rhs)              \{ {\cf18 int} rhs_size = rhs.Size; rhs.Size = Size; Size = rhs_size; {\cf18 int} rhs_cap = rhs.Capacity; rhs.Capacity = Capacity; Capacity = rhs_cap; T* rhs_data = rhs.Data; rhs.Data = Data; Data = rhs_data; \}\par
2246 \par
2247     {\cf17 inline} {\cf18 int}          _grow_capacity({\cf18 int} sz){\cf17  const        }\{ {\cf18 int} new_capacity = Capacity ? (Capacity + Capacity / 2) : 8; {\cf19 return} new_capacity > sz ? new_capacity : sz; \}\par
2248     {\cf17 inline} {\cf18 void}         resize({\cf18 int} new_size)                \{ {\cf19 if} (new_size > Capacity) reserve(_grow_capacity(new_size)); Size = new_size; \}\par
2249     {\cf17 inline} {\cf18 void}         resize({\cf18 int} new_size, {\cf17 const} T& v)    \{ {\cf19 if} (new_size > Capacity) reserve(_grow_capacity(new_size)); {\cf19 if} (new_size > Size) {\cf19 for} ({\cf18 int} n = Size; n < new_size; n++) memcpy(&Data[n], &v, {\cf17 sizeof}(v)); Size = new_size; \}\par
2250     {\cf17 inline} {\cf18 void}         shrink({\cf18 int} new_size)                \{ IM_ASSERT(new_size <= Size); Size = new_size; \} {\cf20 // Resize a vector to a smaller size, guaranteed not to cause a reallocation}\par
