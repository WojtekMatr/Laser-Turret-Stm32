319 {\cf20 //-----------------------------------------------------------------------------}\par
320 {\cf20 // [SECTION] Texture identifiers (ImTextureID, ImTextureRef)}\par
321 {\cf20 //-----------------------------------------------------------------------------}\par
322 \par
323 {\cf20 // ImTextureID = backend specific, low-level identifier for a texture uploaded in GPU/graphics system.}\par
324 {\cf20 // [Compile-time configurable type]}\par
325 {\cf20 // - When a Rendered Backend creates a texture, it store its native identifier into a ImTextureID value.}\par
326 {\cf20 //   (e.g. Used by DX11 backend to a `ID3D11ShaderResourceView*`; Used by OpenGL backends to store `GLuint`;}\par
327 {\cf20 //         Used by SDLGPU backend to store a `SDL_GPUTextureSamplerBinding*`, etc.).}\par
328 {\cf20 // - User may submit their own textures to e.g. ImGui::Image() function by passing this value.}\par
329 {\cf20 // - During the rendering loop, the Renderer Backend retrieve the ImTextureID, which stored inside a}\par
330 {\cf20 //   ImTextureRef, which is stored inside a ImDrawCmd.}\par
331 {\cf20 // - Compile-time type configuration:}\par
332 {\cf20 //   - To use something other than a 64-bit value: add '#define ImTextureID MyTextureType*' in your imconfig.h file.}\par
333 {\cf20 //   - This can be whatever to you want it to be! read the FAQ entry about textures for details.}\par
334 {\cf20 //   - You may decide to store a higher-level structure containing texture, sampler, shader etc. with various}\par
335 {\cf20 //     constructors if you like. You will need to implement ==/!= operators.}\par
336 {\cf20 // History:}\par
337 {\cf20 // - In v1.91.4 (2024/10/08): the default type for ImTextureID was changed from 'void*' to 'ImU64'. This allowed backends requiring 64-bit worth of data to build on 32-bit architectures. Use intermediary intptr_t cast and read FAQ if you have casting warnings.}\par
338 {\cf20 // - In v1.92.0 (2025/06/11): added ImTextureRef which carry either a ImTextureID either a pointer to internal texture atlas. All user facing functions taking ImTextureID changed to ImTextureRef}\par
339 {\cf21 #ifndef ImTextureID}\par
340 {\cf17 typedef} ImU64 ImTextureID;      {\cf20 // Default: store up to 64-bits (any pointer or integer). A majority of backends are ok with that.}\par
341 {\cf21 #endif}\par
342 \par
343 {\cf20 // Define this if you need to change the invalid value for your backend.}\par
344 {\cf20 // - If your backend is using ImTextureID to store an index/offset and you need 0 to be valid, You can add '#define ImTextureID_Invalid ((ImTextureID)-1)' in your imconfig.h file.}\par
345 {\cf20 // - From 2026/03/12 to 2026/03/19 we experimented with changing to default to -1, but I worried it would cause too many issues in third-party code so it was reverted.}\par
346 {\cf21 #ifndef ImTextureID_Invalid}\par
347 {\cf21 #define ImTextureID_Invalid     ((ImTextureID)0)}\par
348 {\cf21 #endif}\par
349 \par
350 {\cf20 // ImTextureRef = higher-level identifier for a texture. Store a ImTextureID _or_ a ImTextureData*.}\par
351 {\cf20 // The identifier is valid even before the texture has been uploaded to the GPU/graphics system.}\par
352 {\cf20 // This is what gets passed to functions such as `ImGui::Image()`, `ImDrawList::AddImage()`.}\par
353 {\cf20 // This is what gets stored in draw commands (`ImDrawCmd`) to identify a texture during rendering.}\par
354 {\cf20 // - When a texture is created by user code (e.g. custom images), we directly store the low-level ImTextureID.}\par
355 {\cf20 //   Because of this, when displaying your own texture you are likely to ever only manage ImTextureID values on your side.}\par
356 {\cf20 // - When a texture is created by the backend, we stores a ImTextureData* which becomes an indirection}\par
357 {\cf20 //   to extract the ImTextureID value during rendering, after texture upload has happened.}\par
358 {\cf20 // - To create a ImTextureRef from a ImTextureData you can use ImTextureData::GetTexRef().}\par
359 {\cf20 //   We intentionally do not provide an ImTextureRef constructor for this: we don't expect this}\par
360 {\cf20 //   to be frequently useful to the end-user, and it would be erroneously called by many legacy code.}\par
361 {\cf20 // - If you want to bind the current atlas when using custom rectangle, you can use io.Fonts->TexRef.}\par
362 {\cf20 // - Binding generators for languages such as C (which don't have constructors), should provide a helper, e.g.}\par
363 {\cf20 //      inline ImTextureRef ImTextureRefFromID(ImTextureID tex_id) \{ ImTextureRef tex_ref = \{ ._TexData = NULL, .TexID = tex_id \}; return tex_ref; \}}\par
364 {\cf20 // In 1.92 we changed most drawing functions using ImTextureID to use ImTextureRef.}\par
365 {\cf20 // We intentionally do not provide an implicit ImTextureRef -> ImTextureID cast operator because it is technically lossy to convert ImTextureRef to ImTextureID before rendering.}\par
366 IM_MSVC_RUNTIME_CHECKS_OFF\par
367 {\cf17 struct }ImTextureRef\par
368 \{\par
369     ImTextureRef()                          \{ _TexData = NULL; _TexID = ImTextureID_Invalid; \}\par
370     ImTextureRef(ImTextureID tex_id)        \{ _TexData = NULL; _TexID = tex_id; \}\par
371 {\cf21 #if !defined(IMGUI_DISABLE_OBSOLETE_FUNCTIONS) && !defined(ImTextureID)}\par
372     ImTextureRef({\cf18 void}* tex_id)              \{ _TexData = NULL; _TexID = (ImTextureID)({\cf18 size_t})tex_id; \}  {\cf20 // For legacy backends casting to ImTextureID}\par
373 {\cf21 #endif}\par
374 \par
375     {\cf17 inline} ImTextureID  GetTexID() {\cf17 const};   {\cf20 // == (_TexData ? _TexData->TexID : _TexID) // Implemented below in the file.}\par
376 \par
377     {\cf20 // Members (either are set, never both!)}\par
378     ImTextureData*      _TexData;           {\cf20 //      A texture, generally owned by a ImFontAtlas. Will convert to ImTextureID during render loop, after texture has been uploaded.}\par
379     ImTextureID         _TexID;             {\cf20 // _OR_ Low-level backend texture identifier, if already uploaded or created by user/app. Generally provided to e.g. ImGui::Image() calls.}\par
380 \};\par
381 IM_MSVC_RUNTIME_CHECKS_RESTORE\par
