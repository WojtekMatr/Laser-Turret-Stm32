2977 {\cf20 // [SECTION] Multi-Select API flags and structures (ImGuiMultiSelectFlags, ImGuiSelectionRequestType, ImGuiSelectionRequest, ImGuiMultiSelectIO, ImGuiSelectionBasicStorage)}\par
2978 {\cf20 //-----------------------------------------------------------------------------}\par
2979 \par
2980 {\cf20 // Multi-selection system}\par
2981 {\cf20 // Documentation at: https://github.com/ocornut/imgui/wiki/Multi-Select}\par
2982 {\cf20 // - Refer to 'Demo->Widgets->Selection State & Multi-Select' for demos using this.}\par
2983 {\cf20 // - This system implements standard multi-selection idioms (Ctrl+Mouse/Keyboard, Shift+Mouse/Keyboard, etc)}\par
2984 {\cf20 //   with support for clipper (skipping non-visible items), box-select and many other details.}\par
2985 {\cf20 // - Selectable(), Checkbox() are supported but custom widgets may use it as well.}\par
2986 {\cf20 // - TreeNode() is technically supported but... using this correctly is more complicated: you need some sort of linear/random access to your tree,}\par
2987 {\cf20 //   which is suited to advanced trees setups also implementing filters and clipper. We will work toward simplifying and demoing it.}\par
2988 {\cf20 // - In the spirit of Dear ImGui design, your code owns actual selection data.}\par
2989 {\cf20 //   This is designed to allow all kinds of selection storage you may use in your application e.g. set/map/hash.}\par
2990 {\cf20 // About ImGuiSelectionBasicStorage:}\par
2991 {\cf20 // - This is an optional helper to store a selection state and apply selection requests.}\par
2992 {\cf20 // - It is used by our demos and provided as a convenience to quickly implement multi-selection.}\par
2993 {\cf20 // Usage:}\par
2994 {\cf20 // - Identify submitted items with SetNextItemSelectionUserData(), most likely using an index into your current data-set.}\par
2995 {\cf20 // - Store and maintain actual selection data using persistent object identifiers.}\par
2996 {\cf20 // - Usage flow:}\par
2997 {\cf20 //     BEGIN - (1) Call BeginMultiSelect() and retrieve the ImGuiMultiSelectIO* result.}\par
2998 {\cf20 //           - (2) Honor request list (SetAll/SetRange requests) by updating your selection data. Same code as Step 6.}\par
2999 {\cf20 //           - (3) [If using clipper] You need to make sure RangeSrcItem is always submitted. Calculate its index and pass to clipper.IncludeItemByIndex(). If storing indices in ImGuiSelectionUserData, a simple clipper.IncludeItemByIndex(ms_io->RangeSrcItem) call will work.}\par
3000 {\cf20 //     LOOP  - (4) Submit your items with SetNextItemSelectionUserData() + Selectable()/TreeNode() calls.}\par
3001 {\cf20 //     END   - (5) Call EndMultiSelect() and retrieve the ImGuiMultiSelectIO* result.}\par
3002 {\cf20 //           - (6) Honor request list (SetAll/SetRange requests) by updating your selection data. Same code as Step 2.}\par
3003 {\cf20 //     If you submit all items (no clipper), Step 2 and 3 are optional and will be handled by each item themselves. It is fine to always honor those steps.}\par
3004 {\cf20 // About ImGuiSelectionUserData:}\par
3005 {\cf20 // - This can store an application-defined identifier (e.g. index or pointer) submitted via SetNextItemSelectionUserData().}\par
3006 {\cf20 // - In return we store them into RangeSrcItem/RangeFirstItem/RangeLastItem and other fields in ImGuiMultiSelectIO.}\par
3007 {\cf20 // - Most applications will store an object INDEX, hence the chosen name and type. Storing an index is natural, because}\par
3008 {\cf20 //   SetRange requests will give you two end-points and you will need to iterate/interpolate between them to update your selection.}\par
3009 {\cf20 // - However it is perfectly possible to store a POINTER or another IDENTIFIER inside ImGuiSelectionUserData.}\par
3010 {\cf20 //   Our system never assume that you identify items by indices, it never attempts to interpolate between two values.}\par
3011 {\cf20 // - If you enable ImGuiMultiSelectFlags_NoRangeSelect then it is guaranteed that you will never have to interpolate}\par
3012 {\cf20 //   between two ImGuiSelectionUserData, which may be a convenient way to use part of the feature with less code work.}\par
3013 {\cf20 // - As most users will want to store an index, for convenience and to reduce confusion we use ImS64 instead of void*,}\par
3014 {\cf20 //   being syntactically easier to downcast. Feel free to reinterpret_cast and store a pointer inside.}\par
3015 \par
3016 {\cf20 // Flags for BeginMultiSelect()}\par
3017 {\cf17 enum} ImGuiMultiSelectFlags_\par
3018 \{\par
3019     ImGuiMultiSelectFlags_None                  = 0,\par
3020     ImGuiMultiSelectFlags_SingleSelect          = 1 << 0,   {\cf20 // Disable selecting more than one item. This is available to allow single-selection code to share same code/logic if desired. It essentially disables the main purpose of BeginMultiSelect() tho!}\par
3021     ImGuiMultiSelectFlags_NoSelectAll           = 1 << 1,   {\cf20 // Disable Ctrl+A shortcut to select all.}\par
3022     ImGuiMultiSelectFlags_NoRangeSelect         = 1 << 2,   {\cf20 // Disable Shift+selection mouse/keyboard support (useful for unordered 2D selection). With BoxSelect is also ensure contiguous SetRange requests are not combined into one. This allows not handling interpolation in SetRange requests.}\par
3023     ImGuiMultiSelectFlags_NoAutoSelect          = 1 << 3,   {\cf20 // Disable selecting items when navigating (useful for e.g. supporting range-select in a list of checkboxes).}\par
3024     ImGuiMultiSelectFlags_NoAutoClear           = 1 << 4,   {\cf20 // Disable clearing selection when navigating or selecting another one (generally used with ImGuiMultiSelectFlags_NoAutoSelect. useful for e.g. supporting range-select in a list of checkboxes).}\par
3025     ImGuiMultiSelectFlags_NoAutoClearOnReselect = 1 << 5,   {\cf20 // Disable clearing selection when clicking/selecting an already selected item.}\par
3026     ImGuiMultiSelectFlags_BoxSelect1d           = 1 << 6,   {\cf20 // Enable box-selection with same width and same x pos items (e.g. full row Selectable()). Box-selection works better with little bit of spacing between items hit-box in order to be able to aim at empty space.}\par
3027     ImGuiMultiSelectFlags_BoxSelect2d           = 1 << 7,   {\cf20 // Enable box-selection with varying width or varying x pos items support (e.g. different width labels, or 2D layout/grid). This is slower: alters clipping logic so that e.g. horizontal movements will update selection of normally clipped items.}\par
3028     ImGuiMultiSelectFlags_BoxSelectNoScroll     = 1 << 8,   {\cf20 // Disable scrolling when box-selecting and moving mouse near edges of scope.}\par
3029     ImGuiMultiSelectFlags_ClearOnEscape         = 1 << 9,   {\cf20 // Clear selection when pressing Escape while scope is focused.}\par
3030     ImGuiMultiSelectFlags_ClearOnClickVoid      = 1 << 10,  {\cf20 // Clear selection when clicking on empty location within scope.}\par
3031     ImGuiMultiSelectFlags_ScopeWindow           = 1 << 11,  {\cf20 // Scope for _BoxSelect and _ClearOnClickVoid is whole window (Default). Use if BeginMultiSelect() covers a whole window or used a single time in same window.}\par
3032     ImGuiMultiSelectFlags_ScopeRect             = 1 << 12,  {\cf20 // Scope for _BoxSelect and _ClearOnClickVoid is rectangle encompassing BeginMultiSelect()/EndMultiSelect(). Use if BeginMultiSelect() is called multiple times in same window.}\par
3033     ImGuiMultiSelectFlags_SelectOnAuto          = 1 << 13,  {\cf20 // Apply selection on mouse down when clicking on unselected item, on mouse up when clicking on selected item. (Default)}\par
3034     ImGuiMultiSelectFlags_SelectOnClickAlways   = 1 << 14,  {\cf20 // Apply selection on mouse down when clicking on any items. Prevents Drag and Drop from being used on multiple-selection, but allows e.g. BoxSelect to always reselect even when clicking inside an existing selection. (Excel style behavior)}\par
3035     ImGuiMultiSelectFlags_SelectOnClickRelease  = 1 << 15,  {\cf20 // Apply selection on mouse release when clicking an unselected item. Allow dragging an unselected item without altering selection.}\par
3036     {\cf20 //ImGuiMultiSelectFlags_RangeSelect2d       = 1 << 15,  // Shift+Selection uses 2d geometry instead of linear sequence, so possible to use Shift+up/down to select vertically in grid. Analogous to what BoxSelect does.}\par
3037     ImGuiMultiSelectFlags_NavWrapX              = 1 << 16,  {\cf20 // [Temporary] Enable navigation wrapping on X axis. Provided as a convenience because we don't have a design for the general Nav API for this yet. When the more general feature be public we may obsolete this flag in favor of new one.}\par
3038     ImGuiMultiSelectFlags_NoSelectOnRightClick  = 1 << 17,  {\cf20 // Disable default right-click processing, which selects item on mouse down, and is designed for context-menus.}\par
3039     ImGuiMultiSelectFlags_SelectOnMask_         = ImGuiMultiSelectFlags_SelectOnAuto | ImGuiMultiSelectFlags_SelectOnClickAlways | ImGuiMultiSelectFlags_SelectOnClickRelease,\par
3040 \par
3041     {\cf20 // Obsolete names}\par
3042 {\cf21 #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS}\par
3043     ImGuiMultiSelectFlags_SelectOnClick         = ImGuiMultiSelectFlags_SelectOnAuto,         {\cf20 // RENAMED in 1.92.6}\par
3044 {\cf21 #endif}\par
