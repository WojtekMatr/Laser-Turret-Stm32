1069     {\cf20 // Inputs Utilities: Shortcut Testing & Routing}\par
1070     {\cf20 // - Typical use is e.g.: 'if (ImGui::Shortcut(ImGuiMod_Ctrl | ImGuiKey_S)) \{ ... \}'.}\par
1071     {\cf20 // - Flags: Default route use ImGuiInputFlags_RouteFocused, but see ImGuiInputFlags_RouteGlobal and other options in ImGuiInputFlags_!}\par
1072     {\cf20 // - Flags: Use ImGuiInputFlags_Repeat to support repeat.}\par
1073     {\cf20 // - ImGuiKeyChord = a ImGuiKey + optional ImGuiMod_Alt/ImGuiMod_Ctrl/ImGuiMod_Shift/ImGuiMod_Super.}\par
1074     {\cf20 //       ImGuiKey_C                          // Accepted by functions taking ImGuiKey or ImGuiKeyChord arguments}\par
1075     {\cf20 //       ImGuiMod_Ctrl | ImGuiKey_C          // Accepted by functions taking ImGuiKeyChord arguments}\par
1076     {\cf20 //   only ImGuiMod_XXX values are legal to combine with an ImGuiKey. You CANNOT combine two ImGuiKey values.}\par
1077     {\cf20 // - The general idea is that several callers may register interest in a shortcut, and only one owner gets it.}\par
1078     {\cf20 //      Parent   -> call Shortcut(Ctrl+S)    // When Parent is focused, Parent gets the shortcut.}\par
1079     {\cf20 //        Child1 -> call Shortcut(Ctrl+S)    // When Child1 is focused, Child1 gets the shortcut (Child1 overrides Parent shortcuts)}\par
1080     {\cf20 //        Child2 -> no call                  // When Child2 is focused, Parent gets the shortcut.}\par
1081     {\cf20 //   The whole system is order independent, so if Child1 makes its calls before Parent, results will be identical.}\par
1082     {\cf20 //   This is an important property as it facilitate working with foreign code or larger codebase.}\par
1083     {\cf20 // - To understand the difference:}\par
1084     {\cf20 //   - IsKeyChordPressed() compares mods and call IsKeyPressed()}\par
1085     {\cf20 //     -> the function has no side-effect.}\par
1086     {\cf20 //   - Shortcut() submits a route, routes are resolved, if it currently can be routed it calls IsKeyChordPressed()}\par
1087     {\cf20 //     -> the function has (desirable) side-effects as it can prevents another call from getting the route.}\par
1088     {\cf20 // - Visualize registered routes in 'Metrics/Debugger->Inputs'.}\par
1089     IMGUI_API {\cf18 bool}          Shortcut(ImGuiKeyChord key_chord, ImGuiInputFlags flags = 0);\par
1090     IMGUI_API {\cf18 void}          SetNextItemShortcut(ImGuiKeyChord key_chord, ImGuiInputFlags flags = 0);\par
