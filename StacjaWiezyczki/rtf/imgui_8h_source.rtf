3458 {\cf20 // [SECTION] Texture API (ImTextureFormat, ImTextureStatus, ImTextureRect, ImTextureData)}\par
3459 {\cf20 //-----------------------------------------------------------------------------}\par
3460 {\cf20 // In principle, the only data types that user/application code should care about are 'ImTextureRef' and 'ImTextureID'.}\par
3461 {\cf20 // They are defined above in this header file. Read their description to the difference between ImTextureRef and ImTextureID.}\par
3462 {\cf20 // FOR ALL OTHER ImTextureXXXX TYPES: ONLY CORE LIBRARY AND RENDERER BACKENDS NEED TO KNOW AND CARE ABOUT THEM.}\par
3463 {\cf20 //-----------------------------------------------------------------------------}\par
3464 \par
3465 {\cf21 #undef Status }{\cf20 // X11 headers are leaking this.}\par
3466 \par
3467 {\cf20 // We intentionally support a limited amount of texture formats to limit burden on CPU-side code and extension.}\par
3468 {\cf20 // Most standard backends only support RGBA32 but we provide a single channel option for low-resource/embedded systems.}\par
3469 {\cf17 enum} ImTextureFormat\par
3470 \{\par
3471     ImTextureFormat_RGBA32,         {\cf20 // 4 components per pixel, each is unsigned 8-bit. Total size = TexWidth * TexHeight * 4}\par
3472     ImTextureFormat_Alpha8,         {\cf20 // 1 component per pixel, each is unsigned 8-bit. Total size = TexWidth * TexHeight}\par
3473 \};\par
3474 \par
3475 {\cf20 // Status of a texture to communicate with Renderer Backend.}\par
3476 {\cf17 enum} ImTextureStatus\par
3477 \{\par
3478     ImTextureStatus_OK,\par
3479     ImTextureStatus_Destroyed,      {\cf20 // Backend destroyed the texture.}\par
3480     ImTextureStatus_WantCreate,     {\cf20 // Requesting backend to create the texture. Set status OK when done.}\par
3481     ImTextureStatus_WantUpdates,    {\cf20 // Requesting backend to update specific blocks of pixels (write to texture portions which have never been used before). Set status OK when done.}\par
3482     ImTextureStatus_WantDestroy,    {\cf20 // Requesting backend to destroy the texture. Set status to Destroyed when done.}\par
3483 \};\par
3484 \par
3485 {\cf20 // Coordinates of a rectangle within a texture.}\par
3486 {\cf20 // When a texture is in ImTextureStatus_WantUpdates state, we provide a list of individual rectangles to copy to the graphics system.}\par
3487 {\cf20 // You may use ImTextureData::Updates[] for the list, or ImTextureData::UpdateBox for a single bounding box.}\par
3488 {\cf17 struct }ImTextureRect\par
3489 \{\par
3490     {\cf18 unsigned} {\cf18 short}      x, y;       {\cf20 // Upper-left coordinates of rectangle to update}\par
3491     {\cf18 unsigned} {\cf18 short}      w, h;       {\cf20 // Size of rectangle to update (in pixels)}\par
3492 \};\par
3493 \par
3494 {\cf20 // Specs and pixel storage for a texture used by Dear ImGui.}\par
3495 {\cf20 // This is only useful for (1) core library and (2) backends. End-user/applications do not need to care about this.}\par
3496 {\cf20 // Renderer Backends will create a GPU-side version of this.}\par
3497 {\cf20 // Why does we store two identifiers: TexID and BackendUserData?}\par
3498 {\cf20 // - ImTextureID    TexID           = lower-level identifier stored in ImDrawCmd. ImDrawCmd can refer to textures not created by the backend, and for which there's no ImTextureData.}\par
3499 {\cf20 // - void*          BackendUserData = higher-level opaque storage for backend own book-keeping. Some backends may have enough with TexID and not need both.}\par
3500  {\cf20 // In columns below: who reads/writes each fields? 'r'=read, 'w'=write, 'core'=main library, 'backend'=renderer backend}\par
3501 {\cf17 struct }ImTextureData\par
3502 \{\par
3503     {\cf20 //------------------------------------------ core / backend ---------------------------------------}\par
3504     {\cf18 int}                 UniqueID;               {\cf20 // w    -   // [DEBUG] Sequential index to facilitate identifying a texture when debugging/printing. Unique per atlas.}\par
3505     ImTextureStatus     Status;                 {\cf20 // rw   rw  // ImTextureStatus_OK/_WantCreate/_WantUpdates/_WantDestroy. Always use SetStatus() to modify!}\par
3506     {\cf18 void}*               BackendUserData;        {\cf20 // -    rw  // Convenience storage for backend. Some backends may have enough with TexID.}\par
3507     ImTextureID         TexID;                  {\cf20 // r    w   // Backend-specific texture identifier. Always use SetTexID() to modify! The identifier will stored in ImDrawCmd::GetTexID() and passed to backend's RenderDrawData function.}\par
3508     ImTextureFormat     Format;                 {\cf20 // w    r   // ImTextureFormat_RGBA32 (default) or ImTextureFormat_Alpha8}\par
3509     {\cf18 int}                 Width;                  {\cf20 // w    r   // Texture width}\par
3510     {\cf18 int}                 Height;                 {\cf20 // w    r   // Texture height}\par
3511     {\cf18 int}                 BytesPerPixel;          {\cf20 // w    r   // 4 or 1}\par
3512     {\cf18 unsigned} {\cf18 char}*      Pixels;                 {\cf20 // w    r   // Pointer to buffer holding 'Width*Height' pixels and 'Width*Height*BytesPerPixels' bytes.}\par
3513     ImTextureRect       UsedRect;               {\cf20 // w    r   // Bounding box encompassing all past and queued Updates[].}\par
3514     ImTextureRect       UpdateRect;             {\cf20 // w    r   // Bounding box encompassing all queued Updates[].}\par
3515     ImVector<ImTextureRect> Updates;            {\cf20 // w    r   // Array of individual updates.}\par
3516     {\cf18 int}                 UnusedFrames;           {\cf20 // w    r   // In order to facilitate handling Status==WantDestroy in some backend: this is a count successive frames where the texture was not used. Always >0 when Status==WantDestroy.}\par
3517     {\cf18 unsigned} {\cf18 short}      RefCount;               {\cf20 // w    r   // Number of contexts using this texture. Used during backend shutdown.}\par
3518     {\cf18 bool}                UseColors;              {\cf20 // w    r   // Tell whether our texture data is known to use colors (rather than just white + alpha).}\par
3519     {\cf18 bool}                WantDestroyNextFrame;   {\cf20 // rw   -   // [Internal] Queued to set ImTextureStatus_WantDestroy next frame. May still be used in the current frame.}\par
3520 \par
3521     {\cf20 // Functions}\par
3522     ImTextureData()     \{ memset(({\cf18 void}*){\cf17 this}, 0, {\cf17 sizeof}(*{\cf17 this})); Status = ImTextureStatus_Destroyed; TexID = ImTextureID_Invalid; \}\par
3523     ~ImTextureData()    \{ DestroyPixels(); \}\par
3524     IMGUI_API {\cf18 void}      Create(ImTextureFormat format, {\cf18 int} w, {\cf18 int} h);\par
3525     IMGUI_API {\cf18 void}      DestroyPixels();\par
3526     {\cf18 void}*               GetPixels()                 \{ IM_ASSERT(Pixels != NULL); {\cf19 return} Pixels; \}\par
3527     {\cf18 void}*               GetPixelsAt({\cf18 int} x, {\cf18 int} y)   \{ IM_ASSERT(Pixels != NULL); {\cf19 return} Pixels + (x + y * Width) * BytesPerPixel; \}\par
3528     {\cf18 int}                 GetSizeInBytes(){\cf17  const      }\{ {\cf19 return} Width * Height * BytesPerPixel; \}\par
3529     {\cf18 int}                 GetPitch(){\cf17  const            }\{ {\cf19 return} Width * BytesPerPixel; \}\par
3530     ImTextureRef        GetTexRef()                 \{ ImTextureRef tex_ref; tex_ref._TexData = {\cf17 this}; tex_ref._TexID = ImTextureID_Invalid; {\cf19 return} tex_ref; \}\par
3531     ImTextureID         GetTexID(){\cf17  const            }\{ {\cf19 return} TexID; \}\par
3532 \par
3533     {\cf20 // Called by Renderer backend}\par
3534     {\cf20 // - Call SetTexID() and SetStatus() after honoring texture requests. Never modify TexID and Status directly!}\par
3535     {\cf20 // - A backend may decide to destroy a texture that we did not request to destroy, which is fine (e.g. freeing resources), but we immediately set the texture back in _WantCreate mode.}\par
3536     {\cf18 void}    SetTexID(ImTextureID tex_id)            \{ TexID = tex_id; \}\par
3537     {\cf18 void}    SetStatus(ImTextureStatus status)       \{ Status = status; {\cf19 if} (status == ImTextureStatus_Destroyed && !WantDestroyNextFrame && Pixels != {\cf17 nullptr}) Status = ImTextureStatus_WantCreate; \}\par
3538 \};\par
