3269 {\cf20 // Draw command list}\par
3270 {\cf20 // This is the low-level list of polygons that ImGui:: functions are filling. At the end of the frame,}\par
3271 {\cf20 // all command lists are passed to your ImGuiIO::RenderDrawListFn function for rendering.}\par
3272 {\cf20 // Each dear imgui window contains its own ImDrawList. You can use ImGui::GetWindowDrawList() to}\par
3273 {\cf20 // access the current window draw list and draw custom primitives.}\par
3274 {\cf20 // You can interleave normal ImGui:: calls and adding primitives to the current draw list.}\par
3275 {\cf20 // In single viewport mode, top-left is == GetMainViewport()->Pos (generally 0,0), bottom-right is == GetMainViewport()->Pos+Size (generally io.DisplaySize).}\par
3276 {\cf20 // You are totally free to apply whatever transformation matrix you want to the data (depending on the use of the transformation you may want to apply it to ClipRect as well!)}\par
3277 {\cf20 // Important: Primitives are always added to the list and not culled (culling is done at higher-level by ImGui:: functions), if you use this API a lot consider coarse culling your drawn objects.}\par
3278 {\cf17 struct }ImDrawList\par
3279 \{\par
3280     {\cf20 // This is what you have to render}\par
3281     ImVector<ImDrawCmd>     CmdBuffer;          {\cf20 // Draw commands. Typically 1 command = 1 GPU draw call, unless the command is a callback.}\par
3282     ImVector<ImDrawIdx>     IdxBuffer;          {\cf20 // Index buffer. Each command consume ImDrawCmd::ElemCount of those}\par
3283     ImVector<ImDrawVert>    VtxBuffer;          {\cf20 // Vertex buffer.}\par
3284     ImDrawListFlags         Flags;              {\cf20 // Flags, you may poke into these to adjust anti-aliasing settings per-primitive.}\par
3285 \par
3286     {\cf20 // [Internal, used while building lists]}\par
3287     {\cf18 unsigned} {\cf18 int}            _VtxCurrentIdx;     {\cf20 // [Internal] generally == VtxBuffer.Size unless we are past 64K vertices, in which case this gets reset to 0.}\par
3288     ImDrawListSharedData*   _Data;              {\cf20 // Pointer to shared draw data (you can use ImGui::GetDrawListSharedData() to get the one from current ImGui context)}\par
3289     ImDrawVert*             _VtxWritePtr;       {\cf20 // [Internal] point within VtxBuffer.Data after each add command (to avoid using the ImVector<> operators too much)}\par
3290     ImDrawIdx*              _IdxWritePtr;       {\cf20 // [Internal] point within IdxBuffer.Data after each add command (to avoid using the ImVector<> operators too much)}\par
3291     ImVector<ImVec2>        _Path;              {\cf20 // [Internal] current path building}\par
3292     ImDrawCmdHeader         _CmdHeader;         {\cf20 // [Internal] template of active commands. Fields should match those of CmdBuffer.back().}\par
3293     ImDrawListSplitter      _Splitter;          {\cf20 // [Internal] for channels api (note: prefer using your own persistent instance of ImDrawListSplitter!)}\par
3294     ImVector<ImVec4>        _ClipRectStack;     {\cf20 // [Internal]}\par
3295     ImVector<ImTextureRef>  _TextureStack;      {\cf20 // [Internal]}\par
3296     ImVector<ImU8>          _CallbacksDataBuf;  {\cf20 // [Internal]}\par
3297     {\cf18 float}                   _FringeScale;       {\cf20 // [Internal] anti-alias fringe is scaled by this value, this helps to keep things sharp while zooming at vertex buffer content}\par
3298     {\cf17 const} {\cf18 char}*             _OwnerName;         {\cf20 // Pointer to owner window's name for debugging}\par
