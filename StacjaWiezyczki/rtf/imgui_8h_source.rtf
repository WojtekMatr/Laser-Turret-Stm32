2065     ImGuiTableFlags_NoPadOuterX                = 1 << 22,  {\cf20 // Default if BordersOuterV is off. Disable outermost padding.}\par
2066     ImGuiTableFlags_NoPadInnerX                = 1 << 23,  {\cf20 // Disable inner padding between columns (double inner padding if BordersOuterV is on, single inner padding if BordersOuterV is off).}\par
2067     {\cf20 // Scrolling}\par
2068     ImGuiTableFlags_ScrollX                    = 1 << 24,  {\cf20 // Enable horizontal scrolling. Require 'outer_size' parameter of BeginTable() to specify the container size. Changes default sizing policy. Because this creates a child window, ScrollY is currently generally recommended when using ScrollX.}\par
2069     ImGuiTableFlags_ScrollY                    = 1 << 25,  {\cf20 // Enable vertical scrolling. Require 'outer_size' parameter of BeginTable() to specify the container size.}\par
2070     {\cf20 // Sorting}\par
