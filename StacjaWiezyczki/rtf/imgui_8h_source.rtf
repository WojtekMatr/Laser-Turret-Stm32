2260     {\cf17 inline} T*           erase_unsorted({\cf17 const} T* it)         \{ IM_ASSERT(it >= Data && it < Data + Size);  {\cf17 const} ptrdiff_t off = it - Data; {\cf19 if} (it < Data + Size - 1) memcpy(Data + off, Data + Size - 1, {\cf17 sizeof}(T)); Size--; {\cf19 return} Data + off; \}\par
