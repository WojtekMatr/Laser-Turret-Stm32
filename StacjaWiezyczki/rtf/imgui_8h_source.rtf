2454     {\cf20 // Options to configure Error Handling and how we handle recoverable errors [EXPERIMENTAL]}\par
2455     {\cf20 // - Error recovery is provided as a way to facilitate:}\par
2456     {\cf20 //    - Recovery after a programming error (native code or scripting language - the latter tends to facilitate iterating on code while running).}\par
2457     {\cf20 //    - Recovery after running an exception handler or any error processing which may skip code after an error has been detected.}\par
2458     {\cf20 // - Error recovery is not perfect nor guaranteed! It is a feature to ease development.}\par
2459     {\cf20 //   You not are not supposed to rely on it in the course of a normal application run.}\par
2460     {\cf20 // - Functions that support error recovery are using IM_ASSERT_USER_ERROR() instead of IM_ASSERT().}\par
2461     {\cf20 // - By design, we do NOT allow error recovery to be 100% silent. One of the three options needs to be checked!}\par
2462     {\cf20 // - Always ensure that on programmers seats you have at minimum Asserts or Tooltips enabled when making direct imgui API calls!}\par
2463     {\cf20 //   Otherwise it would severely hinder your ability to catch and correct mistakes!}\par
2464     {\cf20 // Read https://github.com/ocornut/imgui/wiki/Error-Handling for details.}\par
2465     {\cf20 // - Programmer seats: keep asserts (default), or disable asserts and keep error tooltips (new and nice!)}\par
2466     {\cf20 // - Non-programmer seats: maybe disable asserts, but make sure errors are resurfaced (tooltips, visible log entries, use callback etc.)}\par
2467     {\cf20 // - Recovery after error/exception: record stack sizes with ErrorRecoveryStoreState(), disable assert, set log callback (to e.g. trigger high-level breakpoint), recover with ErrorRecoveryTryToRecoverState(), restore settings.}\par
2468     {\cf18 bool}        ConfigErrorRecovery;                {\cf20 // = true       // Enable error recovery support. Some errors won't be detected and lead to direct crashes if recovery is disabled.}\par
2469     {\cf18 bool}        ConfigErrorRecoveryEnableAssert;    {\cf20 // = true       // Enable asserts on recoverable error. By default call IM_ASSERT() when returning from a failing IM_ASSERT_USER_ERROR()}\par
2470     {\cf18 bool}        ConfigErrorRecoveryEnableDebugLog;  {\cf20 // = true       // Enable debug log output on recoverable errors.}\par
2471     {\cf18 bool}        ConfigErrorRecoveryEnableTooltip;   {\cf20 // = true       // Enable tooltip on recoverable errors. The tooltip include a way to enable asserts if they were disabled.}\par
2472 \par
2473     {\cf20 // Option to enable various debug tools showing buttons that will call the IM_DEBUG_BREAK() macro.}\par
2474     {\cf20 // - The Item Picker tool will be available regardless of this being enabled, in order to maximize its discoverability.}\par
2475     {\cf20 // - Requires a debugger being attached, otherwise IM_DEBUG_BREAK() options will appear to crash your application.}\par
2476     {\cf20 //   e.g. io.ConfigDebugIsDebuggerPresent = ::IsDebuggerPresent() on Win32, or refer to ImOsIsDebuggerPresent() imgui_test_engine/imgui_te_utils.cpp for a Unix compatible version.}\par
2477     {\cf18 bool}        ConfigDebugIsDebuggerPresent;   {\cf20 // = false          // Enable various tools calling IM_DEBUG_BREAK().}\par
2478 \par
2479     {\cf20 // Tools to detect code submitting items with conflicting/duplicate IDs}\par
2480     {\cf20 // - Code should use PushID()/PopID() in loops, or append "##xx" to same-label identifiers.}\par
2481     {\cf20 // - Empty label e.g. Button("") == same ID as parent widget/node. Use Button("##xx") instead!}\par
2482     {\cf20 // - See FAQ https://github.com/ocornut/imgui/blob/master/docs/FAQ.md#q-about-the-id-stack-system}\par
2483     {\cf18 bool}        ConfigDebugHighlightIdConflicts;{\cf20 // = true           // Highlight and show an error message popup when multiple items have conflicting identifiers.}\par
2484     {\cf18 bool}        ConfigDebugHighlightIdConflictsShowItemPicker;{\cf20 //=true // Show "Item Picker" button in aforementioned popup.}\par
2485 \par
2486     {\cf20 // Tools to test correct Begin/End and BeginChild/EndChild behaviors.}\par
2487     {\cf20 // - Presently Begin()/End() and BeginChild()/EndChild() needs to ALWAYS be called in tandem, regardless of return value of BeginXXX()}\par
2488     {\cf20 // - This is inconsistent with other BeginXXX functions and create confusion for many users.}\par
2489     {\cf20 // - We expect to update the API eventually. In the meanwhile we provide tools to facilitate checking user-code behavior.}\par
2490     {\cf18 bool}        ConfigDebugBeginReturnValueOnce;{\cf20 // = false          // First-time calls to Begin()/BeginChild() will return false. NEEDS TO BE SET AT APPLICATION BOOT TIME if you don't want to miss windows.}\par
2491     {\cf18 bool}        ConfigDebugBeginReturnValueLoop;{\cf20 // = false          // Some calls to Begin()/BeginChild() will return false. Will cycle through window depths then repeat. Suggested use: add "io.ConfigDebugBeginReturnValue = io.KeyShift" in your main loop then occasionally press SHIFT. Windows should be flickering while running.}\par
2492 \par
2493     {\cf20 // Option to deactivate io.AddFocusEvent(false) handling.}\par
2494     {\cf20 // - May facilitate interactions with a debugger when focus loss leads to clearing inputs data.}\par
2495     {\cf20 // - Backends may have other side-effects on focus loss, so this will reduce side-effects but not necessary remove all of them.}\par
2496     {\cf18 bool}        ConfigDebugIgnoreFocusLoss;     {\cf20 // = false          // Ignore io.AddFocusEvent(false), consequently not calling io.ClearInputKeys()/io.ClearInputMouse() in input processing.}\par
