2914 {\cf17 inline} ImVec2& operator-=(ImVec2& lhs, {\cf17 const} ImVec2& rhs)       \{ lhs.x -= rhs.x; lhs.y -= rhs.y; {\cf19 return} lhs; \}\par
2915 {\cf17 inline} ImVec2& operator*=(ImVec2& lhs, {\cf17 const} ImVec2& rhs)       \{ lhs.x *= rhs.x; lhs.y *= rhs.y; {\cf19 return} lhs; \}\par
2916 {\cf17 inline} ImVec2& operator/=(ImVec2& lhs, {\cf17 const} ImVec2& rhs)       \{ lhs.x /= rhs.x; lhs.y /= rhs.y; {\cf19 return} lhs; \}\par
2917 {\cf17 inline} {\cf18 bool}    operator==({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs) \{ {\cf19 return} lhs.x == rhs.x && lhs.y == rhs.y; \}\par
