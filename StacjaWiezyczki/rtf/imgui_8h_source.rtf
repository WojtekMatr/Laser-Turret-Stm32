557     {\cf20 // Layout cursor positioning}\par
558     {\cf20 // - By "cursor" we mean the current output position.}\par
559     {\cf20 // - The typical widget behavior is to output themselves at the current cursor position, then move the cursor one line down.}\par
560     {\cf20 // - You can call SameLine() between widgets to undo the last carriage return and output at the right of the preceding widget.}\par
561     {\cf20 // - YOU CAN DO 99% OF WHAT YOU NEED WITH ONLY GetCursorScreenPos() and GetContentRegionAvail().}\par
562     {\cf20 // - Attention! We currently have inconsistencies between window-local and absolute positions we will aim to fix with future API:}\par
563     {\cf20 //    - Absolute coordinate:        GetCursorScreenPos(), SetCursorScreenPos(), all ImDrawList:: functions. -> this is the preferred way forward.}\par
564     {\cf20 //    - Window-local coordinates:   SameLine(offset), GetCursorPos(), SetCursorPos(), GetCursorStartPos(), PushTextWrapPos()}\par
565     {\cf20 //    - Window-local coordinates:   GetContentRegionMax(), GetWindowContentRegionMin(), GetWindowContentRegionMax() --> all obsoleted. YOU DON'T NEED THEM.}\par
566     {\cf20 // - GetCursorScreenPos() = GetCursorPos() + GetWindowPos(). GetWindowPos() is almost only ever useful to convert from window-local to absolute coordinates. Try not to use it.}\par
567     IMGUI_API ImVec2        GetCursorScreenPos();                                           {\cf20 // cursor position, absolute coordinates. THIS IS YOUR BEST FRIEND (prefer using this rather than GetCursorPos(), also more useful to work with ImDrawList API).}\par
568     IMGUI_API {\cf18 void}          SetCursorScreenPos({\cf17 const} ImVec2& pos);                          {\cf20 // cursor position, absolute coordinates. THIS IS YOUR BEST FRIEND.}\par
569     IMGUI_API ImVec2        GetContentRegionAvail();                                        {\cf20 // available space from current position. THIS IS YOUR BEST FRIEND.}\par
570     IMGUI_API ImVec2        GetCursorPos();                                                 {\cf20 // [window-local] cursor position in window-local coordinates. This is not your best friend.}\par
571     IMGUI_API {\cf18 float}         GetCursorPosX();                                                {\cf20 // [window-local] "}\par
572     IMGUI_API {\cf18 float}         GetCursorPosY();                                                {\cf20 // [window-local] "}\par
573     IMGUI_API {\cf18 void}          SetCursorPos({\cf17 const} ImVec2& local_pos);                          {\cf20 // [window-local] "}\par
574     IMGUI_API {\cf18 void}          SetCursorPosX({\cf18 float} local_x);                                   {\cf20 // [window-local] "}\par
