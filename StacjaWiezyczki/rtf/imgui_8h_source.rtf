2040     ImGuiTableFlags_BordersInnerH              = 1 << 7,   {\cf20 // Draw horizontal borders between rows.}\par
2041     ImGuiTableFlags_BordersOuterH              = 1 << 8,   {\cf20 // Draw horizontal borders at the top and bottom.}\par
