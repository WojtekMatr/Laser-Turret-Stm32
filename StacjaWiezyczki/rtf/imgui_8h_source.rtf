3059     {\cf18 bool}                        RangeSrcReset;  {\cf20 //        app:w     /  ms:r          // (If using deletion) Set before EndMultiSelect() to reset ResetSrcItem (e.g. if deleted selection).}\par
3060     {\cf18 int}                         ItemsCount;     {\cf20 //  ms:w, app:r     /        app:r   // 'int items_count' parameter to BeginMultiSelect() is copied here for convenience, allowing simpler calls to your ApplyRequests handler. Not used internally.}\par
