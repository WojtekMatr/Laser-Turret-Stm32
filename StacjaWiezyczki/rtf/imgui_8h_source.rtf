3167 {\cf20 // - VtxOffset: When 'io.BackendFlags & ImGuiBackendFlags_RendererHasVtxOffset' is enabled,}\par
3168 {\cf20 //   this fields allow us to render meshes larger than 64K vertices while keeping 16-bit indices.}\par
3169 {\cf20 //   Backends made for <1.71. will typically ignore the VtxOffset fields.}\par
3170 {\cf20 // - The ClipRect/TexRef/VtxOffset fields must be contiguous as we memcmp() them together (this is asserted for).}\par
3171 {\cf17 struct }ImDrawCmd\par
3172 \{\par
