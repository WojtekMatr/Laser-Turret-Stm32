3153 {\cf20 //  B) render a complex 3D scene inside a UI element without an intermediate texture/render target, etc.}\par
3154 {\cf20 // The expected behavior from your rendering function is 'if (cmd.UserCallback != NULL) \{ cmd.UserCallback(parent_list, cmd); \} else \{ RenderTriangles() \}'}\par
3155 {\cf20 // If you want to override the signature of ImDrawCallback, you can simply use e.g. '#define ImDrawCallback MyDrawCallback' (in imconfig.h) + update rendering backend accordingly.}\par
3156 {\cf21 #ifndef ImDrawCallback}\par
3157 {\cf17 typedef} void (*ImDrawCallback)({\cf17 const} ImDrawList* parent_list, {\cf17 const} ImDrawCmd* cmd);\par
3158 {\cf21 #endif}\par
