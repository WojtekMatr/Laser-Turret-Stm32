2053     ImGuiTableFlags_SizingFixedSame            = 2 << 13,  {\cf20 // Columns default to _WidthFixed or _WidthAuto (if resizable or not resizable), matching the maximum contents width of all columns. Implicitly enable ImGuiTableFlags_NoKeepColumnsVisible.}\par
2054     ImGuiTableFlags_SizingStretchProp          = 3 << 13,  {\cf20 // Columns default to _WidthStretch with default weights proportional to each columns contents widths.}\par
