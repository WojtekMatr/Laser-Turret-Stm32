2785 {\cf20 // Helper: Key->Value storage}\par
2786 {\cf20 // Typically you don't have to worry about this since a storage is held within each Window.}\par
2787 {\cf20 // We use it to e.g. store collapse state for a tree (Int 0/1)}\par
2788 {\cf20 // This is optimized for efficient lookup (dichotomy into a contiguous buffer) and rare insertion (typically tied to user interactions aka max once a frame)}\par
2789 {\cf20 // You can use it as custom user storage for temporary values. Declare your own storage if, for example:}\par
2790 {\cf20 // - You want to manipulate the open/close state of a particular sub-tree in your interface (tree node uses Int 0/1 to store their state).}\par
2791 {\cf20 // - You want to store custom debug data easily without adding or editing structures in your code (probably not efficient, but convenient)}\par
2792 {\cf20 // Types are NOT stored, so it is up to you to make sure your Key don't collide with different types.}\par
2793 {\cf17 struct }ImGuiStorage\par
2794 \{\par
2795     {\cf20 // [Internal]}\par
2796     ImVector<ImGuiStoragePair>      Data;\par
2797 \par
2798     {\cf20 // - Get***() functions find pair, never add/allocate. Pairs are sorted so a query is O(log N)}\par
2799     {\cf20 // - Set***() functions find pair, insertion on demand if missing.}\par
2800     {\cf20 // - Sorted insertion is costly, paid once. A typical frame shouldn't need to insert any new pair.}\par
2801     {\cf18 void}                Clear() \{ Data.clear(); \}\par
2802     IMGUI_API {\cf18 int}       GetInt(ImGuiID key, {\cf18 int} default_val = 0) {\cf17 const};\par
2803     IMGUI_API {\cf18 void}      SetInt(ImGuiID key, {\cf18 int} val);\par
2804     IMGUI_API {\cf18 bool}      GetBool(ImGuiID key, {\cf18 bool} default_val = {\cf17 false}) {\cf17 const};\par
2805     IMGUI_API {\cf18 void}      SetBool(ImGuiID key, {\cf18 bool} val);\par
2806     IMGUI_API {\cf18 float}     GetFloat(ImGuiID key, {\cf18 float} default_val = 0.0f) {\cf17 const};\par
2807     IMGUI_API {\cf18 void}      SetFloat(ImGuiID key, {\cf18 float} val);\par
2808     IMGUI_API {\cf18 void}*     GetVoidPtr(ImGuiID key) {\cf17 const}; {\cf20 // default_val is NULL}\par
2809     IMGUI_API {\cf18 void}      SetVoidPtr(ImGuiID key, {\cf18 void}* val);\par
2810 \par
2811     {\cf20 // - Get***Ref() functions finds pair, insert on demand if missing, return pointer. Useful if you intend to do Get+Set.}\par
2812     {\cf20 // - References are only valid until a new value is added to the storage. Calling a Set***() function or a Get***Ref() function invalidates the pointer.}\par
2813     {\cf20 // - A typical use case where this is convenient for quick hacking (e.g. add storage during a live Edit&Continue session if you can't modify existing struct)}\par
2814     {\cf20 //      float* pvar = ImGui::GetFloatRef(key); ImGui::SliderFloat("var", pvar, 0, 100.0f); some_var += *pvar;}\par
2815     IMGUI_API {\cf18 int}*      GetIntRef(ImGuiID key, {\cf18 int} default_val = 0);\par
