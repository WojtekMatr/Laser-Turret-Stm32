667     {\cf20 // Widgets: Drag Sliders}\par
668     {\cf20 // - Ctrl+Click on any drag box to turn them into an input box. Manually input values aren't clamped by default and can go off-bounds. Use ImGuiSliderFlags_AlwaysClamp to always clamp.}\par
669     {\cf20 // - For all the Float2/Float3/Float4/Int2/Int3/Int4 versions of every function, note that a 'float v[X]' function argument is the same as 'float* v',}\par
670     {\cf20 //   the array syntax is just a way to document the number of elements that are expected to be accessible. You can pass address of your first element out of a contiguous set, e.g. &myvector.x}\par
671     {\cf20 // - Adjust format string to decorate the value with a prefix, a suffix, or adapt the editing and display precision e.g. "%.3f" -> 1.234; "%5.2f secs" -> 01.23 secs; "Biscuit: %.0f" -> Biscuit: 1; etc.}\par
672     {\cf20 // - Format string may also be set to NULL or use the default format ("%f" or "%d").}\par
673     {\cf20 // - Speed are per-pixel of mouse movement (v_speed=0.2f: mouse needs to move by 5 pixels to increase value by 1). For keyboard/gamepad navigation, minimum speed is Max(v_speed, minimum_step_at_given_precision).}\par
674     {\cf20 // - Use v_min < v_max to clamp edits to given limits. Note that Ctrl+Click manual input can override those limits if ImGuiSliderFlags_AlwaysClamp is not used.}\par
675     {\cf20 // - Use v_max = FLT_MAX / INT_MAX etc to avoid clamping to a maximum, same with v_min = -FLT_MAX / INT_MIN to avoid clamping to a minimum.}\par
676     {\cf20 // - We use the same sets of flags for DragXXX() and SliderXXX() functions as the features are the same and it makes it easier to swap them.}\par
677     {\cf20 // - Legacy: Pre-1.78 there are DragXXX() function signatures that take a final `float power=1.0f' argument instead of the `ImGuiSliderFlags flags=0' argument.}\par
678     {\cf20 //   If you get a warning converting a float to ImGuiSliderFlags, read https://github.com/ocornut/imgui/issues/3361}\par
679     IMGUI_API {\cf18 bool}          DragFloat({\cf17 const} {\cf18 char}* label, {\cf18 float}* v, {\cf18 float} v_speed = 1.0f, {\cf18 float} v_min = 0.0f, {\cf18 float} v_max = 0.0f, {\cf17 const} {\cf18 char}* format = {\cf22 "%.3f"}, ImGuiSliderFlags flags = 0);     {\cf20 // If v_min >= v_max we have no bound}\par
680     IMGUI_API {\cf18 bool}          DragFloat2({\cf17 const} {\cf18 char}* label, {\cf18 float} v[2], {\cf18 float} v_speed = 1.0f, {\cf18 float} v_min = 0.0f, {\cf18 float} v_max = 0.0f, {\cf17 const} {\cf18 char}* format = {\cf22 "%.3f"}, ImGuiSliderFlags flags = 0);\par
681     IMGUI_API {\cf18 bool}          DragFloat3({\cf17 const} {\cf18 char}* label, {\cf18 float} v[3], {\cf18 float} v_speed = 1.0f, {\cf18 float} v_min = 0.0f, {\cf18 float} v_max = 0.0f, {\cf17 const} {\cf18 char}* format = {\cf22 "%.3f"}, ImGuiSliderFlags flags = 0);\par
682     IMGUI_API {\cf18 bool}          DragFloat4({\cf17 const} {\cf18 char}* label, {\cf18 float} v[4], {\cf18 float} v_speed = 1.0f, {\cf18 float} v_min = 0.0f, {\cf18 float} v_max = 0.0f, {\cf17 const} {\cf18 char}* format = {\cf22 "%.3f"}, ImGuiSliderFlags flags = 0);\par
