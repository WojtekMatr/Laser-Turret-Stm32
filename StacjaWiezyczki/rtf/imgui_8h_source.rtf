3055     ImVector<ImGuiSelectionRequest> Requests;   {\cf20 //  ms:w, app:r     /  ms:w  app:r   // Requests to apply to your selection data.}\par
3056     ImGuiSelectionUserData      RangeSrcItem;   {\cf20 //  ms:w  app:r     /                // (If using clipper) Begin: Source item (often the first selected item) must never be clipped: use clipper.IncludeItemByIndex() to ensure it is submitted.}\par
3057     ImGuiSelectionUserData      NavIdItem;      {\cf20 //  ms:w, app:r     /                // (If using deletion) Last known SetNextItemSelectionUserData() value for NavId (if part of submitted items).}\par
