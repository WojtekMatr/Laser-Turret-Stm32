2906 {\cf17 inline} ImVec2  operator+({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)  \{ {\cf19 return} ImVec2(lhs.x + rhs.x, lhs.y + rhs.y); \}\par
2907 {\cf17 inline} ImVec2  operator-({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)  \{ {\cf19 return} ImVec2(lhs.x - rhs.x, lhs.y - rhs.y); \}\par
2908 {\cf17 inline} ImVec2  operator*({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)  \{ {\cf19 return} ImVec2(lhs.x * rhs.x, lhs.y * rhs.y); \}\par
2909 {\cf17 inline} ImVec2  operator/({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)  \{ {\cf19 return} ImVec2(lhs.x / rhs.x, lhs.y / rhs.y); \}\par
2910 {\cf17 inline} ImVec2  operator-({\cf17 const} ImVec2& lhs)                     \{ {\cf19 return} ImVec2(-lhs.x, -lhs.y); \}\par
2911 {\cf17 inline} ImVec2& operator*=(ImVec2& lhs, {\cf17 const} {\cf18 float} rhs)         \{ lhs.x *= rhs; lhs.y *= rhs; {\cf19 return} lhs; \}\par
2912 {\cf17 inline} ImVec2& operator/=(ImVec2& lhs, {\cf17 const} {\cf18 float} rhs)         \{ lhs.x /= rhs; lhs.y /= rhs; {\cf19 return} lhs; \}\par
