440     {\cf20 // Child Windows}\par
441     {\cf20 // - Use child windows to begin into a self-contained independent scrolling/clipping regions within a host window. Child windows can embed their own child.}\par
442     {\cf20 // - Before 1.90 (November 2023), the "ImGuiChildFlags child_flags = 0" parameter was "bool border = false".}\par
443     {\cf20 //   This API is backward compatible with old code, as we guarantee that ImGuiChildFlags_Borders == true.}\par
444     {\cf20 //   Consider updating your old code:}\par
445     {\cf20 //      BeginChild("Name", size, false)   -> Begin("Name", size, 0); or Begin("Name", size, ImGuiChildFlags_None);}\par
446     {\cf20 //      BeginChild("Name", size, true)    -> Begin("Name", size, ImGuiChildFlags_Borders);}\par
447     {\cf20 // - Manual sizing (each axis can use a different setting e.g. ImVec2(0.0f, 400.0f)):}\par
448     {\cf20 //     == 0.0f: use remaining parent window size for this axis.}\par
449     {\cf20 //      > 0.0f: use specified size for this axis.}\par
450     {\cf20 //      < 0.0f: right/bottom-align to specified distance from available content boundaries.}\par
451     {\cf20 // - Specifying ImGuiChildFlags_AutoResizeX or ImGuiChildFlags_AutoResizeY makes the sizing automatic based on child contents.}\par
452     {\cf20 //   Combining both ImGuiChildFlags_AutoResizeX _and_ ImGuiChildFlags_AutoResizeY defeats purpose of a scrolling region and is NOT recommended.}\par
453     {\cf20 // - BeginChild() returns false to indicate the window is collapsed or fully clipped, so you may early out and omit submitting}\par
454     {\cf20 //   anything to the window. Always call a matching EndChild() for each BeginChild() call, regardless of its return value.}\par
