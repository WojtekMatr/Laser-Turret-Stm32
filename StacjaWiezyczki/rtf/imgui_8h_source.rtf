3082 {\cf20 // Optional helper to store multi-selection state + apply multi-selection requests.}\par
3083 {\cf20 // - Used by our demos and provided as a convenience to easily implement basic multi-selection.}\par
3084 {\cf20 // - Iterate selection with 'void* it = NULL; ImGuiID id; while (selection.GetNextSelectedItem(&it, &id)) \{ ... \}'}\par
3085 {\cf20 //   Or you can check 'if (Contains(id)) \{ ... \}' for each possible object if their number is not too high to iterate.}\par
3086 {\cf20 // - USING THIS IS NOT MANDATORY. This is only a helper and not a required API.}\par
3087 {\cf20 // To store a multi-selection, in your application you could:}\par
3088 {\cf20 // - Use this helper as a convenience. We use our simple key->value ImGuiStorage as a std::set<ImGuiID> replacement.}\par
3089 {\cf20 // - Use your own external storage: e.g. std::set<MyObjectId>, std::vector<MyObjectId>, interval trees, intrusively stored selection etc.}\par
3090 {\cf20 // In ImGuiSelectionBasicStorage we:}\par
3091 {\cf20 // - always use indices in the multi-selection API (passed to SetNextItemSelectionUserData(), retrieved in ImGuiMultiSelectIO)}\par
3092 {\cf20 // - use the AdapterIndexToStorageId() indirection layer to abstract how persistent selection data is derived from an index.}\par
3093 {\cf20 // - use decently optimized logic to allow queries and insertion of very large selection sets.}\par
3094 {\cf20 // - do not preserve selection order.}\par
3095 {\cf20 // Many combinations are possible depending on how you prefer to store your items and how you prefer to store your selection.}\par
3096 {\cf20 // Large applications are likely to eventually want to get rid of this indirection layer and do their own thing.}\par
3097 {\cf20 // See https://github.com/ocornut/imgui/wiki/Multi-Select for details and pseudo-code using this helper.}\par
3098 {\cf17 struct }ImGuiSelectionBasicStorage\par
3099 \{\par
3100     {\cf20 // Members}\par
3101     {\cf18 int}             Size;           {\cf20 //          // Number of selected items, maintained by this helper.}\par
3102     {\cf18 bool}            PreserveOrder;  {\cf20 // = false  // GetNextSelectedItem() will return ordered selection (currently implemented by two additional sorts of selection. Could be improved)}\par
3103     {\cf18 void}*           UserData;       {\cf20 // = NULL   // User data for use by adapter function        // e.g. selection.UserData = (void*)my_items;}\par
3104     ImGuiID         (*AdapterIndexToStorageId)(ImGuiSelectionBasicStorage* self, {\cf18 int} idx);      {\cf20 // e.g. selection.AdapterIndexToStorageId = [](ImGuiSelectionBasicStorage* self, int idx) \{ return ((MyItems**)self->UserData)[idx]->ID; \};}\par
3105     {\cf18 int}             _SelectionOrder;{\cf20 // [Internal] Increasing counter to store selection order}\par
3106     ImGuiStorage    _Storage;       {\cf20 // [Internal] Selection set. Think of this as similar to e.g. std::set<ImGuiID>. Prefer not accessing directly: iterate with GetNextSelectedItem().}\par
3107 \par
3108     {\cf20 // Methods}\par
3109     IMGUI_API ImGuiSelectionBasicStorage();\par
3110     IMGUI_API {\cf18 void}  ApplyRequests(ImGuiMultiSelectIO* ms_io);   {\cf20 // Apply selection requests coming from BeginMultiSelect() and EndMultiSelect() functions. It uses 'items_count' passed to BeginMultiSelect()}\par
3111     IMGUI_API {\cf18 bool}  Contains(ImGuiID {\cf18 id}) {\cf17 const};                 {\cf20 // Query if an item id is in selection.}\par
3112     IMGUI_API {\cf18 void}  Clear();                                    {\cf20 // Clear selection}\par
3113     IMGUI_API {\cf18 void}  Swap(ImGuiSelectionBasicStorage& r);        {\cf20 // Swap two selections}\par
3114     IMGUI_API {\cf18 void}  SetItemSelected(ImGuiID {\cf18 id}, {\cf18 bool} selected); {\cf20 // Add/remove an item from selection (generally done by ApplyRequests() function)}\par
3115     IMGUI_API {\cf18 bool}  GetNextSelectedItem({\cf18 void}** opaque_it, ImGuiID* out_id); {\cf20 // Iterate selection with 'void* it = NULL; ImGuiID id; while (selection.GetNextSelectedItem(&it, &id)) \{ ... \}'}\par
3116     {\cf17 inline} ImGuiID  GetStorageIdFromIndex({\cf18 int} idx)              \{ {\cf19 return} AdapterIndexToStorageId({\cf17 this}, idx); \}  {\cf20 // Convert index to item id based on provided adapter.}\par
3117 \};\par
