2058     ImGuiTableFlags_NoHostExtendY              = 1 << 17,  {\cf20 // Make outer height stop exactly at outer_size.y (prevent auto-extending table past the limit). Only available when ScrollX/ScrollY are disabled. Data below the limit will be clipped and not visible.}\par
