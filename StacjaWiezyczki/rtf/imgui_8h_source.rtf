883     {\cf20 // Tables}\par
884     {\cf20 // - Full-featured replacement for old Columns API.}\par
885     {\cf20 // - See Demo->Tables for demo code. See top of imgui_tables.cpp for general commentary.}\par
886     {\cf20 // - See ImGuiTableFlags_ and ImGuiTableColumnFlags_ enums for a description of available flags.}\par
887     {\cf20 // The typical call flow is:}\par
888     {\cf20 // - 1. Call BeginTable(), early out if returning false.}\par
889     {\cf20 // - 2. Optionally call TableSetupColumn() to submit column name/flags/defaults.}\par
890     {\cf20 // - 3. Optionally call TableSetupScrollFreeze() to request scroll freezing of columns/rows.}\par
891     {\cf20 // - 4. Optionally call TableHeadersRow() to submit a header row. Names are pulled from TableSetupColumn() data.}\par
892     {\cf20 // - 5. Populate contents:}\par
893     {\cf20 //    - In most situations you can use TableNextRow() + TableSetColumnIndex(N) to start appending into a column.}\par
894     {\cf20 //    - If you are using tables as a sort of grid, where every column is holding the same type of contents,}\par
895     {\cf20 //      you may prefer using TableNextColumn() instead of TableNextRow() + TableSetColumnIndex().}\par
896     {\cf20 //      TableNextColumn() will automatically wrap-around into the next row if needed.}\par
897     {\cf20 //    - IMPORTANT: Comparatively to the old Columns() API, we need to call TableNextColumn() for the first column!}\par
898     {\cf20 //    - Summary of possible call flow:}\par
899     {\cf20 //        - TableNextRow() -> TableSetColumnIndex(0) -> Text("Hello 0") -> TableSetColumnIndex(1) -> Text("Hello 1")  // OK}\par
900     {\cf20 //        - TableNextRow() -> TableNextColumn()      -> Text("Hello 0") -> TableNextColumn()      -> Text("Hello 1")  // OK}\par
901     {\cf20 //        -                   TableNextColumn()      -> Text("Hello 0") -> TableNextColumn()      -> Text("Hello 1")  // OK: TableNextColumn() automatically gets to next row!}\par
902     {\cf20 //        - TableNextRow()                           -> Text("Hello 0")                                               // Not OK! Missing TableSetColumnIndex() or TableNextColumn()! Text will not appear!}\par
903     {\cf20 // - 5. Call EndTable()}\par
904     IMGUI_API {\cf18 bool}          BeginTable({\cf17 const} {\cf18 char}* str_id, {\cf18 int} columns, ImGuiTableFlags flags = 0, {\cf17 const} ImVec2& outer_size = ImVec2(0.0f, 0.0f), {\cf18 float} inner_width = 0.0f);\par
905     IMGUI_API {\cf18 void}          EndTable();                                         {\cf20 // only call EndTable() if BeginTable() returns true!}\par
906     IMGUI_API {\cf18 void}          TableNextRow(ImGuiTableRowFlags row_flags = 0, {\cf18 float} min_row_height = 0.0f); {\cf20 // append into the first cell of a new row. 'min_row_height' include the minimum top and bottom padding aka CellPadding.y * 2.0f.}\par
907     IMGUI_API {\cf18 bool}          TableNextColumn();                                  {\cf20 // append into the next column (or first column of next row if currently in last column). Return true when column is visible.}\par
908     IMGUI_API {\cf18 bool}          TableSetColumnIndex({\cf18 int} column_n);                  {\cf20 // append into the specified column. Return true when column is visible.}\par
