2501 {\cf17 static} stbtt_int32 stbtt__GetGlyphGPOSInfoAdvance({\cf17 const} stbtt_fontinfo *info, {\cf18 int} glyph1, {\cf18 int} glyph2)\par
2502 \{\par
2503    stbtt_uint16 lookupListOffset;\par
2504    stbtt_uint8 *lookupList;\par
2505    stbtt_uint16 lookupCount;\par
2506    stbtt_uint8 *data;\par
2507    stbtt_int32 i, sti;\par
2508 \par
2509    {\cf19 if} (!info->gpos) {\cf19 return} 0;\par
2510 \par
2511    data = info->data + info->gpos;\par
