2601                \} {\cf19 else}\par
2602                   {\cf19 return} 0;\par
2603                {\cf19 break};\par
2604             \}\par
2605 \par
2606             {\cf19 default}:\par
2607                {\cf19 return} 0; {\cf20 // Unsupported position format}\par
2608          \}\par
2609       \}\par
2610    \}\par
2611 \par
2612    {\cf19 return} 0;\par
2613 \}\par
