3562 {\cf20 // tessellate until threshold p is happy... @TODO warped to compensate for non-linear stretching}\par
3563 {\cf17 static} {\cf18 int} stbtt__tesselate_curve(stbtt__point *points, {\cf18 int} *num_points, {\cf18 float} x0, {\cf18 float} y0, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} x2, {\cf18 float} y2, {\cf18 float} objspace_flatness_squared, {\cf18 int} n)\par
3564 \{\par
3565    {\cf20 // midpoint}\par
3566    {\cf18 float} mx = (x0 + 2*x1 + x2)/4;\par
3567    {\cf18 float} my = (y0 + 2*y1 + y2)/4;\par
3568    {\cf20 // versus directly drawn line}\par
3569    {\cf18 float} dx = (x0+x2)/2 - mx;\par
3570    {\cf18 float} dy = (y0+y2)/2 - my;\par
3571    {\cf19 if} (n > 16) {\cf20 // 65536 segments on one curve better be enough!}\par
3572       {\cf19 return} 1;\par
3573    {\cf19 if} (dx*dx+dy*dy > objspace_flatness_squared) \{ {\cf20 // half-pixel error allowed... need to be smaller if AA}\par
3574       stbtt__tesselate_curve(points, num_points, x0,y0, (x0+x1)/2.0f,(y0+y1)/2.0f, mx,my, objspace_flatness_squared,n+1);\par
3575       stbtt__tesselate_curve(points, num_points, mx,my, (x1+x2)/2.0f,(y1+y2)/2.0f, x2,y2, objspace_flatness_squared,n+1);\par
3576    \} {\cf19 else} \{\par
3577       stbtt__add_point(points, *num_points,x2,y2);\par
3578       *num_points = *num_points+1;\par
3579    \}\par
3580    {\cf19 return} 1;\par
3581 \}\par
