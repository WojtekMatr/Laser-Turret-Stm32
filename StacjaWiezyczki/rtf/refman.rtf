3047 {\cf20 // Main IO structure returned by BeginMultiSelect()/EndMultiSelect().}\par
3048 {\cf20 // This mainly contains a list of selection requests.}\par
3049 {\cf20 // - Use 'Demo->Tools->Debug Log->Selection' to see requests as they happen.}\par
3050 {\cf20 // - Some fields are only useful if your list is dynamic and allows deletion (getting post-deletion focus/state right is shown in the demo)}\par
3051 {\cf20 // - Below: who reads/writes each fields? 'r'=read, 'w'=write, 'ms'=multi-select code, 'app'=application/user code.}\par
3052 {\cf17 struct }ImGuiMultiSelectIO\par
3053 \{\par
3054     {\cf20 //------------------------------------------// BeginMultiSelect / EndMultiSelect}\par
3055     ImVector<ImGuiSelectionRequest> Requests;   {\cf20 //  ms:w, app:r     /  ms:w  app:r   // Requests to apply to your selection data.}\par
3056     ImGuiSelectionUserData      RangeSrcItem;   {\cf20 //  ms:w  app:r     /                // (If using clipper) Begin: Source item (often the first selected item) must never be clipped: use clipper.IncludeItemByIndex() to ensure it is submitted.}\par
3057     ImGuiSelectionUserData      NavIdItem;      {\cf20 //  ms:w, app:r     /                // (If using deletion) Last known SetNextItemSelectionUserData() value for NavId (if part of submitted items).}\par
3058     {\cf18 bool}                        NavIdSelected;  {\cf20 //  ms:w, app:r     /        app:r   // (If using deletion) Last known selection state for NavId (if part of submitted items).}\par
3059     {\cf18 bool}                        RangeSrcReset;  {\cf20 //        app:w     /  ms:r          // (If using deletion) Set before EndMultiSelect() to reset ResetSrcItem (e.g. if deleted selection).}\par
3060     {\cf18 int}                         ItemsCount;     {\cf20 //  ms:w, app:r     /        app:r   // 'int items_count' parameter to BeginMultiSelect() is copied here for convenience, allowing simpler calls to your ApplyRequests handler. Not used internally.}\par
3061 \};\par
