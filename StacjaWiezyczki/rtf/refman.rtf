2567                         r = m - 1;\par
2568                      {\cf19 else} {\cf19 if} (needle > straw)\par
2569                         l = m + 1;\par
2570                      {\cf19 else} \{\par
2571                         stbtt_int16 xAdvance = ttSHORT(pairValue + 2);\par
2572                         {\cf19 return} xAdvance;\par
2573                      \}\par
2574                   \}\par
2575                \} {\cf19 else}\par
2576                   {\cf19 return} 0;\par
2577                {\cf19 break};\par
2578             \}\par
2579 \par
2580             {\cf19 case} 2: \{\par
2581                stbtt_uint16 valueFormat1 = ttUSHORT(table + 4);\par
2582                stbtt_uint16 valueFormat2 = ttUSHORT(table + 6);\par
2583                {\cf19 if} (valueFormat1 == 4 && valueFormat2 == 0) \{ {\cf20 // Support more formats?}\par
