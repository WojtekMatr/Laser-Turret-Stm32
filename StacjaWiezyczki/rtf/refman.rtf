308 {\cf20 // Use 'Metrics/Debugger->Tools->Item Picker' to break into the call-stack of a specific item.}\par
309 {\cf20 // This will call IM_DEBUG_BREAK() which you may redefine yourself. See https://github.com/scottt/debugbreak for more reference.}\par
310 {\cf21 #ifndef IM_DEBUG_BREAK}\par
311 {\cf21 #if defined (_MSC_VER)}\par
312 {\cf21 #define IM_DEBUG_BREAK()    __debugbreak()}\par
313 {\cf21 #elif defined(__clang__)}\par
314 {\cf21 #define IM_DEBUG_BREAK()    __builtin_debugtrap()}\par
315 {\cf21 #elif defined(__GNUC__) && (defined(__i386__) || defined(__x86_64__))}\par
316 {\cf21 #define IM_DEBUG_BREAK()    __asm__ volatile("int3;nop")}\par
317 {\cf21 #elif defined(__GNUC__) && defined(__thumb__)}\par
318 {\cf21 #define IM_DEBUG_BREAK()    __asm__ volatile(".inst 0xde01")}\par
319 {\cf21 #elif defined(__GNUC__) && defined(__arm__) && !defined(__thumb__)}\par
320 {\cf21 #define IM_DEBUG_BREAK()    __asm__ volatile(".inst 0xe7f001f0")}\par
321 {\cf21 #else}\par
322 {\cf21 #define IM_DEBUG_BREAK()    IM_ASSERT(0)    }{\cf20 // It is expected that you define IM_DEBUG_BREAK() into something that will break nicely in a debugger!}\par
323 {\cf21 #endif}\par
324 {\cf21 #endif }{\cf20 // #ifndef IM_DEBUG_BREAK}\par
