3555 {\cf17 static} {\cf18 void} stbtt__add_point(stbtt__point *points, {\cf18 int} n, {\cf18 float} x, {\cf18 float} y)\par
3556 \{\par
3557    {\cf19 if} (!points) {\cf19 return}; {\cf20 // during first pass, it's unallocated}\par
3558    points[n].x = x;\par
3559    points[n].y = y;\par
3560 \}\par
