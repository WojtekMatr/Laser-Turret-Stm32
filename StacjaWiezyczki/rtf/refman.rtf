1612    STBTT_assert(!info->cff.size);\par
1613 \par
1614    {\cf19 if} (glyph_index >= info->numGlyphs) {\cf19 return} -1; {\cf20 // glyph index out of range}\par
1615    {\cf19 if} (info->indexToLocFormat >= 2)    {\cf19 return} -1; {\cf20 // unknown index->glyph map format}\par
1616 \par
1617    {\cf19 if} (info->indexToLocFormat == 0) \{\par
1618       g1 = info->glyf + ttUSHORT(info->data + info->loca + glyph_index * 2) * 2;\par
1619       g2 = info->glyf + ttUSHORT(info->data + info->loca + glyph_index * 2 + 2) * 2;\par
