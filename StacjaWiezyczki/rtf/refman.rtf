2585                   stbtt_uint16 classDef2Offset = ttUSHORT(table + 10);\par
2586                   {\cf18 int} glyph1class = stbtt__GetGlyphClass(table + classDef1Offset, glyph1);\par
2587                   {\cf18 int} glyph2class = stbtt__GetGlyphClass(table + classDef2Offset, glyph2);\par
