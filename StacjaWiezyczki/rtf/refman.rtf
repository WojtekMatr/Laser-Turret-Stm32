796 {\cf20 // API key: process text input}\par
797 {\cf20 // [DEAR IMGUI] Added stb_textedit_text(), extracted out and called by stb_textedit_key() for backward compatibility.}\par
798 {\cf17 static} {\cf18 void} stb_textedit_text(IMSTB_TEXTEDIT_STRING* str, STB_TexteditState* state, {\cf17 const} IMSTB_TEXTEDIT_CHARTYPE* text, {\cf18 int} text_len)\par
799 \{\par
800    {\cf20 // can't add newline in single-line mode}\par
801    {\cf19 if} (text[0] == {\cf23 '\\n'} && state->single_line)\par
802       {\cf19 return};\par
803 \par
804    {\cf19 if} (state->insert_mode && !STB_TEXT_HAS_SELECTION(state) && state->cursor < STB_TEXTEDIT_STRINGLEN(str)) \{\par
805       stb_text_makeundo_replace(str, state, state->cursor, 1, 1);\par
806       STB_TEXTEDIT_DELETECHARS(str, state->cursor, 1);\par
807       text_len = STB_TEXTEDIT_INSERTCHARS(str, state->cursor, text, text_len);\par
808       {\cf19 if} (text_len) \{\par
809          state->cursor += text_len;\par
810          state->has_preferred_x = 0;\par
811       \}\par
812    \} {\cf19 else} \{\par
813       stb_textedit_delete_selection(str, state); {\cf20 // implicitly clamps}\par
814       text_len = STB_TEXTEDIT_INSERTCHARS(str, state->cursor, text, text_len);\par
815       {\cf19 if} (text_len) \{\par
816          stb_text_makeundo_insert(state, state->cursor, text_len);\par
817          state->cursor += text_len;\par
818          state->has_preferred_x = 0;\par
819       \}\par
820    \}\par
821 \}\par
822 \par
823 {\cf20 // API key: process a keyboard input}\par
824 {\cf17 static} {\cf18 void} stb_textedit_key(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, STB_TEXTEDIT_KEYTYPE key)\par
825 \{\par
826 retry:\par
827    {\cf19 switch} (key) \{\par
828       {\cf19 default}: \{\par
829 {\cf21 #ifdef STB_TEXTEDIT_KEYTOTEXT}\par
830          {\cf20 // This is not suitable for UTF-8 support.}\par
831          {\cf18 int} c = STB_TEXTEDIT_KEYTOTEXT(key);\par
832          {\cf19 if} (c > 0) \{\par
833             IMSTB_TEXTEDIT_CHARTYPE ch = (IMSTB_TEXTEDIT_CHARTYPE)c;\par
834             stb_textedit_text(str, state, &ch, 1);\par
835          \}\par
836 {\cf21 #endif}\par
837          {\cf19 break};\par
838       \}\par
839 \par
840 {\cf21 #ifdef STB_TEXTEDIT_K_INSERT}\par
841       {\cf19 case} STB_TEXTEDIT_K_INSERT:\par
842          state->insert_mode = !state->insert_mode;\par
843          {\cf19 break};\par
844 {\cf21 #endif}\par
845 \par
846       {\cf19 case} STB_TEXTEDIT_K_UNDO:\par
847          stb_text_undo(str, state);\par
848          state->has_preferred_x = 0;\par
849          {\cf19 break};\par
850 \par
851       {\cf19 case} STB_TEXTEDIT_K_REDO:\par
852          stb_text_redo(str, state);\par
853          state->has_preferred_x = 0;\par
854          {\cf19 break};\par
855 \par
856       {\cf19 case} STB_TEXTEDIT_K_LEFT:\par
857          {\cf20 // if currently there's a selection, move cursor to start of selection}\par
858          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
859             stb_textedit_move_to_first(state);\par
860          {\cf19 else}\par
861             {\cf19 if} (state->cursor > 0)\par
862                state->cursor = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, state->cursor);\par
863          state->has_preferred_x = 0;\par
864          {\cf19 break};\par
865 \par
866       {\cf19 case} STB_TEXTEDIT_K_RIGHT:\par
867          {\cf20 // if currently there's a selection, move cursor to end of selection}\par
868          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
869             stb_textedit_move_to_last(str, state);\par
870          {\cf19 else}\par
871             state->cursor = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->cursor);\par
872          stb_textedit_clamp(str, state);\par
873          state->has_preferred_x = 0;\par
874          {\cf19 break};\par
875 \par
876       {\cf19 case} STB_TEXTEDIT_K_LEFT | STB_TEXTEDIT_K_SHIFT:\par
877          stb_textedit_clamp(str, state);\par
878          stb_textedit_prep_selection_at_cursor(state);\par
879          {\cf20 // move selection left}\par
880          {\cf19 if} (state->select_end > 0)\par
881             state->select_end = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, state->select_end);\par
882          state->cursor = state->select_end;\par
883          state->has_preferred_x = 0;\par
884          {\cf19 break};\par
885 \par
886 {\cf21 #ifdef STB_TEXTEDIT_MOVEWORDLEFT}\par
887       {\cf19 case} STB_TEXTEDIT_K_WORDLEFT:\par
888          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
889             stb_textedit_move_to_first(state);\par
890          {\cf19 else} \{\par
891             state->cursor = STB_TEXTEDIT_MOVEWORDLEFT(str, state->cursor);\par
892             stb_textedit_clamp( str, state );\par
893          \}\par
894          {\cf19 break};\par
895 \par
896       {\cf19 case} STB_TEXTEDIT_K_WORDLEFT | STB_TEXTEDIT_K_SHIFT:\par
897          {\cf19 if}( !STB_TEXT_HAS_SELECTION( state ) )\par
898             stb_textedit_prep_selection_at_cursor(state);\par
899 \par
900          state->cursor = STB_TEXTEDIT_MOVEWORDLEFT(str, state->cursor);\par
901          state->select_end = state->cursor;\par
902 \par
903          stb_textedit_clamp( str, state );\par
904          {\cf19 break};\par
905 {\cf21 #endif}\par
906 \par
907 {\cf21 #ifdef STB_TEXTEDIT_MOVEWORDRIGHT}\par
908       {\cf19 case} STB_TEXTEDIT_K_WORDRIGHT:\par
909          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
910             stb_textedit_move_to_last(str, state);\par
911          {\cf19 else} \{\par
912             state->cursor = STB_TEXTEDIT_MOVEWORDRIGHT(str, state->cursor);\par
913             stb_textedit_clamp( str, state );\par
914          \}\par
915          {\cf19 break};\par
916 \par
917       {\cf19 case} STB_TEXTEDIT_K_WORDRIGHT | STB_TEXTEDIT_K_SHIFT:\par
918          {\cf19 if}( !STB_TEXT_HAS_SELECTION( state ) )\par
919             stb_textedit_prep_selection_at_cursor(state);\par
920 \par
921          state->cursor = STB_TEXTEDIT_MOVEWORDRIGHT(str, state->cursor);\par
922          state->select_end = state->cursor;\par
923 \par
924          stb_textedit_clamp( str, state );\par
925          {\cf19 break};\par
926 {\cf21 #endif}\par
927 \par
928       {\cf19 case} STB_TEXTEDIT_K_RIGHT | STB_TEXTEDIT_K_SHIFT:\par
929          stb_textedit_prep_selection_at_cursor(state);\par
930          {\cf20 // move selection right}\par
931          state->select_end = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->select_end);\par
932          stb_textedit_clamp(str, state);\par
933          state->cursor = state->select_end;\par
934          state->has_preferred_x = 0;\par
935          {\cf19 break};\par
936 \par
937       {\cf19 case} STB_TEXTEDIT_K_DOWN:\par
938       {\cf19 case} STB_TEXTEDIT_K_DOWN | STB_TEXTEDIT_K_SHIFT:\par
939       {\cf19 case} STB_TEXTEDIT_K_PGDOWN:\par
940       {\cf19 case} STB_TEXTEDIT_K_PGDOWN | STB_TEXTEDIT_K_SHIFT: \{\par
941          StbFindState find;\par
942          StbTexteditRow row;\par
943          {\cf18 int} i, j, sel = (key & STB_TEXTEDIT_K_SHIFT) != 0;\par
944          {\cf18 int} is_page = (key & ~STB_TEXTEDIT_K_SHIFT) == STB_TEXTEDIT_K_PGDOWN;\par
945          {\cf18 int} row_count = is_page ? state->row_count_per_page : 1;\par
946 \par
947          {\cf19 if} (!is_page && state->single_line) \{\par
948             {\cf20 // on windows, up&down in single-line behave like left&right}\par
949             key = STB_TEXTEDIT_K_RIGHT | (key & STB_TEXTEDIT_K_SHIFT);\par
950             {\cf19 goto} retry;\par
951          \}\par
952 \par
953          {\cf19 if} (sel)\par
954             stb_textedit_prep_selection_at_cursor(state);\par
955          {\cf19 else} {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
956             stb_textedit_move_to_last(str, state);\par
957 \par
958          {\cf20 // compute current position of cursor point}\par
959          stb_textedit_clamp(str, state);\par
960          stb_textedit_find_charpos(&find, str, state->cursor, state->single_line);\par
961 \par
962          {\cf19 for} (j = 0; j < row_count; ++j) \{\par
963             {\cf18 float} x, goal_x = state->has_preferred_x ? state->preferred_x : find.x;\par
964             {\cf18 int} start = find.first_char + find.length;\par
965 \par
966             {\cf19 if} (find.length == 0)\par
967                {\cf19 break};\par
968 \par
969             {\cf20 // [DEAR IMGUI]}\par
970             {\cf20 // going down while being on the last line shouldn't bring us to that line end}\par
971             {\cf20 //if (STB_TEXTEDIT_GETCHAR(str, find.first_char + find.length - 1) != STB_TEXTEDIT_NEWLINE)}\par
972             {\cf20 //   break;}\par
973 \par
974             {\cf20 // now find character position down a row}\par
975             state->cursor = start;\par
976             STB_TEXTEDIT_LAYOUTROW(&row, str, state->cursor);\par
977             x = row.x0;\par
978             {\cf19 for} (i=0; i < row.num_chars; ) \{\par
979                {\cf18 float} dx = STB_TEXTEDIT_GETWIDTH(str, start, i);\par
980                {\cf18 int} next = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->cursor);\par
981 {\cf21                #ifdef IMSTB_TEXTEDIT_GETWIDTH_NEWLINE}\par
982                {\cf19 if} (dx == IMSTB_TEXTEDIT_GETWIDTH_NEWLINE)\par
983                   {\cf19 break};\par
984 {\cf21                #endif}\par
985                x += dx;\par
986                {\cf19 if} (x > goal_x)\par
987                   {\cf19 break};\par
988                i += next - state->cursor;\par
989                state->cursor = next;\par
990             \}\par
991             stb_textedit_clamp(str, state);\par
992 \par
993             {\cf19 if} (state->cursor == find.first_char + find.length)\par
994                str->LastMoveDirectionLR = ImGuiDir_Left;\par
995             state->has_preferred_x = 1;\par
996             state->preferred_x = goal_x;\par
997 \par
998             {\cf19 if} (sel)\par
999                state->select_end = state->cursor;\par
1000 \par
1001             {\cf20 // go to next line}\par
1002             find.first_char = find.first_char + find.length;\par
1003             find.length = row.num_chars;\par
1004          \}\par
1005          {\cf19 break};\par
1006       \}\par
1007 \par
1008       {\cf19 case} STB_TEXTEDIT_K_UP:\par
1009       {\cf19 case} STB_TEXTEDIT_K_UP | STB_TEXTEDIT_K_SHIFT:\par
1010       {\cf19 case} STB_TEXTEDIT_K_PGUP:\par
1011       {\cf19 case} STB_TEXTEDIT_K_PGUP | STB_TEXTEDIT_K_SHIFT: \{\par
1012          StbFindState find;\par
1013          StbTexteditRow row;\par
1014          {\cf18 int} i, j, prev_scan, sel = (key & STB_TEXTEDIT_K_SHIFT) != 0;\par
1015          {\cf18 int} is_page = (key & ~STB_TEXTEDIT_K_SHIFT) == STB_TEXTEDIT_K_PGUP;\par
1016          {\cf18 int} row_count = is_page ? state->row_count_per_page : 1;\par
1017 \par
1018          {\cf19 if} (!is_page && state->single_line) \{\par
1019             {\cf20 // on windows, up&down become left&right}\par
1020             key = STB_TEXTEDIT_K_LEFT | (key & STB_TEXTEDIT_K_SHIFT);\par
1021             {\cf19 goto} retry;\par
1022          \}\par
1023 \par
1024          {\cf19 if} (sel)\par
1025             stb_textedit_prep_selection_at_cursor(state);\par
1026          {\cf19 else} {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
1027             stb_textedit_move_to_first(state);\par
1028 \par
1029          {\cf20 // compute current position of cursor point}\par
1030          stb_textedit_clamp(str, state);\par
1031          stb_textedit_find_charpos(&find, str, state->cursor, state->single_line);\par
1032 \par
1033          {\cf19 for} (j = 0; j < row_count; ++j) \{\par
1034             {\cf18 float}  x, goal_x = state->has_preferred_x ? state->preferred_x : find.x;\par
1035 \par
1036             {\cf20 // can only go up if there's a previous row}\par
1037             {\cf19 if} (find.prev_first == find.first_char)\par
1038                {\cf19 break};\par
1039 \par
1040             {\cf20 // now find character position up a row}\par
1041             state->cursor = find.prev_first;\par
1042             STB_TEXTEDIT_LAYOUTROW(&row, str, state->cursor);\par
1043             x = row.x0;\par
1044             {\cf19 for} (i=0; i < row.num_chars; ) \{\par
1045                {\cf18 float} dx = STB_TEXTEDIT_GETWIDTH(str, find.prev_first, i);\par
1046                {\cf18 int} next = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->cursor);\par
1047 {\cf21                #ifdef IMSTB_TEXTEDIT_GETWIDTH_NEWLINE}\par
1048                {\cf19 if} (dx == IMSTB_TEXTEDIT_GETWIDTH_NEWLINE)\par
1049                   {\cf19 break};\par
1050 {\cf21                #endif}\par
1051                x += dx;\par
1052                {\cf19 if} (x > goal_x)\par
1053                   {\cf19 break};\par
1054                i += next - state->cursor;\par
1055                state->cursor = next;\par
1056             \}\par
1057             stb_textedit_clamp(str, state);\par
1058 \par
1059             {\cf19 if} (state->cursor == find.first_char)\par
1060                str->LastMoveDirectionLR = ImGuiDir_Right;\par
1061             {\cf19 else} {\cf19 if} (state->cursor == find.prev_first)\par
1062                str->LastMoveDirectionLR = ImGuiDir_Left;\par
1063             state->has_preferred_x = 1;\par
1064             state->preferred_x = goal_x;\par
1065 \par
1066             {\cf19 if} (sel)\par
1067                state->select_end = state->cursor;\par
1068 \par
1069             {\cf20 // go to previous line}\par
1070             {\cf20 // (we need to scan previous line the hard way. maybe we could expose this as a new API function?)}\par
1071             prev_scan = find.prev_first > 0 ? find.prev_first - 1 : 0;\par
1072             {\cf19 while} (prev_scan > 0)\par
1073             \{\par
1074                {\cf18 int} prev = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, prev_scan);\par
1075                {\cf19 if} (STB_TEXTEDIT_GETCHAR(str, prev) == STB_TEXTEDIT_NEWLINE)\par
1076                   {\cf19 break};\par
1077                prev_scan = prev;\par
1078             \}\par
1079             find.first_char = find.prev_first;\par
1080             find.prev_first = STB_TEXTEDIT_MOVELINESTART(str, state, prev_scan);\par
1081          \}\par
1082          {\cf19 break};\par
1083       \}\par
1084 \par
1085       {\cf19 case} STB_TEXTEDIT_K_DELETE:\par
1086       {\cf19 case} STB_TEXTEDIT_K_DELETE | STB_TEXTEDIT_K_SHIFT:\par
1087          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
1088             stb_textedit_delete_selection(str, state);\par
1089          {\cf19 else} \{\par
1090             {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
1091             {\cf19 if} (state->cursor < n)\par
1092                stb_textedit_delete(str, state, state->cursor, IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->cursor) - state->cursor);\par
1093          \}\par
1094          state->has_preferred_x = 0;\par
1095          {\cf19 break};\par
1096 \par
1097       {\cf19 case} STB_TEXTEDIT_K_BACKSPACE:\par
1098       {\cf19 case} STB_TEXTEDIT_K_BACKSPACE | STB_TEXTEDIT_K_SHIFT:\par
1099          {\cf19 if} (STB_TEXT_HAS_SELECTION(state))\par
1100             stb_textedit_delete_selection(str, state);\par
1101          {\cf19 else} \{\par
1102             stb_textedit_clamp(str, state);\par
1103             {\cf19 if} (state->cursor > 0) \{\par
1104                {\cf18 int} prev = IMSTB_TEXTEDIT_GETPREVCHARINDEX(str, state->cursor);\par
1105                stb_textedit_delete(str, state, prev, state->cursor - prev);\par
1106                state->cursor = prev;\par
1107             \}\par
1108          \}\par
1109          state->has_preferred_x = 0;\par
1110          {\cf19 break};\par
1111 \par
1112 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTSTART2}\par
1113       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART2:\par
1114 {\cf21 #endif}\par
1115       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART:\par
1116          state->cursor = state->select_start = state->select_end = 0;\par
1117          state->has_preferred_x = 0;\par
1118          {\cf19 break};\par
1119 \par
1120 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTEND2}\par
1121       {\cf19 case} STB_TEXTEDIT_K_TEXTEND2:\par
1122 {\cf21 #endif}\par
1123       {\cf19 case} STB_TEXTEDIT_K_TEXTEND:\par
1124          state->cursor = STB_TEXTEDIT_STRINGLEN(str);\par
1125          state->select_start = state->select_end = 0;\par
1126          state->has_preferred_x = 0;\par
1127          {\cf19 break};\par
1128 \par
1129 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTSTART2}\par
1130       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART2 | STB_TEXTEDIT_K_SHIFT:\par
1131 {\cf21 #endif}\par
1132       {\cf19 case} STB_TEXTEDIT_K_TEXTSTART | STB_TEXTEDIT_K_SHIFT:\par
1133          stb_textedit_prep_selection_at_cursor(state);\par
1134          state->cursor = state->select_end = 0;\par
1135          state->has_preferred_x = 0;\par
1136          {\cf19 break};\par
1137 \par
1138 {\cf21 #ifdef STB_TEXTEDIT_K_TEXTEND2}\par
1139       {\cf19 case} STB_TEXTEDIT_K_TEXTEND2 | STB_TEXTEDIT_K_SHIFT:\par
1140 {\cf21 #endif}\par
1141       {\cf19 case} STB_TEXTEDIT_K_TEXTEND | STB_TEXTEDIT_K_SHIFT:\par
1142          stb_textedit_prep_selection_at_cursor(state);\par
1143          state->cursor = state->select_end = STB_TEXTEDIT_STRINGLEN(str);\par
1144          state->has_preferred_x = 0;\par
1145          {\cf19 break};\par
1146 \par
1147 \par
1148 {\cf21 #ifdef STB_TEXTEDIT_K_LINESTART2}\par
1149       {\cf19 case} STB_TEXTEDIT_K_LINESTART2:\par
1150 {\cf21 #endif}\par
1151       {\cf19 case} STB_TEXTEDIT_K_LINESTART:\par
1152          stb_textedit_clamp(str, state);\par
1153          stb_textedit_move_to_first(state);\par
1154          state->cursor = STB_TEXTEDIT_MOVELINESTART(str, state, state->cursor);\par
1155          state->has_preferred_x = 0;\par
1156          {\cf19 break};\par
1157 \par
1158 {\cf21 #ifdef STB_TEXTEDIT_K_LINEEND2}\par
1159       {\cf19 case} STB_TEXTEDIT_K_LINEEND2:\par
1160 {\cf21 #endif}\par
1161       {\cf19 case} STB_TEXTEDIT_K_LINEEND: \{\par
1162          stb_textedit_clamp(str, state);\par
1163          stb_textedit_move_to_last(str, state);\par
1164          state->cursor = STB_TEXTEDIT_MOVELINEEND(str, state, state->cursor);\par
1165          state->has_preferred_x = 0;\par
1166          {\cf19 break};\par
1167       \}\par
1168 \par
1169 {\cf21 #ifdef STB_TEXTEDIT_K_LINESTART2}\par
1170       {\cf19 case} STB_TEXTEDIT_K_LINESTART2 | STB_TEXTEDIT_K_SHIFT:\par
1171 {\cf21 #endif}\par
1172       {\cf19 case} STB_TEXTEDIT_K_LINESTART | STB_TEXTEDIT_K_SHIFT:\par
1173          stb_textedit_clamp(str, state);\par
1174          stb_textedit_prep_selection_at_cursor(state);\par
1175          state->cursor = STB_TEXTEDIT_MOVELINESTART(str, state, state->cursor);\par
1176          state->select_end = state->cursor;\par
1177          state->has_preferred_x = 0;\par
1178          {\cf19 break};\par
1179 \par
1180 {\cf21 #ifdef STB_TEXTEDIT_K_LINEEND2}\par
1181       {\cf19 case} STB_TEXTEDIT_K_LINEEND2 | STB_TEXTEDIT_K_SHIFT:\par
1182 {\cf21 #endif}\par
1183       {\cf19 case} STB_TEXTEDIT_K_LINEEND | STB_TEXTEDIT_K_SHIFT: \{\par
1184          stb_textedit_clamp(str, state);\par
1185          stb_textedit_prep_selection_at_cursor(state);\par
1186          state->cursor = STB_TEXTEDIT_MOVELINEEND(str, state, state->cursor);\par
1187          state->select_end = state->cursor;\par
1188          state->has_preferred_x = 0;\par
1189          {\cf19 break};\par
1190       \}\par
1191    \}\par
1192 \}\par
