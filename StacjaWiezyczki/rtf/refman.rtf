1138 {\cf17 static} stbtt_uint8 stbtt__buf_get8(stbtt__buf *b)\par
1139 \{\par
1140    {\cf19 if} (b->cursor >= b->size)\par
1141       {\cf19 return} 0;\par
1142    {\cf19 return} b->data[b->cursor++];\par
1143 \}\par
1144 \par
1145 {\cf17 static} stbtt_uint8 stbtt__buf_peek8(stbtt__buf *b)\par
1146 \{\par
1147    {\cf19 if} (b->cursor >= b->size)\par
1148       {\cf19 return} 0;\par
1149    {\cf19 return} b->data[b->cursor];\par
1150 \}\par
1151 \par
1152 {\cf17 static} {\cf18 void} stbtt__buf_seek(stbtt__buf *b, {\cf18 int} o)\par
1153 \{\par
1154    STBTT_assert(!(o > b->size || o < 0));\par
1155    b->cursor = (o > b->size || o < 0) ? b->size : o;\par
1156 \}\par
1157 \par
1158 {\cf17 static} {\cf18 void} stbtt__buf_skip(stbtt__buf *b, {\cf18 int} o)\par
1159 \{\par
1160    stbtt__buf_seek(b, b->cursor + o);\par
1161 \}\par
1162 \par
1163 {\cf17 static} stbtt_uint32 stbtt__buf_get(stbtt__buf *b, {\cf18 int} n)\par
1164 \{\par
1165    stbtt_uint32 v = 0;\par
1166    {\cf18 int} i;\par
1167    STBTT_assert(n >= 1 && n <= 4);\par
1168    {\cf19 for} (i = 0; i < n; i++)\par
1169       v = (v << 8) | stbtt__buf_get8(b);\par
1170    {\cf19 return} v;\par
1171 \}\par
1172 \par
1173 {\cf17 static} stbtt__buf stbtt__new_buf({\cf17 const} {\cf18 void} *p, {\cf18 size_t} size)\par
1174 \{\par
1175    stbtt__buf r;\par
1176    STBTT_assert(size < 0x40000000);\par
1177    r.data = (stbtt_uint8*) p;\par
1178    r.size = (int) size;\par
1179    r.cursor = 0;\par
1180    {\cf19 return} r;\par
1181 \}\par
1182 \par
1183 {\cf21 #define stbtt__buf_get16(b)  stbtt__buf_get((b), 2)}\par
1184 {\cf21 #define stbtt__buf_get32(b)  stbtt__buf_get((b), 4)}\par
1185 \par
1186 {\cf17 static} stbtt__buf stbtt__buf_range({\cf17 const} stbtt__buf *b, {\cf18 int} o, {\cf18 int} s)\par
1187 \{\par
1188    stbtt__buf r = stbtt__new_buf(NULL, 0);\par
1189    {\cf19 if} (o < 0 || s < 0 || o > b->size || s > b->size - o) {\cf19 return} r;\par
1190    r.data = b->data + o;\par
1191    r.size = s;\par
1192    {\cf19 return} r;\par
1193 \}\par
1194 \par
1195 {\cf17 static} stbtt__buf stbtt__cff_get_index(stbtt__buf *b)\par
1196 \{\par
1197    {\cf18 int} count, start, offsize;\par
1198    start = b->cursor;\par
1199    count = stbtt__buf_get16(b);\par
1200    {\cf19 if} (count) \{\par
1201       offsize = stbtt__buf_get8(b);\par
1202       STBTT_assert(offsize >= 1 && offsize <= 4);\par
1203       stbtt__buf_skip(b, offsize * count);\par
1204       stbtt__buf_skip(b, stbtt__buf_get(b, offsize) - 1);\par
1205    \}\par
1206    {\cf19 return} stbtt__buf_range(b, start, b->cursor - start);\par
1207 \}\par
1208 \par
1209 {\cf17 static} stbtt_uint32 stbtt__cff_int(stbtt__buf *b)\par
1210 \{\par
1211    {\cf18 int} b0 = stbtt__buf_get8(b);\par
1212    {\cf19 if} (b0 >= 32 && b0 <= 246)       {\cf19 return} b0 - 139;\par
1213    {\cf19 else} {\cf19 if} (b0 >= 247 && b0 <= 250) {\cf19 return} (b0 - 247)*256 + stbtt__buf_get8(b) + 108;\par
1214    {\cf19 else} {\cf19 if} (b0 >= 251 && b0 <= 254) {\cf19 return} -(b0 - 251)*256 - stbtt__buf_get8(b) - 108;\par
1215    {\cf19 else} {\cf19 if} (b0 == 28)               {\cf19 return} stbtt__buf_get16(b);\par
1216    {\cf19 else} {\cf19 if} (b0 == 29)               {\cf19 return} stbtt__buf_get32(b);\par
1217    STBTT_assert(0);\par
1218    {\cf19 return} 0;\par
1219 \}\par
1220 \par
1221 {\cf17 static} {\cf18 void} stbtt__cff_skip_operand(stbtt__buf *b) \{\par
1222    {\cf18 int} v, b0 = stbtt__buf_peek8(b);\par
1223    STBTT_assert(b0 >= 28);\par
1224    {\cf19 if} (b0 == 30) \{\par
1225       stbtt__buf_skip(b, 1);\par
1226       {\cf19 while} (b->cursor < b->size) \{\par
1227          v = stbtt__buf_get8(b);\par
1228          {\cf19 if} ((v & 0xF) == 0xF || (v >> 4) == 0xF)\par
1229             {\cf19 break};\par
1230       \}\par
1231    \} {\cf19 else} \{\par
1232       stbtt__cff_int(b);\par
1233    \}\par
1234 \}\par
1235 \par
1236 {\cf17 static} stbtt__buf stbtt__dict_get(stbtt__buf *b, {\cf18 int} key)\par
1237 \{\par
1238    stbtt__buf_seek(b, 0);\par
1239    {\cf19 while} (b->cursor < b->size) \{\par
1240       {\cf18 int} start = b->cursor, end, op;\par
1241       {\cf19 while} (stbtt__buf_peek8(b) >= 28)\par
1242          stbtt__cff_skip_operand(b);\par
1243       end = b->cursor;\par
1244       op = stbtt__buf_get8(b);\par
1245       {\cf19 if} (op == 12)  op = stbtt__buf_get8(b) | 0x100;\par
1246       {\cf19 if} (op == key) {\cf19 return} stbtt__buf_range(b, start, end-start);\par
1247    \}\par
1248    {\cf19 return} stbtt__buf_range(b, 0, 0);\par
1249 \}\par
