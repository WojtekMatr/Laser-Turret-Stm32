3942 {\cf20 // - Currently represents the Platform Window created by the application which is hosting our Dear ImGui windows.}\par
3943 {\cf20 // - In 'docking' branch with multi-viewport enabled, we extend this concept to have multiple active viewports.}\par
3944 {\cf20 // - In the future we will extend this concept further to also represent Platform Monitor and support a "no main platform window" operation mode.}\par
3945 {\cf20 // - About Main Area vs Work Area:}\par
3946 {\cf20 //   - Main Area = entire viewport.}\par
3947 {\cf20 //   - Work Area = entire viewport minus sections used by main menu bars (for platform windows), or by task bar (for platform monitor).}\par
3948 {\cf20 //   - Windows are generally trying to stay within the Work Area of their host viewport.}\par
3949 {\cf17 struct }ImGuiViewport\par
3950 \{\par
3951     ImGuiID             ID;                     {\cf20 // Unique identifier for the viewport}\par
3952     ImGuiViewportFlags  Flags;                  {\cf20 // See ImGuiViewportFlags_}\par
3953     ImVec2              Pos;                    {\cf20 // Main Area: Position of the viewport (Dear ImGui coordinates are the same as OS desktop/native coordinates)}\par
3954     ImVec2              Size;                   {\cf20 // Main Area: Size of the viewport.}\par
3955     ImVec2              FramebufferScale;       {\cf20 // Density of the viewport for Retina display (always 1,1 on Windows, may be 2,2 etc on macOS/iOS). This will affect font rasterizer density.}\par
3956     ImVec2              WorkPos;                {\cf20 // Work Area: Position of the viewport minus task bars, menus bars, status bars (>= Pos)}\par
3957     ImVec2              WorkSize;               {\cf20 // Work Area: Size of the viewport minus task bars, menu bars, status bars (<= Size)}\par
3958 \par
3959     {\cf20 // Platform/Backend Dependent Data}\par
3960     {\cf18 void}*               PlatformHandle;         {\cf20 // void* to hold higher-level, platform window handle (e.g. HWND, GLFWWindow*, SDL_Window*)}\par
3961     {\cf18 void}*               PlatformHandleRaw;      {\cf20 // void* to hold lower-level, platform-native window handle (under Win32 this is expected to be a HWND, unused for other platforms)}\par
3962 \par
3963     ImGuiViewport()     \{ memset(({\cf18 void}*){\cf17 this}, 0, {\cf17 sizeof}(*{\cf17 this})); \}\par
