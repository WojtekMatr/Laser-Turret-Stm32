3583 {\cf17 static} {\cf18 void} stbtt__tesselate_cubic(stbtt__point *points, {\cf18 int} *num_points, {\cf18 float} x0, {\cf18 float} y0, {\cf18 float} x1, {\cf18 float} y1, {\cf18 float} x2, {\cf18 float} y2, {\cf18 float} x3, {\cf18 float} y3, {\cf18 float} objspace_flatness_squared, {\cf18 int} n)\par
3584 \{\par
3585    {\cf20 // @TODO this "flatness" calculation is just made-up nonsense that seems to work well enough}\par
3586    {\cf18 float} dx0 = x1-x0;\par
3587    {\cf18 float} dy0 = y1-y0;\par
3588    {\cf18 float} dx1 = x2-x1;\par
3589    {\cf18 float} dy1 = y2-y1;\par
3590    {\cf18 float} dx2 = x3-x2;\par
3591    {\cf18 float} dy2 = y3-y2;\par
3592    {\cf18 float} dx = x3-x0;\par
3593    {\cf18 float} dy = y3-y0;\par
3594    {\cf18 float} longlen = (float) (STBTT_sqrt(dx0*dx0+dy0*dy0)+STBTT_sqrt(dx1*dx1+dy1*dy1)+STBTT_sqrt(dx2*dx2+dy2*dy2));\par
3595    {\cf18 float} shortlen = (float) STBTT_sqrt(dx*dx+dy*dy);\par
3596    {\cf18 float} flatness_squared = longlen*longlen-shortlen*shortlen;\par
3597 \par
3598    {\cf19 if} (n > 16) {\cf20 // 65536 segments on one curve better be enough!}\par
3599       {\cf19 return};\par
3600 \par
3601    {\cf19 if} (flatness_squared > objspace_flatness_squared) \{\par
3602       {\cf18 float} x01 = (x0+x1)/2;\par
3603       {\cf18 float} y01 = (y0+y1)/2;\par
3604       {\cf18 float} x12 = (x1+x2)/2;\par
3605       {\cf18 float} y12 = (y1+y2)/2;\par
3606       {\cf18 float} x23 = (x2+x3)/2;\par
3607       {\cf18 float} y23 = (y2+y3)/2;\par
3608 \par
3609       {\cf18 float} xa = (x01+x12)/2;\par
3610       {\cf18 float} ya = (y01+y12)/2;\par
3611       {\cf18 float} xb = (x12+x23)/2;\par
3612       {\cf18 float} yb = (y12+y23)/2;\par
3613 \par
3614       {\cf18 float} mx = (xa+xb)/2;\par
3615       {\cf18 float} my = (ya+yb)/2;\par
3616 \par
3617       stbtt__tesselate_cubic(points, num_points, x0,y0, x01,y01, xa,ya, mx,my, objspace_flatness_squared,n+1);\par
3618       stbtt__tesselate_cubic(points, num_points, mx,my, xb,yb, x23,y23, x3,y3, objspace_flatness_squared,n+1);\par
3619    \} {\cf19 else} \{\par
3620       stbtt__add_point(points, *num_points,x3,y3);\par
3621       *num_points = *num_points+1;\par
3622    \}\par
3623 \}\par
