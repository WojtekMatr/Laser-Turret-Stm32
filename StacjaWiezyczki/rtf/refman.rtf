1224     ImGuiChildFlags_AlwaysAutoResize        = 1 << 6,   {\cf20 // Combined with AutoResizeX/AutoResizeY. Always measure size even when child is hidden, always return true, always disable clipping optimization! NOT RECOMMENDED.}\par
