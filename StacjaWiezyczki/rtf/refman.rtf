1622       g2 = info->glyf + ttULONG (info->data + info->loca + glyph_index * 4 + 4);\par
1623    \}\par
1624 \par
1625    {\cf19 return} g1==g2 ? -1 : g1; {\cf20 // if length is 0, return -1}\par
1626 \}\par
