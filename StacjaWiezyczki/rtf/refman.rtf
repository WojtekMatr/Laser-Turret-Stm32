2516    lookupListOffset = ttUSHORT(data+8);\par
2517    lookupList = data + lookupListOffset;\par
2518    lookupCount = ttUSHORT(lookupList);\par
2519 \par
2520    {\cf19 for} (i=0; i<lookupCount; ++i) \{\par
2521       stbtt_uint16 lookupOffset = ttUSHORT(lookupList + 2 + 2 * i);\par
2522       stbtt_uint8 *lookupTable = lookupList + lookupOffset;\par
2523 \par
2524       stbtt_uint16 lookupType = ttUSHORT(lookupTable);\par
2525       stbtt_uint16 subTableCount = ttUSHORT(lookupTable + 4);\par
2526       stbtt_uint8 *subTableOffsets = lookupTable + 6;\par
