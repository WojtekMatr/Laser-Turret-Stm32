2630 {\cf20 // Shared state of InputText(), passed as an argument to your callback when a ImGuiInputTextFlags_Callback* flag is used.}\par
2631 {\cf20 // The callback function should return 0 by default.}\par
2632 {\cf20 // Callbacks (follow a flag name and see comments in ImGuiInputTextFlags_ declarations for more details)}\par
2633 {\cf20 // - ImGuiInputTextFlags_CallbackEdit:        Callback on buffer edit. Note that InputText() already returns true on edit + you can always use IsItemEdited(). The callback is useful to manipulate the underlying buffer while focus is active.}\par
2634 {\cf20 // - ImGuiInputTextFlags_CallbackAlways:      Callback on each iteration}\par
2635 {\cf20 // - ImGuiInputTextFlags_CallbackCompletion:  Callback on pressing TAB}\par
2636 {\cf20 // - ImGuiInputTextFlags_CallbackHistory:     Callback on pressing Up/Down arrows}\par
2637 {\cf20 // - ImGuiInputTextFlags_CallbackCharFilter:  Callback on character inputs to replace or discard them. Modify 'EventChar' to replace or discard, or return 1 in callback to discard.}\par
2638 {\cf20 // - ImGuiInputTextFlags_CallbackResize:      Callback on buffer capacity changes request (beyond 'buf_size' parameter value), allowing the string to grow.}\par
2639 {\cf17 struct }ImGuiInputTextCallbackData\par
2640 \{\par
2641     ImGuiContext*       Ctx;            {\cf20 // Parent UI context}\par
2642     ImGuiInputTextFlags EventFlag;      {\cf20 // One ImGuiInputTextFlags_Callback*    // Read-only}\par
2643     ImGuiInputTextFlags Flags;          {\cf20 // What user passed to InputText()      // Read-only}\par
2644     {\cf18 void}*               UserData;       {\cf20 // What user passed to InputText()      // Read-only}\par
2645     ImGuiID             ID;             {\cf20 // Widget ID                             // Read-only}\par
2646 \par
2647     {\cf20 // Arguments for the different callback events}\par
2648     {\cf20 // - During Resize callback, Buf will be same as your input buffer.}\par
2649     {\cf20 // - However, during Completion/History/Always callback, Buf always points to our own internal data (it is not the same as your buffer)! Changes to it will be reflected into your own buffer shortly after the callback.}\par
2650     {\cf20 // - To modify the text buffer in a callback, prefer using the InsertChars() / DeleteChars() function. InsertChars() will take care of calling the resize callback if necessary.}\par
2651     {\cf20 // - If you know your edits are not going to resize the underlying buffer allocation, you may modify the contents of 'Buf[]' directly. You need to update 'BufTextLen' accordingly (0 <= BufTextLen < BufSize) and set 'BufDirty'' to true so InputText can update its internal state.}\par
2652     ImGuiKey            EventKey;       {\cf20 // Key pressed (Up/Down/TAB)            // Read-only    // [Completion,History]}\par
2653     ImWchar             EventChar;      {\cf20 // Character input                      // Read-write   // [CharFilter] Replace character with another one, or set to zero to drop. return 1 is equivalent to setting EventChar=0;}\par
2654     {\cf18 bool}                EventActivated; {\cf20 // Input field just got activated       // Read-only    // [Always]}\par
2655     {\cf18 bool}                BufDirty;       {\cf20 // Set if you modify Buf/BufTextLen!    // Write        // [Completion,History,Always]}\par
2656     {\cf18 char}*               Buf;            {\cf20 // Text buffer                          // Read-write   // [Resize] Can replace pointer / [Completion,History,Always] Only write to pointed data, don't replace the actual pointer!}\par
2657     {\cf18 int}                 BufTextLen;     {\cf20 // Text length (in bytes)               // Read-write   // [Resize,Completion,History,Always] Exclude zero-terminator storage. In C land: == strlen(some_text), in C++ land: string.length()}\par
2658     {\cf18 int}                 BufSize;        {\cf20 // Buffer size (in bytes) = capacity+1  // Read-only    // [Resize,Completion,History,Always] Include zero-terminator storage. In C land: == ARRAYSIZE(my_char_array), in C++ land: string.capacity()+1}\par
2659     {\cf18 int}                 CursorPos;      {\cf20 //                                      // Read-write   // [Completion,History,Always]}\par
2660     {\cf18 int}                 SelectionStart; {\cf20 //                                      // Read-write   // [Completion,History,Always] == to SelectionEnd when no selection}\par
2661     {\cf18 int}                 SelectionEnd;   {\cf20 //                                      // Read-write   // [Completion,History,Always]}\par
