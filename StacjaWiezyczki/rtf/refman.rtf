243 {\cf20 // Debug Logging for ShowDebugLogWindow(). This is designed for relatively rare events so please don't spam.}\par
244 {\cf21 #define IMGUI_DEBUG_LOG_ERROR(...)      do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventError)       IMGUI_DEBUG_LOG(__VA_ARGS__); else g.DebugLogSkippedErrors++; \} while (0)}\par
245 {\cf21 #define IMGUI_DEBUG_LOG_ACTIVEID(...)   do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventActiveId)    IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
246 {\cf21 #define IMGUI_DEBUG_LOG_FOCUS(...)      do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventFocus)       IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
247 {\cf21 #define IMGUI_DEBUG_LOG_POPUP(...)      do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventPopup)       IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
248 {\cf21 #define IMGUI_DEBUG_LOG_NAV(...)        do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventNav)         IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
249 {\cf21 #define IMGUI_DEBUG_LOG_SELECTION(...)  do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventSelection)   IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
250 {\cf21 #define IMGUI_DEBUG_LOG_CLIPPER(...)    do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper)     IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
251 {\cf21 #define IMGUI_DEBUG_LOG_IO(...)         do \{ if (g.DebugLogFlags & ImGuiDebugLogFlags_EventIO)          IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
252 {\cf21 #define IMGUI_DEBUG_LOG_FONT(...)       do \{ ImGuiContext* g2 = GImGui; if (g2 && g2->DebugLogFlags & ImGuiDebugLogFlags_EventFont) IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0) }{\cf20 // Called from ImFontAtlas function which may operate without a context.}\par
253 {\cf21 #define IMGUI_DEBUG_LOG_INPUTROUTING(...) do\{if (g.DebugLogFlags & ImGuiDebugLogFlags_EventInputRouting)IMGUI_DEBUG_LOG(__VA_ARGS__); \} while (0)}\par
