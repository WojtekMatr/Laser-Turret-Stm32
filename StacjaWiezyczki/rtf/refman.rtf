515 {\cf17 inline} ImVec2 ImMax({\cf17 const} ImVec2& lhs, {\cf17 const} ImVec2& rhs)               \{ {\cf19 return} ImVec2(lhs.x >= rhs.x ? lhs.x : rhs.x, lhs.y >= rhs.y ? lhs.y : rhs.y); \}\par
516 {\cf17 inline} ImVec2 ImClamp({\cf17 const} ImVec2& v, {\cf17 const} ImVec2&mn, {\cf17 const} ImVec2&mx)\{ {\cf19 return} ImVec2((v.x < mn.x) ? mn.x : (v.x > mx.x) ? mx.x : v.x, (v.y < mn.y) ? mn.y : (v.y > mx.y) ? mx.y : v.y); \}\par
517 {\cf17 inline} ImVec2 ImLerp({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf18 float} t)         \{ {\cf19 return} ImVec2(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t); \}\par
518 {\cf17 inline} ImVec2 ImLerp({\cf17 const} ImVec2& a, {\cf17 const} ImVec2& b, {\cf17 const} ImVec2& t) \{ {\cf19 return} ImVec2(a.x + (b.x - a.x) * t.x, a.y + (b.y - a.y) * t.y); \}\par
519 {\cf17 inline} ImVec4 ImLerp({\cf17 const} ImVec4& a, {\cf17 const} ImVec4& b, {\cf18 float} t)         \{ {\cf19 return} ImVec4(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t, a.w + (b.w - a.w) * t); \}\par
520 {\cf17 inline} {\cf18 float}  ImSaturate({\cf18 float} f)                                       \{ {\cf19 return} (f < 0.0f) ? 0.0f : (f > 1.0f) ? 1.0f : f; \}\par
521 {\cf17 inline} {\cf18 float}  ImLengthSqr({\cf17 const} ImVec2& lhs)                            \{ {\cf19 return} (lhs.x * lhs.x) + (lhs.y * lhs.y); \}\par
522 {\cf17 inline} {\cf18 float}  ImLengthSqr({\cf17 const} ImVec4& lhs)                            \{ {\cf19 return} (lhs.x * lhs.x) + (lhs.y * lhs.y) + (lhs.z * lhs.z) + (lhs.w * lhs.w); \}\par
523 {\cf17 inline} {\cf18 float}  ImInvLength({\cf17 const} ImVec2& lhs, {\cf18 float} fail_value)          \{ {\cf18 float} d = (lhs.x * lhs.x) + (lhs.y * lhs.y); {\cf19 if} (d > 0.0f) {\cf19 return} ImRsqrt(d); {\cf19 return} fail_value; \}\par
