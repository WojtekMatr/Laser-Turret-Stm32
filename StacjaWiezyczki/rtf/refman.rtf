\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 1 {\cf20 // dear imgui: Platform Backend for Windows (standard windows API for 32-bits AND 64-bits applications)}\par
2 {\cf20 // This needs to be used along with a Renderer (e.g. DirectX11, OpenGL3, Vulkan..)}\par
3 \par
4 {\cf20 // Implemented features:}\par
5 {\cf20 //  [X] Platform: Clipboard support (for Win32 this is actually part of core dear imgui)}\par
6 {\cf20 //  [X] Platform: Mouse support. Can discriminate Mouse/TouchScreen/Pen.}\par
7 {\cf20 //  [X] Platform: Keyboard support. Since 1.87 we are using the io.AddKeyEvent() function. Pass ImGuiKey values to all key functions e.g. ImGui::IsKeyPressed(ImGuiKey_Space). [Legacy VK_* values are obsolete since 1.87 and not supported since 1.91.5]}\par
8 {\cf20 //  [X] Platform: Gamepad support.}\par
9 {\cf20 //  [X] Platform: Mouse cursor shape and visibility (ImGuiBackendFlags_HasMouseCursors). Disable with 'io.ConfigFlags |= ImGuiConfigFlags_NoMouseCursorChange'.}\par
10 \par
11 {\cf20 // You can use unmodified imgui_impl_* files in your project. See examples/ folder for examples of using this.}\par
12 {\cf20 // Prefer including the entire imgui/ repository into your project (either as a copy or as a submodule), and only build the backends you need.}\par
13 {\cf20 // Learn about Dear ImGui:}\par
14 {\cf20 // - FAQ                  https://dearimgui.com/faq}\par
15 {\cf20 // - Getting Started      https://dearimgui.com/getting-started}\par
16 {\cf20 // - Documentation        https://dearimgui.com/docs (same as your local docs/ folder).}\par
17 {\cf20 // - Introduction, links and more at the top of imgui.cpp}\par
18 \par
19 {\cf21 #pragma once}\par
20 {\cf21 #include "imgui.h"}      {\cf20 // IMGUI_IMPL_API}\par
21 {\cf21 #ifndef IMGUI_DISABLE}\par
22 \par
23 {\cf20 // Follow "Getting Started" link and check examples/ folder to learn about using backends!}\par
24 IMGUI_IMPL_API {\cf18 bool}     ImGui_ImplWin32_Init({\cf18 void}* hwnd);\par
25 IMGUI_IMPL_API {\cf18 bool}     ImGui_ImplWin32_InitForOpenGL({\cf18 void}* hwnd);\par
26 IMGUI_IMPL_API {\cf18 void}     ImGui_ImplWin32_Shutdown();\par
27 IMGUI_IMPL_API {\cf18 void}     ImGui_ImplWin32_NewFrame();\par
28 \par
29 {\cf20 // Win32 message handler your application needs to call.}\par
30 {\cf20 // - Intentionally commented out in a '#if 0' block to avoid dragging dependencies on <windows.h> from this helper.}\par
