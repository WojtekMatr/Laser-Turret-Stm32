549 {\cf17 static} {\cf18 void} stb_text_makeundo_delete(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length);\par
550 {\cf17 static} {\cf18 void} stb_text_makeundo_insert(STB_TexteditState *state, {\cf18 int} where, {\cf18 int} length);\par
551 {\cf17 static} {\cf18 void} stb_text_makeundo_replace(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} old_length, {\cf18 int} new_length);\par
552 \par
553 {\cf17 typedef} {\cf17 struct}\par
554 \{\par
555    {\cf18 float} x,y;    {\cf20 // position of n'th character}\par
556    {\cf18 float} height; {\cf20 // height of line}\par
557    {\cf18 int} first_char, length; {\cf20 // first char of row, and length}\par
558    {\cf18 int} prev_first;  {\cf20 // first char of previous row}\par
559 \} StbFindState;\par
560 \par
561 {\cf20 // find the x/y location of a character, and remember info about the previous row in}\par
562 {\cf20 // case we get a move-up event (for page up, we'll have to rescan)}\par
563 {\cf17 static} {\cf18 void} stb_textedit_find_charpos(StbFindState *find, IMSTB_TEXTEDIT_STRING *str, {\cf18 int} n, {\cf18 int} single_line)\par
564 \{\par
565    StbTexteditRow r;\par
566    {\cf18 int} prev_start = 0;\par
567    {\cf18 int} z = STB_TEXTEDIT_STRINGLEN(str);\par
568    {\cf18 int} i=0, first;\par
569 \par
570    {\cf19 if} (n == z && single_line) \{\par
571       {\cf20 // special case if it's at the end (may not be needed?)}\par
572       STB_TEXTEDIT_LAYOUTROW(&r, str, 0);\par
573       find->y = 0;\par
574       find->first_char = 0;\par
575       find->length = z;\par
576       find->height = r.ymax - r.ymin;\par
577       find->x = r.x1;\par
578       {\cf19 return};\par
579    \}\par
580 \par
581    {\cf20 // search rows to find the one that straddles character n}\par
582    find->y = 0;\par
583 \par
584    {\cf19 for}(;;) \{\par
585       STB_TEXTEDIT_LAYOUTROW(&r, str, i);\par
586       {\cf19 if} (n < i + r.num_chars)\par
587          {\cf19 break};\par
588       {\cf19 if} (str->LastMoveDirectionLR == ImGuiDir_Right && str->Stb->cursor > 0 && str->Stb->cursor == i + r.num_chars && STB_TEXTEDIT_GETCHAR(str, i + r.num_chars - 1) != STB_TEXTEDIT_NEWLINE) {\cf20 // [DEAR IMGUI] Wrapping point handling}\par
589          {\cf19 break};\par
590       {\cf19 if} (i + r.num_chars == z && z > 0 && STB_TEXTEDIT_GETCHAR(str, z - 1) != STB_TEXTEDIT_NEWLINE)  {\cf20 // [DEAR IMGUI] special handling for last line}\par
591          {\cf19 break};   {\cf20 // [DEAR IMGUI]}\par
592       prev_start = i;\par
593       i += r.num_chars;\par
594       find->y += r.baseline_y_delta;\par
595       {\cf19 if} (i == z) {\cf20 // [DEAR IMGUI]}\par
596       \{\par
597          r.num_chars = 0; {\cf20 // [DEAR IMGUI]}\par
598          {\cf19 break};   {\cf20 // [DEAR IMGUI]}\par
599       \}\par
600    \}\par
601 \par
602    find->first_char = first = i;\par
603    find->length = r.num_chars;\par
604    find->height = r.ymax - r.ymin;\par
605    find->prev_first = prev_start;\par
606 \par
607    {\cf20 // now scan to find xpos}\par
608    find->x = r.x0;\par
609    {\cf19 for} (i=0; first+i < n; i = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, first + i) - first)\par
610       find->x += STB_TEXTEDIT_GETWIDTH(str, first, i);\par
611 \}\par
612 \par
613 {\cf21 #define STB_TEXT_HAS_SELECTION(s)   ((s)->select_start != (s)->select_end)}\par
614 \par
615 {\cf20 // make the selection/cursor state valid if client altered the string}\par
616 {\cf17 static} {\cf18 void} stb_textedit_clamp(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
617 \{\par
618    {\cf18 int} n = STB_TEXTEDIT_STRINGLEN(str);\par
619    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
620       {\cf19 if} (state->select_start > n) state->select_start = n;\par
621       {\cf19 if} (state->select_end   > n) state->select_end = n;\par
622       {\cf20 // if clamping forced them to be equal, move the cursor to match}\par
623       {\cf19 if} (state->select_start == state->select_end)\par
624          state->cursor = state->select_start;\par
625    \}\par
626    {\cf19 if} (state->cursor > n) state->cursor = n;\par
627 \}\par
628 \par
629 {\cf20 // delete characters while updating undo}\par
630 {\cf17 static} {\cf18 void} stb_textedit_delete(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state, {\cf18 int} where, {\cf18 int} len)\par
631 \{\par
632    stb_text_makeundo_delete(str, state, where, len);\par
633    STB_TEXTEDIT_DELETECHARS(str, where, len);\par
634    state->has_preferred_x = 0;\par
635 \}\par
636 \par
637 {\cf20 // delete the section}\par
638 {\cf17 static} {\cf18 void} stb_textedit_delete_selection(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
639 \{\par
640    stb_textedit_clamp(str, state);\par
641    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
642       {\cf19 if} (state->select_start < state->select_end) \{\par
643          stb_textedit_delete(str, state, state->select_start, state->select_end - state->select_start);\par
644          state->select_end = state->cursor = state->select_start;\par
645       \} {\cf19 else} \{\par
646          stb_textedit_delete(str, state, state->select_end, state->select_start - state->select_end);\par
647          state->select_start = state->cursor = state->select_end;\par
648       \}\par
649       state->has_preferred_x = 0;\par
650    \}\par
651 \}\par
652 \par
653 {\cf20 // canoncialize the selection so start <= end}\par
654 {\cf17 static} {\cf18 void} stb_textedit_sortselection(STB_TexteditState *state)\par
655 \{\par
656    {\cf19 if} (state->select_end < state->select_start) \{\par
657       {\cf18 int} temp = state->select_end;\par
658       state->select_end = state->select_start;\par
659       state->select_start = temp;\par
660    \}\par
661 \}\par
662 \par
663 {\cf20 // move cursor to first character of selection}\par
664 {\cf17 static} {\cf18 void} stb_textedit_move_to_first(STB_TexteditState *state)\par
665 \{\par
666    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
667       stb_textedit_sortselection(state);\par
668       state->cursor = state->select_start;\par
669       state->select_end = state->select_start;\par
670       state->has_preferred_x = 0;\par
671    \}\par
672 \}\par
673 \par
674 {\cf20 // move cursor to last character of selection}\par
675 {\cf17 static} {\cf18 void} stb_textedit_move_to_last(IMSTB_TEXTEDIT_STRING *str, STB_TexteditState *state)\par
676 \{\par
677    {\cf19 if} (STB_TEXT_HAS_SELECTION(state)) \{\par
678       stb_textedit_sortselection(state);\par
679       stb_textedit_clamp(str, state);\par
680       state->cursor = state->select_end;\par
681       state->select_start = state->select_end;\par
682       state->has_preferred_x = 0;\par
683    \}\par
684 \}\par
