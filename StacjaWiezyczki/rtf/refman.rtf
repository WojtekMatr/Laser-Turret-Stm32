599     ImVec2      GetBR(){\cf17  const                       }\{ {\cf19 return} Max; \}                   {\cf20 // Bottom-right}\par
600     {\cf18 bool}        Contains({\cf17 const} ImVec2& p){\cf17  const     }\{ {\cf19 return} p.x     >= Min.x && p.y     >= Min.y && p.x     <  Max.x && p.y     <  Max.y; \}\par
601     {\cf18 bool}        Contains({\cf17 const} ImRect& r){\cf17  const     }\{ {\cf19 return} r.Min.x >= Min.x && r.Min.y >= Min.y && r.Max.x <= Max.x && r.Max.y <= Max.y; \}\par
602     {\cf18 bool}        ContainsWithPad({\cf17 const} ImVec2& p, {\cf17 const} ImVec2& pad){\cf17  const }\{ {\cf19 return} p.x >= Min.x - pad.x && p.y >= Min.y - pad.y && p.x < Max.x + pad.x && p.y < Max.y + pad.y; \}\par
603     {\cf18 bool}        Overlaps({\cf17 const} ImRect& r){\cf17  const     }\{ {\cf19 return} r.Min.y <  Max.y && r.Max.y >  Min.y && r.Min.x <  Max.x && r.Max.x >  Min.x; \}\par
604     {\cf18 void}        Add({\cf17 const} ImVec2& p)                \{ {\cf19 if} (Min.x > p.x)     Min.x = p.x;     {\cf19 if} (Min.y > p.y)     Min.y = p.y;     {\cf19 if} (Max.x < p.x)     Max.x = p.x;     {\cf19 if} (Max.y < p.y)     Max.y = p.y; \}\par
605     {\cf18 void}        Add({\cf17 const} ImRect& r)                \{ {\cf19 if} (Min.x > r.Min.x) Min.x = r.Min.x; {\cf19 if} (Min.y > r.Min.y) Min.y = r.Min.y; {\cf19 if} (Max.x < r.Max.x) Max.x = r.Max.x; {\cf19 if} (Max.y < r.Max.y) Max.y = r.Max.y; \}\par
606     {\cf18 void}        Expand({\cf17 const} {\cf18 float} amount)          \{ Min.x -= amount;   Min.y -= amount;   Max.x += amount;   Max.y += amount; \}\par
607     {\cf18 void}        Expand({\cf17 const} ImVec2& amount)        \{ Min.x -= amount.x; Min.y -= amount.y; Max.x += amount.x; Max.y += amount.y; \}\par
608     {\cf18 void}        Translate({\cf17 const} ImVec2& d)          \{ Min.x += d.x; Min.y += d.y; Max.x += d.x; Max.y += d.y; \}\par
609     {\cf18 void}        TranslateX({\cf18 float} dx)                \{ Min.x += dx; Max.x += dx; \}\par
