12 {\cf20 //}\par
13 {\cf20 // This library does no range checking of the offsets found in the file,}\par
14 {\cf20 // meaning an attacker can use it to read arbitrary memory.}\par
15 {\cf20 //}\par
16 {\cf20 // =======================================================================}\par
17 {\cf20 //}\par
18 {\cf20 //   This library processes TrueType files:}\par
19 {\cf20 //        parse files}\par
20 {\cf20 //        extract glyph metrics}\par
21 {\cf20 //        extract glyph shapes}\par
22 {\cf20 //        render glyphs to one-channel bitmaps with antialiasing (box filter)}\par
23 {\cf20 //        render glyphs to one-channel SDF bitmaps (signed-distance field/function)}\par
24 {\cf20 //}\par
25 {\cf20 //   Todo:}\par
26 {\cf20 //        non-MS cmaps}\par
27 {\cf20 //        crashproof on bad data}\par
28 {\cf20 //        hinting? (no longer patented)}\par
29 {\cf20 //        cleartype-style AA?}\par
30 {\cf20 //        optimize: use simple memory allocator for intermediates}\par
31 {\cf20 //        optimize: build edge-list directly from curves}\par
32 {\cf20 //        optimize: rasterize directly from curves?}\par
33 {\cf20 //}\par
