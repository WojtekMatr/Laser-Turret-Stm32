527 {\cf20 // TEXTURE BAKING API}\par
528 {\cf20 //}\par
529 {\cf20 // If you use this API, you only have to call two functions ever.}\par
530 {\cf20 //}\par
531 \par
532 {\cf17 typedef} {\cf17 struct}\par
533 \{\par
534    {\cf18 unsigned} {\cf18 short} x0,y0,x1,y1; {\cf20 // coordinates of bbox in bitmap}\par
535    {\cf18 float} xoff,yoff,xadvance;\par
536 \} stbtt_bakedchar;\par
537 \par
538 STBTT_DEF {\cf18 int} stbtt_BakeFontBitmap({\cf17 const} {\cf18 unsigned} {\cf18 char} *data, {\cf18 int} offset,  {\cf20 // font location (use offset=0 for plain .ttf)}\par
539                                 {\cf18 float} pixel_height,                     {\cf20 // height of font in pixels}\par
540                                 {\cf18 unsigned} {\cf18 char} *pixels, {\cf18 int} pw, {\cf18 int} ph,  {\cf20 // bitmap to be filled in}\par
541                                 {\cf18 int} first_char, {\cf18 int} num_chars,          {\cf20 // characters to bake}\par
542                                 stbtt_bakedchar *chardata);             {\cf20 // you allocate this, it's num_chars long}\par
543 {\cf20 // if return is positive, the first unused row of the bitmap}\par
544 {\cf20 // if return is negative, returns the negative of the number of characters that fit}\par
545 {\cf20 // if return is 0, no characters fit and no rows were used}\par
546 {\cf20 // This uses a very crappy packing.}\par
547 \par
548 {\cf17 typedef} {\cf17 struct}\par
549 \{\par
550    {\cf18 float} x0,y0,s0,t0; {\cf20 // top-left}\par
551    {\cf18 float} x1,y1,s1,t1; {\cf20 // bottom-right}\par
552 \} stbtt_aligned_quad;\par
553 \par
554 STBTT_DEF {\cf18 void} stbtt_GetBakedQuad({\cf17 const} stbtt_bakedchar *chardata, {\cf18 int} pw, {\cf18 int} ph,  {\cf20 // same data as above}\par
555                                {\cf18 int} char_index,             {\cf20 // character to display}\par
556                                {\cf18 float} *xpos, {\cf18 float} *ypos,   {\cf20 // pointers to current position in screen pixel space}\par
557                                stbtt_aligned_quad *q,      {\cf20 // output: quad to draw}\par
558                                {\cf18 int} opengl_fillrule);       {\cf20 // true if opengl fill rule; false if DX9 or earlier}\par
559 {\cf20 // Call GetBakedQuad with char_index = 'character - first_char', and it}\par
560 {\cf20 // creates the quad you need to draw and advances the current position.}\par
561 {\cf20 //}\par
562 {\cf20 // The coordinate system used assumes y increases downwards.}\par
563 {\cf20 //}\par
564 {\cf20 // Characters will extend both above and below the current position;}\par
565 {\cf20 // see discussion of "BASELINE" above.}\par
566 {\cf20 //}\par
567 {\cf20 // It's inefficient; you might want to c&p it and optimize it.}\par
