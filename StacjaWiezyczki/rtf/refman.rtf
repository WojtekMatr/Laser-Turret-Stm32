2550                   stbtt_uint8 *pairValueArray = pairValueTable + 2;\par
2551 \par
2552                   {\cf19 if} (coverageIndex >= pairSetCount) {\cf19 return} 0;\par
2553 \par
2554                   needle=glyph2;\par
2555                   r=pairValueCount-1;\par
2556                   l=0;\par
2557 \par
2558                   {\cf20 // Binary search.}\par
2559                   {\cf19 while} (l <= r) \{\par
2560                      stbtt_uint16 secondGlyph;\par
2561                      stbtt_uint8 *pairValue;\par
2562                      m = (l + r) >> 1;\par
2563                      pairValue = pairValueArray + (2 + valueRecordPairSizeInBytes) * m;\par
2564                      secondGlyph = ttUSHORT(pairValue);\par
2565                      straw = secondGlyph;\par
