3149 {\cf20 // ImDrawCallback: Draw callbacks for advanced uses [configurable type: override in imconfig.h]}\par
3150 {\cf20 // NB: You most likely do NOT need to use draw callbacks just to create your own widget or customized UI rendering,}\par
3151 {\cf20 // you can poke into the draw list for that! Draw callback may be useful for example to:}\par
3152 {\cf20 //  A) Change your GPU render state,}\par
3153 {\cf20 //  B) render a complex 3D scene inside a UI element without an intermediate texture/render target, etc.}\par
3154 {\cf20 // The expected behavior from your rendering function is 'if (cmd.UserCallback != NULL) \{ cmd.UserCallback(parent_list, cmd); \} else \{ RenderTriangles() \}'}\par
3155 {\cf20 // If you want to override the signature of ImDrawCallback, you can simply use e.g. '#define ImDrawCallback MyDrawCallback' (in imconfig.h) + update rendering backend accordingly.}\par
3156 {\cf21 #ifndef ImDrawCallback}\par
3157 {\cf17 typedef} void (*ImDrawCallback)({\cf17 const} ImDrawList* parent_list, {\cf17 const} ImDrawCmd* cmd);\par
3158 {\cf21 #endif}\par
3159 \par
3160 {\cf20 // Special Draw callback value to request renderer backend to reset the graphics/render state.}\par
3161 {\cf20 // The renderer backend needs to handle this special value, otherwise it will crash trying to call a function at this address.}\par
3162 {\cf20 // This is useful, for example, if you submitted callbacks which you know have altered the render state and you want it to be restored.}\par
3163 {\cf20 // Render state is not reset by default because they are many perfectly useful way of altering render state (e.g. changing shader/blending settings before an Image call).}\par
3164 {\cf21 #define ImDrawCallback_ResetRenderState     (ImDrawCallback)(-8)}\par
3165 \par
3166 {\cf20 // Typically, 1 command = 1 GPU draw call (unless command is a callback)}\par
3167 {\cf20 // - VtxOffset: When 'io.BackendFlags & ImGuiBackendFlags_RendererHasVtxOffset' is enabled,}\par
3168 {\cf20 //   this fields allow us to render meshes larger than 64K vertices while keeping 16-bit indices.}\par
3169 {\cf20 //   Backends made for <1.71. will typically ignore the VtxOffset fields.}\par
3170 {\cf20 // - The ClipRect/TexRef/VtxOffset fields must be contiguous as we memcmp() them together (this is asserted for).}\par
3171 {\cf17 struct }ImDrawCmd\par
3172 \{\par
3173     ImVec4          ClipRect;           {\cf20 // 4*4  // Clipping rectangle (x1, y1, x2, y2). Subtract ImDrawData->DisplayPos to get clipping rectangle in "viewport" coordinates}\par
3174     ImTextureRef    TexRef;             {\cf20 // 16   // Reference to a font/texture atlas (where backend called ImTextureData::SetTexID()) or to a user-provided texture ID (via e.g. ImGui::Image() calls). Both will lead to a ImTextureID value.}\par
3175     {\cf18 unsigned} {\cf18 int}    VtxOffset;          {\cf20 // 4    // Start offset in vertex buffer. ImGuiBackendFlags_RendererHasVtxOffset: always 0, otherwise may be >0 to support meshes larger than 64K vertices with 16-bit indices.}\par
3176     {\cf18 unsigned} {\cf18 int}    IdxOffset;          {\cf20 // 4    // Start offset in index buffer.}\par
3177     {\cf18 unsigned} {\cf18 int}    ElemCount;          {\cf20 // 4    // Number of indices (multiple of 3) to be rendered as triangles. Vertices are stored in the callee ImDrawList's vtx_buffer[] array, indices in idx_buffer[].}\par
3178     ImDrawCallback  UserCallback;       {\cf20 // 4-8  // If != NULL, call the function instead of rendering the vertices. clip_rect and texture_id will be set normally.}\par
3179     {\cf18 void}*           UserCallbackData;   {\cf20 // 4-8  // Callback user data (when UserCallback != NULL). If called AddCallback() with size == 0, this is a copy of the AddCallback() argument. If called AddCallback() with size > 0, this is pointing to a buffer where data is stored.}\par
3180     {\cf18 int}             UserCallbackDataSize;  {\cf20 // 4 // Size of callback user data when using storage, otherwise 0.}\par
3181     {\cf18 int}             UserCallbackDataOffset;{\cf20 // 4 // [Internal] Offset of callback user data when using storage, otherwise -1.}\par
3182 \par
3183     ImDrawCmd()     \{ memset(({\cf18 void}*){\cf17 this}, 0, {\cf17 sizeof}(*{\cf17 this})); \} {\cf20 // Also ensure our padding fields are zeroed}\par
3184 \par
3185     {\cf20 // Since 1.83: returns ImTextureID associated with this draw call. Warning: DO NOT assume this is always same as 'TextureId' (we will change this function for an upcoming feature)}\par
3186     {\cf20 // Since 1.92: removed ImDrawCmd::TextureId field, the getter function must be used!}\par
3187     {\cf17 inline} ImTextureID GetTexID() {\cf17 const};    {\cf20 // == (TexRef._TexData ? TexRef._TexData->TexID : TexRef._TexID)}\par
3188 \};\par
